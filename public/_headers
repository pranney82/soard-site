## Cache financial PDFs (rarely change, large files)
/financials/*
  Cache-Control: public, max-age=2592000, s-maxage=31536000
  Content-Disposition: inline

## CF Images — immutable, content-negotiated (AVIF/WebP/JPEG via Accept header)
/cdn-cgi/imagedelivery/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept

## Cache static assets aggressively
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

## OG images are regenerated at the SAME URL when content changes —
## they must not inherit the year-long immutable rule above.
/og/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.webmanifest
  Cache-Control: public, max-age=86400

## Cache HTML in browsers briefly, but NOT at the Cloudflare edge (no s-maxage):
## edge-cached HTML survives deploys for up to an hour, so content updates,
## video attaches, and admin publishes looked broken while stale copies served.
## Pages' own asset delivery is already fast without the zone cache.
/*.html
  Cache-Control: public, max-age=300, must-revalidate

