---
/**
 * RevealGrid: reveal video cards + a lightbox player.
 *
 * Used by /reveals/ (full list, year filter) and the /live/ "past reveals"
 * section. Each instance renders its own <dialog>, and the script binds
 * every grid on the page once, so the component is safe to use twice.
 *
 * Cards are links to the video's watch page (the no-JS fallback); with JS
 * a plain click opens the in-page player instead. Modified clicks
 * (cmd/ctrl/shift, middle button) keep the browser's default.
 */
import type { Reveal } from '../../utils/reveals';
import { nextRevealGridId, STREAM_CUSTOMER_HOST } from '../../utils/reveals';
import { cfRaw, cfSrcset } from '../../utils/cf-image';
import lqipManifest from '../../data/lqip-kids.json';

interface Props {
  reveals: Reveal[];
  /** Max columns on wide screens */
  columns?: 3 | 4;
  /** Heading level for card titles, to fit the page outline */
  headingLevel?: 'h2' | 'h3' | 'h4';
  /** Show year filter chips above the grid */
  filter?: boolean;
  /** Mirror the chosen year in ?year= so a filtered view can be shared */
  syncUrl?: boolean;
  /** How many card images load eagerly (above the fold) */
  eager?: number;
  /** Accessible name for the card list */
  label?: string;
}

const {
  reveals,
  columns = 3,
  headingLevel = 'h3',
  filter = false,
  syncUrl = false,
  eager = 0,
  label = 'Reveal videos',
} = Astro.props;

const gid = nextRevealGridId();
const Heading = headingLevel;
const lqip: Record<string, string> = lqipManifest;

const years = filter
  ? [...new Set(reveals.flatMap((r) => r.years))].sort((a, b) => b - a)
  : [];
const yearCounts = new Map<number, number>();
for (const r of reveals) for (const y of r.years) yearCounts.set(y, (yearCounts.get(y) || 0) + 1);

const sizes = columns === 4
  ? '(min-width: 1200px) 276px, (min-width: 1100px) calc(25vw - 30px), (min-width: 760px) calc(33vw - 34px), calc(50vw - 31px)'
  : '(min-width: 1200px) 368px, (min-width: 760px) calc(33vw - 34px), calc(50vw - 31px)';

function art(r: Reveal) {
  if (r.image) {
    return {
      src: cfRaw(r.image, 'w=480,h=360,fit=cover,gravity=face,q=72,metadata=none'),
      srcset: cfSrcset(r.image, [320, 480, 640, 800], { fit: 'cover', gravity: 'face', aspectRatio: 0.75, quality: 72 }),
      placeholder: lqip[r.image] || '',
    };
  }
  // No kid photo: fall back to the video's own frame (CSP allows both hosts)
  if (r.source.type === 'youtube') {
    return { src: `https://i.ytimg.com/vi/${r.source.id}/hqdefault.jpg`, srcset: '', placeholder: '' };
  }
  return {
    src: `https://${STREAM_CUSTOMER_HOST}/${r.source.id}/thumbnails/thumbnail.jpg?time=2s&width=640&height=480&fit=crop`,
    srcset: '',
    placeholder: '',
  };
}

function meta(r: Reveal) {
  return [r.yearLabel, r.rooms.join(', ')].filter(Boolean).join(' · ');
}
---

<div class="rv" data-rv data-columns={columns} data-rv-sync={syncUrl ? '' : undefined}>
  {filter && years.length > 1 && (
    <div class="rv-filter" data-rv-filter role="group" aria-label="Filter reveals by year">
      <button type="button" class="rv-chip is-active" data-rv-year="all" aria-pressed="true">
        All <span class="rv-chip__n">{reveals.length}</span>
      </button>
      {years.map((y) => (
        <button type="button" class="rv-chip" data-rv-year={String(y)} aria-pressed="false">
          {y} <span class="rv-chip__n">{yearCounts.get(y)}</span>
        </button>
      ))}
    </div>
  )}

  <ul class="rv-grid" role="list" aria-label={label}>
    {reveals.map((r, i) => {
      const a = art(r);
      const isEager = i < eager;
      return (
        <li class="rv-card" data-rv-card data-years={r.years.join(' ')}>
          <div class="rv-card__media" style={a.placeholder ? `background-image:url(${a.placeholder})` : undefined}>
            <img
              class="rv-card__img lqip-img"
              src={a.src}
              srcset={a.srcset || undefined}
              sizes={a.srcset ? sizes : undefined}
              alt={`Photo of ${r.names}`}
              width="480"
              height="360"
              loading={isEager ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="rv-card__shade" aria-hidden="true"></span>
            {r.kind === 'live' && (
              <span class="rv-badge rv-badge--live" aria-hidden="true">
                <span class="rv-badge__dot"></span>Live stream
              </span>
            )}
            {r.kids.length > 3 && (
              <span class="rv-badge rv-badge--count" aria-hidden="true">{r.kids.length} kids</span>
            )}
            <span class="rv-card__play" aria-hidden="true">
              <svg viewBox="0 0 24 28" fill="currentColor"><path d="M2 1.5v25l20-12.5L2 1.5z" /></svg>
            </span>
          </div>
          <div class="rv-card__body">
            <Heading class="rv-card__title">
              <a
                class="rv-card__link"
                href={r.watchUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-haspopup="dialog"
                data-rv-open
                data-embed={r.embedUrl}
                data-aspect={String(r.source.aspect)}
                data-title={r.title}
                data-meta={meta(r)}
                data-kids={JSON.stringify(r.kids.map((k) => [k.slug, k.name]))}
              >
                <span class="sr-only">Play </span>{r.title}{r.kind === 'live' && <span class="sr-only"> (live stream replay)</span>}
              </a>
            </Heading>
            {r.kids.length > 3 && <p class="rv-card__names">{r.names}</p>}
            {(r.yearLabel || r.rooms.length > 0) && (
              <p class="rv-card__meta">
                {r.yearLabel && <span class="rv-card__year">{r.yearLabel}</span>}
                {r.rooms.length > 0 && <span class="rv-card__rooms">{r.rooms.join(', ')}</span>}
              </p>
            )}
          </div>
        </li>
      );
    })}
  </ul>

  {filter && <p class="rv-empty" data-rv-empty hidden>No reveal videos for that year yet.</p>}
  <p class="sr-only" data-rv-status aria-live="polite"></p>

  <dialog class="rv-modal" data-rv-modal aria-labelledby={`${gid}-title`}>
    <div class="rv-modal__panel">
      <div class="rv-modal__bar">
        <h2 class="rv-modal__title" id={`${gid}-title`} data-rv-title>Reveal video</h2>
        <button type="button" class="rv-modal__close" data-rv-close aria-label="Close video">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
      </div>
      <div class="rv-modal__frame" data-rv-frame></div>
      <div class="rv-modal__info">
        <p class="rv-modal__meta" data-rv-meta></p>
        <div class="rv-modal__stories" data-rv-stories></div>
      </div>
    </div>
  </dialog>
</div>

<script>
  const LOCK_CLASS = 'rv-scroll-lock';
  const EMBED_ORIGINS = [
    'https://www.youtube-nocookie.com/',
    'https://customer-cuav5h47lgfe96ql.cloudflarestream.com/',
  ];

  function lockScroll() {
    const root = document.documentElement;
    if (root.classList.contains(LOCK_CLASS)) return;
    const gutter = window.innerWidth - root.clientWidth;
    root.classList.add(LOCK_CLASS);
    if (gutter > 0) document.body.style.paddingRight = `${gutter}px`;
  }

  function unlockScroll() {
    document.documentElement.classList.remove(LOCK_CLASS);
    document.body.style.paddingRight = '';
  }

  function storyLink(slug: string, text: string) {
    const a = document.createElement('a');
    a.href = `/kids/${encodeURIComponent(slug)}/`;
    a.textContent = text;
    return a;
  }

  function bindPlayer(root: HTMLElement, dialog: HTMLDialogElement) {
    const frame = dialog.querySelector<HTMLElement>('[data-rv-frame]')!;
    const titleEl = dialog.querySelector<HTMLElement>('[data-rv-title]')!;
    const metaEl = dialog.querySelector<HTMLElement>('[data-rv-meta]')!;
    const storiesEl = dialog.querySelector<HTMLElement>('[data-rv-stories]')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-rv-close]')!;
    let opener: HTMLElement | null = null;

    const fillStories = (raw: string | undefined) => {
      storiesEl.replaceChildren();
      let kids: [string, string][] = [];
      try { kids = JSON.parse(raw || '[]'); } catch { kids = []; }
      if (kids.length === 1) {
        const [slug, name] = kids[0];
        const a = storyLink(slug, `Read ${name}'s story`);
        a.className = 'rv-modal__story';
        storiesEl.append(a);
      } else if (kids.length > 1) {
        const lead = document.createElement('span');
        lead.className = 'rv-modal__stories-lead';
        lead.textContent = 'Read their stories:';
        const list = document.createElement('span');
        list.className = 'rv-modal__names';
        kids.forEach(([slug, name]) => list.append(storyLink(slug, name)));
        storiesEl.append(lead, list);
      }
      storiesEl.hidden = kids.length === 0;
    };

    const open = (link: HTMLElement) => {
      const d = link.dataset;
      const src = d.embed || '';
      if (!EMBED_ORIGINS.some((o) => src.startsWith(o))) {
        window.open((link as HTMLAnchorElement).href, '_blank', 'noopener');
        return;
      }
      opener = link;
      const aspect = Number(d.aspect) > 0 ? Number(d.aspect) : 16 / 9;
      titleEl.textContent = d.title || 'Reveal video';
      metaEl.textContent = d.meta || '';
      metaEl.hidden = !d.meta;
      fillStories(d.kids);

      dialog.style.setProperty('--rv-ar', String(aspect));
      dialog.classList.toggle('is-portrait', aspect < 1);

      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = `${d.title || 'Reveal'} video`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.replaceChildren(iframe);

      lockScroll();
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
      closeBtn.focus();
    };

    // Runs on every close path (button, Esc, backdrop, dialog.close())
    const cleanup = () => {
      frame.replaceChildren(); // dropping the iframe stops playback
      unlockScroll();
      const back = opener;
      opener = null;
      if (back && back.isConnected) back.focus({ preventScroll: true });
    };

    const close = () => {
      if (typeof dialog.close === 'function' && dialog.open) dialog.close();
      else if (dialog.hasAttribute('open')) {
        dialog.removeAttribute('open');
        cleanup();
      }
    };

    dialog.addEventListener('close', cleanup);
    closeBtn.addEventListener('click', close);
    // The dialog fills the viewport; a click outside the panel lands on the dialog itself
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      const items = Array.from(dialog.querySelectorAll<HTMLElement>('button, a[href], iframe'))
        .filter((el) => !el.closest('[hidden]'));
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (!active || !dialog.contains(active)) { e.preventDefault(); first.focus(); }
      else if (e.shiftKey && active === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
    });

    root.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLElement>('[data-rv-open]');
      if (!link || !root.contains(link)) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      open(link);
    });
  }

  function bindFilter(root: HTMLElement, bar: HTMLElement) {
    const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-rv-year]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-rv-card]'));
    const status = root.querySelector<HTMLElement>('[data-rv-status]');
    const empty = root.querySelector<HTMLElement>('[data-rv-empty]');
    const sync = root.hasAttribute('data-rv-sync');

    const apply = (year: string, opts: { announce?: boolean; url?: boolean } = {}) => {
      let shown = 0;
      for (const card of cards) {
        const match = year === 'all' || (card.dataset.years || '').split(' ').includes(year);
        card.hidden = !match;
        if (match) shown++;
      }
      for (const chip of chips) {
        const on = chip.dataset.rvYear === year;
        chip.classList.toggle('is-active', on);
        chip.setAttribute('aria-pressed', String(on));
      }
      if (empty) empty.hidden = shown > 0;
      if (status && opts.announce !== false) {
        status.textContent = year === 'all'
          ? `Showing all ${shown} reveals`
          : `Showing ${shown} ${shown === 1 ? 'reveal' : 'reveals'} from ${year}`;
      }
      if (sync && opts.url !== false) {
        const url = new URL(window.location.href);
        if (year === 'all') url.searchParams.delete('year');
        else url.searchParams.set('year', year);
        // Keep the router's history state; only the query changes
        history.replaceState(history.state, '', url);
      }
    };

    bar.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-rv-year]');
      if (chip && chip.dataset.rvYear) apply(chip.dataset.rvYear);
    });

    if (sync) {
      const wanted = new URL(window.location.href).searchParams.get('year');
      if (wanted && chips.some((c) => c.dataset.rvYear === wanted)) apply(wanted, { announce: false, url: false });
    }
  }

  function initRevealGrids() {
    document.querySelectorAll<HTMLElement>('[data-rv]:not([data-rv-bound])').forEach((root) => {
      root.setAttribute('data-rv-bound', '');
      const dialog = root.querySelector<HTMLDialogElement>('[data-rv-modal]');
      if (dialog) bindPlayer(root, dialog);
      const bar = root.querySelector<HTMLElement>('[data-rv-filter]');
      if (bar) bindFilter(root, bar);
    });
  }

  document.addEventListener('astro:page-load', initRevealGrids);
  // A view transition swaps the page out from under an open player
  document.addEventListener('astro:before-swap', unlockScroll);
</script>

<style>
  /* ── Year filter ── */
  .rv-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .rv-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 16px;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: 100px;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-text-muted);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }
  .rv-chip:hover { border-color: rgba(55, 58, 54, 0.35); color: var(--c-text); }
  .rv-chip:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; }
  .rv-chip__n {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--c-text-light);
    font-variant-numeric: tabular-nums;
  }
  .rv-chip.is-active {
    background: var(--c-dark);
    border-color: var(--c-dark);
    color: var(--c-white);
    box-shadow: 0 2px 8px rgba(55, 58, 54, 0.16);
  }
  .rv-chip.is-active .rv-chip__n { color: var(--c-yellow); }

  /* ── Grid ── */
  .rv-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 14px;
  }
  @media (min-width: 760px) {
    .rv-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 24px; }
  }
  @media (min-width: 1100px) {
    .rv[data-columns='4'] .rv-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* ── Card ── */
  .rv-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .rv-card[hidden] { display: none; }

  .rv-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 18px;
    overflow: hidden;
    background-color: var(--c-warm-gray);
    background-size: cover;
    background-position: center;
    box-shadow:
      0 1px 2px rgba(30, 31, 37, 0.05),
      0 10px 28px rgba(30, 31, 37, 0.08);
    transition: box-shadow 0.35s ease;
  }
  .rv-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }
  .rv-card__img.lqip-pending { opacity: 0; }
  .rv-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(30, 31, 37, 0.5) 0%, rgba(30, 31, 37, 0) 48%);
    pointer-events: none;
  }
  .rv-card__play {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--c-yellow);
    color: var(--c-dark-deep);
    box-shadow:
      0 0 0 6px rgba(255, 218, 36, 0.3),
      0 8px 22px rgba(0, 0, 0, 0.22);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }
  .rv-card__play svg { width: 15px; height: 18px; margin-left: 3px; }

  .rv-badge {
    position: absolute;
    top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    border-radius: 100px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .rv-badge--live {
    left: 12px;
    background: var(--c-dark-deep);
    color: var(--c-cream);
  }
  .rv-badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-yellow);
    box-shadow: 0 0 0 3px rgba(255, 218, 36, 0.25);
  }
  .rv-badge--count {
    right: 12px;
    background: rgba(254, 252, 245, 0.95);
    color: var(--c-dark);
  }

  .rv-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-inline: 2px;
    min-width: 0;
  }
  .rv-card__title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.35vw + 0.92rem, 1.15rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--c-text);
    margin: 0;
    text-wrap: pretty;
  }
  .rv-card__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease;
  }
  /* The link covers the whole card, so the photo plays too */
  .rv-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: 18px;
  }
  /* Same two-tone ring as the global :focus-visible, drawn around the whole card */
  .rv-card__link:focus-visible { outline: none; box-shadow: none; }
  .rv-card__link:focus-visible::after {
    inset: -8px;
    border-radius: 24px;
    outline: 2px solid var(--c-dark);
    outline-offset: 2px;
    box-shadow: 0 0 0 5px var(--c-yellow);
  }
  .rv-card__names {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--c-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rv-card__meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--c-text-muted);
  }
  .rv-card__year {
    font-weight: 700;
    color: var(--c-text);
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) {
    .rv-card:hover .rv-card__media {
      box-shadow:
        0 2px 4px rgba(30, 31, 37, 0.06),
        0 18px 40px rgba(30, 31, 37, 0.14);
    }
    .rv-card:hover .rv-card__img { transform: scale(1.04); }
    .rv-card:hover .rv-card__play {
      transform: scale(1.08);
      box-shadow:
        0 0 0 8px rgba(255, 218, 36, 0.36),
        0 10px 26px rgba(0, 0, 0, 0.25);
    }
    .rv-card:hover .rv-card__link { text-decoration-color: var(--c-yellow); }
  }
  .rv-card:focus-within .rv-card__link { text-decoration-color: var(--c-yellow); }

  .rv-empty {
    margin: 8px 0 0;
    padding: 28px;
    text-align: center;
    border: 1px dashed var(--c-border);
    border-radius: var(--border-radius-lg);
    color: var(--c-text-muted);
  }

  @media (max-width: 640px) {
    .rv-filter {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      padding-bottom: 4px;
      -webkit-mask-image: linear-gradient(to right, #000 85%, transparent);
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
    .rv-filter::-webkit-scrollbar { display: none; }
    .rv-chip { min-height: 38px; padding: 0 14px; }
    .rv-card { gap: 10px; }
    .rv-card__media { border-radius: 14px; }
    .rv-card__link::after { border-radius: 14px; }
    .rv-card__play { left: 10px; bottom: 10px; width: 38px; height: 38px; box-shadow: 0 0 0 4px rgba(255, 218, 36, 0.3), 0 6px 16px rgba(0, 0, 0, 0.22); }
    .rv-card__play svg { width: 12px; height: 14px; margin-left: 2px; }
    .rv-badge { top: 8px; padding: 6px 9px; font-size: 0.6rem; gap: 6px; }
    .rv-badge--live { left: 8px; }
