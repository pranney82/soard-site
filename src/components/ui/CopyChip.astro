---
/**
 * CopyChip.astro
 * One-tap copy-to-clipboard chip for donor reference data (EIN, mailing
 * address) — the values people carry into DAF portals and grant forms.
 * `theme="dark"` for dark sections; light (default) for cream/white.
 */
interface Props {
  text: string;
  label?: string;
  theme?: 'light' | 'dark';
}
const { text, label = 'Copy to clipboard', theme = 'light' } = Astro.props;
---
<button
  type="button"
  class:list={['copy-chip', { 'copy-chip--dark': theme === 'dark' }]}
  data-copy={text}
  data-label={label}
  aria-label={label}
>
  <svg class="ico-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
  <svg class="ico-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</button>

<style>
  .copy-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    flex-shrink: 0;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    color: var(--c-text-muted);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .copy-chip:hover { color: var(--c-dark); border-color: var(--c-dark); }
  .copy-chip svg { width: 14px; height: 14px; }
  .copy-chip .ico-check { display: none; }
  .copy-chip.is-copied { color: var(--c-dark); border-color: var(--c-yellow); background: var(--c-yellow-soft); }
  .copy-chip.is-copied .ico-copy { display: none; }
  .copy-chip.is-copied .ico-check { display: block; }
  .copy-chip--dark { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.16); color: rgba(255,255,255,0.7); }
  .copy-chip--dark:hover { color: #fff; border-color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.1); }
  .copy-chip--dark.is-copied { color: var(--c-yellow); border-color: var(--c-yellow); background: rgba(255,218,36,0.12); }
  @media (pointer: coarse) {
    .copy-chip { width: 36px; height: 36px; }
  }
</style>

<script>
  /* Document-level delegation: bundled once, survives view-transition swaps
     without per-page re-init or cleanup. */
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.copy-chip');
    if (!btn?.dataset.copy) return;
    try { await navigator.clipboard.writeText(btn.dataset.copy); } catch { return; }
    btn.classList.add('is-copied');
    btn.setAttribute('aria-label', 'Copied');
    setTimeout(() => {
      btn.classList.remove('is-copied');
      btn.setAttribute('aria-label', btn.dataset.label || 'Copy to clipboard');
    }, 1800);
  });
</script>
