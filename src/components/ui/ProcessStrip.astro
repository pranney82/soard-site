---
/**
 * ProcessStrip.astro
 * Compact "how a room gets built" strip for conversion pages. Six steps in a
 * row, one line each, linking to the full case-file page at /how-it-works/.
 *
 * variant="donate"   → framed as "what your gift sets in motion"
 * variant="partners" → framed as "where you fit in the build"
 */
interface Props {
  variant?: 'donate' | 'partners';
}
const { variant = 'donate' } = Astro.props;

const copy = {
  donate: {
    label: 'After You Give',
    heading: 'What your gift sets in <em>motion</em>',
    lead: 'Every dollar moves a real room through the same six steps. Follow one from the first application to the reveal.',
    steps: [
      { title: 'Apply', text: 'A family tells us their story and walks us through the space on video.' },
      { title: 'Select', text: 'The committee reads every application, interviews, and visits the home.' },
      { title: 'Design', text: 'Designers draw three layouts. The family walks them at full scale and picks one, then the finishes.' },
      { title: 'Source', text: 'Partners donate flooring, fixtures, furniture, and labor. Your gift fills the gaps.' },
      { title: 'Build', text: 'Contractor partners run the build, start to finish.' },
      { title: 'Reveal', text: 'The child walks in. Everything changes.' },
    ],
    cta: 'See a room built start to finish',
  },
  partners: {
    label: 'Where You Fit',
    heading: 'Every room needs a <em>crew</em>',
    lead: 'Six steps, and partners carry four of them. Here is where a designer, a supplier, a contractor, or a sponsor plugs in.',
    steps: [
      { title: 'Apply', text: 'Families apply. Staff and the committee take it from here.' },
      { title: 'Select', text: 'Interview, home visit, and a yes.' },
      { title: 'Design', text: 'Design partners draw three layouts. The family picks one, then every finish.' },
      { title: 'Source', text: 'Material partners and sponsors supply what the drawings call for.' },
      { title: 'Build', text: 'Contractor partners run the build from demo to punch list.' },
      { title: 'Reveal', text: 'Everyone who touched the room is there when the child sees it.' },
    ],
    cta: 'See how a room gets built',
  },
}[variant];
---

<section class={`pstrip pstrip--${variant}`} aria-labelledby="pstrip-heading">
  <div class="pstrip__inner">
    <div class="pstrip__head" data-reveal>
      <div class="section-label">{copy.label}</div>
      <h2 id="pstrip-heading" set:html={copy.heading} />
      <p class="pstrip__lead">{copy.lead}</p>
    </div>
    <ol class="pstrip__steps" data-reveal data-delay="1">
      {copy.steps.map((s, i) => (
        <li class="pstrip__step">
          <span class="pstrip__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="pstrip__title">{s.title}</span>
          <span class="pstrip__text">{s.text}</span>
        </li>
      ))}
    </ol>
    <div class="pstrip__foot" data-reveal data-delay="2">
      <a href="/how-it-works/" class="pstrip__link">{copy.cta} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
  </div>
</section>

<style>
  .pstrip {
    padding: 72px 0;
    background: var(--c-white);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
    contain: layout style;
  }
  .pstrip--partners { background: var(--c-cream); }
  .pstrip__inner { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-xl); }
  .pstrip__head { max-width: 640px; margin-bottom: 36px; }
  .pstrip__head h2 { font-size: clamp(24px, 3vw, 34px); line-height: 1.2; margin-bottom: 12px; letter-spacing: -0.01em; }
  .pstrip__head h2 :global(em) {
    font-style: italic;
    background-image: linear-gradient(transparent 55%, var(--c-yellow-soft) 55%);
    padding: 0 0.08em;
  }
  .pstrip__lead { font-size: 16px; line-height: 1.7; color: var(--c-text-muted); margin: 0; }

  /* Six steps on one connected line */
  .pstrip__steps {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px;
    position: relative;
  }
  .pstrip__steps::before {
    content: '';
    position: absolute; left: 0; right: 0; top: 13px;
    height: 2px;
    background: linear-gradient(90deg, var(--c-yellow) 0%, var(--c-yellow) 85%, transparent 100%);
    opacity: 0.6;
  }
  .pstrip__step { position: relative; padding-top: 38px; }
  .pstrip__num {
    position: absolute; top: 0; left: 0;
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--c-yellow); color: var(--c-dark);
    font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 0.04em;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 0 5px var(--c-white);
  }
  .pstrip--partners .pstrip__num { box-shadow: 0 0 0 5px var(--c-cream); }
  .pstrip__title { display: block; font-family: var(--font-display); font-weight: 700; font-size: 17px; margin-bottom: 6px; color: var(--c-dark); }
  .pstrip__text { display: block; font-size: 13.5px; line-height: 1.55; color: var(--c-text-muted); }
  .pstrip__foot { margin-top: 32px; }
  .pstrip__link {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; font-weight: 700; color: var(--c-dark);
    padding: 12px 22px; border-radius: 100px;
    border: 1.5px solid var(--c-dark);
    transition: background 0.25s ease, color 0.25s ease, gap 0.25s ease, transform 0.25s ease;
  }
  .pstrip__link:hover { background: var(--c-dark); color: var(--c-yellow); gap: 12px; transform: translateY(-2px); }
  .pstrip__link:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 3px; }

  [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1); }
  [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  [data-delay="1"] { transition-delay: 0.1s; }
  [data-delay="2"] { transition-delay: 0.2s; }

  @media (max-width: 960px) {
    .pstrip__steps { grid-template-columns: repeat(3, 1fr); gap: 28px 20px; }
    .pstrip__steps::before { display: none; }
  }
  @media (max-width: 560px) {
    .pstrip { padding: 56px 0; }
    .pstrip__steps { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .pstrip__link { transition: none; }
  }
</style>
