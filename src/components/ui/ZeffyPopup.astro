---
/**
 * ZeffyPopup — a Zeffy form in a pop-up on our own page, so a giver never leaves the site.
 *
 * Put <ZeffyPopup /> once on a page. Any link on it with data-zeffy="<the form's embed>" (embedOf() in
 * public/admin/zeffy-links.js) then opens that form here, with the link's own ?amount= filled in. The link's href
 * stays the form's full page: what a person gets with no JavaScript, or opening it in a new tab.
 *
 * Used by /donate/ (every gift button, and Give from your DAF) and /ways-to-give/ (Give from Your DAF).
 *
 * Focus works like the kid-page reveal modal: remember who opened it, move focus into the dialog, keep Tab inside it,
 * and give focus back on close. Escape closes it.
 */
---

<div class="zeffy-modal" id="zeffy-modal" aria-hidden="true" inert role="dialog" aria-modal="true" aria-label="Donation form">
  <div class="zeffy-modal-backdrop" id="zeffy-modal-close"></div>
  <div class="zeffy-modal-container">
    <button class="zeffy-modal-x" id="zeffy-modal-x" type="button" aria-label="Close donation form">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <iframe id="zeffy-iframe" title="Donation form powered by Zeffy" allow="payment" allowpaymentrequest></iframe>
  </div>
</div>

<script>
  /* Per-visit: everything below is aborted on astro:before-swap, so listeners never stack across client-side
     navigations, and the page never stays locked if someone leaves with the pop-up open */
  let _popupAC: AbortController | null = null;

  function cleanupPopup() {
    _popupAC?.abort();
    _popupAC = null;
    document.body.style.overflow = '';
  }

  document.addEventListener('astro:page-load', () => {
    cleanupPopup();
    const modal = document.getElementById('zeffy-modal');
    const iframe = document.getElementById('zeffy-iframe') as HTMLIFrameElement | null;
    if (!modal || !iframe) return;
    _popupAC = new AbortController();
    const signal = _popupAC.signal;
    let previousFocus: HTMLElement | null = null;

    // The link's own form, as Zeffy embeds it (data-zeffy), with the link's amount
    function openModal(link: HTMLAnchorElement) {
      const amount = new URL(link.href).searchParams.get('amount');
      const src = new URL(link.dataset.zeffy || '');
      if (amount) src.searchParams.set('amount', amount);
      iframe!.src = src.toString();
      previousFocus = document.activeElement as HTMLElement | null;
      modal!.classList.add('is-open');
      modal!.setAttribute('aria-hidden', 'false');
      modal!.inert = false;
      document.body.style.overflow = 'hidden';
      document.getElementById('zeffy-modal-x')?.focus();
    }

    function closeModal() {
      modal!.classList.remove('is-open');
      modal!.setAttribute('aria-hidden', 'true');
      modal!.inert = true;
      document.body.style.overflow = '';
      previousFocus?.focus();
      previousFocus = null;
      // 'about:blank': an empty src resolves to the page's own URL, which would reload the whole page invisibly
      setTimeout(() => { if (!modal!.classList.contains('is-open')) iframe!.src = 'about:blank'; }, 350);
    }

    // One listener for every data-zeffy link on the page, including any added after load. A link whose data-zeffy
    // isn't a link at all opens its href as usual rather than an empty pop-up
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = (e.target as Element | null)?.closest?.('a[data-zeffy]') as HTMLAnchorElement | null;
      if (!link || !/^https:\/\//.test(link.dataset.zeffy || '')) return;
      e.preventDefault();
      openModal(link);
    }, { signal });

    document.getElementById('zeffy-modal-close')?.addEventListener('click', closeModal, { signal });
    document.getElementById('zeffy-modal-x')?.addEventListener('click', closeModal, { signal });

    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('is-open')) return;
      if (e.key === 'Escape') { closeModal(); return; }
      // Keep Tab inside the dialog: keyboard focus never wanders behind the backdrop
      if (e.key === 'Tab') {
        const focusables = Array.from(modal.querySelectorAll<HTMLElement>('button, iframe, a[href]'));
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (!active || !modal.contains(active)) { e.preventDefault(); first.focus(); }
        else if (e.shiftKey && active === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
      }
    }, { signal });
  });

  document.addEventListener('astro:before-swap', cleanupPopup);
</script>

<style>
  .zeffy-modal {
    position: fixed;
    inset: 0;
    /* Above the sticky header (1000) and mobile menu (1100), below only the focus-revealed skip link (9999) */
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    view-transition-name: none;
  }
  .zeffy-modal.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  .zeffy-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .zeffy-modal-container {
    position: relative;
    width: 90vw;
    max-width: 520px;
    height: 85vh;
    max-height: 700px;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.25);
    transform: translateY(24px) scale(0.97);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .zeffy-modal.is-open .zeffy-modal-container {
    transform: translateY(0) scale(1);
  }
  .zeffy-modal-x {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.06);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    color: var(--c-dark);
    transition: background 0.2s ease;
  }
  .zeffy-modal-x:hover { background: rgba(0, 0, 0, 0.12); }
  #zeffy-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 768px) {
    .zeffy-modal-container {
      width: 100vw;
      max-width: 100vw;
      height: 100vh;
      height: 100dvh;
      max-height: none;
      border-radius: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zeffy-modal, .zeffy-modal-container { transition: none; }
  }
</style>
