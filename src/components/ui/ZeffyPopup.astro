---
/**
 * ZeffyPopup — a Zeffy form in a pop-up on our own page, so a giver never leaves the site.
 *
 * Put <ZeffyPopup /> once on a page. Any link on it made with giftLink() or dafGift() (public/admin/zeffy-links.js)
 * then opens its form here: data-zeffy is the form's embed with the link's amount, and href is the form's own page,
 * what a person gets with no JavaScript, or opening it in a new tab.
 *
 * Used by /donate/ (every gift button, and Give from Your DAF) and /ways-to-give/ (Give from Your DAF).
 *
 * A native <dialog> opened with showModal(): the page behind can't be reached by Tab, a screen reader or a click
 * while it's open (keys typed inside Zeffy's form never reach our page, so this is the only thing that keeps focus
 * in). Escape, the close button and a click beside the form close it; focus goes back to the link. The form's frame
 * is made on each open and taken away on close, so opening the form never adds to the Back button's history.
 */
---

<dialog class="zeffy-modal" id="zeffy-modal" aria-label="Donation form">
  <div class="zeffy-modal-container" id="zeffy-modal-container">
    <button class="zeffy-modal-x" id="zeffy-modal-x" type="button" aria-label="Close donation form">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
</dialog>

<script>
  import { onPageLoad } from '../../utils/page-load';
  /* Per-visit: everything below is aborted on astro:before-swap, so listeners never stack across client-side
     navigations, and the page never stays locked if someone leaves with the pop-up open */
  let _popupAC: AbortController | null = null;

  function cleanupPopup() {
    const dialog = document.getElementById('zeffy-modal') as HTMLDialogElement | null;
    if (dialog?.open) dialog.close();
    _popupAC?.abort();
    _popupAC = null;
    document.body.style.overflow = '';
  }

  onPageLoad(() => {
    cleanupPopup();
    const dialog = document.getElementById('zeffy-modal') as HTMLDialogElement | null;
    const box = document.getElementById('zeffy-modal-container');
    if (!dialog || !box || typeof dialog.showModal !== 'function') return;
    _popupAC = new AbortController();
    const signal = _popupAC.signal;
    let opener: HTMLElement | null = null;

    // The link's own form, as Zeffy embeds it, with its amount (giftLink puts both in data-zeffy)
    function open(link: HTMLAnchorElement) {
      box!.querySelector('iframe')?.remove();
      const frame = document.createElement('iframe');
      frame.className = 'zeffy-modal-frame';
      frame.title = 'Donation form powered by Zeffy';
      frame.allow = 'payment';
      frame.src = link.dataset.zeffy!;
      box!.append(frame);
      opener = link;
      dialog!.showModal();
      document.body.style.overflow = 'hidden';
      document.getElementById('zeffy-modal-x')?.focus();
    }

    // However it closes (the button, Escape, a click beside the form, leaving the page): the frame goes, the page
    // scrolls again, and focus is back on the link that opened it
    dialog.addEventListener('close', () => {
      box.querySelector('iframe')?.remove();
      document.body.style.overflow = '';
      opener?.focus();
      opener = null;
    }, { signal });

    // One listener for every gift link on the page, including any added after load. A link whose data-zeffy isn't a
    // link at all opens its href as usual rather than an empty pop-up; ⌘/Ctrl/Shift/middle-click keep their new tab
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = (e.target as Element | null)?.closest?.('a[data-zeffy]') as HTMLAnchorElement | null;
      if (!link || !/^https:\/\//.test(link.dataset.zeffy || '')) return;
      e.preventDefault();
      open(link);
    }, { signal });

    document.getElementById('zeffy-modal-x')?.addEventListener('click', () => dialog.close(), { signal });
    // The dialog fills the screen and the form sits in it: a click on the dialog itself is a click beside the form
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); }, { signal });
  });

  document.addEventListener('astro:before-swap', cleanupPopup);
</script>

<style>
  /* Full screen and see-through, so the form's box can sit in the middle and a click beside it lands on the dialog */
  .zeffy-modal {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .zeffy-modal[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .zeffy-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: zeffy-fade 0.3s ease;
  }
  .zeffy-modal-container {
    position: relative;
    width: 90vw;
    max-width: 520px;
    height: 85vh;
    max-height: 700px;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.25);
  }
  .zeffy-modal[open] .zeffy-modal-container {
    animation: zeffy-rise 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes zeffy-fade { from { opacity: 0; } }
  @keyframes zeffy-rise { from { opacity: 0; transform: translateY(24px) scale(0.97); } }
  .zeffy-modal-x {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 10;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.06);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    color: var(--c-dark);
    transition: background 0.2s ease;
  }
  .zeffy-modal-x:hover { background: rgba(0, 0, 0, 0.12); }
  .zeffy-modal-x:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; }
  .zeffy-modal-container :global(.zeffy-modal-frame) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 768px) {
    .zeffy-modal-container {
      width: 100vw;
      max-width: 100vw;
      height: 100vh;
      height: 100dvh;
      max-height: none;
      border-radius: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zeffy-modal::backdrop, .zeffy-modal[open] .zeffy-modal-container { animation: none; }
  }
</style>
