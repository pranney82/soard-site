  .af-review-section[data-missing] .af-review-toggle .af-step-mark { background: var(--af-attn-bg); border-color: var(--af-gold); color: var(--af-attn-ink); }
  .af-review-name { display: grid; gap: 2px; min-width: 0; }
  .af-review-h { flex: 1; min-width: 0; margin: 0; font-family: var(--font-body); font-size: inherit; letter-spacing: 0; }
  .af-review-h .af-review-toggle { width: 100%; }
  .af-review-title { font-size: 16.5px; font-weight: 700; line-height: 1.35; }
  .af-review-toggle .af-step-mark { font-size: 15px; }
  .af-review-item { grid-template-columns: minmax(0, 1fr) auto; column-gap: 12px; }
  .af-review-item > :is(dt, dd) { grid-column: 1; }
  .af-review-item > .af-review-change { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
  .af-review-sum { font-size: 14px; line-height: 1.4; color: var(--c-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .af-review-section[data-missing] .af-review-sum { color: var(--af-attn-ink); font-weight: 600; }
  .af-review-chev { width: 16px; height: 16px; fill: none; stroke: var(--c-text-muted); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform .25s var(--af-ease); }
  .af-review-section[data-open] .af-review-chev { transform: rotate(180deg); }
  .af-review-body { padding: 0 22px 10px 64px; }
  .af-review-section[data-open] .af-review-body { animation: afDrop .22s var(--af-ease) both; }
  .af-review-change { justify-self: start; min-height: 32px; padding: 2px 0; font-size: 14px; }

  /* ── Moving between screens: the old one slips out, the new one slides in from the side
        it's going to (View Transitions; a plain slide where the browser has none) ── */
  .af-vt .af-stage { view-transition-name: af-stage; }
  .af-vt::view-transition-group(root), .af-vt::view-transition-old(root), .af-vt::view-transition-new(root) { animation: none; }
  .af-vt::view-transition-group(af-stage) { animation: none; }
  .af-vt::view-transition-old(af-stage) { animation: afOutNext 120ms cubic-bezier(.4,0,1,1) both; }
  .af-vt::view-transition-new(af-stage) { animation: afInNext 260ms cubic-bezier(.05,.7,.1,1) 110ms both; }
  /* Between screens of the same step its name holds still; only the questions move */
  .af-vt.af-vt-same .af-head { view-transition-name: af-head; }
  .af-vt::view-transition-group(af-head), .af-vt::view-transition-new(af-head) { animation: none; }
  .af-vt::view-transition-old(af-head) { animation: none; opacity: 0; }
  .af-vt.af-vt-back::view-transition-old(af-stage) { animation-name: afOutBack; }
  .af-vt.af-vt-back::view-transition-new(af-stage) { animation-name: afInBack; }
  @keyframes afOutNext { to { opacity: 0; transform: translateX(-12px); } }
  @keyframes afInNext { from { opacity: 0; transform: translateX(16px); } }
  @keyframes afOutBack { to { opacity: 0; transform: translateX(12px); } }
  @keyframes afInBack { from { opacity: 0; transform: translateX(-16px); } }
  @keyframes afShow { to { opacity: 1; } }

  /* ── A phone ── */
  @media (max-width: 640px) {
