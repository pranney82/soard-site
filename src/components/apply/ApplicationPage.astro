    html.af-focus .af-field .af-float > :is(input:not([type=radio]):not([type=checkbox]):not([type=file]), select) { min-height: 52px; padding: 22px 15px 4px; }
    html.af-focus .af-float-label { top: 15px; }
    html.af-focus .af-steps-toggle { padding: 0 10px; font-size: 13.5px; gap: 4px; }
    /* Where they are, on one line beside "All steps" (Spanish runs longer) */
    html.af-focus .af-step-text { flex-wrap: nowrap; white-space: nowrap; font-size: 11.5px; letter-spacing: .07em; gap: 8px; min-width: 0; }
    html.af-focus .af-part { gap: 8px; }
