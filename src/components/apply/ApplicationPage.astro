    html.af-focus .af-choice { padding: 12px 16px; min-height: 50px; }
    html.af-focus .af-choices { gap: 8px; }
    /* A photo in one compact row on its own screen: the picture, then what's there over its buttons */
    html.af-focus .af-upload--photo { grid-template-columns: 76px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 14px; row-gap: 6px; align-items: center; padding: 12px; }
    html.af-focus .af-upload--photo .af-upload-preview { width: 76px; height: 76px; grid-row: 1 / span 2; }
    html.af-focus .af-upload--photo .af-upload-status { align-self: end; margin: 0; }
    html.af-focus .af-upload--photo .af-upload-actions { grid-column: 2; align-self: start; display: flex; flex-wrap: wrap; gap: 0 12px; align-items: center; }
    html.af-focus .af-upload--photo .af-upload-actions .af-btn--upload { flex: 0 1 auto; min-height: 44px; padding-inline: 18px; }
    /* A phone's cards: the icon beside the name, the words the card's full width under them */
    html.af-focus .af-content .af-scope-title { font-size: 21px; line-height: 1.25; }
    html.af-focus .af-content .af-offer-card { grid-template-columns: 36px minmax(0, 1fr); column-gap: 12px; row-gap: 6px; align-items: center; padding: 14px 16px; }
    html.af-focus .af-content .af-offer-text { display: contents; }
