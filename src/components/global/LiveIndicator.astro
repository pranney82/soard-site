---
/**
 * LiveIndicator.astro
 * Floating bottom-right card for live room reveals. Driven by the shared
 * live client (src/utils/live-client.ts): WebSocket push from the real-time
 * hub, polling fallback. No admin action is needed to show it; the state
 * machine flips it when the phone starts streaming.
 *
 * What it says and when: src/utils/live-banner.ts
 *   data-state=upcoming  steady yellow dot, "Coming up", from 7 days out; "Reveal day" on the
 *                        day; "Just ended" until the recording is ready
 *   data-state=live      pulsing yellow dot, "Live now", links to the live page
 *   data-state=replay    play glyph, "Replay ready"
 * The next confirmed reveal inside the week is named on its second line.
 *
 * Behavior:
 *   - Never sits on a button or a video: when one is under it at rest, it steps
 *     aside until that's gone, and it stays above a bar fixed to the bottom.
 *     "Live now" moves up under the header instead, if that's clear. Stepped
 *     aside it stays in the tab order, and coming into focus brings it back.
 *   - Closing it is remembered per reveal and per stage, so "Live now" still shows
 *   - Hidden on /live/ and on the reveal's own live page, which already show it;
 *     another kid's live page gets it, so a reveal can't go unmentioned there
 *   - transition:persist keeps it mounted across view transitions
 *   - Respects prefers-reduced-motion
 */
---

<div id="live-indicator" class="live-pill" hidden transition:persist="live-indicator" role="status">
  <a class="live-pill__link" href="/live/">
    <img class="live-pill__photo" alt="" width="40" height="40" loading="lazy" hidden />
    <span class="live-pill__text">
      <span class="live-pill__top">
        <span class="live-pill__dot" aria-hidden="true"></span>
        <strong class="live-pill__label">Live now</strong>
        <span class="live-pill__cta" aria-hidden="true">Watch&nbsp;→</span>
      </span>
      <span class="live-pill__msg"></span>
      <span class="live-pill__next" hidden></span>
    </span>
  </a>
  <button class="live-pill__dismiss" type="button" aria-label="Dismiss live notification">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
</div>

<style>
  .live-pill {
    position: fixed;
    right: calc(1rem + env(safe-area-inset-right, 0px));
    bottom: calc(1rem + var(--live-pill-lift, 0px) + env(safe-area-inset-bottom, 0px));
    z-index: 900; /* under the sticky header (1000) and its mobile menu */
    display: flex;
    align-items: stretch;
    width: min(23.5rem, calc(100vw - 2rem));
    background: var(--c-dark-deep);
    color: var(--c-cream);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-xl);
    opacity: 0;
    transform: translateY(calc(0.75rem - var(--live-pill-rise, 0px)));
    transition: opacity 350ms ease, transform 350ms cubic-bezier(0.16, 1, 0.3, 1), bottom 300ms ease;
  }
  .live-pill.is-visible { opacity: 1; transform: translateY(calc(-1 * var(--live-pill-rise, 0px))); }
  /* A button is under it: out of the way until the page moves on */
  .live-pill.is-visible.is-aside { opacity: 0; transform: translateY(calc(100% + 1.25rem)); pointer-events: none; }
  .live-pill[hidden] { display: none; }

  .live-pill__link {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.5rem 0.625rem 0.75rem;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-body);
    border-radius: var(--border-radius-lg) 0 0 var(--border-radius-lg);
    min-width: 0;
  }
  .live-pill__link:focus-visible { outline: 2px solid var(--c-yellow); outline-offset: -2px; }

  .live-pill__photo {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; object-fit: cover;
    border: 2px solid var(--c-yellow); background: var(--c-dark);
  }
  .live-pill__photo[hidden] { display: none; }

  .live-pill__dot {
    position: relative; flex-shrink: 0; width: 8px; height: 8px; border-radius: 50%;
    background: var(--c-yellow);
  }
  .live-pill__dot::after {
    content: ''; position: absolute; inset: -4px; border-radius: 50%;
    border: 2px solid var(--c-yellow); opacity: 0;
    animation: live-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes live-ping {
    0%   { transform: scale(0.6); opacity: 0.9; }
    70%  { transform: scale(1.5); opacity: 0; }
    100% { transform: scale(1.5); opacity: 0; }
  }
  .live-pill[data-state='upcoming'] .live-pill__dot::after,
  .live-pill[data-state='replay'] .live-pill__dot::after { animation: none; opacity: 0; }
  /* Replay: the dot becomes a tiny play glyph */
  .live-pill[data-state='replay'] .live-pill__dot {
    width: 0; height: 0; border-radius: 0; background: none;
    border-top: 5px solid transparent; border-bottom: 5px solid transparent; border-left: 8px solid var(--c-yellow);
  }

  .live-pill__text { flex: 1; display: flex; flex-direction: column; gap: 0.0625rem; min-width: 0; }
  .live-pill__top { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.4rem; }
  .live-pill__label {
    white-space: nowrap; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-yellow);
  }
  .live-pill__msg { font-size: 0.875rem; line-height: 1.3; color: rgba(254, 252, 245, 0.9); }
  .live-pill__next { font-size: 0.8125rem; line-height: 1.3; color: rgba(254, 252, 245, 0.7); }
  .live-pill__next[hidden] { display: none; }
  .live-pill__cta {
    margin-left: auto; flex-shrink: 0; font-size: 0.75rem; font-weight: 600; color: var(--c-yellow);
    white-space: nowrap; transition: transform var(--transition-fast);
  }
  .live-pill__link:hover .live-pill__cta { transform: translateX(2px); }

  .live-pill__dismiss {
    flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 2.25rem;
    margin: 0; padding: 0; background: none; border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0 var(--border-radius-lg) var(--border-radius-lg) 0;
    color: rgba(254, 252, 245, 0.5); cursor: pointer;
    transition: color var(--transition-fast), background var(--transition-fast);
  }
  .live-pill__dismiss:hover { color: var(--c-cream); background: rgba(255, 255, 255, 0.06); }
  .live-pill__dismiss:focus-visible { outline: 2px solid var(--c-yellow); outline-offset: -2px; }

  @media (prefers-reduced-motion: reduce) {
    .live-pill { transition: opacity 350ms ease; transform: translateY(calc(-1 * var(--live-pill-rise, 0px))); }
    .live-pill.is-visible.is-aside { transform: none; }
    .live-pill__dot::after { animation: none; }
    .live-pill__link:hover .live-pill__cta { transform: none; }
  }
</style>

<script>
  import { cfRaw } from '../../utils/cf-image';
  import { getLiveClient, type LiveState } from '../../utils/live-client';
  import { readReveals } from '../../utils/reveals-client';
  import { bannerStage, bannerWords, revealsAfter, dismissValue, sitsOn, pageShowsIt, remindersUsable, browserCanPush, MAIN_CONTROLS, PICTURES, type Box, type NextReveal } from '../../utils/live-banner';

  const DISMISS_KEY = 'soard-live-dismissed';
  const REVEALS_WAIT_MS = 2500; // a slow schedule holds the banner back this long at most
  const BOTTOM_BARS = '.auction-bar, .sticky-cta, .ev-sticky-cta';
  const TOP_BARS = '.site-header, .chapter-nav';
  const FOCUSABLE = 'a[href], button, input, select, textarea, summary, [tabindex]:not([tabindex="-1"])';
  const client = getLiveClient();
  let status: LiveState | null = null;
  let seen = '';                           // the broadcast and phase last read
  let remindersOn = false;
  let reveals: NextReveal[] | null = null; // null until the schedule has been read
  let readingSchedule = false;
  let closed: string | null = null;        // stands in when the browser won't keep it
  let pressing = false;                    // a finger or mouse is down on the banner
  let clearTimer: ReturnType<typeof setTimeout> | undefined;
  let hideTimer: ReturnType<typeof setTimeout> | undefined;

  function readClosed() {
    if (closed !== null) return closed; // what was just closed beats an older stored value
    try { return localStorage.getItem(DISMISS_KEY); } catch { return null; }
  }
  function writeClosed(value: string) {
    closed = value;
    try { localStorage.setItem(DISMISS_KEY, value); } catch { /* remembered for this page only */ }
  }

  const currentStage = () => (pageShowsIt(location.pathname, status?.kidSlug, reveals || []) ? null : bannerStage(status));

  function readSchedule() {
    if (readingSchedule) return;
    readingSchedule = true;
    (readReveals() as Promise<NextReveal[] | null>).then((list) => {
      readingSchedule = false;
      // A read that failed keeps what it has: not knowing isn't the same as nothing planned
      const changed = !!list && JSON.stringify(list) !== JSON.stringify(reveals);
      if (list) reveals = list;
      if (changed) render();
    });
    setTimeout(() => { if (reveals === null) { reveals = []; render(); } }, REVEALS_WAIT_MS);
  }

  /** Where the banner rests, whether or not it's stepped aside right now */
  function restingBox(el: HTMLElement) {
    const css = getComputedStyle(el);
    const right = document.documentElement.clientWidth - (parseFloat(css.right) || 0);
    const bottom = document.documentElement.clientHeight - (parseFloat(css.bottom) || 0);
    return { left: right - el.offsetWidth, top: bottom - el.offsetHeight, right, bottom };
  }

  function somethingUnder(el: HTMLElement, box: Box) {
    // The control keyboard focus is on stays in view, whatever it is (not a page area holding focus)
    const focused = document.activeElement;
    if (focused?.matches(FOCUSABLE) && !el.contains(focused) && sitsOn(box, focused.getBoundingClientRect(), 0)) return true;
    for (const c of document.querySelectorAll(MAIN_CONTROLS)) {
      if (el.contains(c)) continue;
      const r = c.getBoundingClientRect();
      if (!r.width || !r.height || !sitsOn(box, r, c.matches(PICTURES) ? 0 : undefined)) continue;
      // A slider's input is see-through on purpose; anything else at zero opacity isn't there yet
      const checkOpacity = !c.matches('input[type="range"]');
      const shown = c.checkVisibility ? c.checkVisibility({ checkOpacity, checkVisibilityCSS: true }) : getComputedStyle(c).visibility !== 'hidden';
      if (shown && getComputedStyle(c).pointerEvents !== 'none') return true;
    }
    return false;
  }

  /** A bar fixed to the bottom of the screen keeps the banner above it */
  function clearBottomBars(el: HTMLElement) {
    const viewH = document.documentElement.clientHeight;
    let up = 0;
    for (const bar of document.querySelectorAll(BOTTOM_BARS)) {
      const r = bar.getBoundingClientRect();
      if (r.height && r.top < viewH - 1 && r.bottom >= viewH - 1) up = Math.max(up, viewH - r.top);
    }
    const lift = `${Math.round(up)}px`;
    if (el.style.getPropertyValue('--live-pill-lift') !== lift) el.style.setProperty('--live-pill-lift', lift);
  }

  /** How far up the banner goes to sit just under the header and anything stuck beneath it */
  function riseToHeader(el: HTMLElement, box: Box) {
    let under = 0;
    for (const bar of document.querySelectorAll(TOP_BARS)) {
      const r = bar.getBoundingClientRect();
      if (r.height && r.bottom > under && getComputedStyle(bar).visibility !== 'hidden') under = r.bottom;
    }
    // Section navs stick to the top on some pages: whatever is pinned there stays uncovered
    const x = (box.left + box.right) / 2;
    for (let i = 0; i < 3; i++) {
      const below = under + 4;
      const stuck = document.elementsFromPoint(x, below).find((e) => {
        if (el.contains(e) || e === document.body || e === document.documentElement) return false;
        return /sticky|fixed/.test(getComputedStyle(e).position) && e.getBoundingClientRect().bottom > below;
      });
      if (!stuck) break;
      under = stuck.getBoundingClientRect().bottom;
    }
    return Math.max(0, box.top - under - 12);
  }

  function keepClear() {
    const el = document.getElementById('live-indicator');
    if (!el || el.hidden || pressing) return; // never moves out from under a press
    clearBottomBars(el);
    // Someone tabbed to it: it shows, and holds still
    if (el.querySelector(':focus-visible')) { el.classList.remove('is-aside'); return; }
    let aside = false;
    let rise = 0;
    const box = restingBox(el);
    if (somethingUnder(el, box)) {
      aside = true;
      // A live reveal is the one thing that has to reach people: it tries the top before it gives way
      if (currentStage() === 'live') {
        const up = riseToHeader(el, box);
        if (!somethingUnder(el, { ...box, top: box.top - up, bottom: box.bottom - up })) { aside = false; rise = up; }
      }
    }
    el.classList.toggle('is-aside', aside);
    const value = `${Math.round(rise)}px`;
    if (el.style.getPropertyValue('--live-pill-rise') !== value) el.style.setProperty('--live-pill-rise', value);
  }
  const keepClearSoon = () => { clearTimeout(clearTimer); clearTimer = setTimeout(keepClear, 120); };

  /** Focus leaving with the banner lands somewhere that makes sense, not at the top of nothing */
  function moveFocusOut(el: HTMLElement) {
    if (!el.contains(document.activeElement)) return;
    const main = document.getElementById('main-content');
    if (!main) return;
    if (!main.hasAttribute('tabindex')) {
      main.setAttribute('tabindex', '-1');
      main.addEventListener('blur', () => main.removeAttribute('tabindex'), { once: true });
    }
    main.focus({ preventScroll: true });
  }

  /** Writes only what changed: this is a status region, and every write can be read aloud */
  function put(node: HTMLElement, text: string) {
    if (node.textContent !== text) node.textContent = text;
  }

  function render() {
    const el = document.getElementById('live-indicator');
    if (!el || pressing) return; // what's under the press stays what was pressed
    clearTimeout(hideTimer);
    // A stream with no kid named, on a kid's own live page: the schedule says whether it's theirs
    if (status?.live && !status.kidSlug && reveals === null && /^\/live\/[^/]+/.test(location.pathname)) { readSchedule(); return; }
    const stage = currentStage();
    const show = stage && status && readClosed() !== dismissValue(status, stage);
    if (!show || !stage || !status) {
      moveFocusOut(el);
      el.classList.remove('is-visible');
      el.hidden = true;
      return;
    }
    // The first showing waits for the schedule, so the banner doesn't grow a line after it appears
    if (stage !== 'live' && reveals === null) { readSchedule(); return; }
    const link = el.querySelector('.live-pill__link') as HTMLAnchorElement;
    const label = el.querySelector('.live-pill__label') as HTMLElement;
    const msg = el.querySelector('.live-pill__msg') as HTMLElement;
    const nextEl = el.querySelector('.live-pill__next') as HTMLElement;
    const cta = el.querySelector('.live-pill__cta') as HTMLElement;
    const dismiss = el.querySelector('.live-pill__dismiss') as HTMLButtonElement;
    const photo = el.querySelector('.live-pill__photo') as HTMLImageElement;

    el.dataset.state = stage === 'live' || stage === 'replay' ? stage : 'upcoming';
    if (status.image) {
      const src = cfRaw(status.image, 'w=96,h=96,fit=cover,q=85');
      if (photo.getAttribute('src') !== src) photo.src = src;
      photo.hidden = false;
    } else photo.hidden = true;

    const next = stage === 'live' ? [] : revealsAfter(status, reveals || []);
    const words = bannerWords(status, stage, next, { remindersOn });
    const href = `${status.url || status.liveUrl || '/live/'}${words.anchor}`;
    if (link.getAttribute('href') !== href) link.href = href;
    put(label, words.label);
    put(msg, words.msg);
    put(nextEl, words.next);
    nextEl.hidden = !words.next;
    put(cta, words.cta);
    if (link.getAttribute('aria-label') !== words.aria) link.setAttribute('aria-label', words.aria);

    link.onclick = () => client.beacon('banner_click', { state: stage });
    dismiss.onclick = () => {
      if (status) writeClosed(dismissValue(status, stage));
      moveFocusOut(el);
      el.classList.remove('is-visible');
      hideTimer = setTimeout(() => { if (!el.classList.contains('is-visible')) el.hidden = true; }, 400);
    };

    if (el.hidden) {
      el.hidden = false;
      keepClear(); // before it fades in, so it never flashes over a button
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-visible')));
    } else {
      el.classList.add('is-visible');
      keepClearSoon();
    }
  }

  client.subscribe((s, meta) => {
    status = s;
    remindersOn = remindersUsable(meta.reminders, browserCanPush());
    const now = `${s?.id}:${s?.phase}`;
    if (now !== seen) { seen = now; if (reveals !== null && currentStage()) readSchedule(); }
    render();
  });
  // Keeps the words and the schedule fresh; this is also what brings a countdown up a week out
  setInterval(() => {
    if (!status?.upcoming && !status?.replay) return;
    if (reveals !== null && currentStage()) readSchedule();
    render();
  }, 60_000);
  document.addEventListener('astro:page-load', () => {
    // It stays mounted across pages, so the click that got here can leave focus on it
    const active = document.activeElement as HTMLElement | null;
    if (active?.closest('#live-indicator')) active.blur();
    pressing = false;
    if (reveals !== null && currentStage()) readSchedule();
    render();
    keepClearSoon();
  });
  addEventListener('scroll', keepClearSoon, { passive: true });
  addEventListener('resize', keepClearSoon, { passive: true });
  addEventListener('load', keepClearSoon);
  document.addEventListener('pointerdown', (e) => { if ((e.target as Element | null)?.closest?.('#live-indicator')) pressing = true; }, true);
  const pressEnded = () => {
    if (!pressing) return;
    pressing = false;
    // After the click lands: a change that came in during the press waits for it
    setTimeout(() => { render(); keepClear(); }, 120);
  };
  for (const end of ['pointerup', 'pointercancel', 'contextmenu']) addEventListener(end, pressEnded, true);
  addEventListener('blur', pressEnded); // the window only: an element's blur doesn't reach here
  document.addEventListener('focusin', keepClear);
  document.addEventListener('focusout', keepClearSoon);
  document.fonts?.ready.then(keepClearSoon);
  // Buttons fade in, panels open and layouts settle late, with no event to say so
  setInterval(() => { if (!document.hidden) keepClear(); }, 500);
</script>
