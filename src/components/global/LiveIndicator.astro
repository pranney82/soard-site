---
/**
 * LiveIndicator.astro
 * Floating bottom-corner pill for live room reveals. Driven by the shared
 * live client (src/utils/live-client.ts): WebSocket push from the real-time
 * hub, polling fallback. No admin action is needed to show it; the state
 * machine flips it when the phone starts streaming.
 *
 * States (data-state):
 *   upcoming — steady yellow dot, "Reveal day", shows when we go live
 *   live     — pulsing yellow dot, "Live now", links to the live page
 *   replay   — play glyph, "Replay ready"
 *
 * Behavior:
 *   - Dismissable per broadcast id; stays dismissed for the session
 *   - Hidden on the /live pages themselves (they show everything already)
 *   - transition:persist keeps it mounted across view transitions
 *   - Respects prefers-reduced-motion
 */
---

<div id="live-indicator" class="live-pill" hidden transition:persist="live-indicator" role="status">
  <a class="live-pill__link" href="/live/">
    <img class="live-pill__photo" alt="" width="44" height="44" loading="lazy" hidden />
    <span class="live-pill__dot" aria-hidden="true"></span>
    <span class="live-pill__text">
      <strong class="live-pill__label">Live now</strong>
      <span class="live-pill__msg"></span>
    </span>
    <span class="live-pill__cta" aria-hidden="true">Watch&nbsp;→</span>
  </a>
  <button class="live-pill__dismiss" type="button" aria-label="Dismiss live notification">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
</div>

<style>
  .live-pill {
    position: fixed;
    left: calc(1rem + env(safe-area-inset-left, 0px));
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 900; /* under the sticky header (1000) and its mobile menu */
    display: flex;
    align-items: stretch;
    max-width: min(24rem, calc(100vw - 2rem));
    background: var(--c-dark-deep);
    color: var(--c-cream);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-xl);
    opacity: 0;
    transform: translateY(0.75rem);
    transition: opacity 350ms ease, transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .live-pill.is-visible { opacity: 1; transform: translateY(0); }
  .live-pill[hidden] { display: none; }

  .live-pill__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.25rem 0.75rem 1rem;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-body);
    border-radius: var(--border-radius-lg) 0 0 var(--border-radius-lg);
    min-width: 0;
  }
  .live-pill__link:focus-visible { outline: 2px solid var(--c-yellow); outline-offset: -2px; }

  .live-pill__photo {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%; object-fit: cover;
    border: 2px solid var(--c-yellow); background: var(--c-dark);
  }
  .live-pill__photo[hidden] { display: none; }

  .live-pill__dot {
    position: relative; flex-shrink: 0; width: 10px; height: 10px; border-radius: 50%;
    background: var(--c-yellow);
  }
  .live-pill__dot::after {
    content: ''; position: absolute; inset: -4px; border-radius: 50%;
    border: 2px solid var(--c-yellow); opacity: 0;
    animation: live-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes live-ping {
    0%   { transform: scale(0.6); opacity: 0.9; }
    70%  { transform: scale(1.5); opacity: 0; }
    100% { transform: scale(1.5); opacity: 0; }
  }
  .live-pill[data-state='upcoming'] .live-pill__dot::after,
  .live-pill[data-state='replay'] .live-pill__dot::after { animation: none; opacity: 0; }
  /* Replay: the dot becomes a tiny play glyph */
  .live-pill[data-state='replay'] .live-pill__dot {
    width: 0; height: 0; border-radius: 0; background: none;
    border-top: 6px solid transparent; border-bottom: 6px solid transparent; border-left: 10px solid var(--c-yellow);
  }

  .live-pill__text { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .live-pill__label {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-yellow);
  }
  .live-pill__msg { font-size: 0.875rem; line-height: 1.35; color: rgba(254, 252, 245, 0.85); }
  .live-pill__cta {
    flex-shrink: 0; align-self: center; font-size: 0.8rem; font-weight: 600; color: var(--c-yellow);
    white-space: nowrap; padding-left: 0.25rem; transition: transform var(--transition-fast);
  }
  .live-pill__link:hover .live-pill__cta { transform: translateX(2px); }

  .live-pill__dismiss {
    flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 2.25rem;
    margin: 0; padding: 0; background: none; border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0 var(--border-radius-lg) var(--border-radius-lg) 0;
    color: rgba(254, 252, 245, 0.5); cursor: pointer;
    transition: color var(--transition-fast), background var(--transition-fast);
  }
  .live-pill__dismiss:hover { color: var(--c-cream); background: rgba(255, 255, 255, 0.06); }
  .live-pill__dismiss:focus-visible { outline: 2px solid var(--c-yellow); outline-offset: -2px; }

  @media (prefers-reduced-motion: reduce) {
    .live-pill { transition: opacity 350ms ease; transform: none; }
    .live-pill__dot::after { animation: none; }
    .live-pill__link:hover .live-pill__cta { transform: none; }
  }
</style>

<script>
  import { cfRaw } from '../../utils/cf-image';
  import { getLiveClient, formatWhen, relativeUntil, type LiveState } from '../../utils/live-client';

  const DISMISS_KEY = 'soard-live-dismissed';
  const client = getLiveClient();
  let status: LiveState | null = null;
  let tick: ReturnType<typeof setInterval> | undefined;

  function onLivePage() {
    return location.pathname === '/live' || location.pathname.startsWith('/live/');
  }

  function render() {
    const el = document.getElementById('live-indicator');
    if (!el) return;
    const active = status && (status.live || status.upcoming || status.replay);
    const show = active && !onLivePage() && sessionStorage.getItem(DISMISS_KEY) !== String(status!.id);
    if (!show || !status) {
      el.classList.remove('is-visible');
      el.hidden = true;
      return;
    }
    const link = el.querySelector('.live-pill__link') as HTMLAnchorElement;
    const label = el.querySelector('.live-pill__label') as HTMLElement;
    const msg = el.querySelector('.live-pill__msg') as HTMLElement;
    const cta = el.querySelector('.live-pill__cta') as HTMLElement;
    const dismiss = el.querySelector('.live-pill__dismiss') as HTMLButtonElement;
    const photo = el.querySelector('.live-pill__photo') as HTMLImageElement;

    const state = status.live ? 'live' : status.replay ? 'replay' : 'upcoming';
    el.dataset.state = state;
    link.href = status.url || status.liveUrl || '/live/';
    if (status.image) { photo.src = cfRaw(status.image, 'w=96,h=96,fit=cover,q=85'); photo.hidden = false; }
    else photo.hidden = true;

    const who = status.kidName ? `${status.kidName}'s room reveal` : (status.title || 'Live room reveal');
    if (state === 'live') {
      label.textContent = 'Live now';
      msg.textContent = status.message || who;
      cta.textContent = 'Watch →';
      link.setAttribute('aria-label', `${msg.textContent}. Watch live now.`);
    } else if (state === 'replay') {
      label.textContent = 'Replay ready';
      msg.textContent = `Missed ${status.kidName ? `${status.kidName}'s` : 'the'} reveal? Watch it any time.`;
      cta.textContent = 'Watch →';
      link.setAttribute('aria-label', `${msg.textContent} Open the replay.`);
    } else {
      label.textContent = 'Reveal day';
      const rel = relativeUntil(status.scheduledAt);
      msg.textContent = status.scheduledAt ? `${who} goes live ${formatWhen(status.scheduledAt)}${rel ? ` (${rel})` : ''}.` : who;
      cta.textContent = 'Remind me →';
      link.setAttribute('aria-label', `${msg.textContent} Get a reminder.`);
    }

    link.onclick = () => client.beacon('banner_click', { state });
    dismiss.onclick = () => {
      sessionStorage.setItem(DISMISS_KEY, String(status?.id));
      el.classList.remove('is-visible');
      setTimeout(() => { el.hidden = true; }, 400);
    };

    if (el.hidden) {
      el.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-visible')));
    } else {
      el.classList.add('is-visible');
    }
  }

  client.subscribe((s) => { status = s; render(); });
  // Keep the relative time fresh while a countdown is showing
  tick = setInterval(() => { if (status?.upcoming) render(); }, 60_000);
  document.addEventListener('astro:page-load', render);
</script>
