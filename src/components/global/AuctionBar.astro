---
/**
 * AuctionBar.astro
 * Site-wide bidding CTA for the Evening of Sunshine auction.
 *
 * Placement is per-platform, because the slot that converts differs:
 *   desktop (>=768px) — in flow above the sticky header, scrolls away
 *   mobile  (<768px)  — fixed to the bottom, inside the thumb arc, stays put
 *
 * It leads with the deadline rather than the announcement: time scarcity is
 * what actually drives auction bids. The close time is rendered server-side as
 * an absolute phrase ("Saturday at 10 PM") so a CDN-cached page can never show
 * a stale relative number, then an inline script upgrades it to a live
 * countdown during parse, before first paint.
 *
 * Two-stage cutoff (see utils/auction.ts): not rendered at all in builds made
 * after BID_CLOSES, and hidden client-side for cached pages served after it.
 *
 * Dismissal is per-session, not permanent — this runs for about a day, and
 * someone returning tomorrow should see it again.
 */
import { BID_URL, BID_CLOSES_MS, auctionIsOpen, bidClosesLabel } from '../../utils/auction';

const show = auctionIsOpen();
const closesLabel = bidClosesLabel();
---

{show && (
  <>
    {/* Runs before the bar is parsed so a dismissed or expired bar never
        paints. The class goes on <html> because the bar is not in the DOM yet. */}
    <script is:inline define:vars={{ closesAt: BID_CLOSES_MS }}>
      (function () {
        try {
          var dead = Date.now() >= closesAt;
          var gone = sessionStorage.getItem('soard-auction-bar') === 'dismissed';
          if (dead || gone) document.documentElement.classList.add('auction-bar-off');
        } catch (e) {
          /* sessionStorage throws in some private modes; showing the bar is the safe fallback */
        }
      })();
    </script>

    <aside class="auction-bar" transition:persist="auction-bar" aria-label="Online auction">
      <a class="auction-bar__link" href={BID_URL} target="_blank" rel="noopener">
        <span class="auction-bar__dot" aria-hidden="true"></span>
        <span class="auction-bar__copy">
          <span class="auction-bar__long">Bidding closes {closesLabel}</span>
          <span class="auction-bar__short">Closes {closesLabel.replace(/^\w+ at /, '')}</span>
        </span>
        <span class="auction-bar__cta">
          Bid Now
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
      <button class="auction-bar__dismiss" type="button" aria-label="Dismiss auction notice">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </aside>

    <script is:inline define:vars={{ closesAt: BID_CLOSES_MS }}>
      (function () {
        var HOUR = 3600000, MIN = 60000;

        /* Long form for the desktop strip, short for narrow phones. Both go
           urgent under an hour, which is when hesitant bidders convert. */
        function phrases(msLeft) {
          if (msLeft >= 24 * HOUR) return null; // keep the server-rendered absolute time
          var h = Math.floor(msLeft / HOUR);
          var m = Math.floor((msLeft % HOUR) / MIN);
          if (msLeft < HOUR) {
            return { long: 'Final hour to bid, ' + Math.max(m, 1) + 'm left', short: Math.max(m, 1) + 'm left', urgent: true };
          }
          var span = m === 0 ? h + 'h' : h + 'h ' + m + 'm';
          return { long: 'Bidding closes in ' + span, short: 'Closes in ' + span, urgent: false };
        }

        function tick() {
          var bar = document.querySelector('.auction-bar');
          var left = closesAt - Date.now();
          if (left <= 0) {
            document.documentElement.classList.add('auction-bar-off');
            return;
          }
          if (!bar) return;
          var p = phrases(left);
          if (!p) return;
          var lo = bar.querySelector('.auction-bar__long');
          var sh = bar.querySelector('.auction-bar__short');
          if (lo) lo.textContent = p.long;
          if (sh) sh.textContent = p.short;
          bar.classList.toggle('is-urgent', p.urgent);
        }

        function wire() {
          var bar = document.querySelector('.auction-bar');
          if (!bar || bar.dataset.wired) return;
          bar.dataset.wired = '1';
          var btn = bar.querySelector('.auction-bar__dismiss');
          if (btn) {
            btn.addEventListener('click', function () {
              document.documentElement.classList.add('auction-bar-off');
              try { sessionStorage.setItem('soard-auction-bar', 'dismissed'); } catch (e) {}
            });
          }
        }

        wire();
        tick();
        setInterval(tick, 30000);
        document.addEventListener('astro:page-load', function () { wire(); tick(); });
      })();
    </script>
  </>
)}

<style>
  /* ─────────────────────────────────────────────────────────────
     Mobile first: fixed to the bottom, in the thumb arc.
     ───────────────────────────────────────────────────────────── */
  .auction-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 950; /* over content, under the mobile nav overlay (1100) */
    display: flex;
    align-items: stretch;
    background: var(--c-dark-deep);
    color: var(--c-cream);
    font-family: var(--font-body);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.18);
  }

  /* Hidden by the inline script when dismissed or past the cutoff. */
  :global(html.auction-bar-off) .auction-bar { display: none; }

  .auction-bar__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1;
    min-width: 0;
    padding: 0.7rem 0.4rem 0.7rem 1rem;
    color: inherit;
    text-decoration: none;
  }
  .auction-bar__link:focus-visible {
    outline: 2px solid var(--c-yellow);
    outline-offset: -3px;
    border-radius: 4px;
  }

  .auction-bar__dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-yellow);
    animation: auction-pulse 2s ease-out infinite;
  }
  @keyframes auction-pulse {
    0%   { box-shadow: 0 0 0 0 var(--c-yellow-glow); }
    70%  { box-shadow: 0 0 0 7px rgba(255, 218, 36, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 218, 36, 0); }
  }
  /* Under an hour the dot beats faster and the copy goes yellow. */
  .auction-bar.is-urgent .auction-bar__dot { animation-duration: 1s; }
  .auction-bar.is-urgent .auction-bar__copy { color: var(--c-yellow); font-weight: 700; }

  .auction-bar__copy {
    min-width: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* One phrasing per breakpoint; the script keeps both in sync. */
  .auction-bar__long { display: none; }
  .auction-bar__short { display: inline; }

  .auction-bar__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    background: var(--c-yellow);
    color: var(--c-dark);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }
  .auction-bar__link:hover .auction-bar__cta { background: var(--c-yellow-hover); }

  .auction-bar__dismiss {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem; /* 44px touch target even though the glyph stays small */
    background: none;
    border: none;
    color: rgba(254, 252, 245, 0.45);
    cursor: pointer;
    transition: color var(--transition-fast);
  }
  .auction-bar__dismiss:hover { color: var(--c-cream); }
  .auction-bar__dismiss:focus-visible {
    outline: 2px solid var(--c-yellow);
    outline-offset: -3px;
    border-radius: 4px;
  }

  /* Keep the page's own content clear of the fixed bar. */
  @media (max-width: 767px) {
    :global(body) { padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px)); }
    :global(html.auction-bar-off body) { padding-bottom: 0; }

    /* The gala page ships its own sticky bid bar; never stack two. */
    :global(body:has(.gv-sticky-cta)) .auction-bar { display: none; }
    :global(body:has(.gv-sticky-cta)) { padding-bottom: 0; }
  }

  /* ─────────────────────────────────────────────────────────────
     Desktop: back into the flow, above the sticky header.
     ───────────────────────────────────────────────────────────── */
  @media (min-width: 768px) {
    .auction-bar {
      position: relative;
      z-index: 999; /* under the sticky header (1000) so it tucks away cleanly */
      justify-content: center;
      gap: 0.25rem;
      border-top: none;
      box-shadow: none;
      padding-bottom: 0;
      padding-left: env(safe-area-inset-left, 0px);
      padding-right: env(safe-area-inset-right, 0px);
    }
    .auction-bar__link {
      flex: 0 1 auto;
      justify-content: center;
      gap: 0.75rem;
      padding: 0.6rem 0.5rem 0.6rem 1rem;
    }
    .auction-bar__copy { font-size: 0.875rem; }
    .auction-bar__long { display: inline; }
    .auction-bar__short { display: none; }
    .auction-bar__cta {
      font-size: 0.8125rem;
      padding: 0.3rem 0.7rem;
    }
    .auction-bar__link:hover .auction-bar__cta { transform: translateX(2px); }
    .auction-bar__dismiss { width: 2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .auction-bar__dot { animation: none; }
    .auction-bar__link:hover .auction-bar__cta { transform: none; }
  }

  @media print { .auction-bar { display: none; } }
</style>
