---
/**
 * AuctionBar.astro
 * Slim strip above the sticky header that runs while online bidding for the
 * Evening of Sunshine auction is open. Sits in normal document flow, so it
 * scrolls away and the header takes over at the top of the viewport.
 *
 * Two-stage cutoff (see utils/auction.ts): the bar is not rendered at all in
 * builds made after BID_CLOSES, and an inline script hides it in browsers that
 * load a cached page after the deadline.
 *
 * Dismissal is per-session (sessionStorage), not permanent — this runs for
 * about a day, and a visitor coming back tomorrow should see it again.
 *
 * The bar deliberately mirrors LiveIndicator's visual language (dark ground,
 * pulsing yellow dot) so the two read as the same system if both are up.
 */
import { BID_URL, BID_CLOSES_MS, auctionIsOpen } from '../../utils/auction';

const show = auctionIsOpen();
---

{show && (
  <>
    {/* Runs before the bar is parsed, so a dismissed or expired bar never
        paints. Class goes on <html> because the bar itself is not in the DOM
        yet at this point. */}
    <script is:inline define:vars={{ closesAt: BID_CLOSES_MS }}>
      (function () {
        try {
          var dead = Date.now() >= closesAt;
          var gone = sessionStorage.getItem('soard-auction-bar') === 'dismissed';
          if (dead || gone) document.documentElement.classList.add('auction-bar-off');
        } catch (e) {
          /* sessionStorage can throw in private mode; showing the bar is the safe fallback */
        }
      })();
    </script>

    <aside class="auction-bar" transition:persist="auction-bar" aria-label="Online auction">
      <a class="auction-bar__link" href={BID_URL} target="_blank" rel="noopener">
        <span class="auction-bar__dot" aria-hidden="true"></span>
        <span class="auction-bar__copy">
          <strong class="auction-bar__lead">The auction is open</strong>
          <span class="auction-bar__sub">Bid from anywhere, seat at the gala or not.</span>
        </span>
        <span class="auction-bar__cta">
          Bid Now
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
      <button class="auction-bar__dismiss" type="button" aria-label="Dismiss auction notice">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </aside>

    <script is:inline define:vars={{ closesAt: BID_CLOSES_MS }}>
      (function () {
        function wire() {
          var bar = document.querySelector('.auction-bar');
          if (!bar || bar.dataset.wired) return;
          bar.dataset.wired = '1';
          var btn = bar.querySelector('.auction-bar__dismiss');
          if (btn) {
            btn.addEventListener('click', function () {
              document.documentElement.classList.add('auction-bar-off');
              try { sessionStorage.setItem('soard-auction-bar', 'dismissed'); } catch (e) {}
            });
          }
        }
        /* A tab left open across the deadline should drop the bar on its own. */
        function sweep() {
          if (Date.now() >= closesAt) document.documentElement.classList.add('auction-bar-off');
        }
        wire();
        sweep();
        setInterval(sweep, 60000);
        document.addEventListener('astro:page-load', function () { wire(); sweep(); });
      })();
    </script>
  </>
)}

<style>
  .auction-bar {
    position: relative;
    z-index: 999; /* under the sticky header (1000) so the header covers it when pinned */
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 0.25rem;
    background: var(--c-dark-deep);
    color: var(--c-cream);
    font-family: var(--font-body);
    padding-left: env(safe-area-inset-left, 0px);
    padding-right: env(safe-area-inset-right, 0px);
  }

  /* Hidden by the inline script when dismissed or past the cutoff. */
  :global(html.auction-bar-off) .auction-bar { display: none; }

  .auction-bar__link {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    padding: 0.6rem 0.5rem 0.6rem 1rem;
    color: inherit;
    text-decoration: none;
    min-width: 0;
  }
  .auction-bar__link:focus-visible {
    outline: 2px solid var(--c-yellow);
    outline-offset: -3px;
    border-radius: 4px;
  }

  .auction-bar__dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-yellow);
    box-shadow: 0 0 0 0 var(--c-yellow-glow);
    animation: auction-pulse 2s ease-out infinite;
  }
  @keyframes auction-pulse {
    0%   { box-shadow: 0 0 0 0 var(--c-yellow-glow); }
    70%  { box-shadow: 0 0 0 7px rgba(255, 218, 36, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 218, 36, 0); }
  }

  .auction-bar__copy {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
  }
  .auction-bar__lead {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .auction-bar__sub {
    font-size: 0.8125rem;
    color: rgba(254, 252, 245, 0.66);
  }

  .auction-bar__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    background: var(--c-yellow);
    color: var(--c-dark);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }
  .auction-bar__link:hover .auction-bar__cta {
    background: var(--c-yellow-hover);
    transform: translateX(2px);
  }

  .auction-bar__dismiss {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    background: none;
    border: none;
    color: rgba(254, 252, 245, 0.45);
    cursor: pointer;
    transition: color var(--transition-fast);
  }
  .auction-bar__dismiss:hover { color: var(--c-cream); }
  .auction-bar__dismiss:focus-visible {
    outline: 2px solid var(--c-yellow);
    outline-offset: -3px;
    border-radius: 4px;
  }

  /* Phones: the qualifier line is the first thing to go, then the lead tightens. */
  @media (max-width: 639px) {
    .auction-bar__sub { display: none; }
    .auction-bar__link { padding-left: 0.75rem; gap: 0.5rem; flex-wrap: nowrap; }
    .auction-bar__lead { font-size: 0.8125rem; }
    /* Keep a 44px touch target even though the glyph stays small. */
    .auction-bar__dismiss { width: 2.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .auction-bar__dot { animation: none; }
    .auction-bar__link:hover .auction-bar__cta { transform: none; }
  }

  /* Printing a page should not carry a time-boxed promo. */
  @media print { .auction-bar { display: none; } }
</style>
