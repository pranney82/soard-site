---
/**
 * AuctionBar.astro
 * Site-wide bidding CTA for the Evening of Sunshine auction.
 *
 * Placement is per-platform, because the slot that converts differs:
 *   desktop (>=768px) — in flow above the sticky header, scrolls away
 *   mobile  (<768px)  — fixed to the bottom, inside the thumb arc, stays put
 *
 * It leads with the deadline rather than the announcement: time scarcity is
 * what actually drives auction bids. The close time is rendered server-side as
 * an absolute phrase ("Saturday at 10 PM") so a CDN-cached page can never show
 * a stale relative number, then an inline script upgrades it to a live
 * countdown during parse, before first paint.
 *
 * Two-stage cutoff (see utils/auction.ts): not rendered at all in builds made
 * after BID_CLOSES, and hidden client-side for cached pages served after it.
 *
 * Dismissal is per-session, not permanent — this runs for about a day, and
 * someone returning tomorrow should see it again.
 */
import { BID_URL, BID_CLOSES_MS, auctionIsOpen, bidClosesLabel, AUCTION_ITEM_COUNT, AUCTION_TEASER } from '../../utils/auction';

const show = auctionIsOpen();
const closesLabel = bidClosesLabel();
---

{show && (
  <>
    {/* Runs before the bar is parsed so a dismissed or expired bar never
        paints. The class goes on <html> because the bar is not in the DOM yet. */}
    <script is:inline define:vars={{ closesAt: BID_CLOSES_MS }}>
      (function () {
        try {
          var dead = Date.now() >= closesAt;
          var gone = sessionStorage.getItem('soard-auction-bar') === 'dismissed';
          if (dead || gone) document.documentElement.classList.add('auction-bar-off');
          else document.documentElement.classList.add('auction-bar-anim');
        } catch (e) {
          /* sessionStorage throws in some private modes; showing the bar is the safe fallback */
        }
      })();
    </script>

    <aside class="auction-bar" transition:persist="auction-bar" aria-label="Online auction">
      <a class="auction-bar__link" href={BID_URL} target="_blank" rel="noopener">
        <span class="auction-bar__dot" aria-hidden="true"></span>
        <span class="auction-bar__copy">
          <span class="auction-bar__teaser">{AUCTION_TEASER}</span>
          <span class="auction-bar__meta">
            <strong class="auction-bar__count">{AUCTION_ITEM_COUNT} items live</strong>
            <span class="auction-bar__sep" aria-hidden="true">&middot;</span>
            <span class="auction-bar__time">Closes {closesLabel}</span>
          </span>
        </span>
        <span class="auction-bar__cta">
          Bid Now
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
      <button class="auction-bar__dismiss" type="button" aria-label="Dismiss auction notice">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </aside>

    <script is:inline define:vars={{ closesAt: BID_CLOSES_MS }}>
      (function () {
        var HOUR = 3600000, MIN = 60000;

        /* Only the time phrase changes; the item context is static. Goes
           urgent under an hour, which is when hesitant bidders convert. */
        function phrase(msLeft) {
          if (msLeft >= 24 * HOUR) return null; // keep the server-rendered absolute time
          var h = Math.floor(msLeft / HOUR);
          var m = Math.floor((msLeft % HOUR) / MIN);
          if (msLeft < HOUR) return { text: 'Final hour, ' + Math.max(m, 1) + 'm left', urgent: true };
          return { text: 'Closes in ' + (m === 0 ? h + 'h' : h + 'h ' + m + 'm'), urgent: false };
        }

        function tick() {
          var bar = document.querySelector('.auction-bar');
          var left = closesAt - Date.now();
          if (left <= 0) {
            document.documentElement.classList.add('auction-bar-off');
            return;
          }
          if (!bar) return;
          var p = phrase(left);
          if (!p) return;
          var t = bar.querySelector('.auction-bar__time');
          if (t) t.textContent = p.text;
          bar.classList.toggle('is-urgent', p.urgent);
        }

        function wire() {
          var bar = document.querySelector('.auction-bar');
          if (!bar || bar.dataset.wired) return;
          bar.dataset.wired = '1';
          var btn = bar.querySelector('.auction-bar__dismiss');
          if (btn) {
            btn.addEventListener('click', function () {
              document.documentElement.classList.add('auction-bar-off');
              try { sessionStorage.setItem('soard-auction-bar', 'dismissed'); } catch (e) {}
            });
          }
        }

        /* Let the page settle for a beat, then bring the bar in. */
        function enter() {
          var bar = document.querySelector('.auction-bar');
          if (!bar || bar.classList.contains('is-in')) return;
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { bar.classList.add('is-in'); });
          });
        }

        wire();
        tick();
        setTimeout(enter, 350);
        setInterval(tick, 30000);
        document.addEventListener('astro:page-load', function () { wire(); tick(); enter(); });
      })();
    </script>
  </>
)}

<style>
  /* ─────────────────────────────────────────────────────────────
     Mobile first: fixed to the bottom, in the thumb arc.
     ───────────────────────────────────────────────────────────── */
  .auction-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 950; /* over content, under the mobile nav overlay (1100) */
    display: flex;
    align-items: stretch;
    background: var(--c-dark-deep);
    color: var(--c-cream);
    font-family: var(--font-body);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.18);
  }

  /* Hidden by the inline script when dismissed or past the cutoff. */
  :global(html.auction-bar-off) .auction-bar { display: none; }

  /* Entrance. Only armed when the inline script ran, so no-JS shows in place. */
  :global(html.auction-bar-anim) .auction-bar {
    transform: translateY(100%);
    transition: transform 550ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(html.auction-bar-anim) .auction-bar.is-in { transform: none; }

  .auction-bar__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 0.6rem;
    row-gap: 0.25rem;
    flex: 1;
    min-width: 0;
    padding: 0.6rem 0.4rem 0.6rem 1rem;
    color: inherit;
    text-decoration: none;
  }
  /* Let the copy's children become grid items so they can be placed. */
  .auction-bar__copy { display: contents; }
  .auction-bar__dot    { grid-area: 1 / 1 / 2 / 2; }
  .auction-bar__teaser { grid-area: 1 / 2 / 2 / 4; }
  .auction-bar__meta   { grid-area: 2 / 1 / 3 / 3; }
  .auction-bar__cta    { grid-area: 2 / 3 / 3 / 4; }
  .auction-bar__link:focus-visible {
    outline: 2px solid var(--c-yellow);
    outline-offset: -3px;
    border-radius: 4px;
  }

  .auction-bar__dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-yellow);
    animation: auction-pulse 2s ease-out infinite;
  }
  @keyframes auction-pulse {
    0%   { box-shadow: 0 0 0 0 var(--c-yellow-glow); }
    70%  { box-shadow: 0 0 0 7px rgba(255, 218, 36, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 218, 36, 0); }
  }
  /* Under an hour the dot beats faster and the copy goes yellow. */
  .auction-bar.is-urgent .auction-bar__dot { animation-duration: 1s; }
  .auction-bar.is-urgent .auction-bar__time { color: var(--c-yellow); font-weight: 700; }

  /* What is actually up for grabs. This is the line that earns the tap. */
  .auction-bar__teaser {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .auction-bar__meta {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: rgba(254, 252, 245, 0.6);
    white-space: nowrap;
  }
  .auction-bar__count { font-weight: 700; color: var(--c-yellow); }
  .auction-bar__sep { opacity: 0.55; }
  /* Tabular figures so the minutes ticking down never shift the layout. */
  .auction-bar__time { font-variant-numeric: tabular-nums; }

  .auction-bar__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    background: var(--c-yellow);
    color: var(--c-dark);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }
  .auction-bar__link:hover .auction-bar__cta { background: var(--c-yellow-hover); }

  .auction-bar__dismiss {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem; /* 44px touch target even though the glyph stays small */
    background: none;
    border: none;
    color: rgba(254, 252, 245, 0.45);
    cursor: pointer;
    transition: color var(--transition-fast);
  }
  .auction-bar__dismiss:hover { color: var(--c-cream); }
  .auction-bar__dismiss:focus-visible {
    outline: 2px solid var(--c-yellow);
    outline-offset: -3px;
    border-radius: 4px;
  }

  /* Keep the page's own content clear of the fixed bar. */
  @media (max-width: 767px) {
    :global(body) { padding-bottom: calc(86px + env(safe-area-inset-bottom, 0px)); }
    :global(html.auction-bar-off body) { padding-bottom: 0; }

    /* The gala page ships its own sticky bid bar; never stack two. */
    :global(body:has(.gv-sticky-cta)) .auction-bar { display: none; }
    :global(body:has(.gv-sticky-cta)) { padding-bottom: 0; }
  }

  /* ─────────────────────────────────────────────────────────────
     Desktop: back into the flow, above the sticky header.
     ───────────────────────────────────────────────────────────── */
  @media (min-width: 768px) {
    .auction-bar {
      position: relative;
      z-index: 999; /* under the sticky header (1000) so it tucks away cleanly */
      justify-content: center;
      gap: 0.25rem;
      border-top: none;
      box-shadow: none;
      padding-bottom: 0;
      padding-left: env(safe-area-inset-left, 0px);
      padding-right: env(safe-area-inset-right, 0px);
    }
    .auction-bar__link {
      flex: 0 1 auto;
      justify-content: center;
      gap: 0.75rem;
      padding: 0.6rem 0.5rem 0.6rem 1rem;
    }
    .auction-bar__link {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      flex: 0 1 auto;
    }
    /* Flatten both wrappers so every part sits on one row. */
    .auction-bar__copy,
    .auction-bar__meta { display: contents; }
    .auction-bar__count { order: -1; font-size: 0.875rem; }
    .auction-bar__sep { order: -1; }
    .auction-bar__teaser { order: 0; font-size: 0.875rem; font-weight: 400; color: rgba(254, 252, 245, 0.72); }
    .auction-bar__time { order: 1; font-size: 0.875rem; color: rgba(254, 252, 245, 0.72); }
    .auction-bar__time::before { content: '\00B7'; margin-right: 0.55rem; opacity: 0.55; }
    .auction-bar__cta {
      font-size: 0.8125rem;
      padding: 0.3rem 0.7rem;
    }
    .auction-bar__link:hover .auction-bar__cta { transform: translateX(2px); }
    .auction-bar__dismiss { width: 2rem; }
    /* In flow at the top: slide down into space already reserved, so no shift. */
    :global(html.auction-bar-anim) .auction-bar { transform: translateY(-100%); }
    :global(html.auction-bar-anim) .auction-bar.is-in { transform: none; }
  }

  /* Sub-375px phones: one step down keeps the whole teaser on the line. */
  @media (max-width: 374px) {
    .auction-bar__teaser { font-size: 0.75rem; }
    .auction-bar__meta { font-size: 0.6875rem; }
    .auction-bar__cta { padding: 0.55rem 0.8rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.auction-bar-anim) .auction-bar { transform: none; transition: none; }
    .auction-bar__dot { animation: none; }
    .auction-bar__link:hover .auction-bar__cta { transform: none; }
  }

  @media print { .auction-bar { display: none; } }
</style>
