---
/**
 * LiveDesign.astro — "The design" on a reveal's live page
 * =======================================================
 * The room as it was, the plan the designers drew and the look they chose,
 * on the live page from an hour before the reveal, through it and after
 * (Peter, Nov 9 2026: "it should remain on the page during the reveal too").
 * It sits under the hero, never on the video. Empty and hidden in the built
 * page: src/utils/live-design.ts fills it once /api/reveal-design says it's
 * open, so nothing of the design is in the page before then.
 *
 * Any picture opens large in the viewer (a native <dialog>): drawings need
 * room to be read. Arrows, swipe and Escape work there. During the watch
 * party it is not modal, so the reveal stays in sight: on a laptop it opens
 * beside the video, over the messages (ldv--side, as the give form does);
 * on a phone it fills the screen with the video held small in its top left
 * corner (ldv--pinned: the bar leaves that corner, --ldp-*, and LiveStage
 * pins the video there). The design strip beside the video is
 * LiveDesignRail.astro; live-design.ts drives both.
 */
---

<section class="live-design" data-live-design aria-labelledby="ldz-title" hidden>
  <div class="container">
    <div class="ldz-head">
      <p class="section-label section-label--yellow">The design</p>
      <h2 id="ldz-title" class="ldz-title"><span data-ldz="name">The</span> room, <em>from plan to reveal</em></h2>
      <p class="ldz-lead" data-ldz="lead">How the room looked, the plan the designers drew, and the look they chose. Watch the reveal to see it finished.</p>
    </div>
    <div class="ldz-parts" data-ldz="parts"></div>
  </div>
</section>

<dialog class="ldv" data-ldz-viewer aria-labelledby="ldv-caption">
  <div class="ldv__bar">
    <p class="ldv__caption" id="ldv-caption"><span class="ldv__kicker" data-ldv="kicker"></span><span data-ldv="caption"></span></p>
    <span class="ldv__count" data-ldv="count" aria-live="polite"></span>
    <form method="dialog"><button class="ldv__btn" type="submit" aria-label="Close" data-ldv="close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button></form>
  </div>
  <div class="ldv__stage" data-ldv="stage">
    <img class="ldv__img" data-ldv="img" alt="" />
  </div>
  <div class="ldv__nav">
    <button class="ldv__btn" type="button" data-ldv="prev" aria-label="Previous picture">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button class="ldv__btn" type="button" data-ldv="next" aria-label="Next picture">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
</dialog>

<!-- Global: the cards are drawn by live-design.ts, so they never carry this component's scope. Every class is ldz-/ldv- -->
<style is:global>
  .live-design { background: #fff; border-top: 1px solid var(--c-border); padding: clamp(56px, 7vw, 96px) 0; scroll-margin-top: 80px; }
  .live-design[hidden] { display: none; }
  .ldz-head { max-width: 720px; margin-bottom: clamp(32px, 4vw, 48px); }
  .ldz-title { font-size: clamp(1.9rem, 3.4vw, 2.75rem); letter-spacing: -0.02em; line-height: 1.15; margin: 0 0 14px; }
  /* The site's yellow marker, as a flat bar behind the words */
  .ldz-title em { position: relative; z-index: 0; font-style: italic; font-weight: 400; white-space: nowrap; padding: 0 0.05em; }
  .ldz-title em::after { content: ''; position: absolute; z-index: -1; left: 0; right: 0; bottom: 0.06em; height: 0.42em; background: rgba(255, 218, 36, 0.42); }
  .ldz-lead { color: var(--c-text-muted); line-height: 1.7; margin: 0; }

  .ldz-parts { display: grid; gap: clamp(40px, 5vw, 64px); }
  .ldz-part__head { display: flex; align-items: baseline; gap: 14px; margin: 0 0 18px; }
  .ldz-part__title { font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 700; letter-spacing: -0.015em; margin: 0; }
  .ldz-part__note { color: var(--c-text-muted); font-size: 15px; margin: 0; }

  .ldz-grid { display: grid; gap: 16px; list-style: none; margin: 0; padding: 0; }
  .ldz-grid--photos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ldz-grid--photos[data-n='1'] { grid-template-columns: minmax(0, 1fr); max-width: 880px; }
  .ldz-grid--photos[data-n='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ldz-grid--photos[data-n='4'] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ldz-grid--plans { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .ldz-grid--boards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .ldz-grid--one { grid-template-columns: minmax(0, 1fr); max-width: 880px; }

  .ldz-item {
    position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in;
    border-radius: 18px; overflow: hidden; text-align: left; color: inherit; font: inherit;
  }
  .ldz-item:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 3px; box-shadow: 0 0 0 6px var(--c-dark); }
  /* The picture's own box: it has its shape before the picture arrives (set from a tiny copy), so nothing jumps */
  .ldz-pic { position: relative; display: block; width: 100%; aspect-ratio: 3 / 2; overflow: hidden; }
  .ldz-pic img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .ldz-pic img:not([src]) { visibility: hidden; }
  .ldz-item:hover .ldz-pic img { transform: scale(1.025); }
  .ldz-grid--photos .ldz-item { background: var(--c-cream); }
  .ldz-grid--photos .ldz-pic { aspect-ratio: 4 / 3; }
  .ldz-grid--photos .ldz-pic img { object-fit: cover; }
  /* Drawings and boards on paper: whole, never cropped by the card */
  .ldz-paper { background: #fff; border: 1px solid var(--c-border); box-shadow: 0 18px 40px rgba(30, 31, 37, 0.07); padding: 60px clamp(14px, 2vw, 24px) clamp(14px, 2vw, 24px); }
  .ldz-boards .ldz-paper { padding-top: clamp(14px, 2vw, 24px); }
  /* What a picture is, on it: BEFORE on the room's photos, EXISTING and PROPOSED on the plans. Solid and ringed in white
     so it reads on any photo; the new plan's is the yellow one (the strip's and the starting-soon screen's look) */
  .ldz-badge {
    position: absolute; top: 12px; left: 12px; z-index: 1; padding: 7px 12px 6px; border-radius: 8px;
    background: var(--c-dark); color: #fff; font-size: 13px; font-weight: 800; line-height: 1.1; letter-spacing: 0.12em; text-transform: uppercase;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.92), 0 6px 18px rgba(0, 0, 0, 0.2);
  }
  .ldz-badge--proposed { background: var(--c-yellow); color: var(--c-dark); }
  /* A plan's or a board's caption, under it */
  .ldz-cap { margin: 12px 0 0; color: var(--c-text); font-size: 15px; font-weight: 600; line-height: 1.35; }

  @media (max-width: 768px) {
    .ldz-grid--photos, .ldz-grid--photos[data-n='4'] { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .ldz-grid--plans, .ldz-grid--boards { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .ldz-item { border-radius: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ldz-item img { transition: none; }
    .ldz-item:hover .ldz-pic img { transform: none; }
  }

  /* ── Viewer ── */
  .ldv {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: #16171b; color: #fff; overflow: hidden; overscroll-behavior: contain;
    display: grid; grid-template-rows: auto minmax(0, 1fr) auto;
  }
  .ldv:not([open]) { display: none; }
  .ldv::backdrop { background: rgba(22, 23, 27, 0.6); }

  /* Where the video sits, small, while the viewer covers a phone (LiveStage's 'design' pin reads these) */
  :root { --ldp-top: calc(max(10px, env(safe-area-inset-top, 0px)) + 30px); --ldp-h: 148px; --ldp-hw: 88px; --ldp-left: max(12px, env(safe-area-inset-left, 0px)); }

  /* Beside the video on a laptop: down the left, over the messages; the video and the strip stay as they are */
  .ldv.ldv--side {
    position: fixed; z-index: 1200; inset: calc(var(--header-height) + 12px) auto 12px 12px;
    width: var(--ldv-w, 640px); height: auto; border-radius: 20px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.32), 0 8px 24px rgba(0, 0, 0, 0.14);
    animation: ldv-side 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes ldv-side { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: none; } }
  .ldv--side .ldv__bar { padding-top: 16px; }

  /* A phone: the whole screen, the video small in the top left corner and the caption beside it */
  .ldv.ldv--pinned { position: fixed; z-index: 1200; inset: 0; animation: ldv-pinned 0.24s ease-out; }
  @keyframes ldv-pinned { from { opacity: 0; } to { opacity: 1; } }
  .ldv--pinned .ldv__bar {
    --pin-w: calc(var(--ldp-h) * 0.5625);
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: start; column-gap: 12px; row-gap: 8px;
    min-height: calc(var(--ldp-top) + var(--ldp-h) + 12px); padding: var(--ldp-top) 12px 0 calc(var(--ldp-left) + var(--pin-w) + 16px);
  }
  .ldv--pinned.ldv--wide .ldv__bar { --pin-w: calc(var(--ldp-hw) * 1.7778); min-height: calc(var(--ldp-top) + var(--ldp-hw) + 12px); }
  .ldv--pinned .ldv__caption { display: block; grid-column: 1; grid-row: 1; font-size: 15.5px; -webkit-line-clamp: unset; }
  .ldv--pinned .ldv__count { grid-column: 1; grid-row: 2; font-size: 13.5px; }
  .ldv--pinned .ldv__bar > form { grid-column: 2; grid-row: 1; margin-top: -4px; }
  @media (prefers-reduced-motion: reduce) { .ldv.ldv--side, .ldv.ldv--pinned { animation: none; } }
  .ldv__bar { display: flex; align-items: center; gap: 16px; padding: max(14px, env(safe-area-inset-top)) clamp(14px, 3vw, 28px) 10px; }
  .ldv__caption { flex: 1; min-width: 0; margin: 0; font-size: 16px; font-weight: 600; line-height: 1.35; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .ldv__kicker { margin-right: 10px; color: var(--c-yellow); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  /* A picture's badge leads its caption, as on the picture: white for the room before and the existing plan, yellow for the proposed */
  .ldv__kicker:is([data-kind='before'], [data-kind='as-built'], [data-kind='proposed']) {
    display: inline-block; padding: 5px 9px 4px; border-radius: 6px; background: #fff; color: #16171b;
    font-weight: 800; letter-spacing: 0.12em; vertical-align: 1px;
  }
  .ldv__kicker[data-kind='proposed'] { background: var(--c-yellow); }
  /* On a phone, beside the small video: the badge on its own line above the caption */
  .ldv.ldv--pinned .ldv__kicker { display: table; margin: 0 0 8px; }
  .ldv__count { color: rgba(255, 255, 255, 0.7); font-size: 14px; font-variant-numeric: tabular-nums; }
  /* The picture always fits the space between the bar and the arrows, whatever its shape and the screen's */
  .ldv__stage { position: relative; min-height: 0; margin: 8px clamp(8px, 3vw, 28px); touch-action: pinch-zoom; }
  .ldv__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ldv__nav { display: flex; justify-content: center; gap: 16px; padding: 10px 0 max(18px, env(safe-area-inset-bottom)); }
  .ldv__btn {
    display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.28); background: rgba(255, 255, 255, 0.08); color: #fff; cursor: pointer;
  }
  .ldv__btn:hover { background: rgba(255, 255, 255, 0.16); }
  .ldv__btn:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; }
  .ldv__btn[hidden] { display: none; }
  /* A narrow phone with a landscape video: beside the small video there's no room for words, so they go under it */
  @media (max-width: 420px) {
    .ldv--pinned.ldv--wide .ldv__bar { min-height: 0; padding: calc(var(--ldp-top) + var(--ldp-hw) + 12px) 12px 0; }
  }
  /* (Last, so it wins over the phone rules above.) A phone held sideways: the small video keeps the left side to itself and the viewer takes the rest at full height
     (above the picture, the room the video needs would leave the picture a sliver) */
  @media (min-aspect-ratio: 7/4) and (max-height: 540px) and (min-width: 560px) and (max-width: 960px), (min-aspect-ratio: 7/4) and (max-height: 540px) and (min-width: 560px) and (max-width: 1023px) and (pointer: coarse) {
    .ldv.ldv--pinned {
      --pin-w: calc(var(--ldp-h) * 0.5625);
      grid-template-columns: calc(var(--ldp-left) + var(--pin-w) + 16px) minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr);
    }
    .ldv.ldv--pinned.ldv--wide { --pin-w: calc(var(--ldp-hw) * 1.7778); }
    .ldv.ldv--pinned > .ldv__bar { grid-column: 2; grid-row: 1; }
    .ldv.ldv--pinned > .ldv__stage { grid-column: 2; grid-row: 2; margin-top: 4px; }
    /* The arrows under the small video, in the room it leaves, so the picture gets the height */
    .ldv.ldv--pinned > .ldv__nav { grid-column: 1; grid-row: 1 / -1; align-self: end; flex-wrap: wrap; justify-content: flex-start; gap: 8px; padding: 0 0 max(12px, env(safe-area-inset-bottom)) var(--ldp-left); }
    .ldv--pinned .ldv__bar, .ldv--pinned.ldv--wide .ldv__bar { min-height: 0; padding: var(--ldp-top) max(12px, env(safe-area-inset-right)) 0 0; }
    .ldv.ldv--pinned > .ldv__stage { margin-right: max(8px, env(safe-area-inset-right)); }
    /* The badge leads the caption on its line, as on a laptop */
    .ldv.ldv--pinned .ldv__kicker { display: inline-block; margin: 0 10px 0 0; }
  }
</style>
