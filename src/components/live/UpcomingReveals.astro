---
/**
 * UpcomingReveals.astro — "Coming up": the next reveals, in date order
 * =====================================================================
 * On /live/ (it leads the page between reveals) and the events page.
 * Filled in the browser from /api/reveals (JobTread, edge-cached), so a date
 * set or moved in JobTread shows within minutes, with no rebuild. Hidden
 * until there's a reveal to show; no placeholder while it loads.
 *
 * A confirmed reveal shows its day and time, "Watch live" and its own
 * calendar file. A tentative one shows only its third of the month, "Mid
 * November", on a three-part month bar, never a day (Peter, Oct 22 2026).
 * Every child has their own "Add to calendar" invite (the live link only;
 * it fills in the day and time on its own, RevealInvite.astro), and the
 * panel adds every reveal in one calendar. On /live/ between reveals the
 * hero shows these instead (HeroUpcoming), so this band closes the page.
 *
 * A timeline: the "when" in a column, a dot on a line, the kid beside it.
 * Beside it, "Get every reveal by email" and "in your calendar". On a phone
 * the when sits above each card and the two cards follow the list. Motion: the line draws, rows rise in turn, the month bar fills;
 * all of it off with reduced motion.
 */

import { remindPromise } from '../../utils/live-banner';
import { upcomingAtBuild } from '../../utils/reveals-copy';
import { bandRowsHtml } from '../../utils/band-rows';
import { rowsSignature } from '../../utils/upcoming-rows';

interface Props {
  /** Heading HTML (fixed strings from the page; <em> gets the marker) */
  heading?: string;
  lead?: string;
  label?: string;
  /** A kid left out of the list (the live page's own kid, whose timing its hero shows) */
  exclude?: string | null;
  /** Where clicks are counted from (broadcast History) */
  where?: string;
  id?: string;
  /** Given (the events page): with nothing scheduled the band stays, with this lead and the two ways to hear about the next one */
  emptyLead?: string;
}

const {
  heading = 'The next rooms to <em>reveal</em>',
  lead = 'These families are in the middle of their builds. Each reveal gets its exact day and time once the build is close, and every one streams live right here.',
  label = 'Coming up',
  exclude = null,
  where = 'up-next',
  id = 'up-next',
  emptyLead = '',
} = Astro.props;

// Drawn at build from the reveals copy, so the band has its height from the first paint (the browser redraws only
// when /api/reveals says something different): nothing jumps when it arrives, and Back or a reload lands in place
const atBuild = upcomingAtBuild().filter((r) => r.slug !== exclude);
---

<section class="upn" id={id} data-invite-where={where} data-upnext data-exclude={exclude || ''} data-keep-empty={emptyLead ? '' : undefined} data-empty={atBuild.length ? undefined : ''} hidden={!atBuild.length && !emptyLead} aria-labelledby={`${id}-title`}>
  <!-- Reading order is the order on screen at every width: the intro, the reveals, then the ways to follow them all.
       On a wide screen the cards sit in the left column under the intro (grid areas) -->
  <div class="container upn__grid">
    <div class="upn__intro">
      <p class="section-label section-label--yellow upn__label">{label}</p>
      <h2 id={`${id}-title`} class="upn__title" set:html={heading} />
      <p class="upn__lead upn__lead--full">{lead}</p>
      {emptyLead && <p class="upn__lead upn__lead--empty">{emptyLead}</p>}
    </div>

    <ol class="upn__list" data-upn-list data-sig={rowsSignature(atBuild)} aria-label="Upcoming reveals" set:html={bandRowsHtml(atBuild)}></ol>

    <div class="upn-ways">
      <!-- Email for every reveal: there from the first paint, taken out if Reveals → Settings has reminders off, and left
           out on /live/ while that page's own reminder form is already the every-reveal one (data-remind-here) -->
      <!-- id: a page's "Get every reveal by email" button comes here (/reveals/) -->
      <div class="upn-cal upn-mail" id={`${id}-mail`} data-upn-mail>
        <div class="upn-cal__head">
          <span class="upn-cal__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <div>
            <h3 class="upn-cal__title" id={`${id}-mail-title`}>Get every reveal by email</h3>
            <p class="upn-cal__text" data-upn-mail-lead>{remindPromise()}</p>
          </div>
        </div>
        <!-- method="post" and a button that's off until the script wires it: nothing ever sends the address in a link -->
        <form class="upn-mail__form" data-upn-mail-form method="post" novalidate aria-labelledby={`${id}-mail-title`}>
          <div class="upn-mail__row">
            <label class="sr-only" for={`${id}-email`}>Email address for every reveal</label>
            <input class="upn-mail__input" id={`${id}-email`} type="email" name="email" placeholder="you@example.com" autocomplete="email" enterkeyhint="send" required />
            <button class="upn-cal__btn upn-mail__btn" type="submit" disabled>
              <span class="btn-text">Email me</span><span class="btn-busy"><span class="btn-spinner" aria-hidden="true"></span><span class="sr-only">Sending</span></span><span class="btn-done">Sent</span>
            </button>
          </div>
          <div class="upn-mail__hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <p class="remind-note" role="status" aria-live="polite"></p>
        </form>
        <!-- The quick check (Turnstile) runs in a small frame here, out of sight unless it needs a click -->
        <div class="upn-mail__check" data-upn-mail-check></div>
      </div>

      <div class="upn-cal" data-upn-cal>
        <div class="upn-cal__head">
          <span class="upn-cal__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
          </span>
          <div>
            <h3 class="upn-cal__title">Get every reveal in your calendar</h3>
            <p class="upn-cal__text"><span data-cal-one>Or add one child at a time with their own invite. </span>Every reveal shows up with its day, time and live link as soon as it's set, and moves on its own if plans change.</p>
          </div>
        </div>
        <button class="upn-cal__btn" type="button" data-invite="all">Add every reveal</button>
        <!-- With no script the sheet can't open: the calendar feed itself, which any calendar app can subscribe to -->
        <a class="upn-cal__btn upn-cal__nojs" href="webcal://sunshineonaranneyday.com/api/reveals.ics">Add every reveal</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section: a dark band, so the schedule reads apart from the cream and white around it ── */
  .upn {
    --upn-ink: var(--c-cream);
    --upn-muted: rgba(254, 252, 245, 0.68);
    --upn-faint: rgba(254, 252, 245, 0.14);
    --upn-card: rgba(255, 255, 255, 0.045);
    --upn-card-hover: rgba(255, 255, 255, 0.08);
    --upn-line: rgba(255, 218, 36, 0.28);
    --upn-when: 150px;
    --upn-node: 28px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    /* No overflow clipping here: it would stop the intro column from sticking (the glow clips itself) */
    position: relative; isolation: isolate;
    background: var(--c-dark-deep); color: var(--upn-ink);
    padding-block: clamp(64px, 8vw, 112px);
    /* The page's scroll-padding already clears the header plus 1rem; the dark band lands flush under the header */
    scroll-margin-top: -1rem;
  }
  .upn[hidden] { display: none; }
  .upn__grid {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas: 'intro list' 'ways list'; grid-template-rows: auto 1fr;
    column-gap: clamp(40px, 6vw, 96px); row-gap: 32px; align-items: start;
  }
  .upn__intro { grid-area: intro; }
  .upn__list { grid-area: list; }
  /* The cards stay in view while a long list scrolls by, but only when they fit with room for a note and the
     quick check to open under them (data-ways="stick", decided by placeWays() below); otherwise they scroll with
     the page. Never pinned by their foot: growing would then push the button up under the pointer. */
  .upn-ways { grid-area: ways; align-self: start; }
  .upn[data-ways='stick'] .upn-ways { position: sticky; top: calc(var(--header-height) + 32px); }

  /* ── Intro ── */
  .upn__label { color: var(--c-yellow); }
  .upn__title {
    margin: 0; color: var(--upn-ink);
    font-size: clamp(2rem, 3.6vw, 3rem); letter-spacing: -0.03em; line-height: 1.08;
  }
  .upn__title :global(em) {
    font-style: italic; background-image: linear-gradient(transparent 58%, rgba(255, 218, 36, 0.38) 58%, rgba(255, 218, 36, 0.38) 92%, transparent 92%);
    background-repeat: no-repeat; background-size: 0% 100%; padding: 0 0.05em;
    transition: background-size 1.1s var(--ease) 0.35s;
  }
  .upn.is-in .upn__title :global(em) { background-size: 100% 100%; }
  .upn__lead { margin: 18px 0 0; color: var(--upn-muted); font-size: clamp(15px, 1.4vw, 17px); line-height: 1.7; max-width: 460px; }

  /* ── Calendar panel ── */
  .upn-cal {
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 20px; padding: 24px;
  }
  .upn-cal__head { display: flex; gap: 16px; align-items: flex-start; margin-bottom: 20px; }
  .upn-cal__icon {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center;
    background: var(--c-yellow); color: var(--c-dark-deep);
  }
  .upn-cal__title { margin: 0 0 6px; font-family: var(--font-body); font-size: 17px; font-weight: 700; letter-spacing: -0.005em; color: var(--upn-ink); }
  .upn-cal__text { margin: 0; color: var(--upn-muted); font-size: 14.5px; line-height: 1.6; }
  .upn-cal__btn {
    display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 50px; padding: 12px 20px;
    border-radius: 100px; border: 0; background: var(--c-yellow); color: var(--c-dark-deep);
    font: inherit; font-size: 15px; font-weight: 700; cursor: pointer;
    transition: background 0.2s ease, transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .upn-cal__btn:hover { background: var(--c-yellow-hover); transform: translateY(-1px); box-shadow: 0 10px 26px rgba(255, 218, 36, 0.18); }
  .upn-cal__btn:active { transform: scale(0.98); transition-duration: 80ms; }
  /* A yellow ring a dark gap away (the site's ring adds a yellow glow that melts into a yellow button) */
  .upn-cal__btn:focus-visible { outline: 2px solid var(--c-yellow); outline-offset: 3px; box-shadow: none; }

  /* ── The two ways to follow every reveal: email, then the calendar ── */
  .upn-ways { display: grid; gap: 14px; }
  /* On /live/ the page's own form may already be the every-reveal one (data-remind-here): the card steps out,
     except while someone is using it (data-mail-busy), so it never vanishes mid-word, or once they've signed up in it
     (data-mail-done), so their confirmation stays */
  .upn-mail[hidden], .upn[data-remind-here]:not([data-mail-busy]):not([data-mail-done]):not([data-mail-seen]) .upn-mail { display: none; }
  /* The address and its button share a line; with no room, the button takes its own, full width */
  .upn-mail__row { display: flex; flex-wrap: wrap; gap: 10px; }
  .upn-mail__input {
    flex: 999 1 240px; min-width: 0; min-height: 50px; padding: 0 20px; border-radius: 100px;
    border: 1.5px solid rgba(254, 252, 245, 0.34); background: rgba(255, 255, 255, 0.06); color: var(--upn-ink);
    font: inherit; font-size: 16px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
  }
  .upn-mail__input::placeholder { color: rgba(254, 252, 245, 0.62); }
  .upn-mail__input:hover { border-color: rgba(254, 252, 245, 0.5); }
  .upn-mail__input:focus { outline: none; border-color: var(--c-yellow); box-shadow: 0 0 0 3px rgba(255, 218, 36, 0.22); }
  /* "Email me", the spinner and "Sent" share one cell, so the button never changes size: nothing moves */
  .upn-mail__btn { flex: 1 0 auto; width: auto; padding: 0 26px; display: inline-grid; place-items: center; }
  .upn-mail__btn > span { grid-area: 1 / 1; display: inline-flex; align-items: center; }
  .upn-mail__btn .btn-busy, .upn-mail__btn .btn-done { visibility: hidden; }
  .upn-mail__form:global(.is-busy) .btn-text, .upn-mail__form:global(.is-done) .btn-text { visibility: hidden; }
  .upn-mail__form:global(.is-busy) .btn-busy, .upn-mail__form:global(.is-done) .btn-done { visibility: visible; }
  .upn-mail__btn[aria-disabled='true'], .upn-mail__btn[aria-disabled='true']:hover, .upn-mail__btn[aria-disabled='true']:active {
    cursor: default; transform: none; box-shadow: none; background: var(--c-yellow);
  }
  /* Sent: the address quietens, still readable (as on the /live/ form) */
  .upn-mail__form:global(.is-done) .upn-mail__input { color: var(--upn-muted); }
  /* Not a usable address: the box says so too, not only the words under it */
  .upn-mail__input[aria-invalid='true'] { border-color: var(--upn-ink); border-width: 2px; }
  /* The browser's saved address keeps the band's colours (Chrome paints autofill pale blue otherwise) */
  .upn-mail__input:-webkit-autofill, .upn-mail__input:-webkit-autofill:hover {
    -webkit-text-fill-color: var(--upn-ink); caret-color: var(--upn-ink);
    -webkit-box-shadow: 0 0 0 100px #36373C inset; transition: background-color 600000s 0s;
  }
  .upn-mail__input:-webkit-autofill:focus { -webkit-box-shadow: 0 0 0 100px #36373C inset, 0 0 0 3px rgba(255, 218, 36, 0.22); }
  .upn-mail__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .upn-mail .remind-note { margin: 12px 0 0; font-size: 14px; line-height: 1.55; color: var(--upn-muted); overflow-wrap: anywhere; }
  .upn-mail .remind-note:empty { margin: 0; }
  .upn-mail .remind-note.remind-note--error { color: var(--upn-ink); font-weight: 600; }
  .upn-mail :global(.remind-fix) {
    padding: 0; border: 0; background: none; font: inherit; font-weight: 600; color: var(--upn-ink); cursor: pointer;
    text-decoration: underline; text-decoration-color: var(--c-yellow); text-underline-offset: 3px; overflow-wrap: anywhere;
  }
  .upn-mail :global(.remind-fix:focus-visible) { outline: 2px solid var(--c-yellow); outline-offset: 0; border-radius: 2px; box-shadow: none; }
  .upn-mail__check :global(iframe) { display: block; width: 100%; height: 0; border: 0; overflow: hidden; transition: height 0.2s ease; }
  .upn-mail__check:global(.is-shown) :global(iframe) { height: 72px; margin-top: 12px; }

  /* ── Timeline ── */
  .upn__list { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  /* The line runs through the dots, from the first to the last */
  .upn__list::before {
    content: ''; position: absolute; left: calc(var(--upn-when) + var(--upn-node) / 2 - 1px); width: 2px;
    top: var(--upn-line-top, 40px); bottom: var(--upn-line-bottom, 40px);
    background: var(--upn-line);
    transform-origin: top; transform: scaleY(0); transition: transform 1.2s var(--ease) 0.15s;
  }
  .upn.is-in .upn__list::before { transform: scaleY(1); }
  /* One reveal: a dot, no line */
  .upn__list:has(> :only-child)::before { display: none; }

  /* ── Nothing scheduled (the events page keeps the band): the intro, then the two ways to hear about the next one ── */
  .upn__lead--empty { display: none; }
  .upn[data-empty] .upn__lead--full, .upn[data-empty] .upn__list, .upn[data-empty] [data-cal-one] { display: none; }
  .upn[data-empty] .upn__lead--empty { display: block; }
  @media (min-width: 961px) {
    .upn[data-empty] .upn__grid { grid-template-areas: 'intro ways'; grid-template-rows: none; }
  }

  :global(.upn-row) {
    display: grid; grid-template-columns: var(--upn-when) var(--upn-node) minmax(0, 1fr); align-items: center;
    opacity: 0; transform: translateY(18px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    transition-delay: calc(0.25s + var(--i, 0) * 0.09s);
  }
  .upn.is-in :global(.upn-row) { opacity: 1; transform: none; }
  /* No script: the rows the build drew are simply there; the email card (it needs the script) and the child's own
     invite buttons (they open a sheet) step out; "Add every reveal" is the calendar feed itself */
  .upn-cal__nojs { display: none; }
  @media (scripting: none) {
    :global(.upn-row) { opacity: 1; transform: none; }
    .upn-mail, .upn :global(.upn-add), .upn-cal__btn[data-invite] { display: none; }
    .upn-cal__nojs { display: inline-flex; text-decoration: none; }
  }
  /* Before the script has wired it (a slow phone), "Email me" looks as off as it is */
  .upn-mail__btn:disabled { opacity: 0.55; cursor: default; transform: none; box-shadow: none; }

  /* When */
  :global(.upn-when) { padding-right: 18px; text-align: right; }
  :global(.upn-when__top) { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--c-yellow); }
  :global(.upn-when__main) { margin: 4px 0 0; font-family: var(--font-display); font-weight: 700; font-size: 20px; letter-spacing: -0.02em; line-height: 1.15; color: var(--upn-ink); white-space: nowrap; }
  :global(.upn-when__sub) { margin: 4px 0 0; font-size: 13.5px; color: var(--upn-muted); }
  /* A month in thirds; the reveal's third fills in */
  :global(.upn-month) { display: inline-flex; gap: 4px; margin-top: 10px; }
  :global(.upn-month span) { position: relative; width: 22px; height: 4px; border-radius: 4px; background: var(--upn-faint); overflow: hidden; }
  :global(.upn-month span.is-on)::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; background: var(--c-yellow);
    transform-origin: left; transform: scaleX(0); transition: transform 0.8s var(--ease);
    transition-delay: calc(0.65s + var(--i, 0) * 0.09s);
  }
  .upn.is-in :global(.upn-month span.is-on)::after { transform: scaleX(1); }

  /* Dot */
  :global(.upn-node) { position: relative; justify-self: center; width: 14px; height: 14px; border-radius: 50%; background: var(--c-dark-deep); border: 2px solid var(--c-yellow); }
  :global(.upn-row[data-state='confirmed'] .upn-node) { background: var(--c-yellow); box-shadow: 0 0 0 5px rgba(255, 218, 36, 0.16); }
  :global(.upn-row.is-next .upn-node)::after {
    content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid var(--c-yellow); opacity: 0;
    animation: upn-ping 2.4s cubic-bezier(0, 0, 0.2, 1) 1.4s infinite;
  }
  @keyframes upn-ping { 0% { transform: scale(0.6); opacity: 0.85; } 70%, 100% { transform: scale(1.7); opacity: 0; } }

  /* Card */
  :global(.upn-card) {
    position: relative; display: flex; align-items: center; gap: 18px; min-width: 0;
    padding: 14px 20px 14px 14px; border-radius: 20px;
    background: var(--upn-card); border: 1px solid rgba(255, 255, 255, 0.07);
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  :global(.upn-card:hover) { background: var(--upn-card-hover); border-color: rgba(255, 255, 255, 0.12); transform: translateY(-2px); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28); }
  :global(.upn-row[data-state='confirmed'] .upn-card) { border-color: rgba(255, 218, 36, 0.35); }
  :global(.upn-card__photo) {
    flex-shrink: 0; width: 96px; height: 96px; border-radius: 14px; overflow: hidden; display: block;
    background: rgba(255, 255, 255, 0.06);
  }
  :global(.upn-card__photo img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s var(--ease); }
  :global(.upn-card:hover .upn-card__photo img) { transform: scale(1.06); }
  :global(.upn-card__photo--blank) {
    display: grid; place-items: center; color: var(--c-yellow);
    font-family: var(--font-display); font-weight: 700; font-size: 38px; line-height: 1;
    background: rgba(255, 218, 36, 0.16);
  }
  :global(.upn-card__body) { min-width: 0; flex: 1; }
  :global(.upn-card__name) { margin: 0; font-size: clamp(1.25rem, 2vw, 1.5rem); letter-spacing: -0.02em; line-height: 1.2; color: var(--upn-ink); }
  /* The whole card opens the story; the actions sit above that link */
  :global(.upn-card__name a) { color: inherit; text-decoration: none; }
  :global(.upn-card__name a)::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  /* The ring goes round the whole card (below), not a second one round the name */
  :global(.upn-card__name a:focus-visible) { outline: none; box-shadow: none; }
  :global(.upn-card:has(.upn-card__name a:focus-visible)) { outline: 2px solid var(--c-yellow); outline-offset: 3px; }
  :global(.upn-card__rooms) {
    margin: 4px 0 0; font-size: 14px; line-height: 1.45; color: var(--upn-muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  :global(.upn-card__foot) { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 16px; margin-top: 12px; }
  :global(.upn-pill) {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border-radius: 100px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: var(--upn-muted); border: 1px solid rgba(254, 252, 245, 0.18);
  }
  :global(.upn-act) {
    position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 6px;
    font-size: 14px; font-weight: 700; color: var(--upn-ink); text-decoration: none;
    border-bottom: 2px solid var(--c-yellow); padding: 6px 0 2px;
  }
  :global(.upn-act svg) { transition: transform 0.25s ease; }
  :global(.upn-act:hover svg) { transform: translateX(3px); }
  :global(.upn-act:hover) { color: var(--c-yellow); }
  :global(.upn-act:focus-visible) { outline: 2px solid var(--c-yellow); outline-offset: 3px; border-radius: 2px; box-shadow: none; }
  /* The child's own invite */
  :global(.upn-add) {
    position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 0 14px; white-space: nowrap;
    border-radius: 100px; border: 1.5px solid rgba(254, 252, 245, 0.35); background: transparent; color: var(--upn-ink);
    font: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.3s var(--ease);
  }
  :global(.upn-add svg) { flex-shrink: 0; }
  :global(.upn-add:hover) { background: var(--c-yellow); border-color: var(--c-yellow); color: var(--c-dark-deep); transform: translateY(-1px); }
  :global(.upn-add:focus-visible) { outline: 2px solid var(--c-yellow); outline-offset: 3px; box-shadow: none; }
  :global(.upn-row[data-state='confirmed'] .upn-add) { background: var(--c-yellow); border-color: var(--c-yellow); color: var(--c-dark-deep); }

  /* ── Tablet and phone: one column, in reading order: intro, the list, the two cards ── */
  @media (max-width: 960px) {
    .upn__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'intro' 'list' 'ways'; grid-template-rows: none; row-gap: 36px; }
    .upn[data-ways='stick'] .upn-ways { position: static; }
    .upn[data-empty] .upn__grid { grid-template-areas: 'intro' 'ways'; }
    .upn__lead { max-width: 560px; }
  }
  /* Touch: a tap leaves no hover look behind */
  @media (hover: none) {
    .upn-cal__btn:hover { background: var(--c-yellow); transform: none; box-shadow: none; }
  }
  /* Windows high contrast: the yellow fill is dropped, so the buttons need an edge of their own */
  @media (forced-colors: active) {
    .upn-cal__btn { border: 2px solid ButtonText; }
  }
  /* Phone: the when moves above each card, the line runs down the left edge */
  @media (max-width: 640px) {
    .upn { --upn-node: 22px; }
    .upn__list { gap: 22px; }
    .upn__list::before { left: calc(var(--upn-node) / 2 - 1px); }
    :global(.upn-row) { grid-template-columns: var(--upn-node) minmax(0, 1fr); grid-template-areas: 'node when' '. card'; align-items: start; row-gap: 10px; }
    :global(.upn-node) { grid-area: node; margin-top: 3px; width: 12px; height: 12px; }
    :global(.upn-when) { grid-area: when; text-align: left; padding: 0 0 0 10px; display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; }
    :global(.upn-when__top), :global(.upn-when__main), :global(.upn-when__sub) { margin: 0; }
    :global(.upn-when__main) { font-size: 18px; }
    :global(.upn-month) { margin: 0; align-self: center; }
    :global(.upn-card) { grid-area: card; margin-left: 10px; padding: 12px 14px 12px 12px; gap: 14px; border-radius: 16px; }
    :global(.upn-card__photo) { width: 76px; height: 76px; border-radius: 12px; }
    :global(.upn-card__foot) { margin-top: 10px; }
    .upn-cal { padding: 20px; }
  }
  /* The narrowest phones (after the phone rules above, so it wins): a smaller photo, so the card's words and buttons keep inside it */
  @media (max-width: 360px) {
    :global(.upn-card) { gap: 12px; }
    :global(.upn-card__photo) { width: 56px; height: 56px; border-radius: 10px; }
    :global(.upn-card__photo--blank) { font-size: 26px; }
    :global(.upn-pill) { white-space: nowrap; }
    :global(.upn-add) { padding: 0 11px; gap: 6px; font-size: 13px; }
  }
  @media (hover: none) {
    :global(.upn-card:hover) { transform: none; box-shadow: none; }
    :global(.upn-card:hover .upn-card__photo img) { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .upn__list::before, :global(.upn-row), :global(.upn-month span.is-on)::after, .upn__title :global(em) { transition: none; }
    .upn__list::before { transform: none; }
    :global(.upn-row) { opacity: 1; transform: none; }
    :global(.upn-month span.is-on)::after { transform: none; }
    .upn__title :global(em) { background-size: 100% 100%; }
    :global(.upn-row.is-next .upn-node)::after { animation: none; }
    :global(.upn-card), :global(.upn-card__photo img), .upn-cal__btn, :global(.upn-add), .upn-mail__input, .upn-mail__check :global(iframe) { transition: none; }
  }
</style>

<script>
  import { readUpcoming, readSignup, type Signup } from '../../utils/reveals-client';
  import { upcomingAtBuild } from '../../utils/reveals-copy';
  import { bandRowsHtml } from '../../utils/band-rows';
  import { rowsSignature } from '../../utils/upcoming-rows';
  import { remindPromise } from '../../utils/live-banner';
  import { wireRemindForm } from '../../utils/remind-signup';
  import { holdPlace, keepFocus } from '../../utils/hold-place';

  /**
   * "Get every reveal by email": a sign-up with no kid, so it's for every reveal. Whether it's
   * open, and the notes it promises, come in the same /api/reveals answer as the list (Reveals →
   * Settings), so the band opens with the card already in place or already left out.
   */
  function setUpMail(section: HTMLElement) {
    const box = section.querySelector<HTMLElement>('[data-upn-mail]');
    const form = box?.querySelector<HTMLFormElement>('[data-upn-mail-form]');
    if (!box || !form) return () => {};
    const signup = wireRemindForm(form, {
      checkBox: box.querySelector<HTMLElement>('[data-upn-mail-check]'),
      kid: () => '',
      // Apart from the /live/ page's own form: "live-all", "events-all"
      source: () => `${section.dataset.inviteWhere || 'up-next'}-all`,
      theme: 'dark',
    });
    document.addEventListener('astro:before-swap', () => signup.destroy(), { once: true });
    // In use (focus in it, an address typed, or signed up): /live/ never takes it away (data-mail-busy)
    const lead = box.querySelector<HTMLElement>('[data-upn-mail-lead]');
    let held: Signup | null | undefined; // settings that came in while someone was using the card
    const apply = (s: Signup | null) => {
      box.hidden = !s?.email;
      if (lead && s) lead.textContent = remindPromise(s.hours);
    };
    // In use (focus in it, or an address typed and not sent): nothing takes it away until they're done with it.
    // Signed up in it: it stays to show so (but doesn't hold the whole band on screen, data-mail-done)
    const mark = () => {
      const was = section.hasAttribute('data-mail-busy');
      const now = signup.inUse();
      section.toggleAttribute('data-mail-busy', now);
      // Its own "Sent" keeps it; one only shown here because the page form's sign-up covered it doesn't bring it back
      section.toggleAttribute('data-mail-done', signup.signedHere());
      // Done with it: the band catches up with whatever it held back meanwhile
      if (was && !now) {
        if (held !== undefined) { apply(held); held = undefined; }
        section.dispatchEvent(new Event('upnext:current'));
      }
    };
    for (const type of ['focusin', 'input', 'remind-state']) form.addEventListener(type, mark);
    // On screen, the card never vanishes from under someone (a tap meant for it would land on what moved up): it goes
    // once it's off screen, with what they're looking at held in place
    if ('IntersectionObserver' in window) {
      const seen = new IntersectionObserver(([e]) => { holdPlace(() => section.toggleAttribute('data-mail-seen', e.isIntersecting)); });
      seen.observe(box);
      document.addEventListener('astro:before-swap', () => seen.disconnect(), { once: true });
    }
    form.addEventListener('focusout', () => setTimeout(mark));
    // undefined: the settings couldn't be read, so the card stays as it is
    return (s: Signup | null | undefined) => {
      if (s === undefined) return;
      if (section.hasAttribute('data-mail-busy')) { held = s; return; }
      apply(s);
    };
  }

  // Room the cards keep below them while they stick: a few lines of news and the quick check
  const GROW_ROOM = 170;
  /** Decides stick or scroll from the cards' height with nothing open under the form, so news or the check never flips it mid-sign-up */
  function waysPlacer(section: HTMLElement, ways: HTMLElement) {
    let closedHeight = 0;
    return () => {
      const opened = !!ways.querySelector('.remind-note:not(:empty), [data-upn-mail-check].is-shown');
      if (!opened || !closedHeight) closedHeight = ways.offsetHeight;
      const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 84;
      section.dataset.ways = closedHeight + GROW_ROOM <= innerHeight - header - 32 - 24 ? 'stick' : 'flow';
    };
  }

  /** A photo that won't load: the kid's initial in its place */
  function blank(img: HTMLImageElement) {
    const box = img.parentElement;
    if (!box) return;
    box.classList.add('upn-card__photo--blank');
    box.setAttribute('aria-hidden', 'true');
    box.textContent = box.dataset.initial || '';
  }

  /** Line ends at the first and last dots, wherever the rows wrap. Layout positions (offsetTop), not on-screen
   *  ones: rows still rising into place would otherwise put the line 18px off its dots. */
  function placeLine(list: HTMLElement) {
    const nodes = list.querySelectorAll<HTMLElement>('.upn-node');
    if (!nodes.length) return;
    // offsetTop counts from the nearest positioned or transformed box (a rising row, in Chrome): add up to the list
    const topIn = (n: HTMLElement) => { let y = 0; let at: HTMLElement | null = n; while (at && at !== list) { y += at.offsetTop; at = at.offsetParent as HTMLElement | null; } return y; };
    const mid = (n: HTMLElement) => topIn(n) + n.offsetHeight / 2;
    list.style.setProperty('--upn-line-top', `${mid(nodes[0])}px`);
    list.style.setProperty('--upn-line-bottom', `${list.offsetHeight - mid(nodes[nodes.length - 1])}px`);
  }

  async function setUp(section: HTMLElement) {
    if (section.dataset.ready) return;
    section.dataset.ready = '1';
    const list = section.querySelector<HTMLElement>('[data-upn-list]');
    if (!list) return;

    // The build's rows are on screen already: their line goes through their dots from the start
    placeLine(list);
    const ways = section.querySelector<HTMLElement>('.upn-ways');
    const place = ways ? waysPlacer(section, ways) : () => {};
    const show = setUpMail(section);
    const showMail = (s: Signup | null | undefined) => { show(s); place(); };
    // Everything is set up from what the build drew, before the schedule is asked for: the list rises in, the
    // live page's current reveal is left out, and nothing waits on an answer that may be slow or never come.
    // A schedule that can't be read changes nothing; settings that can't be read (undefined) leave the card as it is.
    let all = upcomingAtBuild();
    let signup: Signup | null | undefined;
    // What the build drew (its signature), so the same list isn't drawn twice
    let drawn: string | null = list.dataset.sig ?? null;
    const keepEmpty = section.hasAttribute('data-keep-empty');
    // A photo that fails to load, now or later (error doesn't bubble: caught on the way down)
    list.addEventListener('error', (e) => { if (e.target instanceof HTMLImageElement) blank(e.target); }, true);
    list.querySelectorAll('img').forEach((img) => { if (img.complete && !img.naturalWidth) blank(img); });
    // Left out: the page's own kid (data-exclude) and, on /live/, the reveal the page is showing right now
    // (data-current, set by LivePage, which fires upnext:current). Whatever changes, the field someone is typing in
    // stays where it is on screen (holdPlace), and keyboard focus stays on its control (keepFocus)
    const draw = () => holdPlace(() => {
      const skip = new Set([section.dataset.exclude, section.dataset.current].filter(Boolean));
      const shown = all.filter((r) => !skip.has(r.slug));
      // Someone mid-sign-up keeps the band as it is until they're done (mark() redraws then)
      if (!shown.length && section.hasAttribute('data-mail-busy')) return;
      const key = rowsSignature(shown);
      if (key !== drawn) {
        drawn = key;
        keepFocus(list, () => { list.innerHTML = bandRowsHtml(shown); });
      }
      if (shown.length) placeLine(list);
      section.toggleAttribute('data-empty', !shown.length);
      // Nothing scheduled: the band goes, or (the events page) stays as the way to hear about the next one, while
      // email sign-up is open, or not yet known not to be (its card says what the band offers)
      section.hidden = !shown.length && !(keepEmpty && signup !== null && signup?.email !== false);
    });
    draw();
    section.addEventListener('upnext:current', draw);
    // LivePage read a changed schedule: a reveal cancelled or moved
    section.addEventListener('upnext:refresh', async () => {
      const [list, s] = await Promise.all([readUpcoming(), readSignup()]);
      if (list) all = list;
      if (s !== undefined) signup = s;
      showMail(s);
      draw();
    });
    const ro = new ResizeObserver(() => { placeLine(list); place(); });
    ro.observe(list);
    if (ways) ro.observe(ways);
    addEventListener('resize', place);
    document.addEventListener('astro:before-swap', () => { ro.disconnect(); removeEventListener('resize', place); }, { once: true });

    // Motion starts when the section comes into view
    if (!('IntersectionObserver' in window)) section.classList.add('is-in');
    else {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { section.classList.add('is-in'); io.disconnect(); }
      }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
      io.observe(section);
      document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
    }

    // Now the schedule, as JobTread has it
    const [fresh, s] = await Promise.all([readUpcoming(), readSignup()]);
    if (!section.isConnected) return;
    if (fresh) all = fresh;
    if (s !== undefined) signup = s;
    showMail(s);
    draw();
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-upnext]').forEach((s) => { void setUp(s); });
  });
</script>
