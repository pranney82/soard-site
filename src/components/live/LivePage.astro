---
/**
 * LivePage.astro — the live reveal page (used by /live/ and /live/[slug]/)
 * ========================================================================
 * Editorial split hero, same skeleton as apply/donate: text left, frame
 * right. The frame (LiveStage) holds the kid's photo until the last 30
 * minutes, then the starting-soon screen, then the live video, then the
 * replay. On /live/ between reveals the frame shows what's coming up
 * instead (HeroUpcoming: each child with their own calendar invite,
 * RevealInvite). Everything dynamic comes from the shared live client, so the page
 * flips within a second of the phone connecting and never needs a rebuild.
 *
 * /live/ has no kid of its own: it follows whichever reveal is current. The
 * Pages Function functions/live/[[path]].js fills in that kid's headline,
 * story, photo and share image before the HTML leaves the server and marks
 * the hero with data-follow, and during the watch party it also lays the
 * page out for the video before first paint; the script keeps it current.
 *
 * Watch party (data-party: starting soon, live, replay): the crew shoots
 * portrait, so the frame becomes a 9:16 video as tall as the screen allows,
 * with nothing drawn on the picture and one simple bar under it. The
 * messages for the family (LiveMessages) sit beside it on a desktop and
 * under it on a phone, where the kid's name sits above it. Kept simple for
 * people who have never been here: watch, leave a message, give, share.
 * Nothing sends people off to watch somewhere else, except a Facebook-only
 * broadcast with no video here. The pieces: LiveStage.astro + utils/live-stage.ts (the frame),
 * LiveMessages.astro + utils/live-messages.ts (the messages),
 * LiveGive.astro + utils/live-give.ts (giving without leaving the reveal)
 * and utils/live-player.ts (the video). The room's design goes with the
 * video once it's out, an hour before (LiveDesignRail.astro: down the side
 * of a portrait video, under a landscape one), and in full under the hero
 * (LiveDesign.astro); utils/live-design.ts fills both.
 */
import { storyLead } from '../../utils/story-lead';
import { cfRaw } from '../../utils/cf-image';
import { LIVE_GENERIC_LEAD } from '../../utils/live-hero-text';
import PastReveals from './PastReveals.astro';
import LiveStage from './LiveStage.astro';
import LiveMessages from './LiveMessages.astro';
import LiveGive from './LiveGive.astro';
import UpcomingReveals from './UpcomingReveals.astro';
import HeroUpcoming from './HeroUpcoming.astro';
import RevealInvite from './RevealInvite.astro';
import LiveDesign from './LiveDesign.astro';
import LiveDesignRail from './LiveDesignRail.astro';
import ShareSheet from '../ui/ShareSheet.astro';
import { upcomingAtBuild } from '../../utils/reveals-copy';

interface KidLite {
  slug: string; name: string; heroImage: string | null; heroSummary?: string | null; shortDescription?: string | null;
  bio?: string | null; roomTypes?: string[] | null; year?: number | null; fundraisingUrl?: string | null;
}
interface Props { kid?: KidLite | null; fallbackImage: string }
const { kid = null, fallbackImage } = Astro.props;

const GENERIC_LEAD = LIVE_GENERIC_LEAD;
const photo = kid?.heroImage || fallbackImage;
const name = kid?.name || null;
const summary = kid?.heroSummary || kid?.shortDescription || null;
const story = storyLead(kid?.bio) || summary;
const rooms = kid?.roomTypes?.length ? kid.roomTypes.join(', ') : null;
// /live/ between reveals: the hero shows what's coming up (the page script keeps this current)
const heroNext = !kid && upcomingAtBuild().length > 0;
const SHARE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="m16 6-4-4-4 4"/><path d="M12 2v13"/></svg>';
---

<div class="live-page" data-view="loading" data-next={heroNext ? '' : undefined}>
<section class="hero" id="live-hero" data-phase="loading" data-orientation="portrait" data-kid={kid?.slug || ''} data-generic-lead={GENERIC_LEAD} data-generic-photo={cfRaw(fallbackImage, 'w=640,h=800,fit=cover,gravity=face,q=82')} data-whole>
  <div class="hero-inner">
    <div class="hero-text">
      <p class="hero-eyebrow"><span class="hero-eyebrow__dot" aria-hidden="true"></span><span data-live="eyebrow">Live reveal</span></p>
      <h1 data-live="title">
        {name ? <>{name}'s <em>room reveal</em></> : <>Watch the <em>reveal</em> live</>}
      </h1>
      <p class="hero-lead" data-live="lead">
        {summary || GENERIC_LEAD}
      </p>
      <p class="hero-status" data-live="status" aria-live="polite"></p>
      <!-- The reveals after this one, on a child's page or while /live/ follows one: "After Dylan: Max on Friday, November 20 and Colin in early December" -->
      <p class="hero-next" data-live="next-line" hidden><span data-live="next-text"></span> <a href="#up-next">See every reveal</a></p>
      <!-- The messages box sits in the hero during the watch party; the server moves it (between the markers) into its
           section below when the page goes out with a reveal coming up (functions/live/[[path]].js) -->
      <div class="hero-party" data-slot="hero" hidden><!--msgs-panel--><LiveMessages /><!--/msgs-panel--></div>
      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg hero-glow" href="https://www.facebook.com/SunshineOnaRanneyDay" target="_blank" rel="noopener" data-live="cta-facebook" hidden>Watch on Facebook</a>
        <a class="btn btn-primary btn-lg hero-glow" href="#remind" data-live="cta-remind" hidden>Get every reveal by email</a>
        <a class="btn btn-outline-dark" href="/api/reminders?ics=1" data-live="cta-calendar" hidden>Add to calendar</a>
        <a class="btn btn-outline-dark" href="#messages" data-live="cta-messages" hidden>Leave a message</a>
        <a class="btn btn-outline-dark" href="#past-reveals" data-live="cta-past" hidden>Watch past reveals</a>
        <a class="btn btn-outline-dark" href="/donate/?src=live" data-live="cta-donate">Fund the next room</a>
        <button class="btn btn-outline-dark hero-share" type="button" data-live="cta-share" hidden><Fragment set:html={SHARE} /><span data-live="share-label">Share</span></button>
      </div>
    </div>

    <div class="hero-frame" id="player">
      <LiveStage photo={photo} alt={name || 'A child in a newly built room'} />
      <!-- The room's design with the video during the watch party (hidden until the hero has data-design) -->
      <LiveDesignRail />
      {!kid && <HeroUpcoming />}
    </div>
  </div>
  <span data-whole-end hidden></span>
</section>

<!-- The room's design, from an hour before the reveal (empty until /api/reveal-design says so) -->
<LiveDesign />

<section class="live-msgs" id="messages" data-live-msgs hidden>
  <div class="container" data-slot="section"></div>
</section>

<!-- Between reveals past reveals come before this (.live-page order): the server moves them here in the page itself
     (functions/live/[[path]].js), so a page arriving in pieces is drawn top to bottom as it's seen -->
<!--live-body-->
<section class="section section--cream live-body">
  <div class="container live-grid">
    <div class="live-main">
      <div class="live-block" id="remind" data-live="remind-block" hidden>
        <p class="section-label" data-live="remind-label">Reminders</p>
        <h2 data-live="remind-heading">Never miss a reveal</h2>
        <!-- Both promises sit in one spot and the longer one sets its height, so picking a choice below never moves the form -->
        <p class="live-block__lead remind-lead" data-live="remind-lead" data-scope="all" hidden><span data-lead="all">We'll email you about every reveal: when it gets a date, the day before, an hour before, when we go live, and when the replay is up. Nothing else, ever.</span><span data-lead="one" aria-hidden="true"></span></p>
        <!-- Which reveals: asked only when the block names a child. Every reveal is picked to start (it covers this child's too) -->
        <fieldset class="remind-scope" data-live="remind-scope" hidden>
          <legend class="sr-only">Which reveals to hear about</legend>
          <label class="remind-opt"><input type="radio" name="remind-scope" value="all" checked /><span>Every reveal</span></label>
          <label class="remind-opt"><input type="radio" name="remind-scope" value="one" /><span data-live="scope-one">Just this one</span></label>
        </fieldset>
        <!-- method="post" and a button that's off until the script wires it: nothing ever sends the address in a link -->
        <form class="remind-form" data-live="form-email" method="post" novalidate hidden>
          <div class="remind-row">
            <label class="sr-only" for="remind-email" data-live="remind-email-label">Email address for every reveal</label>
            <input class="remind-input" id="remind-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" enterkeyhint="send" required />
            <button class="btn btn-primary remind-btn" type="submit" disabled>
              <span class="btn-text">Email me</span><span class="btn-busy"><span class="btn-spinner" aria-hidden="true"></span><span class="sr-only">Sending</span></span><span class="btn-done">Done</span>
            </button>
          </div>
          <div class="remind-hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <p class="remind-note" role="status" aria-live="polite"></p>
        </form>
        <!-- The quick check (Turnstile) runs in a small frame here, out of sight unless it needs a click -->
        <div class="remind-check" data-live="remind-check"></div>
        <div class="remind-extras">
          <button class="remind-link" type="button" data-live="push-btn" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            <span data-live="push-label">Turn on browser alerts</span>
          </button>
          <a class="remind-link" href="/api/reminders?ics=1" data-live="calendar-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
            Add to calendar
          </a>
        </div>
      </div>

      {kid && story && (
        <div class="live-block">
          <p class="section-label">About {kid.name}</p>
          <h2>The story behind the room</h2>
          <p class="live-block__lead">{story}</p>
          <p class="live-meta">
            {rooms && <span>{rooms}</span>}
            {kid.year && <span>{kid.year}</span>}
          </p>
          <a class="live-more" href={`/kids/${kid.slug}/`}>Read {kid.name}'s full story
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      )}
    </div>

    <aside class="live-side">
      <div class="live-card live-card--dark">
        <p class="live-card__label">Why we stream</p>
        <p class="live-card__text">Every reveal is the moment a family sees months of work for the first time. Watching live is the closest thing to being in the room, and it is how most of our supporters first found us.</p>
        <a class="btn btn-primary" href="/donate/?src=live-side" data-live="cta-donate-side">Fund the next room</a>
      </div>
    </aside>
  </div>
</section>

<!-- Past reveals lead the page when nothing is scheduled; what's coming up is in the hero then (see .live-page order rules) -->
<div class="live-next"><UpcomingReveals exclude={kid?.slug} where={kid ? 'live-kid' : 'live'} /></div>
<!--live-past--><div class="live-past"><PastReveals limit={6} /></div><!--/live-past-->
<LiveGive />
<RevealInvite />
<ShareSheet />
</div>

<style>
  /* ── Page order: past reveals lead when nothing is on, otherwise they close the page.
     What's coming up is in the hero on /live/ between reveals; otherwise it closes the page too. ── */
  .live-page { display: flex; flex-direction: column; }
  .live-page > .hero { order: 0; }
  .live-page > :global(.live-design) { order: 1; }
  .live-page > .live-msgs { order: 1; }
  .live-page > .live-body { order: 4; }
  .live-page > :global(.live-next) { order: 5; }
  .live-page > :global(.live-past) { order: 6; }
  .live-page[data-view='idle'] > :global(.live-past) { order: 2; }
  /* ...except while someone is mid-sign-up in its email card, or it's on screen (data-in-view): it never vanishes
     from under someone; it goes once they've moved on, with what they're looking at held in place (holdPlace) */
  .live-page[data-next] > :global(.live-next):not(:has([data-mail-busy])):not([data-in-view]) { display: none; }

  /* ── The frame: the stage, or what's coming up ── */
  .live-page[data-next] .hero-frame > :global([data-stage]) { display: none; }
  .live-page:not([data-next]) .hero-frame > :global([data-hero-next]) { display: none; }

  /* ── Editorial split hero (matches apply/donate) ── */
  .hero {
    background: var(--c-cream);
    padding: var(--hero-space-top) 0 clamp(64px, 8vw, 100px);
    position: relative;
    /* No layout containment or transforms on the hero: they would trap the docked mini player */
    min-height: clamp(480px, 70vh, 720px);
    overflow: hidden;
  }
  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-xl);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }

  .hero-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--c-text-muted); margin-bottom: 20px; display: flex; align-items: center; gap: 12px;
  }
  .hero-eyebrow::before { content: ''; width: 28px; height: 2px; background: currentColor; flex-shrink: 0; }
  .hero-eyebrow__dot { display: none; width: 10px; height: 10px; border-radius: 50%; background: var(--c-yellow); position: relative; }
  .hero[data-phase='live'] .hero-eyebrow__dot,
  .hero[data-phase='starting'] .hero-eyebrow__dot { display: inline-block; }
  .hero[data-phase='live'] .hero-eyebrow__dot::after {
    content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--c-yellow); opacity: 0;
    animation: live-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes live-ping { 0% { transform: scale(0.6); opacity: 0.9; } 70%, 100% { transform: scale(1.5); opacity: 0; } }

  .hero-text h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: -0.035em; line-height: 1.04; color: var(--c-text);
    margin-bottom: 24px; animation: heroSlide 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-text h1 :global(em) {
    font-style: italic; background-image: linear-gradient(transparent 52%, var(--c-yellow-soft) 52%);
    background-repeat: no-repeat; background-size: 100% 100%; padding: 0 0.05em;
  }
  .hero-lead {
    font-size: clamp(16px, 1.6vw, 18px); color: var(--c-text-muted); line-height: 1.7; margin-bottom: 20px; max-width: 480px;
    opacity: 0; animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  .hero-status {
    font-family: var(--font-display); font-size: clamp(1.1rem, 1.8vw, 1.35rem); color: var(--c-text); margin: 0 0 32px; min-height: 1.6em;
    opacity: 0; animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }
  .hero-status:empty { margin-bottom: 20px; }
  .hero-next { margin: -16px 0 28px; font-size: 15px; line-height: 1.6; color: var(--c-text-muted); max-width: 520px; }
  .hero-next[hidden] { display: none; }
  .hero-next a { color: var(--c-dark); font-weight: 600; text-decoration: underline; text-decoration-color: var(--c-yellow); text-decoration-thickness: 2px; text-underline-offset: 3px; white-space: nowrap; }
  .hero-ctas {
    display: flex; gap: 14px; flex-wrap: wrap;
    opacity: 0; animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }
  .hero-ctas [hidden], .hero-ctas [data-capped] { display: none !important; }
  .hero-share { display: inline-flex; align-items: center; gap: 8px; }
  .hero-share :global(svg) { width: 17px; height: 17px; }
  .hero-party { margin-bottom: 20px; }
  .hero-party[hidden] { display: none; }

  /* backwards, not both: a transform left on after the entrance would trap the docked mini player */
  .hero-frame {
    position: relative; animation: heroPhotoIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) backwards; scroll-margin-top: 100px;
    /* The height the stage (video + bar) may take */
    --fh: clamp(420px, calc(100svh - var(--header-height) - var(--apply-bar-h, 0px) - 44px - var(--fh-cut, 0px)), 900px);
  }

  /* ── The room's design with the video (LiveDesignRail): down the side of a portrait video, which never fills the
     width, so the video keeps its height; under a landscape one, which gives up the strip's height ── */
  .hero[data-party][data-design][data-orientation='portrait'] .hero-frame { display: flex; align-items: stretch; justify-content: center; gap: var(--hds-gap); }
  .hero[data-party][data-design][data-orientation='portrait'] .hero-frame > :global([data-stage]) { flex: none; margin-inline: 0; }
  .hero[data-party][data-design][data-orientation='landscape'] .hero-frame { display: flex; flex-direction: column; gap: var(--hds-gap); --fh-cut: calc(var(--hds-h) + var(--hds-gap)); }
  /* The yellow card behind the video would show between it and the strip */
  .hero[data-party][data-design] .hero-frame :global(.stage__accent) { display: none; }

  /* ── Watch party: video beside the messages ── */
  .hero[data-party] { padding: clamp(20px, 2.4vw, 32px) 0 clamp(48px, 5vw, 72px); min-height: 0; }
  .hero[data-party] .hero-inner { grid-template-columns: minmax(0, 1fr) auto; gap: clamp(32px, 4.5vw, 72px); align-items: stretch; }
  .hero[data-party][data-orientation='landscape'] .hero-inner { grid-template-columns: minmax(300px, 0.8fr) minmax(0, 1.2fr); }
  /* Top, not centre: a tall messages column must never push the video below the fold */
  .hero[data-party] .hero-frame { align-self: start; }
  .hero[data-party] .hero-lead { display: none; }
  .hero[data-party] .hero-status:empty { display: none; }
  .hero[data-party] .hero-status { margin-bottom: 20px; min-height: 0; }
  .hero[data-party] .hero-text h1 { font-size: clamp(2rem, 3.4vw, 3.1rem); margin-bottom: 16px; }
  .hero[data-party] .hero-eyebrow { margin-bottom: 14px; }

  /* ── Body ── */
  .live-msgs { background: #fff; border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); padding: clamp(48px, 6vw, 80px) 0; scroll-margin-top: 80px; }
  .live-msgs[hidden] { display: none; }
  .live-body { padding-top: clamp(48px, 6vw, 80px); }
  .live-grid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(40px, 5vw, 80px); align-items: start; }
  .live-block { margin-bottom: clamp(40px, 5vw, 64px); }
  .live-block h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -0.02em; margin: 8px 0 16px; }
  .live-block__lead { color: var(--c-text-muted); line-height: 1.7; max-width: 560px; margin-bottom: 24px; }
  .live-meta { display: flex; gap: 16px; color: var(--c-text-light); font-size: 14px; margin-bottom: 12px; }
  .live-meta span + span::before { content: '·'; margin-right: 16px; }
  .live-more { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--c-dark); text-decoration: none; border-bottom: 2px solid var(--c-yellow); padding-bottom: 2px; }
  .live-more:hover svg { transform: translateX(3px); }
  .live-more svg { transition: transform var(--transition-fast); }

  .remind-lead { display: grid; }
  .remind-lead[hidden] { display: none; }
  .remind-lead > span { grid-area: 1 / 1; }
  .remind-lead[data-scope='all'] > [data-lead='one'], .remind-lead[data-scope='one'] > [data-lead='all'] { visibility: hidden; }
  /* Every reveal | Just Dylan's: two pills on one line, the picked one filled */
  .remind-scope { display: flex; flex-wrap: wrap; gap: 8px; border: 0; padding: 0; margin: -8px 0 16px; min-width: 0; }
  .remind-scope[hidden] { display: none; }
  .remind-opt { position: relative; display: inline-flex; }
  .remind-opt input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .remind-opt span {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 18px; border-radius: 999px;
    border: 1.5px solid rgba(55, 58, 54, 0.38); background: #fff; color: var(--c-text);
    font-weight: 600; font-size: 15px; white-space: nowrap; transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }
  .remind-opt:hover span { border-color: var(--c-dark); }
  .remind-opt input:checked + span { background: var(--c-dark); border-color: var(--c-dark); color: #fff; }
  .remind-opt input:focus-visible + span { outline: 3px solid var(--c-yellow); outline-offset: 2px; box-shadow: 0 0 0 5px var(--c-dark); }
  .remind-scope[aria-disabled='true'] .remind-opt input { cursor: default; }
  .remind-scope[aria-disabled='true'] .remind-opt:not(:has(input:checked)) span { opacity: 0.45; }
  .remind-form { margin-bottom: 12px; }
  .remind-form[hidden] { display: none; }
  /* The address and its button share a line; with no room, the button takes its own, full width */
  .remind-row { display: flex; flex-wrap: wrap; gap: 10px; max-width: 520px; }
  .remind-input {
    flex: 999 1 240px; min-width: 0; padding: 14px 18px; border-radius: 100px; border: 1.5px solid rgba(45, 46, 51, 0.6);
    background: #fff; font: inherit; font-size: 16px; color: var(--c-text); transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .remind-input:focus { outline: none; border-color: var(--c-dark); box-shadow: 0 0 0 3px rgba(255, 218, 36, 0.6); }
  /* Not a usable address: the box says so too, not only the words under it */
  .remind-input[aria-invalid='true'] { border-color: var(--c-dark); border-width: 2px; }
  /* "Email me", the spinner and "Sent" share one cell, so the button never changes size: nothing moves.
     (Sending or sent, it's aria-disabled: global.css stops it acting pressable, and focus stays on it.) */
  .remind-btn { flex: 1 0 auto; display: inline-grid; place-items: center; }
  .remind-btn > span { grid-area: 1 / 1; display: inline-flex; align-items: center; }
  .remind-btn .btn-busy, .remind-btn .btn-done { visibility: hidden; }
  .remind-form.is-busy .btn-text, .remind-form.is-done .btn-text { visibility: hidden; }
  .remind-form.is-busy .btn-busy, .remind-form.is-done .btn-done { visibility: visible; }
  /* Sent: the address quietens, still readable (it can be edited to send again) */
  .remind-form.is-done .remind-input { color: var(--c-text-muted); }
  .remind-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .remind-note { font-size: 14px; color: var(--c-text-muted); min-height: 1.4em; margin: 8px 0 0; overflow-wrap: anywhere; }
  .remind-note--error { color: var(--c-text); font-weight: 600; }
  .remind-note :global(.remind-fix) { padding: 0; border: 0; background: none; font: inherit; font-weight: 600; color: var(--c-text); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; overflow-wrap: anywhere; }
  .remind-note :global(.remind-fix:focus-visible) { outline: 2px solid var(--c-dark); outline-offset: 0; border-radius: 2px; box-shadow: none; }
  /* The text form shows one step at a time */
  .remind-check { max-width: 520px; }
  .remind-check :global(iframe) { display: block; width: 100%; height: 0; border: 0; overflow: hidden; transition: height var(--transition-fast); }
  .remind-check.is-shown :global(iframe) { height: 72px; margin: 4px 0 12px; }
  .remind-extras { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 16px; }
  .remind-link {
    display: inline-flex; align-items: center; gap: 8px; background: none; border: none; padding: 0; font: inherit; font-size: 14px; font-weight: 600;
    color: var(--c-dark); cursor: pointer; text-decoration: none; border-bottom: 2px solid var(--c-yellow); padding-bottom: 2px;
  }
  .remind-link[hidden] { display: none; }
  .remind-link:hover { border-bottom-color: var(--c-dark); }

  .live-side { display: grid; gap: 20px; position: sticky; top: calc(var(--header-height) + 24px); }
  .live-card { background: #fff; border: 1px solid var(--c-border); border-radius: var(--border-radius-lg); padding: 24px; }
  .live-card--dark { background: var(--c-dark-deep); color: var(--c-cream); border-color: transparent; }
  .live-card__label { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-muted); margin: 0 0 10px; }
  .live-card--dark .live-card__label { color: var(--c-yellow); }
  .live-card__text { line-height: 1.6; margin: 0 0 18px; color: inherit; }
  .live-card--dark .live-card__text { color: rgba(254, 252, 245, 0.85); }

  @media (min-width: 961px) {
    /* A portrait stage sits in an auto-sized column, where a percentage width has nothing to
       resolve against (desktop only: on phones the column is the screen width, and 100% is right) */
    .hero[data-party][data-orientation='portrait'] .hero-frame { --stage-max: 100vw; }
    /* The text column matches the video's height and the message wall takes up the slack */
    .hero[data-party] .hero-text { display: flex; flex-direction: column; min-height: 0; }
    .hero[data-party] .hero-party:not([hidden]) { flex: 1 1 0; display: flex; flex-direction: column; }
  }
  @media (max-width: 960px) {
    .hero-inner, .hero[data-party] .hero-inner, .hero[data-party][data-orientation='landscape'] .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 40px; text-align: center; }
    .hero-lead, .hero-status { margin-inline: auto; }
    .hero-ctas { justify-content: center; }
    .hero-frame { width: 100%; max-width: 380px; margin: 0 auto; }
    .live-page[data-next] .hero-frame { max-width: 560px; }
    .hero-eyebrow { justify-content: center; }
    .live-grid { grid-template-columns: 1fr; }
    .live-side { position: static; }

    /* Phones and tablets: the kid's name, then the video as big as fits under it, then the messages */
    .hero[data-party] .hero-inner, .hero[data-party][data-orientation='landscape'] .hero-inner { gap: 0; }
    .hero[data-party] .hero-text { display: contents; }
    .hero[data-party] .hero-eyebrow { display: none; }
    .hero[data-party] .hero-text h1 {
      order: 1; font-size: 1.4rem; line-height: 1.25; letter-spacing: -0.015em; margin: 0 0 10px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .hero[data-party] .hero-frame { order: 2; max-width: none; --fh: calc(100svh - var(--header-height) - 12px - 2.2rem - 18px - var(--fh-cut, 0px)); }
    /* The strip takes its width from beside the video: the video is at most what's left */
    .hero[data-party][data-design][data-orientation='portrait'] .hero-frame > :global([data-stage]) { --stage-max: calc(100% - var(--hds-w) - var(--hds-gap)); }
    .hero[data-party] .hero-status { order: 3; margin: 20px auto 0; }
    .hero[data-party] .hero-party { order: 4; margin: 24px 0 0; }
    .hero[data-party] .hero-ctas { order: 5; margin-top: 24px; }
  }
  @media (max-width: 768px) {
    .hero { padding-top: var(--hero-space-top); padding-bottom: var(--space-xl); min-height: auto; }
    .hero[data-party] { padding-top: 12px; padding-bottom: 32px; }
    .hero[data-party] .hero-inner { padding: 0 var(--space-md); }
    .hero-text h1 { font-size: clamp(2rem, 9vw, 3rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-text h1, .hero-lead, .hero-status, .hero-ctas, .hero-frame { animation: none; opacity: 1; }
    .hero-eyebrow__dot::after { animation: none; }
  }
</style>

<script>
  import { getLiveClient, formatWhen, relativeUntil, type LiveState, type ReminderOptions } from '../../utils/live-client';
  import { shareable } from '../../utils/live-stats';
  import { remindersUsable, browserCanPush, revealIsToday, replayOverdue, runningLate } from '../../utils/live-banner';
  import { holdPlace, keepFocus } from '../../utils/hold-place';
  import { upcomingAtBuild } from '../../utils/reveals-copy';
  import { wireRemindForm } from '../../utils/remind-signup';
  import { createStage } from '../../utils/live-stage';
  import { createMessages } from '../../utils/live-messages';
  import { createGive } from '../../utils/live-give';
  import { createLiveDesign } from '../../utils/live-design';
  import { openShareSheet } from '../../utils/share-sheet';
  import { cfRaw } from '../../utils/cf-image';
  import { readUpcoming, loadSignup, inviteData, inviteLinks, scheduleOnPage, type UpcomingReveal } from '../../utils/reveals-client';
  import { heroRowsHtml, rowsSignature, afterLine } from '../../utils/upcoming-rows';
  import { plannedText, betweenText, ctasThatApply, ctaPicks, remindParts, remindWords } from '../../utils/live-hero-text';

  /** The starting-soon screen fills the frame for the last hour: it carries the room's design for people waiting (the crew may start streaming up to 30 minutes early, per the runbook) */
  const SLATE_LEAD_MS = 60 * 60 * 1000;

  // The hero's buttons, two at most, and which apply when: src/utils/live-hero-text.ts (HERO_CTAS, ctasThatApply), shared
  // with the server, which shows the same two from the first paint

  const client = getLiveClient();

  /**
   * The site navigates client-side (Astro ClientRouter), which runs this
   * module once per visit to the site, not once per visit to the page. So
   * the page sets itself up on every astro:page-load that lands on it, and
   * stops its video, timers and listeners when it is swapped out; otherwise
   * coming back to it (the Back button) would show a dead page.
   */
  let teardown: (() => void) | null = null;
  let firstPage = true; // the page the document loaded with (a reload or Back to it) rather than one the router swapped in
  document.addEventListener('astro:before-swap', () => { teardown?.(); teardown = null; });
  document.addEventListener('astro:page-load', () => {
    teardown?.();
    teardown = null;
    const hero = document.getElementById('live-hero') as HTMLElement | null;
    const stageEl = hero?.querySelector<HTMLElement>('[data-stage]');
    if (hero && stageEl) teardown = setUp(hero, stageEl);
  });

  function setUp(hero: HTMLElement, stageEl: HTMLElement) {
    const pageKid = hero.dataset.kid || '';
    // Set by functions/live/[[path]].js when /live/ was rendered for the current kid
    const followKid = hero.dataset.follow || '';
    const page = hero.closest('.live-page') as HTMLElement | null;
    const q = <T extends Element>(k: string) => hero.querySelector(`[data-live="${k}"]`) as T | null;
    const body = document.querySelector('.live-body') as HTMLElement | null;
    const bq = <T extends Element>(k: string) => body?.querySelector(`[data-live="${k}"]`) as T | null;
    const setHidden = (el: Element | null, hidden: boolean) => { if (el) (el as HTMLElement).hidden = hidden; };
    const setAttr = (el: HTMLElement, name: string, on: boolean) => { if (on) el.setAttribute(name, ''); else el.removeAttribute(name); };
    let last: LiveState | null = null;
    let lastMeta: { reminders: ReminderOptions | null } = { reminders: null };
    let remindKid = ''; // who a sign-up here is for; empty means every reveal
    let remindNamed = ''; // the child the block names (its slug), whichever reveals they pick
    let remindShown = ''; // that child's name (empty: the block names nobody, and signs up for every reveal)
    const upNextBand = () => document.getElementById('up-next');
    // Someone who came for what's next (the starting-soon screen's "Coming up next" code opens /live/#up-next). The
    // browser looked for the band while the page was still laid out as built, often with it hidden: between reveals
    // the hero shows the same list instead. So go there now, to whichever is showing. Once, on arrival (not on Back).
    let upNextArrived = location.hash !== '#up-next' || (history.state?.scrollY || 0) > 0;
    function arriveAtUpNext() {
      if (upNextArrived) return;
      const shown = (el: HTMLElement | null) => (el && el.getBoundingClientRect().height > 0 ? el : null);
      const target = shown(upNextBand()) || shown(hero.querySelector<HTMLElement>('[data-hero-next]'));
      if (!target) return; // the next draw tries again
      upNextArrived = true;
      requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    }

    // Whether the Coming up band is on screen (see the .live-next rule): the page going idle doesn't pull it from under someone
    const nextWrap = document.querySelector<HTMLElement>('.live-next');
    const bandSeen = nextWrap && 'IntersectionObserver' in window
      ? new IntersectionObserver(([e]) => { holdPlace(() => nextWrap.toggleAttribute('data-in-view', e.isIntersecting)); })
      : null;
    if (nextWrap) bandSeen?.observe(nextWrap);
    let display = 'loading';
    let shownKid = pageKid || followKid;
    let viewed = false;
    let rendered = false;
    let alive = true;
    const slateFailed = new Set<string>();
    // What's coming up (JobTread via /api/reveals): the idle hero names the next reveal and lists them. It starts from
    // the schedule the server drew the page from (left on the hero, functions/live/[[path]].js), so the status line,
    // the buttons and the rows are already what this script draws; else as the build had it (the hero's rows were
    // drawn from the same), so a child's page opens with that child's form, not every reveal's until the schedule comes
    const drawnFrom = scheduleOnPage(hero);
    let upcoming: UpcomingReveal[] = drawnFrom?.upcoming ?? upcomingAtBuild();
    let upcomingLoaded = !!drawnFrom;

    const stage = createStage(stageEl, {
      client,
      // The hero lays itself out around the video's real shape
      onShape: (orientation, party) => { hero.dataset.orientation = orientation; setAttr(hero, 'data-party', party); },
      onSlateFailed: (src) => { slateFailed.add(src); if (last) render(last, lastMeta); },
    });

    const panel = document.querySelector<HTMLElement>('[data-msgs="panel"]');
    const heroSlot = hero.querySelector<HTMLElement>('[data-slot="hero"]');
    const section = document.querySelector<HTMLElement>('[data-live-msgs]');
    const sectionSlot = section?.querySelector<HTMLElement>('[data-slot="section"]');
    const messages = panel && heroSlot && section && sectionSlot
      ? createMessages({ client, panel, heroSlot, section, sectionSlot, cta: q('cta-messages') })
      : null;

    // ── The room's design, from an hour before the reveal (it asks for whichever kid render() is showing) ──
    const designEl = document.querySelector<HTMLElement>('[data-live-design]');
    const design = designEl ? createLiveDesign(designEl, {
      hero,
      rail: hero.querySelector<HTMLElement>('[data-design-rail]'),
      frame: hero.querySelector<HTMLElement>('.hero-frame'),
      stage,
    }) : null;

    // ── Giving without leaving the reveal ───────────────────────────
    const giveEl = document.querySelector<HTMLElement>('[data-give]');
    const give = giveEl ? createGive(giveEl, { client, stage }) : null;
    const giveFrom = (where: string) => (e: Event) => {
      // During the watch party the form opens beside the video; otherwise the link goes to /donate/
      if (!give || !stage.party) { client.beacon('click_donate', { where }); return; }
      e.preventDefault();
      give.open(where);
    };
    q('cta-donate')?.addEventListener('click', giveFrom('hero'));
    bq('cta-donate-side')?.addEventListener('click', giveFrom('side'));

    // ── Two hero buttons at most (HERO_CTAS) ────────────────────────
    // Each button still says on its own whether it applies (hidden); this picks the first two that do for the moment
    // and holds the rest back with data-capped. The message box shows or hides its button on its own schedule, so a
    // change to any button's hidden re-picks.
    const ctaBox = hero.querySelector<HTMLElement>('.hero-ctas');
    function capCtas() {
      if (!ctaBox) return;
      const all = [...ctaBox.querySelectorAll<HTMLElement>('[data-live^="cta-"]')];
      const byKey = (k: string) => all.find((el) => el.dataset.live === k);
      const picked = ctaPicks(display, (k) => { const el = byKey(k); return !!el && !el.hidden; }).map(byKey) as HTMLElement[];
      for (const el of all) {
        const at = picked.indexOf(el);
        el.toggleAttribute('data-capped', at < 0);
        el.style.order = at < 0 ? '' : String(at);
      }
    }
    const ctaWatch = ctaBox ? new MutationObserver(capCtas) : null;
    ctaWatch?.observe(ctaBox!, { subtree: true, attributes: true, attributeFilter: ['hidden'] });

    // ── /live/ follows the current kid ──────────────────────────────
    function setTitle(kidName: string | null, view: string) {
      const h1 = q<HTMLElement>('title');
      if (!h1) return;
      const [before, mid, after] = kidName ? [`${kidName}'s `, 'room reveal', '']
        : view === 'live' ? ["Today's ", 'room reveal', '']
        : view === 'replay' ? ['Watch the ', 'reveal', '']
        : ['Watch the ', 'reveal', ' live'];
      if (h1.textContent === `${before}${mid}${after}`) return;
      const em = document.createElement('em');
      em.textContent = mid;
      h1.textContent = '';
      h1.append(before, em, after);
    }
    function setPhoto(src: string) {
      const img = q<HTMLImageElement>('photo');
      if (!img || img.getAttribute('src') === src) return;
      img.removeAttribute('srcset');
      img.src = src;
    }
    function follow(s: LiveState, view: string) {
      if (pageKid) return;
      const want = view !== 'idle' && s.kidSlug ? s.kidSlug : '';
      if (want !== shownKid) {
        shownKid = want;
        const lead = q<HTMLElement>('lead');
        if (want) {
          if (lead) lead.textContent = s.message || `Watch ${s.kidName ? `${s.kidName}'s` : 'the'} room reveal live, right here.`;
          if (s.image) setPhoto(cfRaw(s.image, 'w=640,h=800,fit=cover,gravity=face,q=82'));
        } else {
          if (lead) lead.textContent = hero.dataset.genericLead || '';
          if (hero.dataset.genericPhoto) setPhoto(hero.dataset.genericPhoto);
        }
      }
      setTitle(want ? s.kidName || null : null, view);
    }

    // ── Starting-soon screen in the frame for the last 30 minutes ──
    function slateSrc(s: LiveState, view: string, kidSlug: string) {
      if (view !== 'upcoming' || !kidSlug || !s.scheduledAt) return '';
      if (Date.parse(s.scheduledAt) - Date.now() > SLATE_LEAD_MS) return '';
      const src = `/live/${kidSlug}/slate/?embed=1&music=0${s.orientation === 'portrait' ? '&o=portrait' : ''}`;
      return slateFailed.has(src) ? '' : src;
    }

    // Whatever a redraw moves, the field someone is typing in stays where it is on screen; and coming back to the page,
    // its first real drawing puts back what the visitor was looking at
    function render(state: LiveState | null, meta: { reminders: ReminderOptions | null }) {
      holdPlace(() => drawPage(state, meta));
      restoreSpot();
    }

    // ── Coming back (reload, Back, Forward) ──
    // The page is drawn "loading" and takes its real order only once it knows the broadcast (between reveals, past
    // reveals lead), after the scroll has been put back by number. So it notes what was on screen as it's left, and
    // puts that back in the same place once it has drawn.
    const spotKey = `live-spot:${location.pathname}`;
    const headerLine = () => (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 84) + 1;
    // A part of the page, named so it's found again: its id, else its place among the page's parts (that order never
    // changes; only how they're shown does)
    const nameOf = (el: HTMLElement) => (el.id ? `#${CSS.escape(el.id)}` : el.parentElement === page ? `:scope > :nth-child(${[...page!.children].indexOf(el) + 1})` : '');
    function spotNow() {
      if (!page) return null;
      const line = headerLine();
      const marks = [...page.querySelectorAll<HTMLElement>(':scope > *, #remind, #up-next, #past-reveals, #messages')].filter((el) => el.getBoundingClientRect().height > 0 && nameOf(el));
      // The part whose top is on screen nearest the header (what they were looking at); else the innermost one
      // spanning the line under the header
      const onScreen = marks.filter((el) => { const t = el.getBoundingClientRect().top; return t >= line && t < innerHeight * 0.8; })
        .sort((x, y) => x.getBoundingClientRect().top - y.getBoundingClientRect().top);
      let at: HTMLElement | null = onScreen[0] || null;
      if (!at) for (const el of marks) { const r = el.getBoundingClientRect(); if (r.top <= line && r.bottom > line && (!at || at.contains(el))) at = el; }
      if (!at) return null;
      return { key: nameOf(at), offset: Math.round(at.getBoundingClientRect().top) };
    }
    const saveSpot = () => {
      try { const spot = scrollY > 0 ? spotNow() : null; if (spot) sessionStorage.setItem(spotKey, JSON.stringify(spot)); else sessionStorage.removeItem(spotKey); } catch { /* storage off */ }
    };
    addEventListener('pagehide', saveSpot);
    document.addEventListener('astro:before-preparation', saveSpot, { once: true });
    const navType = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
    const returning = firstPage ? navType === 'reload' || navType === 'back_forward' : (history.state?.scrollY || 0) > 0;
    firstPage = false;
    let spotPending = returning;
    // The part they were on may only appear once its own data comes (the Coming up band): it's tried again for a
    // few seconds, unless the visitor scrolls first, in which case they've moved on and are left where they are
    const gaveUp = () => { spotPending = false; };
    for (const type of ['wheel', 'touchstart', 'keydown']) addEventListener(type, gaveUp, { once: true, passive: true });
    let spotUntil = 0;
    function restoreSpot() {
      if (!spotPending || !rendered || !page) return;
      let saved: { key: string; offset: number } | null = null;
      try { saved = JSON.parse(sessionStorage.getItem(spotKey) || 'null'); } catch { /* storage off */ }
      if (!saved) { spotPending = false; return; }
      const el = page.querySelector<HTMLElement>(saved.key);
      if (!el || !el.getBoundingClientRect().height) {
        spotUntil ||= Date.now() + 5000;
        if (Date.now() < spotUntil) setTimeout(restoreSpot, 150); else spotPending = false;
        return;
      }
      spotPending = false;
      const moved = el.getBoundingClientRect().top - saved.offset;
      if (Math.abs(moved) >= 1) scrollBy({ top: moved, behavior: 'instant' as ScrollBehavior });
    }
    function drawPage(state: LiveState | null, meta: { reminders: ReminderOptions | null }) {
      last = state; lastMeta = meta;
      const s = state || ({ phase: 'idle' } as LiveState);
      // A stream with no kid known yet only counts as this kid's on the day of this kid's reveal
      const forThisKid = !pageKid || s.kidSlug === pageKid || (!s.kidSlug && revealIsToday(pageKid, upcoming.filter((r) => r.confirmed)));
      const phase = forThisKid ? s.phase : 'idle';
      const view = phase === 'live' || phase === 'ending' ? 'live' : phase === 'replay' ? 'replay' : phase === 'scheduled' || phase === 'armed' ? 'upcoming' : 'idle';
      const kidSlug = pageKid || (view !== 'idle' ? s.kidSlug || '' : '');
      const hasPlayer = !!(s.player && forThisKid && (view === 'live' || view === 'replay'));
      const slate = hasPlayer ? '' : slateSrc(s, view, kidSlug);
      display = slate ? 'starting' : view;
      const party = !!slate || hasPlayer;
      hero.dataset.phase = display;
      setAttr(hero, 'data-party', party);
      if (page) page.dataset.view = display;
      // Starting or live, the video is the only thing: the application bar is asked to step aside
      if (display === 'starting' || display === 'live') document.dispatchEvent(new CustomEvent('apply-bar:step-aside'));
      follow(s, view);
      design?.setKid(kidSlug, display);
      // "Coming up" leaves out the reveal this page is showing
      const upNext = upNextBand();
      const showing = view !== 'idle' ? kidSlug : '';
      if (upNext && (upNext.dataset.current || '') !== showing) {
        upNext.dataset.current = showing;
        upNext.dispatchEvent(new Event('upnext:current'));
      }

      const eyebrow = q<HTMLElement>('eyebrow');
      const status = q<HTMLElement>('status');
      // Written only when it changes, and a ticking countdown isn't read aloud every minute
      const setStatus = (text: string) => { if (status && status.textContent !== text) status.textContent = text; };
      status?.setAttribute('aria-live', view === 'upcoming' ? 'off' : 'polite');
      let badge = '';
      if (view === 'live') {
        if (eyebrow) eyebrow.textContent = 'Live now';
        // The video says it all; without one (a Facebook-only broadcast) point people there
        setStatus(hasPlayer ? '' : 'We are live on Facebook right now.');
        badge = 'Live';
      } else if (view === 'replay') {
        // A recording is only on its way from our own stream, and only for a few hours
        const waiting = s.source === 'stream' && !replayOverdue(s.endedAt);
        if (eyebrow) eyebrow.textContent = hasPlayer || waiting ? 'Replay' : 'Ended';
        setStatus(hasPlayer ? '' : waiting ? 'The reveal just ended. The replay will appear here soon.' : 'This reveal has ended.');
        badge = hasPlayer || waiting ? 'Processing' : 'Ended';
      } else if (view === 'upcoming') {
        const rel = relativeUntil(s.scheduledAt);
        if (slate) {
          if (eyebrow) eyebrow.textContent = runningLate(s.scheduledAt) ? 'Running late' : 'Starting soon';
          setStatus(s.scheduledAt && Date.parse(s.scheduledAt) > Date.now() ? `We go live ${formatWhen(s.scheduledAt)}. Stay right here.` : runningLate(s.scheduledAt) ? 'We’re running a little late. Stay right here.' : 'Any moment now. Stay right here.');
        } else {
          // The server wrote the same (plannedText), so normally nothing changes here
          const said = plannedText(s.scheduledAt);
          if (eyebrow) eyebrow.textContent = said.eyebrow;
          setStatus(said.status);
        }
        badge = rel ? `Live ${rel}` : 'Coming up';
      } else {
        if (eyebrow) eyebrow.textContent = 'Live reveal';
        setStatus(idleStatus());
      }

      // What's coming up fills the frame on /live/ between reveals (as the build had it until the live list arrives)
      if (page && !pageKid) setAttr(page, 'data-next', display === 'idle' && (upcomingLoaded ? upcoming.length > 0 : page.hasAttribute('data-next')));

      // CTAs: which apply (the same rule the server used for the first paint)
      const inviteFor = kidSlug ? upcoming.find((r) => r.slug === kidSlug) : undefined;
      const applies = ctasThatApply({
        display, view, scheduledAt: s.scheduledAt || null, remindUsable: remindersUsable(meta.reminders, browserCanPush()),
        pageKid, inSchedule: !!inviteFor, pastOnPage: !!document.getElementById('past-reveals'), hasPlayer,
      });
      setHidden(q('cta-remind'), !applies['cta-remind']);
      // Calendar: this child's own invite (the live link only), whether or not the day is set yet;
      // the broadcast's own file when a scheduled reveal isn't in the list
      for (const el of [q<HTMLAnchorElement>('cta-calendar'), bq<HTMLAnchorElement>('calendar-link')]) {
        if (!el) continue;
        if (inviteFor) {
          for (const [k, v] of Object.entries(inviteData(inviteFor))) el.setAttribute(k, v);
          el.href = inviteLinks(inviteFor).copy;
        } else {
          for (const k of ['data-invite', 'data-invite-name', 'data-invite-when', 'data-invite-set']) el.removeAttribute(k);
          el.href = '/api/reminders?ics=1';
        }
      }
      setHidden(q('cta-calendar'), !applies['cta-calendar']);
      setHidden(q('cta-past'), !applies['cta-past']);
      setHidden(q('cta-share'), !applies['cta-share']);
      const fbCta = q<HTMLAnchorElement>('cta-facebook');
      if (fbCta) { fbCta.href = s.facebookUrl || fbCta.href; setHidden(fbCta, !applies['cta-facebook']); }
      capCtas();

      // What comes after this reveal, while it's still ahead (on /live/ between reveals the frame lists them all). The
      // server wrote it already (the same afterLine), so normally nothing changes here
      const nextLine = q<HTMLElement>('next-line');
      if (nextLine) {
        const text = afterLine(upcoming, kidSlug, s.kidSlug === kidSlug ? s.kidName || '' : '');
        const t = q<HTMLElement>('next-text');
        if (t && t.textContent !== text) t.textContent = text;
        setHidden(nextLine, !text || !(display === 'upcoming' || display === 'idle'));
      }

      stage.update({
        mode: display as 'idle' | 'upcoming' | 'starting' | 'live' | 'replay',
        player: hasPlayer ? s.player : null,
        slate,
        orientation: s.orientation === 'landscape' ? 'landscape' : 'portrait',
        badge,
        late: slate && runningLate(s.scheduledAt),
      });
      messages?.update({ active: forThisKid && !!s.id && view !== 'idle', broadcastId: s.id, kidName: s.kidName, party });
      if (!party) give?.close();

      // The reminder block, by the rules the server drew it with (remindParts, remindWords: live-hero-text.ts)
      const parts = remindParts({
        reminders: meta.reminders, canPush: browserCanPush(), view, pageKid,
        scheduledAt: s.scheduledAt || null, kidName: s.kidName || '', kidSlug: s.kidSlug || '', inviteFor,
      });
      const remindersOn = parts.on;
      const emailForm = bq<HTMLFormElement>('form-email');
      if (emailForm) emailForm.hidden = !parts.email;
      const lead = bq<HTMLElement>('remind-lead');
      const pushBtn = bq<HTMLButtonElement>('push-btn');
      if (pushBtn) pushBtn.hidden = !parts.push;
      const cal = bq<HTMLElement>('calendar-link');
      if (cal) cal.hidden = !parts.calendar;
      setHidden(bq('remind-block'), !(parts.on || (!!cal && parts.calendar)));
      arriveAtRemind(display);
      const rl = bq<HTMLElement>('remind-label');
      if (rl) rl.textContent = parts.label;
      const rh = bq<HTMLElement>('remind-heading');
      const remindName = parts.name;
      const nextKid = parts.slug;
      // Someone filling the form in keeps the reveal it said it was for until they're done with it:
      // the broadcast moving on mid-word never quietly re-aims their sign-up
      // A finished every-reveal sign-up keeps saying so: it already covers whoever is next.
      // (Read once: the heading, label, promise and who it signs up for all hold, or all move, together)
      const typing = !!remindForm?.inUse();
      if (remindForm?.coversAll() && remindForm.signedHere() && nextKid === remindNamed) {
        // Sent from here with "Every reveal" picked: it stays just as it was sent, heading and choice and all (nothing
        // jumps); it covers whoever comes next, and says so once the page moves on to another reveal
      } else if (remindForm?.coversAll()) {
        // Signed up for every reveal (here, or in the band's card): it says so, whoever is next
        remindNamed = '';
        remindShown = '';
      } else if (nextKid === remindNamed || !typing) {
        if (nextKid !== remindNamed) {
          // A finished sign-up for one child opens again for the next, and every reveal is picked again
          if (emailForm?.classList.contains('is-done')) remindForm?.reset();
          if (remindNamed) setScope('all');
        }
        remindNamed = nextKid;
        remindShown = remindName;
      }
      remindKid = remindShown && scopeNow() === 'one' ? remindNamed : '';
      const words = remindWords(parts, { shown: remindShown, scope: remindKid ? 'one' : 'all', hours: meta.reminders?.hours, view });
      // Every reveal unless they pick just this child's (Peter, Nov 9 2026); a block that names nobody is every reveal's
      const scopeBox = bq<HTMLElement>('remind-scope');
      if (scopeBox) {
        scopeBox.hidden = !words.scopeShown || !emailForm;
        // Sent, or sending: the choice it was sent with stays, and can't be changed under it
        scopeBox.setAttribute('aria-disabled', String(!!emailForm && (emailForm.classList.contains('is-busy') || emailForm.classList.contains('is-done'))));
      }
      const scopeOne = bq<HTMLElement>('scope-one');
      if (scopeOne && words.scopeOne) scopeOne.textContent = words.scopeOne;
      const emailLabel = bq<HTMLElement>('remind-email-label');
      if (emailLabel) emailLabel.textContent = words.emailLabel;
      upNextBand()?.toggleAttribute('data-remind-here', !!emailForm && words.remindHere);
      // Its heading and promise don't change under someone typing either; the promise is about whom the form is for
      if (rh && (!rh.textContent || !typing)) rh.textContent = words.heading;
      if (lead) {
        lead.hidden = !remindersOn;
        lead.dataset.scope = words.scope;
        const [forAll, forOne] = [lead.querySelector<HTMLElement>('[data-lead="all"]'), lead.querySelector<HTMLElement>('[data-lead="one"]')];
        forAll?.setAttribute('aria-hidden', String(words.scope !== 'all'));
        forOne?.setAttribute('aria-hidden', String(words.scope !== 'one'));
        if (!typing) {
          if (forAll) forAll.textContent = words.leadAll;
          if (forOne) forOne.textContent = words.leadOne;
        }
      }

      rendered = true;
      arriveAtUpNext();
      if (!viewed) {
        viewed = true;
        const src = new URLSearchParams(location.search).get('src') || '';
        client.beacon('view_live_page', { phase: display, kid: pageKid || s.kidSlug || '', ...(src ? { src: src.slice(0, 24) } : {}) });
        if (src === 'qr') client.beacon('qr_scan', { kid: s.kidSlug || '' });
      }
    }

    /** Between reveals: when this kid's reveal is, or which reveal is next */
    function idleStatus() {
      // The server wrote the same (betweenText) when the schedule said something
      const said = betweenText(upcoming, pageKid);
      if (said || pageKid) return said;
      return !upcomingLoaded ? '' : remindersUsable(lastMeta.reminders, browserCanPush())
        ? 'No reveal is scheduled right now. Get a reminder for the next one, and watch the last few while you wait.'
        : 'No reveal is scheduled right now. Watch the last few while you wait.';
    }
    /** The hero's rows for this list, in this browser's time zone: drawn only when they'd say something different */
    const drawHeroRows = (list: UpcomingReveal[]) => {
      const box = hero.querySelector<HTMLElement>('[data-hero-next]');
      const rows = box?.querySelector<HTMLElement>('[data-hnx-list]');
      const sig = rowsSignature(list);
      if (box && rows && box.dataset.sig !== sig) { keepFocus(rows, () => { rows.innerHTML = heroRowsHtml(list); }); box.dataset.sig = sig; }
    };
    // At once, in this browser's zone: the build drew the rows in Eastern, the edge in the zone Cloudflare places the
    // visitor in. Only when they're the build's rows (the same reveals): rows the edge drew from a newer schedule wait
    // for that schedule (refreshUpcoming), rather than going back to the build's
    {
      const drawnSig = hero.querySelector<HTMLElement>('[data-hero-next]')?.dataset.sig || '';
      const reveals = (sig: string) => sig.slice(sig.indexOf('|') + 1);
      if (reveals(drawnSig) === reveals(rowsSignature(upcoming))) drawHeroRows(upcoming);
    }
    const refreshUpcoming = () => readUpcoming().then((list) => {
      // A read that failed keeps what's on the page: not knowing isn't the same as nothing planned
      if (!alive || !list) return;
      const changed = JSON.stringify(list) !== JSON.stringify(upcoming);
      upcoming = list;
      upcomingLoaded = true;
      if (changed) upNextBand()?.dispatchEvent(new Event('upnext:refresh'));
      // The hero's rows as JobTread has them now (the build wrote the last copy's)
      drawHeroRows(list);
      if (rendered && last) render(last, lastMeta);
      // Before the live state is in, the list fills the frame only between reveals: not when the server already drew the
      // page for a reveal that's on (data-view 'upcoming' and the rest), or the frame would flash the list
      else if (page && !pageKid && (page.dataset.view === 'loading' || page.dataset.view === 'idle')) holdPlace(() => setAttr(page, 'data-next', list.length > 0));
    });
    refreshUpcoming();
    // The live state can't be read (its request failed, or hangs): rather than a page with no sign-up at all, show it as
    // between reveals, with the every-reveal sign-up when Reveals → Settings has it open. The real state takes over the
    // moment it arrives.
    // At once when the read is known to have failed; after 5s when it just hasn't answered
    let fellBack = false;
    const fallBack = async () => {
      if (rendered || !alive || fellBack) return;
      fellBack = true;
      const open = await loadSignup();
      if (rendered || !alive) return;
      render(null, { reminders: open ? { enabled: open.email, email: open.email, hours: open.hours, sms: false, push: false, pushKey: null } : null });
    };
    const fallback = window.setTimeout(fallBack, 5000);
    if (client.unreachable) void fallBack();
    const offUnreachable = client.on('unreachable', () => { void fallBack(); });
    // A reveal cancelled or moved shows up here without a reload
    const upcomingTimer = setInterval(refreshUpcoming, 60_000);

    // Beacons on the primary actions
    q('cta-facebook')?.addEventListener('click', () => client.beacon('click_facebook'));
    // (A child's invite counts its own clicks in the invite sheet)
    q('cta-calendar')?.addEventListener('click', (e) => { if (!(e.currentTarget as HTMLElement).dataset.invite) client.beacon('click_calendar'); });

    // ── Reminder forms ──────────────────────────────────────────────
    // Nobody is on the list until the address proves it's theirs: email
    // gets a link to confirm.

    // Someone who tapped "Remind me" came for the form. It was still hidden when the browser looked for #remind, so go there now it's showing.
    // Decided once, on arrival: the hero's own "Remind me" sets this hash too, and the page redraws every few seconds.
    // Coming Back to a page keeps its scroll (the router notes it in history.state), so that isn't an arrival either.
    let arrived = location.hash !== '#remind' || (history.state?.scrollY || 0) > 0;
    function arriveAtRemind(view: string) {
      const block = bq('remind-block');
      if (arrived || !block || block.hidden) return;
      arrived = true;
      // The tab was left open until the reveal: stay on the slate or the video. The browser keeps going to a hash until
      // the page has loaded, so the hash goes, and the page comes back up once it's done.
      if (view !== 'upcoming' && view !== 'idle') {
        history.replaceState(history.state, '', location.pathname + location.search);
        const toVideo = () => requestAnimationFrame(() => scrollTo(0, 0));
        toVideo();
        if (document.readyState !== 'complete') addEventListener('load', toVideo, { once: true });
        return;
      }
      requestAnimationFrame(() => {
        block.scrollIntoView({ block: 'start' });
        // A keyboard opening over the form would hide it on a phone
        if (matchMedia('(hover: hover)').matches) (block.querySelector('input:not([type="hidden"])') as HTMLElement | null)?.focus({ preventScroll: true });
      });
    }

    // One sign-up, shared with the Coming up band's every-reveal card (remind-signup.ts)
    const emailForm = bq<HTMLFormElement>('form-email');
    const remindForm = emailForm ? wireRemindForm(emailForm, {
      checkBox: bq<HTMLElement>('remind-check'),
      kid: () => remindKid,
      source: () => (pageKid ? 'live-kid' : 'live'),
    }) : null;
    // A sign-up elsewhere on the page that covers this form shows here at once, heading and all (not on the next redraw)
    emailForm?.addEventListener('remind-done', () => { if (rendered && alive) render(last, lastMeta); });

    // Every reveal or just this child's: read at the moment of sending (remind-signup asks kid() then)
    const scopeInputs = [...(body?.querySelectorAll<HTMLInputElement>('input[name="remind-scope"]') || [])];
    function scopeNow(): 'all' | 'one' { return scopeInputs.find((i) => i.checked)?.value === 'one' ? 'one' : 'all'; }
    let scopeWas: 'all' | 'one' = 'all';
    function setScope(v: 'all' | 'one') { for (const i of scopeInputs) i.checked = i.value === v; scopeWas = v; }
    setScope(scopeNow());
    const onScope = () => {
      // While it sends, or once it's sent, the choice it went with stands
      if (emailForm && (emailForm.classList.contains('is-busy') || emailForm.classList.contains('is-done'))) { setScope(scopeWas); return; }
      scopeWas = scopeNow();
      if (rendered && alive) render(last, lastMeta);
    };
    for (const i of scopeInputs) i.addEventListener('change', onScope);
    // Editing the address after "Sent" opens the form again: the choice opens with it at once
    const onTyped = () => {
      const box = bq<HTMLElement>('remind-scope');
      if (box && emailForm && !emailForm.classList.contains('is-busy') && !emailForm.classList.contains('is-done')) box.setAttribute('aria-disabled', 'false');
    };
    emailForm?.addEventListener('input', onTyped);

    // Browser push
    const pushBtn = bq<HTMLButtonElement>('push-btn');
    pushBtn?.addEventListener('click', async () => {
      const label = bq<HTMLElement>('push-label');
      const key = client.reminders?.pushKey;
      if (!key) return;
      try {
        pushBtn.disabled = true; if (label) label.textContent = 'Asking your browser…';
        const reg = await navigator.serviceWorker.register('/sw.js');
        await navigator.serviceWorker.ready;
        const perm = await Notification.requestPermission();
        if (perm !== 'granted') { if (label) label.textContent = 'Alerts blocked in this browser'; return; }
        const raw = key.replace(/-/g, '+').replace(/_/g, '/');
        const pad = raw.length % 4 ? '='.repeat(4 - (raw.length % 4)) : '';
        const appKey = Uint8Array.from(atob(raw + pad), c => c.charCodeAt(0));
        const sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: appKey });
        const res = await fetch('/api/reminders', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ channel: 'push', subscription: sub.toJSON(), kidSlug: remindKid || undefined, source: 'push' }) });
        if (label) label.textContent = res.ok ? 'Browser alerts are on' : 'Could not save. Try again.';
        if (!res.ok) pushBtn.disabled = false;
      } catch {
        if (label) label.textContent = 'Could not turn on alerts here';
        pushBtn.disabled = false;
      }
    });

    // Share
    // Shared without ?src= (a friend's visit isn't the sharer's email or QR scan)
    const pageUrl = () => shareable(location.href.split('#')[0]);
    // Hero share: a sheet that says what it can do (text, email, Facebook, copy, and the phone's own menu); without one, copy the link
    q<HTMLButtonElement>('cta-share')?.addEventListener('click', async () => {
      const label = q<HTMLElement>('share-label');
      const title = q<HTMLElement>('title')?.textContent?.replace(/\s+/g, ' ').trim() || document.title;
      const name = (shownKid && upcoming.find((r) => r.slug === shownKid)?.name) || (last?.kidName || '');
      const live = display === 'live';
      const opened = openShareSheet({
        title: name ? `Share ${name}'s reveal` : 'Share the reveal',
        text: live ? `${title}, live now` : display === 'replay' ? `Watch ${title}` : `Watch ${title} live`,
        lead: live ? 'Send the link: it opens right here, live.' : 'Send the link: it opens right here, and plays live when it starts.',
        url: pageUrl(),
        onShare: (how) => client.beacon('share', { how }),
      });
      if (opened) return;
      try { await navigator.clipboard.writeText(pageUrl()); if (label) { label.textContent = 'Link copied'; setTimeout(() => { label.textContent = 'Share'; }, 2000); } client.beacon('share', { how: 'copy' }); } catch { /* blocked */ }
    });

    // Last, so everything render() touches is declared before the first (possibly synchronous) call
    const unsubscribe = client.subscribe(render);
    // Keeps the countdown fresh and opens the starting-soon window on time
    const countdown = setInterval(() => { if (last?.upcoming) render(last, { reminders: client.reminders }); }, 15_000);
    return () => {
      alive = false;
      clearInterval(upcomingTimer);
      unsubscribe();
      remindForm?.destroy();
      clearTimeout(fallback);
      offUnreachable();
      ctaWatch?.disconnect();
      design?.destroy();
      for (const i of scopeInputs) i.removeEventListener('change', onScope);
      emailForm?.removeEventListener('input', onTyped);
      removeEventListener('pagehide', saveSpot);
      for (const type of ['wheel', 'touchstart', 'keydown']) removeEventListener(type, gaveUp);
      bandSeen?.disconnect();
      clearInterval(countdown);
      give?.destroy();
      stage.destroy();
      messages?.destroy();
    };
  }
</script>
