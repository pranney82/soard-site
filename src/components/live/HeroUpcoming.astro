---
/**
 * HeroUpcoming.astro — "Coming up" in the live page's hero
 * =========================================================
 * Between reveals, /live/'s hero frame shows what's next instead of a
 * photo: every upcoming reveal, soonest first, each with its own "Add"
 * invite (the live link only; it fills in the day and time on its own,
 * RevealInvite.astro). Tentative reveals show only their third of the month.
 *
 * Written at build time from the reveals copy, so it's there on first
 * paint; LivePage refreshes the rows from /api/reveals and decides when the
 * frame shows this (hero[data-next]) or the stage (a reveal is on).
 */
import { upcomingAtBuild } from '../../utils/reveals-copy';
import { heroRowsHtml, rowsSignature } from '../../utils/upcoming-rows';

const list = upcomingAtBuild();
---

<div class="hnx" data-hero-next data-sig={rowsSignature(list)} data-count={list.length} data-invite-where="live-hero">
  <div class="hnx__accent" aria-hidden="true"></div>
  <section class="hnx__card" aria-labelledby="hnx-title">
    <div class="hnx__head">
      <h2 class="hnx__label" id="hnx-title"><span class="hnx__dot" aria-hidden="true"></span>Coming up</h2>
      <p class="hnx__hint">Tap Add for an invite with the live link</p>
    </div>
    <ol class="hnx__list" data-hnx-list set:html={heroRowsHtml(list)} />
    <button class="hnx__all" type="button" data-invite="all">
      Add every reveal to your calendar
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </button>
  </section>
</div>

<style is:global>
  .hnx { --ease: cubic-bezier(0.16, 1, 0.3, 1); position: relative; width: 100%; max-width: 480px; margin-left: auto; animation: hnx-in 0.8s var(--ease) 0.1s both; }
  @keyframes hnx-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  .hnx__accent {
    position: absolute; right: -22px; bottom: -22px; width: 62%; height: 46%; border-radius: 28px;
    background: var(--c-yellow); opacity: 0; animation: hnx-accent 1.1s var(--ease) 0.6s forwards;
  }
  @keyframes hnx-accent { to { opacity: 0.4; } }
  .hnx__card {
    position: relative; background: var(--c-white); border-radius: 28px; padding: 22px 22px 16px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.1), 0 8px 22px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(55, 58, 54, 0.06);
  }
  .hnx__head { display: flex; align-items: baseline; justify-content: space-between; gap: 6px 14px; flex-wrap: wrap; padding: 0 4px 12px; border-bottom: 1px solid var(--c-border); }
  .hnx__label {
    display: inline-flex; align-items: center; gap: 10px; margin: 0;
    font-family: var(--font-body); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-dark);
  }
  .hnx__dot { position: relative; width: 9px; height: 9px; border-radius: 50%; background: var(--c-yellow); box-shadow: 0 0 0 1px rgba(55, 58, 54, 0.1); }
  .hnx__dot::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 2px solid var(--c-yellow); opacity: 0; animation: hnx-ping 2.4s cubic-bezier(0, 0, 0.2, 1) 1.2s infinite; }
  @keyframes hnx-ping { 0% { transform: scale(0.6); opacity: 0.85; } 70%, 100% { transform: scale(1.6); opacity: 0; } }
  .hnx__hint { margin: 0; font-size: 13px; color: var(--c-text-light); }

  .hnx__list { list-style: none; margin: 0; padding: 0; }
  .hnx-row {
    display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: 14px;
    padding: 12px 4px; border-bottom: 1px solid var(--c-border);
    opacity: 0; animation: hnx-row 0.6s var(--ease) both; animation-delay: calc(0.3s + var(--i, 0) * 0.07s);
  }
  .hnx-row:last-child { border-bottom: 0; }
  @keyframes hnx-row { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .hnx-photo { width: 56px; height: 56px; border-radius: 14px; overflow: hidden; display: grid; place-items: center; background: var(--c-warm-gray); }
  .hnx-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s var(--ease); }
  .hnx-row:hover .hnx-photo img { transform: scale(1.07); }
  .hnx-photo__initial { font-family: var(--font-display); font-weight: 700; font-size: 24px; color: var(--c-dark); }
  .hnx-text { min-width: 0; }
  .hnx-name { margin: 0 0 3px; font-family: var(--font-display); font-weight: 700; font-size: 18px; letter-spacing: -0.015em; line-height: 1.2; }
  .hnx-name a { color: var(--c-text); text-decoration: none; background-image: linear-gradient(var(--c-yellow), var(--c-yellow)); background-size: 0% 2px; background-position: 0 100%; background-repeat: no-repeat; transition: background-size 0.35s var(--ease); }
  .hnx-name a:hover, .hnx-name a:focus-visible { background-size: 100% 2px; }
  .hnx-name a:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; border-radius: 2px; }
  .hnx-when { display: flex; align-items: center; flex-wrap: wrap; gap: 2px 8px; margin: 0; font-size: 14px; color: var(--c-text-muted); }
  .hnx-when > span { white-space: nowrap; }
  .hnx-when__short { display: none; }
  .hnx-when--set { color: var(--c-text); font-weight: 600; }
  .hnx-when__time::before { content: '·'; margin-right: 8px; color: var(--c-text-light); }
  .hnx-when__dot { flex-shrink: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--c-yellow); box-shadow: 0 0 0 3px rgba(255, 218, 36, 0.25); }
  /* A month in thirds; the reveal's third fills in */
  .hnx-month { display: inline-flex; gap: 3px; flex-shrink: 0; }
  .hnx-month i { position: relative; width: 12px; height: 4px; border-radius: 4px; background: var(--c-border); overflow: hidden; }
  .hnx-month i.is-on::after { content: ''; position: absolute; inset: 0; background: var(--c-yellow); transform-origin: left; transform: scaleX(0); animation: hnx-fill 0.7s var(--ease) both; animation-delay: calc(0.75s + var(--i, 0) * 0.07s); }
  @keyframes hnx-fill { to { transform: scaleX(1); } }
  .hnx-add {
    display: inline-flex; align-items: center; gap: 7px; min-height: 44px; padding: 0 16px; border-radius: 100px;
    border: 1.5px solid var(--c-dark); background: transparent; color: var(--c-dark);
    font: inherit; font-size: 14px; font-weight: 700; cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .hnx-add:hover { background: var(--c-dark); color: var(--c-yellow); transform: translateY(-1px); box-shadow: 0 6px 16px rgba(55, 58, 54, 0.15); }
  .hnx-add:active { transform: scale(0.97); transition-duration: 80ms; }
  .hnx-add:focus-visible { outline: 2px solid var(--c-yellow); outline-offset: 3px; }
  .hnx-row[data-state='confirmed'] .hnx-add { background: var(--c-yellow); border-color: var(--c-yellow); }
  .hnx-row[data-state='confirmed'] .hnx-add:hover { background: var(--c-dark); border-color: var(--c-dark); }
  .hnx__all {
    display: inline-flex; align-items: center; gap: 8px; margin: 10px 4px 2px; padding: 8px 0; border: 0; background: none;
    font: inherit; font-size: 14px; font-weight: 700; color: var(--c-dark); cursor: pointer;
    text-decoration: underline; text-decoration-color: var(--c-yellow); text-decoration-thickness: 2px; text-underline-offset: 5px;
  }
  .hnx__all svg { transition: transform 0.25s ease; }
  .hnx__all:hover svg { transform: translateX(3px); }
  .hnx__all:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 3px; border-radius: 4px; }

  @media (max-width: 960px) {
    .hnx { margin: 0 auto; max-width: 560px; text-align: left; }
  }
  @media (max-width: 480px) {
    .hnx__card { padding: 18px 14px 12px; border-radius: 22px; }
    .hnx__accent { right: -10px; bottom: -12px; }
    .hnx-row { grid-template-columns: 48px minmax(0, 1fr) auto; gap: 12px; }
    .hnx-photo { width: 48px; height: 48px; border-radius: 12px; }
    .hnx-add { padding: 0 12px; gap: 6px; }
    .hnx-when__long { display: none; }
    .hnx-when__short { display: inline; }
    /* The time goes to its own line under the day */
    .hnx-when__time { flex-basis: 100%; padding-left: 16px; }
    .hnx-when__time::before { content: none; }
  }
  @media (hover: none) { .hnx-row:hover .hnx-photo img { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .hnx, .hnx__accent, .hnx-row, .hnx-month i.is-on::after { animation: none; opacity: 1; transform: none; }
    .hnx__accent { opacity: 0.4; }
    .hnx__dot::after { animation: none; }
  }
</style>
