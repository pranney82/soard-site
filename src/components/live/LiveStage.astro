---
/**
 * LiveStage.astro — the frame on the live page: photo, starting-soon screen, video
 * ===============================================================================
 * Before the watch party it is the hero's portrait photo with its badge
 * (countdown, "Live" for a Facebook-only broadcast, "Processing").
 *
 * During the watch party (data-party: starting soon, live, replay) it is the
 * video, as big as the screen allows, with nothing drawn on the picture and
 * one simple bar under it:
 *
 *   ┌──────────────┐
 *   │              │
 *   │    video     │
 *   │              │
 *   └──────────────┘
 *   captions line                        (replay, when switched on)
 *   ● LIVE · 34 watching    [Tap for sound]   then   [sound] [♥] [full screen]
 *   or  [▶] seek bar with the reveal marked, time under it  [CC] [full screen]   (replay)
 *   [ Jump to the reveal ]               (replay, once the moment is known)
 *
 * The only things ever shown over the frame are for when there is no
 * picture: "The camera is getting ready", "Reconnecting", "Tap to watch".
 *
 * Sizing: the page sets --fh, the height the whole stage may take; the
 * stage fits the video and bar inside it at the picture's real shape (--ar,
 * width / height). Behaviour lives in src/utils/live-stage.ts.
 */
import { cfRaw, cfSrcset, cfLqip } from '../../utils/cf-image';

interface Props { photo: string; alt: string }
const { photo, alt } = Astro.props;

const svg = (paths: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
const SPEAKER = '<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/>';
const ICON = {
  soundOff: svg(`${SPEAKER}<path d="M22 9l-6 6"/><path d="M16 9l6 6"/>`),
  soundOn: svg(`${SPEAKER}<path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 18.364a9 9 0 0 0 0-12.728"/>`),
  full: svg('<path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/>'),
  heart: svg('<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>'),
  play: svg('<path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5z" fill="currentColor"/>'),
  pause: svg('<rect x="6" y="4" width="4" height="16" rx="1" fill="currentColor"/><rect x="14" y="4" width="4" height="16" rx="1" fill="currentColor"/>'),
  close: svg('<path d="M18 6 6 18"/><path d="m6 6 12 12"/>'),
  eye: svg('<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>'),
  spark: svg('<path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0l1.58 6.14a2 2 0 0 0 1.44 1.44l6.14 1.58a.5.5 0 0 1 0 .96l-6.14 1.58a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z"/>'),
};
---

<div class="stage" data-stage data-mode="loading" data-orientation="portrait" tabindex="-1">
  <div class="stage__screen">
    <div class="stage__accent" aria-hidden="true"></div>
    <div class="stage__picture" data-s="picture" data-live="frame" style={`background-image:url(${cfLqip(photo)})`}>
      <div class="stage__clip">
        <img
          class="stage__photo lqip-img"
          src={cfRaw(photo, 'w=640,h=800,fit=cover,gravity=face,q=82')}
          srcset={cfSrcset(photo, [400, 640, 800, 1024], { fit: 'cover', gravity: 'face', aspectRatio: 1.25 })}
          sizes="(max-width: 960px) 90vw, 40vw"
          width="640" height="800"
          alt={alt}
          loading="eager" fetchpriority="high" decoding="async"
          data-live="photo"
        />
        <div class="stage__player" data-s="player" hidden></div>
        <div class="stage__note" data-s="note" role="status" hidden>
          <p class="stage__note-title" data-s="note-title"></p>
          <p class="stage__note-text" data-s="note-text"></p>
        </div>
        <button class="stage__tap" type="button" data-s="tap" hidden>
          <span class="stage__tap-icon"><Fragment set:html={ICON.play} /></span>
          <span>Tap to watch</span>
        </button>
        <p class="stage__badge" data-s="badge" hidden><span class="stage__badge-dot" aria-hidden="true"></span><span data-s="badge-text"></span></p>
      </div>
      <div class="stage__dockbar" data-s="dockbar" hidden>
        <span class="stage__dock-label"><span class="dot" aria-hidden="true"></span><span data-s="dock-label">Live</span></span>
        <button class="stage__undock" type="button" data-s="undock" aria-label="Close the mini player"><Fragment set:html={ICON.close} /></button>
      </div>
    </div>
  </div>

  <p class="stage__cc" data-s="cc" aria-hidden="true" hidden><span data-s="cc-text"></span></p>

  <div class="stage__bar" data-s="bar" hidden>
    <div class="bar__live" data-s="livebar">
      <span class="bar__status"><span class="bar__dot" aria-hidden="true"></span><span data-s="status">Connecting</span></span>
      <span class="bar__count" data-s="count" hidden><span class="bar__count-n"><Fragment set:html={ICON.eye} /><span data-s="count-num"></span></span><span class="bar__count-word" data-s="count-word"></span></span>
      <span class="bar__end">
        <button class="bar__sound" type="button" data-s="sound" hidden><Fragment set:html={ICON.soundOff} /><span>Tap for sound</span></button>
        <button class="bar__btn" type="button" data-s="mute" aria-label="Mute" title="Sound (M)" hidden>
          <span class="bar__on"><Fragment set:html={ICON.soundOn} /></span>
          <span class="bar__off"><Fragment set:html={ICON.soundOff} /></span>
        </button>
        <button class="bar__btn bar__heart" type="button" data-s="heart" aria-label="Send love to the family" title="Send love" hidden><Fragment set:html={ICON.heart} /></button>
        <button class="bar__btn" type="button" data-full aria-label="Full screen" title="Full screen (F)" hidden><Fragment set:html={ICON.full} /></button>
      </span>
    </div>
    <div class="bar__replay" data-s="replaybar" hidden>
      <button class="bar__play" type="button" data-s="play" aria-label="Play">
        <span class="bar__icon-play"><Fragment set:html={ICON.play} /></span>
        <span class="bar__icon-pause"><Fragment set:html={ICON.pause} /></span>
      </button>
      <div class="seek">
        <span class="seek__line" aria-hidden="true"></span>
        <span class="seek__mark" data-s="mark" aria-hidden="true" hidden><Fragment set:html={ICON.spark} /></span>
        <input class="seek__range" type="range" min="0" max="1000" step="1" value="0" data-s="seek" aria-label="Seek" aria-valuetext="0:00" />
      </div>
      <span class="bar__time" data-s="time"><span data-s="time-now">0:00</span><span class="bar__total" data-s="time-total"></span></span>
      <button class="bar__btn bar__cc" type="button" data-s="cc-toggle" aria-label="Captions" aria-pressed="false" title="Captions (C)" hidden>CC</button>
      <button class="bar__btn" type="button" data-full aria-label="Full screen" title="Full screen (F)"><Fragment set:html={ICON.full} /></button>
    </div>
  </div>

  <button class="stage__jump" type="button" data-s="jump" hidden>
    <Fragment set:html={ICON.spark} /><span class="stage__jump-label" data-s="jump-label">Jump to the reveal</span><span class="stage__jump-at" data-s="jump-at"></span>
  </button>

  <!-- Something that goes with the picture (the page's design strip). The grid places it beside the picture; it comes
       last so the keyboard reaches the video's own controls first -->
  <div class="stage__beside"><slot name="beside" /></div>
</div>

<style>
  /* ── Before the watch party: the hero's portrait photo ── */
  .stage { --ar: 0.5625; --gap: 8px; --bar: 52px; --below: calc(var(--bar) + var(--gap)); position: relative; outline: none; }
  .stage[data-orientation='landscape'] { --ar: 1.7778; }
  .stage__screen { position: relative; }
  .stage__accent {
    position: absolute; bottom: -16px; right: -16px; width: 65%; height: 50%; background: var(--c-yellow);
    border-radius: 24px; z-index: 0; opacity: 0; animation: accentIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.7s both;
  }
  @keyframes accentIn { to { opacity: 0.35; } }
  .stage__picture {
    position: relative; z-index: 1; aspect-ratio: 4 / 5; border-radius: 24px;
    background-size: cover; background-position: center; background-color: var(--c-dark-deep);
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.12), 0 8px 24px rgba(0, 0, 0, 0.06);
  }
  .stage__clip { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; container-type: inline-size; }
  .stage__photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .stage__player { position: absolute; inset: 0; transition: opacity 0.3s ease; }
  .stage__player[hidden] { display: none; }
  /* :global: the video and iframes are created at runtime, so they have no Astro scope attribute */
  .stage__player :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .stage__player :global(video) { width: 100%; height: 100%; display: block; object-fit: contain; background: #000; }
  .stage[data-pkind='replay'] .stage__player :global(video) { cursor: pointer; }

  .stage__badge {
    position: absolute; left: 16px; bottom: 16px; z-index: 3; margin: 0;
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--c-dark-deep); color: var(--c-cream); padding: 10px 16px; border-radius: 100px;
    font-size: 13px; font-weight: 600; letter-spacing: 0.02em; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }
  .stage__badge[hidden] { display: none; }
  .stage__badge-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-yellow); }

  /* ── Watch party: the video, with the bar underneath ── */
  .stage[data-party] {
    /* The picture: as big as the height allows at its shape (--pic). Beside it, whatever the page puts there (it says
       how wide with --beside and --beside-gap: the design strip, as tall as the picture). The captions line, the bar
       and Jump run under both. The stage is as wide as that, or as wide as its controls need (--controls-min) when
       that's more, never wider than the column: on a phone a portrait picture is sized by the screen's height, so it
       can be narrower than its bar needs, and then the picture and what's beside it keep their size in the middle and
       the bar takes the room (Peter, Nov 11 2026: the video stays full size, no shortcuts) */
    --pic: calc((var(--fh, 640px) - var(--below)) * var(--ar));
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--pic)) var(--beside-gap, 0px) var(--beside, 0px) minmax(0, 1fr);
    grid-template-areas: '. screen . beside .' 'cc cc cc cc cc' 'bar bar bar bar bar' 'jump jump jump jump jump';
    width: min(var(--stage-max, 100%), max(calc(var(--pic) + var(--beside-gap, 0px) + var(--beside, 0px)), var(--controls-min, 0px)));
    margin-inline: auto;
  }
  /* A landscape picture fills the width: what goes with it sits under everything */
  .stage[data-party][data-orientation='landscape'] { grid-template-areas: '. screen . . .' 'cc cc cc cc cc' 'bar bar bar bar bar' 'jump jump jump jump jump' 'beside beside beside beside beside'; }
  .stage[data-party] .stage__screen { grid-area: screen; }
  .stage[data-party] .stage__beside { grid-area: beside; position: relative; min-width: 0; }
  .stage[data-party] .stage__cc { grid-area: cc; }
  .stage[data-party] .stage__bar { grid-area: bar; container: bar / inline-size; }
  .stage[data-party] .stage__jump { grid-area: jump; }
  /* A replay's bar holds play, the line, captions and full screen: room enough for a line worth dragging */
  .stage[data-party][data-mode='replay'] { --controls-min: 320px; }
  /* Live: "Live", the count and three buttons (or Tap for sound); starting soon: its words, the count and the heart */
  .stage[data-party][data-mode='live'] { --controls-min: 270px; }
  .stage[data-party][data-mode='starting'] { --controls-min: 250px; }
  .stage[data-party][data-cc] { --below: calc(var(--bar) + var(--gap) + 3.4em + var(--gap)); }
  .stage[data-party][data-jump] { --below: calc(var(--bar) + var(--gap) + 46px + var(--gap)); }
  .stage[data-party][data-cc][data-jump] { --below: calc(var(--bar) + var(--gap) + 3.4em + var(--gap) + 46px + var(--gap)); }
  .stage[data-party] .stage__screen { aspect-ratio: var(--ar); }
  .stage[data-party] .stage__picture { position: absolute; inset: 0; aspect-ratio: auto; border-radius: 20px; }
  .stage[data-party] .stage__photo { display: none; }
  /* While the camera connects or reconnects, the kid's photo sits behind the note */
  .stage[data-party][data-pkind='live'][data-pstatus='connecting'] .stage__photo,
  .stage[data-party][data-pstatus='waiting'] .stage__photo,
  .stage[data-party][data-pstatus='reconnecting'] .stage__photo { display: block; filter: blur(16px) brightness(0.45); transform: scale(1.12); }
  .stage[data-pkind='live'][data-pstatus='connecting'] .stage__player,
  .stage[data-pstatus='waiting'] .stage__player,
  .stage[data-pstatus='reconnecting'] .stage__player { opacity: 0; }

  .stage__note {
    position: absolute; inset: 0; z-index: 2; display: grid; place-content: center; text-align: center;
    padding: 24px; color: #fff; pointer-events: none;
  }
  .stage__note[hidden] { display: none; }
  .stage__note-title { font-family: var(--font-display); font-size: clamp(1.2rem, 7cqi, 1.6rem); line-height: 1.2; margin: 0 0 8px; }
  .stage__note-text { font-size: 14px; line-height: 1.55; margin: 0 auto; max-width: 30ch; color: rgba(255, 255, 255, 0.86); }
  .stage__note-text:empty { display: none; }

  .stage__tap {
    position: absolute; inset: 0; z-index: 4; display: grid; place-content: center; justify-items: center; gap: 12px;
    border: 0; background: rgba(0, 0, 0, 0.35); color: #fff; font: inherit; font-size: 15px; font-weight: 700; cursor: pointer;
  }
  .stage__tap[hidden] { display: none; }
  .stage__tap-icon { width: 76px; height: 76px; border-radius: 50%; background: var(--c-yellow); color: var(--c-dark); display: grid; place-items: center; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); }
  .stage__tap-icon :global(svg) { width: 32px; height: 32px; margin-left: 4px; }
  .stage__tap:focus-visible .stage__tap-icon { outline: 3px solid #fff; outline-offset: 3px; }

  /* ── Captions line (replay) ── */
  /* Always two lines tall (a longer cue is shown a page at a time, live-stage.ts), so nothing under it ever moves */
  .stage__cc {
    margin: var(--gap) 0 0; height: calc(2 * 1.4em + 12px); overflow: hidden; display: grid; place-items: center; text-align: center;
    padding: 6px 14px; border-radius: 14px; background: var(--c-dark-deep); color: #fff; font-size: 15px; line-height: 1.4; overflow-wrap: anywhere;
  }
  .stage__cc[hidden] { display: none; }

  /* ── Bar ── */
  /* Above the yellow accent that peeks out from behind the video */
  .stage__bar, .stage__cc, .stage__jump { position: relative; z-index: 1; }
  .stage__bar {
    margin-top: var(--gap); height: var(--bar); display: flex; align-items: center;
    padding: 0 6px 0 16px; border-radius: 100px; background: #fff; border: 1px solid var(--c-border); min-width: 0;
  }
  .stage__bar[hidden] { display: none; }
  .bar__live { display: flex; align-items: center; gap: 10px; width: 100%; min-width: 0; }
  /* Replay: play, the progress line with the time under it, then captions and full screen. The time shares the
     line's cell instead of taking a width of its own, so the line gets everything the buttons don't need, and a
     portrait video's narrow bar still holds every control (nothing ever hangs off its end) */
  .bar__replay { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-auto-flow: column; grid-auto-columns: auto; align-items: center; column-gap: 8px; width: 100%; min-width: 0; }
  .bar__replay > .seek, .bar__replay > .bar__time { grid-row: 1; grid-column: 2; }
  .bar__live[hidden], .bar__replay[hidden] { display: none; }
  .bar__status { display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0; font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text); white-space: nowrap; }
  .bar__status span:last-child { overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 360px) { .stage__bar { padding-left: 12px; } }
  /* The bar's words give way by the bar's own width, not the screen's (beside a sideways phone's picture it's narrow on
     a wide screen): the viewer count's words go first, so "Live" and "Starting soon" are never squeezed out */
  @container bar (max-width: 300px) { .bar__status { font-size: 11px; letter-spacing: 0.04em; } }
  .bar__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--c-text-light); position: relative; flex-shrink: 0; }
  .stage[data-onair] .bar__dot { background: var(--c-yellow); }
  .stage[data-onair][data-mode='live'] .bar__dot::after {
    content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--c-yellow); opacity: 0;
    animation: live-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes live-ping { 0% { transform: scale(0.6); opacity: 0.9; } 70%, 100% { transform: scale(1.5); opacity: 0; } }
  /* The count takes the room between the status and the buttons. Short of room, its word steps aside first, then the
     number with its eye (a line that's never shown takes them): never a bare eye, never "Live" squeezed */
  .bar__count {
    flex: 1 1 0; min-width: 0; display: flex; flex-wrap: wrap; align-items: center; column-gap: 5px; height: 20px; line-height: 20px; overflow: hidden;
    font-size: 13px; font-weight: 600; color: var(--c-text-muted); white-space: nowrap;
  }
  .bar__count::before { content: ''; flex: 0 0 0; height: 20px; margin-right: -5px; }
  .bar__count[hidden] { display: none; }
  .bar__count-n { display: inline-flex; align-items: center; gap: 6px; }
  .bar__count :global(svg) { width: 15px; height: 15px; }
  .bar__end { margin-left: auto; display: flex; align-items: center; gap: 4px; }
  .bar__end [hidden] { display: none; }
  .bar__sound {
    display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px 0 12px;
    border: 0; border-radius: 100px; background: var(--c-yellow); color: var(--c-dark);
    font: inherit; font-size: 14px; font-weight: 800; cursor: pointer; white-space: nowrap;
    animation: soundNudge 2.8s ease-in-out 1.5s 3;
  }
  .bar__sound :global(svg) { width: 19px; height: 19px; }
  .bar__sound:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; }
  @keyframes soundNudge { 0%, 80%, 100% { transform: none; } 88% { transform: scale(1.06); } }
  .bar__btn {
    width: 40px; height: 40px; flex-shrink: 0; padding: 0; border: 0; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
    background: transparent; color: var(--c-dark); transition: background 150ms ease, transform 150ms ease;
  }
  .bar__btn[hidden] { display: none; }
  .bar__btn:hover { background: var(--c-cream); }
  .bar__btn:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; }
  .bar__btn :global(svg) { width: 21px; height: 21px; }
  .bar__off, .stage[data-muted] .bar__on { display: none; }
  .bar__on, .stage[data-muted] .bar__off { display: grid; }
  .bar__heart { color: var(--c-dark); }
  .bar__heart :global(svg) { fill: var(--c-yellow); }
  .bar__heart:active, .bar__heart.is-pop { transform: scale(0.84); }
  /* Others watching sent love: the heart beats (no numbers, nothing over the picture) */
  .bar__heart.is-beat { animation: heartBeat 0.6s ease-out; }
  @keyframes heartBeat { 0% { transform: none; } 25% { transform: scale(1.22); } 50% { transform: scale(0.96); } 75% { transform: scale(1.1); } 100% { transform: none; } }
  .bar__cc { font-size: 12px; font-weight: 800; letter-spacing: 0.04em; border: 1.5px solid var(--c-border); width: 40px; height: 32px; border-radius: 8px; }
  .bar__cc[aria-pressed='true'] { background: var(--c-dark); color: #fff; border-color: var(--c-dark); }

  .bar__play {
    width: 40px; height: 40px; flex-shrink: 0; padding: 0; border: 0; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
    background: var(--c-yellow); color: var(--c-dark); margin-left: -10px;
  }
  .bar__play :global(svg) { width: 16px; height: 16px; }
  .bar__icon-play :global(svg) { margin-left: 2px; }
  .bar__play:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; }
  .bar__icon-pause, .stage[data-playing] .bar__icon-play { display: none; }
  .stage[data-playing] .bar__icon-pause { display: grid; }
  .bar__icon-play { display: grid; }
  /* Under the progress line, at its end. When there isn't room for all of it, the length steps aside first, then
     the time: each wraps onto a second line that is never shown, so nothing runs into the buttons */
  .bar__time {
    align-self: end; display: flex; flex-wrap: wrap; column-gap: 0.3em; height: 14px; line-height: 14px; overflow: hidden;
    font-size: 12px; font-weight: 600; color: var(--c-text-muted); font-variant-numeric: tabular-nums; white-space: nowrap; pointer-events: none;
  }
  /* Pushes the time to the end; as tall as a line, so a first line holding only this still hides what wrapped */
  .bar__time::before { content: ''; flex: 1 0 0; height: 14px; }
  .bar__total:empty { display: none; }

  /* The line sits in the top of its cell (--seek-pad leaves the bottom for the time); the whole cell still seeks */
  .seek {
    --seek-pad: 14px; position: relative; min-width: 0; height: 40px; display: flex; align-items: center;
    /* The slider's handle (16px) runs along a track 8px in from each end of the cell, so its centre travels from 16px
       to 16px short of the end: the reveal's star, drawn exactly where the handle is at that moment (--at, how far
       along the reveal is), always fits in the cell with its ring, even at the very start or end */
    --mark-x: calc(16px + (100% - 32px) * var(--at, 0.5));
  }
  /* The line you see is its own element, along the track (with how far it's played, --f on the cell, and a gap for
     the star); the slider itself is see-through except its handle, and sits over both, so the handle is always whole
