---
/**
 * EventRecap — an event's page once it's over: the pro photos, then the
 * sponsors (Peter, Oct 2026). Used by the gala and golf pages after their
 * event, by every year page (/events/gala/2026/) and by /events/<slug>/ for
 * any other past event. The rules for which photos and sponsors belong to
 * which event live in public/admin/events-shared.js.
 *
 *   Hero      the site's editorial split: thank-you words left, the cover
 *             photo right (the first photo; the poster until photos arrive)
 *   Photos    RecapPhotos.astro: justified rows, viewer, save and share
 *   Sponsors  RecapSponsors.astro: levels as a logo wall, named moments
 *   Close     next year's date when it's set, else donate / all events
 *
 * Themes keep each series in its own colors: 'gala' (Havana sunset),
 * 'golf' (fairway green), 'default' (the site's cream and yellow).
 */
import { cfRaw, cfSrcset, cfLqip } from '../../utils/cf-image';
import RecapPhotos from './RecapPhotos.astro';
import RecapSponsors from './RecapSponsors.astro';
import {
  seriesOf, seriesEvents, isOver, yearOf, fmtDay, displayName, recapLead,
  recapPhotos, recapSponsors, cleanHighlights,
} from '../../../public/admin/events-shared.js';

interface Props {
  ev: any;
  events: any[];
  pageDoc?: any;
  theme?: 'gala' | 'golf' | 'default';
  /** The gala's theme for the year ("Havana Nights") */
  themeName?: string;
}

const { ev, events, pageDoc = null, theme = 'default', themeName = '' } = Astro.props;
const series = seriesOf(ev);
const year = yearOf(ev);
const name = displayName(ev);
const label = `${name} ${year}`.trim();
const when = series?.key === 'gala' ? 'night' : 'day';
const photos = recapPhotos(ev, events, pageDoc);
const sponsors = recapSponsors(ev, events, pageDoc);
const highlights = cleanHighlights(ev.highlights);
const lead = recapLead(ev, { photos: photos.length, sponsors: sponsors.length });
const credit = ev.photographer ? { name: String(ev.photographer).trim(), url: ev.photographerUrl || '' } : undefined;

/* The words of the title that get the highlighter */
const titleParts = (() => {
  const m = name.match(/^(.*\s)(\S+)$/);
  return m ? { lead: m[1], last: m[2] } : { lead: '', last: name };
})();

/* Cover: the first photo, the second overlapping it; the poster before photos */
const cover = photos[0]?.id || ev.image || null;
const coverIsPoster = !photos.length && !!ev.image;
const second = photos[1]?.id || null;
const coverAlt = photos[0]?.alt || (coverIsPoster ? `${label} poster` : `${label}, a moment from the ${when}`);

/* What comes next in the series: a date to save, or the evergreen page */
const newer = series ? seriesEvents(series, events).filter((e: any) => e.date > ev.date) : [];
const nextUp = newer.length ? newer[newer.length - 1] : null;
const nextIsSet = !!nextUp && !isOver(nextUp);

/* Video: on a series event it's the invitation, so only other events show one */
function youTubeId(url: string): string | null {
  return url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|v\/|shorts\/))([\w-]{11})/)?.[1] || null;
}
const streamId: string | null = !series ? ev.streamVideoId || null : null;
const ytId: string | null = !series && !streamId && ev.videoUrl ? youTubeId(ev.videoUrl) : null;
---

<div class={`rc rc--${theme}`}>
  <!-- ═══ HERO ═══ -->
  <section class="rh" aria-labelledby="rh-title">
    <div class="rh-inner">
      <div class="rh-text">
        <p class="rh-eyebrow">{year} · Thank you</p>
        <h1 id="rh-title" class="rh-title" transition:name="event-title">
          {titleParts.lead}<em>{titleParts.last}</em>
        </h1>
        {themeName && <p class="rh-theme">{themeName}</p>}
        <ul class="rh-meta" role="list">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
            <time datetime={ev.date}>{fmtDay(ev.date, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}</time>
          </li>
          {ev.location && (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
              {String(ev.location).trim()}
            </li>
          )}
        </ul>
        <p class="rh-lead">{lead}</p>
        {(photos.length > 0 || sponsors.length > 0) && (
          <div class="rh-ctas">
            {photos.length > 0 && (
              <a href="#photos" class="btn btn-primary btn-lg">
                See the photos
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
              </a>
            )}
            {sponsors.length > 0 && (
              <a href="#sponsors" class={photos.length ? 'btn btn-outline-dark rh-btn-2' : 'btn btn-primary btn-lg'}>Our sponsors</a>
            )}
          </div>
        )}
        {highlights.length > 0 && (
          <dl class="rh-highlights">
            {highlights.map((h) => (
              <div>
                <dt>{h.label}</dt>
                <dd>{h.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <div class="rh-frame">
        <div class="rh-accent" aria-hidden="true"></div>
        {cover ? (
          photos.length ? (
            <a class="rh-photo" href="#photo-1" data-rp-jump="0" aria-label="Open the first photo" style={`background-image:url('${cfLqip(cover)}')`}>
              <img
                src={cfRaw(cover, 'w=640,h=800,fit=cover,gravity=face,q=82')}
                srcset={cfSrcset(cover, [400, 640, 800, 1024], { fit: 'cover', gravity: 'face', aspectRatio: 1.25, quality: 82 })}
                sizes="(max-width: 860px) 80vw, (max-width: 1200px) 38vw, 440px"
                alt={coverAlt}
                width="640" height="800"
                loading="eager" fetchpriority="high" decoding="async"
                transition:name="event-hero"
              />
            </a>
          ) : (
            <div class="rh-photo" style={`background-image:url('${cfLqip(cover)}')`}>
              <img
                src={cfRaw(cover, 'w=640,h=800,fit=cover,gravity=top,q=82')}
                srcset={cfSrcset(cover, [400, 640, 800, 1024], { fit: 'cover', gravity: 'top', aspectRatio: 1.25, quality: 82 })}
                sizes="(max-width: 860px) 80vw, (max-width: 1200px) 38vw, 440px"
                alt={coverAlt}
                width="640" height="800"
                loading="eager" fetchpriority="high" decoding="async"
                transition:name="event-hero"
              />
            </div>
          )
        ) : (
          <div class="rh-photo rh-photo--made" aria-hidden="true">
            <span class="rh-made__year">{year}</span>
            <span class="rh-made__name">{name}</span>
          </div>
        )}
        {second && (
          <a class="rh-photo rh-photo--small" href="#photo-2" data-rp-jump="1" aria-label="Open the second photo" style={`background-image:url('${cfLqip(second)}')`}>
            <img
              src={cfRaw(second, 'w=360,h=432,fit=cover,gravity=face,q=75')}
              srcset={`${cfRaw(second, 'w=200,h=240,fit=cover,gravity=face,q=75')} 200w, ${cfRaw(second, 'w=360,h=432,fit=cover,gravity=face,q=75')} 360w`}
              sizes="180px"
              alt=""
              width="360" height="432"
              loading="lazy" decoding="async"
            />
          </a>
        )}
      </div>
    </div>
    {photos.length > 0 && (
      <a class="rh-stat" href="#photos">
        <span class="rh-stat__num">{photos.length}</span>
        <span class="rh-stat__label">photos from<br />the {when}</span>
      </a>
    )}
  </section>

  <!-- ═══ PHOTOS ═══ -->
  {photos.length > 0 ? (
    <RecapPhotos photos={photos} label={label} when={when} credit={credit} />
  ) : (
    <section class="rc-pending" id="photos" aria-labelledby="rc-pending-title">
      <div class="rc-pending__card">
        <span class="rc-pending__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
        </span>
        <div>
          <h2 id="rc-pending-title">The photos are on the way</h2>
          <p>Our photographer is working through the {when}. They’ll be right here, ready to view and save, as soon as they’re in.</p>
        </div>
      </div>
    </section>
  )}

  <!-- ═══ SPONSORS ═══ -->
  {sponsors.length > 0 && (
    <RecapSponsors
      tiers={sponsors}
      when={when}
      kind={series?.kind || 'event'}
      mailSubject={series?.mailSubject || name}
    />
  )}

  <!-- ═══ VIDEO (events outside a series) ═══ -->
  {(streamId || ytId) && (
    <section class="rc-video" id="video" aria-labelledby="rc-video-title">
      <div class="rc-wrap">
        <h2 id="rc-video-title" class="rc-h2">The video</h2>
        <div class="rc-video__frame">
          <button class="rc-video__facade" type="button" data-stream-id={streamId || undefined} data-yt-id={ytId || undefined} aria-label={`Play the ${label} video`}>
            <img
              src={streamId
                ? `https://videodelivery.net/${streamId}/thumbnails/thumbnail.jpg?time=2s&width=1600&height=900&fit=crop`
                : `https://i.ytimg.com/vi/${ytId}/maxresdefault.jpg`}
              alt=""
              loading="lazy" decoding="async" width="1600" height="900"
            />
            <span class="rc-video__play" aria-hidden="true">
              <svg viewBox="0 0 24 28" width="26" height="30"><path d="M2 1.5v25l20-12.5L2 1.5z" fill="currentColor"/></svg>
            </span>
          </button>
        </div>
      </div>
    </section>
  )}

  <!-- ═══ MORE ABOUT IT (events outside a series) ═══ -->
  {!series && ev.body && (
    <section class="rc-body">
      <div class="rc-wrap rc-body__inner" set:html={ev.body} />
    </section>
  )}

  <!-- ═══ CLOSE ═══ -->
  <section class="rc-close" aria-labelledby="rc-close-title">
    <div class="rc-wrap">
      <div class="rc-close__card">
        {nextIsSet ? (
          <Fragment>
            <p class="rc-close__eyebrow">Save the date</p>
            <h2 id="rc-close-title">{displayName(nextUp)} {yearOf(nextUp)} is {fmtDay(nextUp.date, { weekday: 'long', month: 'long', day: 'numeric' })}</h2>
            <p>Tickets, sponsorships and everything else about this year’s {series?.kind || 'event'} are on its page.</p>
            <div class="rc-close__ctas">
              <a href={series!.path} class="btn btn-primary btn-lg">See {yearOf(nextUp)}’s {series?.key === 'gala' ? 'gala' : 'tournament'}</a>
              <a href="/donate/" class="btn btn-ghost-light">Donate</a>
            </div>
          </Fragment>
        ) : (
          <Fragment>
            <p class="rc-close__eyebrow">{series ? 'See you next year' : 'Get involved'}</p>
            <h2 id="rc-close-title">{series ? `Next year’s ${series.key === 'gala' ? 'gala' : 'tournament'} is already in the works` : 'Every event builds a child’s room'}</h2>
            <p>{series ? 'Newsletter subscribers hear the date first. Sign up just below, or give now and help build the next room.' : 'Join us at the next one, or give today and help build the next dream room.'}</p>
            <div class="rc-close__ctas">
              <a href="/donate/" class="btn btn-primary btn-lg">Donate</a>
              <a href="/events/" class="btn btn-ghost-light">All events</a>
            </div>
          </Fragment>
        )}
      </div>
    </div>
  </section>
</div>

<style>
  /* ─── Themes ─── */
  .rc {
    --rc-paper: var(--c-cream);
    --rc-paper-2: #fff;
    --rc-ink: var(--c-text);
    --rc-muted: var(--c-text-muted);
    --rc-eyebrow: var(--c-text-muted);
    --rc-accent: var(--c-yellow);
    --rc-highlight: var(--c-yellow-soft);
    --rc-band: var(--c-dark);
    --rc-band-accent: var(--c-yellow);
    --rc-tile: #ece6d8;
    --rc-line: rgba(0, 0, 0, 0.09);
    --rc-close: var(--c-dark-deep);
    background: var(--rc-paper);
  }
  .rc--gala {
    --rc-paper: #faf3e0;
    --rc-paper-2: #fffaf0;
    --rc-ink: #0d2f3f;
    --rc-muted: #4b5d63;
    --rc-eyebrow: #b04f3d;
    --rc-accent: #d4a017;
    --rc-highlight: rgba(232, 152, 112, 0.42);
    --rc-band: linear-gradient(150deg, #0d2f3f 0%, #1a4759 60%, #24586a 100%);
    --rc-band-accent: #f0c35a;
    --rc-tile: #efe2c6;
    --rc-line: rgba(13, 47, 63, 0.12);
    --rc-close: linear-gradient(150deg, #0d2f3f 0%, #1a4759 100%);
  }
  .rc--golf {
    --rc-paper: #f7f8f2;
    --rc-paper-2: #fff;
    --rc-ink: #12301f;
    --rc-muted: #4f5b52;
    --rc-eyebrow: #2e7d32;
    --rc-accent: var(--c-yellow);
    --rc-highlight: rgba(255, 218, 36, 0.38);
    --rc-band: linear-gradient(150deg, #0d2818 0%, #1a472a 55%, #2e7d32 100%);
    --rc-band-accent: var(--c-yellow);
    --rc-tile: #e3e8dc;
    --rc-line: rgba(18, 48, 31, 0.1);
    --rc-close: linear-gradient(150deg, #0d2818 0%, #1a472a 100%);
  }

  /* ─── Hero (the site's editorial split, apply.astro is the reference) ─── */
  .rh {
    position: relative;
    background: var(--rc-paper);
    padding: clamp(72px, 9vw, 128px) 0 clamp(72px, 8vw, 104px);
    overflow: hidden;
  }
  .rh-inner {
    max-width: var(--max-width, 1200px);
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 32px);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }
  .rh-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rc-eyebrow);
    animation: rhUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }
  .rh-eyebrow::before { content: ''; width: 28px; height: 2px; background: currentColor; flex-shrink: 0; }
  .rh-title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.6vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--rc-ink);
    text-wrap: balance;
  }
  .rh-title em {
    font-style: italic;
    background-image: linear-gradient(transparent 54%, var(--rc-highlight) 54%);
    padding: 0 0.05em;
  }
  .rh-theme {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    color: var(--rc-eyebrow);
  }
  .rh-meta {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 15px;
    font-weight: 500;
    color: var(--rc-ink);
  }
  .rh-meta li { display: inline-flex; align-items: center; gap: 8px; }
  .rh-meta svg { color: var(--rc-eyebrow); flex-shrink: 0; }
  .rh-lead {
    margin: 0 0 34px;
    max-width: 500px;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.7;
    color: var(--rc-muted);
    text-wrap: pretty;
    animation: rhUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  .rh-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    animation: rhUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }
  .rh-ctas .btn { gap: 10px; }
  .rh-btn-2 { min-height: 56px; }
  .rh-highlights {
    margin: 34px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 36px;
  }
  .rh-highlights div { display: flex; flex-direction: column-reverse; }
  .rh-highlights dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.1;
    color: var(--rc-ink);
  }
  .rh-highlights dt {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rc-muted);
  }

  .rh-frame { position: relative; animation: rhPhoto 0.5s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .rh-accent {
    position: absolute;
    bottom: -16px;
    right: -16px;
    width: 65%;
    height: 50%;
    background: var(--rc-accent);
    border-radius: 24px;
    opacity: 0.35;
    animation: rhAccent 1s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
  }
  .rh-photo {
    position: relative;
    z-index: 1;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    overflow: hidden;
    background-color: var(--rc-tile);
    background-size: cover;
    background-position: center;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.14), 0 8px 24px rgba(0, 0, 0, 0.06);
  }
  .rh-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  a.rh-photo:hover img { transform: scale(1.03); }
  a.rh-photo:focus-visible { outline: 3px solid var(--rc-accent); outline-offset: 4px; }
  .rh-photo--small {
    position: absolute;
    bottom: -24px;
    left: -32px;
    width: 40%;
    aspect-ratio: 5 / 6;
    z-index: 2;
    border: 4px solid var(--rc-paper);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.06), 0 12px 36px rgba(0, 0, 0, 0.14);
  }
  .rh-photo--made {
    display: grid;
    align-content: end;
    gap: 6px;
    padding: 32px;
    background: var(--rc-band);
    color: #fff;
  }
  .rh-made__year { font-family: var(--font-display); font-size: clamp(3rem, 7vw, 5rem); line-height: 1; color: var(--rc-band-accent); }
  .rh-made__name { font-family: var(--font-display); font-size: 1.4rem; line-height: 1.2; }
  .rh-stat {
    position: absolute;
    bottom: clamp(24px, 4vw, 44px);
    right: clamp(24px, 6vw, 80px);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border-radius: var(--border-radius-lg, 20px);
    background: var(--c-dark);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08), 0 16px 48px rgba(0, 0, 0, 0.16);
    transition: transform 0.2s ease;
  }
  .rh-stat:hover { transform: translateY(-2px); }
  .rh-stat:focus-visible { outline: 3px solid var(--rc-accent); outline-offset: 3px; }
  .rh-stat__num { font-family: var(--font-display); font-size: clamp(28px, 3vw, 38px); font-weight: 700; line-height: 1; color: var(--c-yellow); }
  .rh-stat__label { font-size: 12px; font-weight: 600; line-height: 1.35; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.65); }

  @keyframes rhUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  @keyframes rhPhoto { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes rhAccent { from { opacity: 0; transform: scale(0.85); } to { opacity: 0.35; transform: none; } }

  @media (max-width: 860px) {
    .rh-inner { grid-template-columns: 1fr; gap: 48px; }
    .rh-frame { max-width: 380px; width: 100%; margin: 0 auto; }
    .rh-photo--small { left: -14px; bottom: -18px; width: 36%; }
    .rh-stat { position: relative; right: auto; bottom: auto; margin: 36px auto 0; width: fit-content; }
  }
  @media (max-width: 480px) {
    .rh-ctas .btn { width: 100%; justify-content: center; }
  }

  /* ─── Photos on the way ─── */
  .rc-pending {
    background: var(--rc-paper);
    padding: 0 clamp(16px, 4vw, 32px) clamp(64px, 8vw, 96px);
  }
  .rc-pending__card {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    gap: 20px;
    align-items: center;
    padding: clamp(22px, 3vw, 32px);
    border-radius: 22px;
    background: var(--rc-paper-2);
    border: 1px dashed var(--rc-line);
  }
  .rc-pending__icon {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--rc-highlight);
    color: var(--rc-ink);
  }
  .rc-pending h2 { margin: 0 0 4px; font-family: var(--font-display); font-size: clamp(1.2rem, 2vw, 1.45rem); color: var(--rc-ink); }
  .rc-pending p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--rc-muted); }
  @media (max-width: 520px) { .rc-pending__card { flex-direction: column; text-align: center; } }

  /* ─── Video, story ─── */
  .rc-wrap { max-width: 1100px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); }
  .rc-h2 { margin: 0 0 24px; font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--rc-ink); }
  .rc-video { background: var(--rc-paper); padding: clamp(56px, 8vw, 96px) 0 0; }
  .rc-video__frame { position: relative; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; background: #111; }
  .rc-video__facade { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .rc-video__facade img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rc-video__play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 84px; height: 84px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(255, 255, 255, 0.95); color: #111; padding-left: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25); transition: transform 0.3s ease, background 0.3s ease;
  }
  .rc-video__facade:hover .rc-video__play, .rc-video__facade:focus-visible .rc-video__play { transform: translate(-50%, -50%) scale(1.08); background: var(--c-yellow); }
  .rc-video__facade:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 4px; }
  .rc-body { background: var(--rc-paper); padding: clamp(56px, 8vw, 96px) 0 0; }
  .rc-body__inner { max-width: 720px; font-size: 17px; line-height: 1.8; color: var(--rc-ink); }
  .rc-body__inner :global(h2) { font-family: var(--font-display); font-size: 1.5rem; margin: 2rem 0 0.75rem; }
  .rc-body__inner :global(p + p) { margin-top: 1rem; }

  /* ─── Close ─── */
  .rc-close { background: var(--rc-paper); padding: clamp(64px, 9vw, 112px) 0; }
  .rc-close__card {
    position: relative;
    overflow: hidden;
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(36px, 6vw, 64px) clamp(20px, 5vw, 56px);
    border-radius: 28px;
    background: var(--rc-close);
    color: #fff;
    text-align: center;
  }
  .rc-close__card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 55% 60% at 12% 100%, rgba(255, 218, 36, 0.16) 0%, transparent 60%);
    pointer-events: none;
  }
  .rc-close__eyebrow { position: relative; margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--rc-band-accent); }
  .rc-close__card h2 { position: relative; margin: 0 0 14px; font-family: var(--font-display); font-size: clamp(1.6rem, 3.4vw, 2.4rem); line-height: 1.15; color: #fff; text-wrap: balance; }
  .rc-close__card p:not(.rc-close__eyebrow) { position: relative; margin: 0 auto 28px; max-width: 520px; font-size: 16px; line-height: 1.7; color: rgba(255, 255, 255, 0.72); }
  .rc-close__ctas { position: relative; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

  @media (prefers-reduced-motion: reduce) {
    .rh-eyebrow, .rh-lead, .rh-ctas, .rh-frame, .rh-accent { animation: none; }
    .rh-accent { opacity: 0.35; }
    .rh-photo img { transition: none; }
  }
</style>

<script>
  /* Video facade: the player loads only when someone presses play */
  function initRecapVideo() {
    document.querySelectorAll<HTMLButtonElement>('.rc-video__facade').forEach((b) => {
      if (b.dataset.ready) return;
      b.dataset.ready = '1';
      b.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.title = b.getAttribute('aria-label') || 'Event video';
        iframe.allowFullscreen = true;
        iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
        if (b.dataset.streamId) {
          iframe.src = `https://iframe.videodelivery.net/${b.dataset.streamId}?autoplay=true&preload=true`;
          iframe.allow = 'accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture';
        } else if (b.dataset.ytId) {
          iframe.src = `https://www.youtube-nocookie.com/embed/${b.dataset.ytId}?autoplay=1&rel=0`;
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        } else return;
        b.replaceWith(iframe);
      });
    });
  }
  document.addEventListener('astro:page-load', initRecapVideo);
</script>
