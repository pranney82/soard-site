---
/**
 * RecapPhotos — an event's pro photos after the event (EventRecap.astro).
 *
 * Justified rows at each photo's real shape (src/data/dimensions-events.json,
 * written at build), the first rows shown and "Show all" for the rest. A tap
 * opens the viewer: full screen, arrows, keys and swipe, Save (a full-size
 * JPEG) and Share (a link straight to that photo, /…/#photo-12). Without
 * JavaScript every tile is a plain link to the full-size photo.
 */
import { cfRaw, cfLqip, cfSrcset, CF_BASE } from '../../utils/cf-image';
import dims from '../../data/dimensions-events.json';

interface Props {
  photos: { id: string; alt?: string }[];
  /** "Evening of Sunshine 2026": alt text, file names, the share title */
  label: string;
  when?: 'night' | 'day';
  credit?: { name?: string; url?: string };
  /** Tiles shown before "Show all" */
  initial?: number;
}

const { photos, label, when = 'day', credit, initial = 20 } = Astro.props;
const DIMS = dims as Record<string, [number, number]>;
const total = photos.length;
const shown = total <= initial + 4 ? total : initial;
const fileBase = label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'photo';

const tiles = photos.map((p, i) => {
  const d = DIMS[p.id];
  const ar = d ? Math.round((d[0] / d[1]) * 1000) / 1000 : 1.5;
  const alt = p.alt || `${label}, photo ${i + 1} of ${total}`;
  return {
    ...p, i, ar, alt,
    src: cfRaw(p.id, 'w=480,fit=scale-down,q=80'),
    srcset: cfSrcset(p.id, [240, 360, 480, 720, 960, 1200], { fit: 'scale-down', quality: 80 }),
    sizes: `(max-width: 640px) ${Math.ceil(ar * 170)}px, ${Math.ceil(ar * 340)}px`,
    full: cfRaw(p.id, 'w=2000,fit=scale-down,q=86'),
  };
});
---

<section class="rp" id="photos" aria-labelledby="rp-heading" data-rp data-cf-base={CF_BASE} data-file={fileBase} data-label={label}>
  <div class="rp-wrap">
    <header class="rp-head">
      <p class="rp-eyebrow">In photos</p>
      <h2 id="rp-heading" class="rp-title">The {when} in <em>photos</em></h2>
      <p class="rp-sub">
        {total} {total === 1 ? 'photo' : 'photos'}. Tap any one to see it full size, save it, or send it to a friend.
      </p>
      {credit?.name && (
        <p class="rp-credit">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
          Photos by {credit.url ? <a href={credit.url} target="_blank" rel="noopener">{credit.name}</a> : credit.name}
        </p>
      )}
    </header>

    <ul class="rp-grid" role="list">
      {tiles.map((t) => (
        <li class="rp-item" style={`--ar:${t.ar}`} hidden={t.i >= shown}>
          <a
            class="rp-tile"
            href={t.full}
            id={`photo-${t.i + 1}`}
            data-rp-open={t.i}
            data-id={t.id}
            data-ar={t.ar}
            data-alt={t.alt}
            aria-label={`Open photo ${t.i + 1} of ${total}`}
            style={`background-image:url('${cfLqip(t.id)}')`}
          >
            <img
              src={t.src}
              srcset={t.srcset}
              sizes={t.sizes}
              alt={t.alt}
              width={Math.round(t.ar * 400)}
              height="400"
              loading={t.i < 8 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
        </li>
      ))}
    </ul>

    {total > shown && (
      <div class="rp-more">
        <button type="button" class="rp-more__btn" data-rp-more aria-controls="photos">
          Show all {total} photos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
      </div>
    )}
  </div>

  <dialog class="rv" data-rv aria-label={`${label} photos`}>
    <div class="rv-shell">
      <header class="rv-bar">
        <p class="rv-count" aria-live="polite"><span data-rv-pos>1</span><span class="rv-of"> of {total}</span></p>
        <div class="rv-actions">
          <button type="button" class="rv-btn" data-rv-share>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><path d="m16 6-4-4-4 4"/><path d="M12 2v13"/></svg>
            <span>Share</span>
          </button>
          <a class="rv-btn" data-rv-save href={tiles[0]?.full} download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>
            <span>Save</span>
          </a>
          <button type="button" class="rv-btn rv-btn--close" data-rv-close aria-label="Close photos" autofocus>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
      </header>

      <div class="rv-stage" data-rv-stage>
        <button type="button" class="rv-nav rv-nav--prev" data-rv-prev aria-label="Previous photo">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <figure class="rv-figure">
          <img class="rv-img" data-rv-img alt="" decoding="async" />
        </figure>
        <button type="button" class="rv-nav rv-nav--next" data-rv-next aria-label="Next photo">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>

      <footer class="rv-foot">
        <button type="button" class="rv-step" data-rv-prev aria-label="Previous photo">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <p class="rv-caption">
          <span data-rv-caption></span>
          {credit?.name && <span class="rv-credit">Photo by {credit.name}</span>}
        </p>
        <button type="button" class="rv-step" data-rv-next aria-label="Next photo">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </footer>
      <p class="rv-toast" data-rv-toast role="status" aria-live="polite"></p>
    </div>
  </dialog>
</section>

<style>
  .rp {
    background: var(--rc-paper, var(--c-cream));
    padding: clamp(64px, 9vw, 120px) 0 clamp(56px, 8vw, 104px);
  }
  .rp-wrap {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
  }
  .rp-head {
    display: grid;
    gap: 10px;
    max-width: 640px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .rp-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rc-eyebrow, var(--c-text-muted));
    margin: 0;
  }
  .rp-eyebrow::before { content: ''; width: 28px; height: 2px; background: currentColor; }
  .rp-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--rc-ink, var(--c-text));
    margin: 0;
  }
  .rp-title em {
    font-style: italic;
    background-image: linear-gradient(transparent 56%, var(--rc-highlight, var(--c-yellow-soft)) 56%);
    padding: 0 0.04em;
  }
  .rp-sub {
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.65;
    color: var(--rc-muted, var(--c-text-muted));
    margin: 0;
  }
  .rp-credit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--rc-ink, var(--c-text));
    margin: 4px 0 0;
  }
  .rp-credit svg { color: var(--rc-muted, var(--c-text-muted)); }
  .rp-credit a { color: inherit; text-decoration: underline; text-decoration-color: var(--rc-accent, var(--c-yellow)); text-decoration-thickness: 2px; text-underline-offset: 3px; }

  /* Justified rows: each tile grows in proportion to its shape, so every
     photo in a row ends up the same height; the filler keeps the last row
     from stretching. */
  .rp-grid {
    --row: clamp(120px, 17.5vw, 260px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.7vw, 10px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rp-grid::after { content: ''; flex: 1e4 1 0; }
  .rp-item {
    flex: calc(var(--ar) * 1000) 1 calc(var(--ar) * var(--row));
    min-width: 0;
  }
  .rp-item[hidden] { display: none; }
  .rp-tile {
    display: block;
    position: relative;
    aspect-ratio: var(--ar);
    border-radius: clamp(6px, 0.8vw, 12px);
    overflow: hidden;
    background-color: var(--rc-tile, #e9e2d3);
    background-size: cover;
    background-position: center;
    outline-offset: 3px;
  }
  .rp-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }
  .rp-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    pointer-events: none;
  }
  @media (hover: hover) {
    .rp-tile:hover img { transform: scale(1.035); filter: brightness(1.04); }
  }
  .rp-tile:focus-visible { outline: 3px solid var(--rc-accent, var(--c-yellow)); }

  .rp-more { display: flex; justify-content: center; margin-top: clamp(28px, 4vw, 40px); }
  .rp-more__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 30px;
    border-radius: 999px;
    border: 2px solid var(--rc-ink, var(--c-dark));
    background: transparent;
    color: var(--rc-ink, var(--c-dark));
    font: inherit;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .rp-more__btn:hover { background: var(--rc-ink, var(--c-dark)); color: var(--rc-paper, var(--c-cream)); transform: translateY(-2px); }
  .rp-more__btn:focus-visible { outline: 3px solid var(--rc-accent, var(--c-yellow)); outline-offset: 3px; }

  @media (max-width: 640px) {
    .rp-grid { --row: 112px; }
  }

  /* ─── Viewer ─── */
  .rv {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #0d0d0e;
    color: #fff;
    overflow: hidden;
  }
  .rv::backdrop { background: #0d0d0e; }
  .rv[open] { animation: rvIn 0.22s ease both; }
  @keyframes rvIn { from { opacity: 0; } to { opacity: 1; } }
  .rv-shell {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }
  .rv-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: max(10px, env(safe-area-inset-top)) clamp(12px, 2.4vw, 28px) 10px;
  }
  .rv-count {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .rv-of { color: rgba(255, 255, 255, 0.55); font-weight: 500; }
  .rv-actions { display: flex; align-items: center; gap: 6px; }
  .rv-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    padding: 0 14px;
    border-radius: 999px;
    border: 0;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .rv-btn:hover { background: rgba(255, 255, 255, 0.16); }
  .rv-btn--close { padding: 0; width: 44px; }
  .rv-btn:focus-visible, .rv-nav:focus-visible, .rv-step:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; }

  .rv-stage {
    position: relative;
    display: grid;
    grid-template-columns: clamp(56px, 7vw, 96px) minmax(0, 1fr) clamp(56px, 7vw, 96px);
    align-items: center;
    min-height: 0;
    touch-action: pinch-zoom;
    user-select: none;
  }
  .rv-figure {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    align-self: stretch;
    margin: 0;
    min-height: 0;
  }
  /* Pinned to the stage, so a tall photo never pushes the bar off the screen */
  .rv-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    -webkit-user-drag: none;
  }
  .rv-img.is-dragging { transition: none; }
  .rv-nav {
    justify-self: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 0;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .rv-nav:hover { background: rgba(255, 255, 255, 0.18); transform: scale(1.06); }
  .rv-nav--prev { grid-column: 1; grid-row: 1; }
  .rv-nav--next { grid-column: 3; grid-row: 1; }
  .rv-nav:disabled, .rv-step:disabled { opacity: 0.25; cursor: default; transform: none; }

  .rv-foot {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px clamp(12px, 2.4vw, 28px) max(14px, env(safe-area-inset-bottom));
    min-height: 64px;
  }
  .rv-caption {
    grid-column: 2;
    margin: 0;
    text-align: center;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    display: grid;
    gap: 2px;
  }
  .rv-credit { font-size: 12px; color: rgba(255, 255, 255, 0.45); }
  .rv-step {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    display: none;
    place-items: center;
    cursor: pointer;
  }
  .rv-toast {
    position: absolute;
    left: 50%;
    bottom: calc(84px + env(safe-area-inset-bottom));
    transform: translate(-50%, 8px);
    margin: 0;
    padding: 10px 18px;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-size: 14px;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .rv-toast.is-on { opacity: 1; transform: translate(-50%, 0); }

  @media (max-width: 720px) {
    .rv-stage { grid-template-columns: 0 minmax(0, 1fr) 0; }
    .rv-nav { display: none; }
    .rv-step { display: grid; }
    .rv-btn span { display: none; }
    .rv-btn { padding: 0; width: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rp-tile img, .rv-img, .rp-more__btn { transition: none; }
    .rv[open] { animation: none; }
  }
  :global(html.rv-lock) { overflow: hidden; }
</style>

<script>
  /* The photo viewer: one <dialog> per gallery, filled from the tiles */
  type Tile = { el: HTMLAnchorElement; id: string; ar: number; alt: string };

  function initRecapPhotos() {
    document.querySelectorAll<HTMLElement>('[data-rp]').forEach((root) => {
      if (root.dataset.rpReady) return;
      root.dataset.rpReady = '1';

      const base = root.dataset.cfBase || '';
      const fileBase = root.dataset.file || 'photo';
      const label = root.dataset.label || document.title;
      const tiles: Tile[] = [...root.querySelectorAll<HTMLAnchorElement>('[data-rp-open]')].map((el) => ({
        el, id: el.dataset.id || '', ar: Number(el.dataset.ar) || 1.5, alt: el.dataset.alt || '',
      }));
      const dlg = root.querySelector<HTMLDialogElement>('[data-rv]');
      const img = root.querySelector<HTMLImageElement>('[data-rv-img]');
      if (!dlg || !img || !tiles.length) return;
      const pos = dlg.querySelector<HTMLElement>('[data-rv-pos]')!;
      const caption = dlg.querySelector<HTMLElement>('[data-rv-caption]')!;
      const save = dlg.querySelector<HTMLAnchorElement>('[data-rv-save]')!;
      const toast = dlg.querySelector<HTMLElement>('[data-rv-toast]')!;
      const prevs = dlg.querySelectorAll<HTMLButtonElement>('[data-rv-prev]');
      const nexts = dlg.querySelectorAll<HTMLButtonElement>('[data-rv-next]');
      const stage = dlg.querySelector<HTMLElement>('[data-rv-stage]')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let at = 0;
      let toastTimer = 0;

      // Sizes in steps, so neighbors and repeat visits hit the cache
      const viewWidth = (t: Tile) => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const need = Math.max(window.innerWidth, window.innerHeight * t.ar) * dpr;
        return Math.min(2400, Math.ceil(need / 400) * 400);
      };
      const fullUrl = (t: Tile) => `${base}/${t.id}/w=${viewWidth(t)},fit=scale-down,q=86`;
      const saveUrl = (t: Tile) => `${base}/${t.id}/w=3200,fit=scale-down,q=92,format=jpeg`;
      const fileName = (i: number) => `${fileBase}-${String(i + 1).padStart(2, '0')}.jpg`;
      const preload = (i: number) => { const t = tiles[i]; if (t) { const p = new Image(); p.decoding = 'async'; p.src = fullUrl(t); } };

      function showMore() {
        root.querySelectorAll<HTMLElement>('.rp-item[hidden]').forEach((li) => { li.hidden = false; });
        root.querySelector('.rp-more')?.remove();
      }

      function show(i: number) {
        at = Math.max(0, Math.min(tiles.length - 1, i));
        const t = tiles[at];
        // The tile's own picture shows at once; the sharp one replaces it when ready
        const thumb = t.el.querySelector('img');
        img.src = thumb?.currentSrc || thumb?.src || '';
        img.alt = t.alt;
        const sharp = new Image();
        sharp.decoding = 'async';
        sharp.onload = () => { if (tiles[at] === t) img.src = sharp.src; };
        sharp.src = fullUrl(t);
        pos.textContent = String(at + 1);
        caption.textContent = /, photo \d+ of \d+$/.test(t.alt) ? '' : t.alt;
        save.href = saveUrl(t);
        save.setAttribute('download', fileName(at));
        prevs.forEach((b) => { b.disabled = at === 0; });
        nexts.forEach((b) => { b.disabled = at === tiles.length - 1; });
        history.replaceState(history.state, '', `#photo-${at + 1}`);
        preload(at + 1);
        preload(at - 1);
      }

      function open(i: number) {
        if (tiles[i]?.el.closest('li')?.hidden) showMore();
        show(i);
        if (!dlg.open) {
          document.documentElement.classList.add('rv-lock');
          dlg.showModal();
        }
      }

      function step(d: number) {
        const next = at + d;
        if (next < 0 || next >= tiles.length) return;
        if (reduced) { show(next); return; }
        img.style.opacity = '0';
        img.style.transform = `translateX(${d * -24}px)`;
        window.setTimeout(() => {
          show(next);
          img.style.transition = 'none';
          img.style.transform = `translateX(${d * 24}px)`;
          requestAnimationFrame(() => {
            img.style.transition = '';
            img.style.opacity = '1';
            img.style.transform = '';
          });
        }, 120);
      }

      function say(text: string) {
        toast.textContent = text;
        toast.classList.add('is-on');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove('is-on'), 2200);
      }

      // Tiles open the viewer; the link stays for no-JS and new tabs
      tiles.forEach((t, i) => t.el.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        open(i);
      }));
      // The recap hero's photos open the same viewer
      document.querySelectorAll<HTMLAnchorElement>('[data-rp-jump]').forEach((a) => a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        open(Number(a.dataset.rpJump) || 0);
      }));
      root.querySelector('[data-rp-more]')?.addEventListener('click', () => {
        const first = root.querySelector<HTMLElement>('.rp-item[hidden] a');
        showMore();
        first?.focus({ preventScroll: true });
      });

      prevs.forEach((b) => b.addEventListener('click', () => step(-1)));
      nexts.forEach((b) => b.addEventListener('click', () => step(1)));
      dlg.querySelector('[data-rv-close]')?.addEventListener('click', () => dlg.close());
      dlg.addEventListener('close', () => {
        document.documentElement.classList.remove('rv-lock');
        history.replaceState(history.state, '', `${location.pathname}${location.search}`);
        tiles[at]?.el.focus({ preventScroll: true });
        tiles[at]?.el.scrollIntoView({ block: 'nearest' });
      });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
        else if (e.key === 'Home') { e.preventDefault(); show(0); }
        else if (e.key === 'End') { e.preventDefault(); show(tiles.length - 1); }
      });

      // Share: the link to this photo (a phone's own share sheet when it has one)
      dlg.querySelector('[data-rv-share]')?.addEventListener('click', async () => {
        const url = `${location.origin}${location.pathname}#photo-${at + 1}`;
        if (navigator.share) {
          try { await navigator.share({ title: label, text: `${label}, photo ${at + 1}`, url }); } catch { /* closed the sheet */ }
          return;
        }
        try { await navigator.clipboard.writeText(url); say('Link copied'); } catch { say(url); }
      });

      // Save: phones get "Save Image" from their share sheet; computers download the file.
      // Another origin (a local preview) ignores download, so fetch it there.
      save.addEventListener('click', async (e) => {
        const href = save.href;
        const name = save.getAttribute('download') || 'photo.jpg';
        const phone = matchMedia('(pointer: coarse)').matches;
        const sameOrigin = new URL(href).origin === location.origin;
        if (!phone && sameOrigin) return;
        e.preventDefault();
        say('Getting the photo…');
        try {
          const blob = await (await fetch(href)).blob();
          const file = new File([blob], name, { type: blob.type || 'image/jpeg' });
          if (phone && navigator.canShare?.({ files: [file] })) {
            toast.classList.remove('is-on');
            await navigator.share({ files: [file], title: label });
            return;
          }
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = name;
          a.click();
          window.setTimeout(() => URL.revokeObjectURL(a.href), 4000);
          say('Saved');
        } catch (err) {
          if ((err as Error)?.name === 'AbortError') { toast.classList.remove('is-on'); return; }
          window.open(href, '_blank', 'noopener');
          toast.classList.remove('is-on');
        }
      });

      // Swipe left/right for the next photo, down to close
      let sx = 0, sy = 0, dx = 0, dy = 0, dragging = false, pid = -1;
      stage.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' || (e.target as HTMLElement).closest('button')) return;
        dragging = true; pid = e.pointerId; sx = e.clientX; sy = e.clientY; dx = dy = 0;
        img.classList.add('is-dragging');
      });
      stage.addEventListener('pointermove', (e) => {
        if (!dragging || e.pointerId !== pid) return;
        dx = e.clientX - sx; dy = e.clientY - sy;
        if (Math.abs(dx) > Math.abs(dy)) img.style.transform = `translateX(${dx}px)`;
        else if (dy > 0) { img.style.transform = `translateY(${dy}px)`; img.style.opacity = String(Math.max(0.3, 1 - dy / 400)); }
      });
      const end = () => {
        if (!dragging) return;
        dragging = false;
        img.classList.remove('is-dragging');
        img.style.transform = '';
        img.style.opacity = '';
        if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
        else if (dy > 110 && dy > Math.abs(dx)) dlg.close();
      };
      stage.addEventListener('pointerup', end);
      stage.addEventListener('pointercancel', end);

      // A link to one photo (#photo-12) opens it
      const m = location.hash.match(/^#photo-(\d+)$/);
      if (m && tiles[Number(m[1]) - 1]) open(Number(m[1]) - 1);
    });
  }

  document.addEventListener('astro:page-load', initRecapPhotos);
</script>
