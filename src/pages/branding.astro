  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  let _tocCleanup: (() => void) | null = null;

  function cleanupBranding() {
    _tocCleanup?.();
    _tocCleanup = null;
  }

  /* ── Table of contents: scrollspy, sliding marker, click-to-scroll ──
     Deterministic: the active section is the last one whose top has crossed a
     reading line just below the sticky chrome. At the very bottom of the page
     the last section wins, so short final sections can still be reached. */
  function initToc() {
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.brand-section'));
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (!sections.length || !links.length) return;
    const sublinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-sublink]'));
    const subHeads = new Map<string, HTMLElement[]>();
    for (const s of sublinks) {
      const parent = s.dataset.tocParent || '';
      const h = document.getElementById(s.dataset.tocSublink || '');
      if (h) subHeads.set(parent, [...(subHeads.get(parent) || []), h]);
    }

    const ac = new AbortController();
    const { signal } = ac;
    const side = document.querySelector<HTMLElement>('[data-toc-side]');
    const marker = document.querySelector<HTMLElement>('[data-toc-marker]');
    const bar = document.querySelector<HTMLElement>('[data-toc-bar]');
    const strip = document.querySelector<HTMLElement>('[data-toc-strip]');
    const header = document.querySelector<HTMLElement>('.site-header');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const scrollBehavior = (): ScrollBehavior => (reduceMotion.matches ? 'auto' : 'smooth');

    let activeId = '';
    let activeSub: string | null = null;
    let reseatTimer = 0;
    let locked = false;      // true while a click-initiated scroll is in flight
    let navigating = false;  // true inside Astro's navigate(), which fires a synthetic popstate
    let raf = 0;
    let animRaf = 0;

    const barVisible = () => !!bar && getComputedStyle(bar).display !== 'none';
    const chromeBottom = () => {
      const h = header ? header.getBoundingClientRect().bottom : 0;
      return h + (barVisible() && bar ? bar.getBoundingClientRect().height : 0);
    };

    /* Sidebar: keep the active link inside the (possibly scrolled) sidebar and place the marker on it. */
    const offsetInSide = (el: HTMLElement) => {
      if (!side) return { top: 0, height: el.offsetHeight };
      return { top: el.getBoundingClientRect().top - side.getBoundingClientRect().top + side.scrollTop, height: el.offsetHeight };
    };
    const updateSideFades = () => {
      if (!side) return;
      side.classList.toggle('fade-top', side.scrollTop > 4);
      side.classList.toggle('fade-bottom', side.scrollTop + side.clientHeight < side.scrollHeight - 4);
    };
    const placeMarker = (link: HTMLElement, instant: boolean, shift = 0) => {
      if (!marker || !side) return;
      const m = offsetInSide(link);
      const top = m.top + shift;
      const height = m.height;
      if (instant) marker.classList.add('no-anim');
      marker.style.setProperty('--y', `${Math.round(top)}px`);
      marker.style.setProperty('--h', `${Math.round(height)}px`);
      marker.classList.add('is-ready');
      if (instant) { void marker.offsetHeight; marker.classList.remove('no-anim'); }
      // Reveal inside the sidebar without touching window scroll.
      const pad = 12;
      if (top < side.scrollTop + pad) side.scrollTo({ top: Math.max(0, top - pad), behavior: instant ? 'auto' : scrollBehavior() });
      else if (top + height > side.scrollTop + side.clientHeight - pad) side.scrollTo({ top: top + height - side.clientHeight + pad, behavior: instant ? 'auto' : scrollBehavior() });
    };

    /* Pill bar: center the active pill and keep the edge fades honest. */
    const updateStripFades = () => {
      if (!bar || !strip) return;
      bar.classList.toggle('at-start', strip.scrollLeft <= 2);
      bar.classList.toggle('at-end', strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 2);
    };
    const centerPill = (pill: HTMLElement, instant: boolean) => {
      if (!strip || !barVisible()) return;
      const left = pill.getBoundingClientRect().left - strip.getBoundingClientRect().left + strip.scrollLeft;
      const target = left + pill.offsetWidth / 2 - strip.clientWidth / 2;
      strip.scrollTo({ left: Math.max(0, target), behavior: instant ? 'auto' : scrollBehavior() });
    };

    /* The sidebar's current row is the sub-link when a sub-heading has been reached,
       otherwise the section link. The pill bar only knows sections. */
    const currentEl = () =>
      (activeSub && sublinks.find(s => s.dataset.tocSublink === activeSub)) ||
      links.find(l => l.classList.contains('sidebar-link') && l.dataset.tocLink === activeId) || null;
    const subBox = (id: string) => document.querySelector<HTMLElement>(`[data-toc-sub="${id}"] > ul`);
    const reseat = () => { const el = currentEl(); if (el) placeMarker(el, false); updateSideFades(); };
    const setActive = (id: string, sub: string | null, instant = false) => {
      if (id === activeId && sub === activeSub) return;
      const prevId = activeId;
      activeId = id;
      activeSub = sub;
      for (const a of links) {
        const isSide = a.classList.contains('sidebar-link');
        const on = a.dataset.tocLink === id && (!isSide || sub === null);
        a.classList.toggle('active', on);
        if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
        if (isSide) a.closest('.sidebar-item')?.classList.toggle('is-open', a.dataset.tocLink === id);
        if (on && !isSide) centerPill(a, instant);
      }
      for (const s of sublinks) {
        const on = s.dataset.tocSublink === sub;
        s.classList.toggle('active', on);
        if (on) s.setAttribute('aria-current', 'location'); else s.removeAttribute('aria-current');
      }
      const el = currentEl();
      if (!el) return;
      // Groups above the target are mid-collapse/expand: aim the marker at the settled layout.
      let shift = 0;
      if (prevId !== id) {
        const closing = prevId ? subBox(prevId) : null;
        const opening = subBox(id);
        const below = (box: HTMLElement) => !box.contains(el) && !!(box.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING);
        if (closing && below(closing)) shift -= closing.getBoundingClientRect().height;
        if (opening && below(opening)) shift += opening.scrollHeight - opening.getBoundingClientRect().height;
      }
      placeMarker(el, instant, shift);
      if (prevId !== id) { clearTimeout(reseatTimer); reseatTimer = window.setTimeout(reseat, 360); }
    };
    side?.addEventListener('transitionend', (e) => { if ((e.target as HTMLElement).classList?.contains('sidebar-sub')) reseat(); }, { signal });

    const compute = () => {
      const doc = document.documentElement;
      if (window.scrollY + window.innerHeight >= doc.scrollHeight - 2) return { id: sections[sections.length - 1].id, sub: null };
      const cb = chromeBottom();
      const line = cb + Math.min(120, (window.innerHeight - cb) * 0.25) + 1;
      let current = sections[0].id;
      for (const s of sections) {
        if (s.getBoundingClientRect().top <= line) current = s.id; else break;
      }
      let sub: string | null = null;
      for (const h of subHeads.get(current) || []) {
        if (h.getBoundingClientRect().top <= line) sub = h.id; else break;
      }
      return { id: current, sub };
    };
    const sync = (instant = false) => { const c = compute(); setActive(c.id, c.sub, instant); };
    const onScroll = () => {
      if (locked || raf) return;
      raf = requestAnimationFrame(() => { raf = 0; sync(); });
    };

    /* Click. Astro's router owns history: its same-page hash navigation runs synchronously
       and lands the section exactly where scroll-padding + scroll-margin put it. We take
       that landing as the destination, restore the origin before anything paints, and let
       the browser glide between the two in one smooth scroll (one scroll, one scrollend,
       one history update). The spy stays locked until we arrive, so passing sections never
       flicker through the sidebar. Any user input cancels the ride. */
    const instant = 'instant' as ScrollBehavior;
    const stopAnim = () => { cancelAnimationFrame(animRaf); animRaf = 0; };
    const unlock = () => { stopAnim(); locked = false; sync(); };
    const rideTo = (target: HTMLElement, startY: number, endY: number, expectedTop: number) => {
      if (Math.abs(endY - startY) < 2) { unlock(); return; }
      window.scrollTo({ top: endY, behavior: 'smooth' });
      const t0 = performance.now();
      let last = window.scrollY;
      let still = 0;
      const watch = (now: number) => {
        const y = window.scrollY;
        const arrived = Math.abs(y - endY) < 1;
        still = Math.abs(y - last) < 0.5 ? still + 1 : 0;
        last = y;
        if (arrived || (still >= 6 && now - t0 > 250) || now - t0 > 1800) {
          // Final seat: correct for anything that shifted while we were moving (image loads).
          const drift = target.getBoundingClientRect().top - expectedTop;
          if (arrived && Math.abs(drift) > 1) window.scrollTo({ top: window.scrollY + drift, behavior: instant });
          animRaf = 0;
          unlock();
          return;
        }
        animRaf = requestAnimationFrame(watch);
      };
      animRaf = requestAnimationFrame(watch);
    };
    for (const a of [...links, ...sublinks]) {
      a.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        const id = a.dataset.tocLink || a.dataset.tocSublink || '';
        const target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        stopAnim();
        const startY = window.scrollY;
        navigating = true;
        navigate(`#${id}`);                                   // sync: history entry + native jump
        navigating = false;
        locked = true;
        setActive(a.dataset.tocParent || id, a.dataset.tocSublink || null);
        const endY = window.scrollY;                            // exact landing, per the CSS offsets
        const expectedTop = target.getBoundingClientRect().top; // section's seat at that landing
        if (scrollBehavior() === 'auto') { unlock(); return; }
        window.scrollTo({ top: startY, behavior: instant });    // same task: nothing has painted yet
        rideTo(target, startY, endY, expectedTop);
      }, { signal });
    }
    const cancelOnInput = () => { if (animRaf) unlock(); };
    window.addEventListener('wheel', cancelOnInput, { passive: true, signal });
    window.addEventListener('touchstart', cancelOnInput, { passive: true, signal });
    window.addEventListener('keydown', (e) => { if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(e.key)) cancelOnInput(); }, { signal });

    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', () => { updateSideFades(); updateStripFades(); const el = currentEl(); if (el) placeMarker(el, true); }, { passive: true, signal });
    const onHistory = () => { if (!navigating) unlock(); };
    window.addEventListener('popstate', onHistory, { signal });
    window.addEventListener('hashchange', onHistory, { signal });
    side?.addEventListener('scroll', updateSideFades, { passive: true, signal });
    strip?.addEventListener('scroll', updateStripFades, { passive: true, signal });

    updateSideFades();
    updateStripFades();
    sync(true);
    // Fonts settle a beat after load; re-seat the marker once they do.
    document.fonts?.ready.then(() => { const el = currentEl(); if (el) placeMarker(el, true); updateSideFades(); });

    _tocCleanup = () => { ac.abort(); cancelAnimationFrame(raf); stopAnim(); clearTimeout(reseatTimer); };
  }

  function initBranding() {
    const cards = document.querySelectorAll('.color-card');
    if (!cards.length) return;

    cleanupBranding();
    initToc();

    cards.forEach(card=>{card.addEventListener('click',()=>{const hex=(card as HTMLElement).dataset.hex;navigator.clipboard.writeText(hex!);let toast=document.querySelector('.brand-toast');if(!toast){toast=document.createElement('div');toast.className='brand-toast';document.body.appendChild(toast)}toast.textContent=`Copied ${hex}`;toast.classList.add('visible');setTimeout(()=>toast.classList.remove('visible'),2000)})});

    // Copy buttons on media cards
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.media-card');
        if (!card) return;
        const textEl = card.querySelector('.media-copy-text');
        if (!textEl) return;
        const text = (textEl as HTMLElement).innerText.trim();
        navigator.clipboard.writeText(text);
        btn.classList.add('copied');
        btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Copied!';
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>Copy';
        }, 2000);
      });
    });

  }

  document.addEventListener('astro:page-load', initBranding);
  document.addEventListener('astro:before-swap', cleanupBranding);
</script>
