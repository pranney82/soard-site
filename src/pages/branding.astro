  /* Toast */
  :global(.brand-toast){position:fixed;bottom:32px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--c-dark-deep);color:#fff;padding:12px 24px;border-radius:10px;font-size:14px;font-weight:500;opacity:0;pointer-events:none;transition:all .3s ease;z-index:999;box-shadow:0 8px 32px rgba(0,0,0,.2)}
  :global(.brand-toast.visible){opacity:1;transform:translateX(-50%) translateY(0)}

  /* ═══ RESPONSIVE ═══ */
  @media(max-width:1024px){.brand-sidebar{display:none}.brand-layout{padding:32px 20px 48px}.logo-grid-3{grid-template-columns:repeat(3,1fr)}.brand-mobile-nav{display:block}.brand-section,.brand-section h3[id]{scroll-margin-top:calc(var(--brand-nav-h,52px) + 8px)}}
