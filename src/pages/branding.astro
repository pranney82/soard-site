<style>
  /* ═══ HERO ═══ */
  .brand-hero{background:var(--c-cream);padding:80px 24px 60px;text-align:center}
  .brand-hero-label{font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:#8A7200;margin-bottom:16px}
  .brand-hero h1{font-size:clamp(2.5rem,5vw,3.75rem);font-weight:300;color:var(--c-dark);margin-bottom:16px;letter-spacing:-.02em;line-height:1.15}
  .brand-hero-sub{font-size:clamp(1.1rem,2vw,1.35rem);color:rgba(55,58,54,.85);max-width:600px;margin:0 auto 32px;line-height:1.6}
  .brand-hero-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .hero-btn{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:100px;font-size:14px;font-weight:600;text-decoration:none;transition:all .2s ease;border:none;cursor:pointer}
  .hero-btn-primary{background:var(--c-yellow);color:var(--c-dark)}
  .hero-btn-primary:hover{filter:brightness(1.05);box-shadow:0 4px 16px rgba(255,218,36,.35);transform:translateY(-1px)}

  /* ═══ LAYOUT ═══ */
  .brand-layout{--toc-top:calc(var(--header-height) + 12px);max-width:1280px;margin:0 auto;padding:48px 24px 64px;display:flex;gap:48px}
  .brand-sidebar{width:224px;flex-shrink:0}

  /* Sticky sidebar. Fits any viewport height: scrolls internally, hidden scrollbar,
     edge fades (.fade-top/.fade-bottom set by script) signal overflow. */
  .sidebar-inner{position:sticky;top:var(--toc-top);max-height:calc(100vh - var(--toc-top) - 24px);max-height:calc(100dvh - var(--toc-top) - 24px);overflow-y:auto;overscroll-behavior:contain;scrollbar-width:none;padding:4px 8px 8px 0;isolation:isolate}
  .sidebar-inner::-webkit-scrollbar{display:none}
  .sidebar-inner.fade-bottom{-webkit-mask-image:linear-gradient(to bottom,#000 calc(100% - 40px),transparent);mask-image:linear-gradient(to bottom,#000 calc(100% - 40px),transparent)}
  .sidebar-inner.fade-top{-webkit-mask-image:linear-gradient(to bottom,transparent,#000 40px);mask-image:linear-gradient(to bottom,transparent,#000 40px)}
  .sidebar-inner.fade-top.fade-bottom{-webkit-mask-image:linear-gradient(to bottom,transparent,#000 40px,#000 calc(100% - 40px),transparent);mask-image:linear-gradient(to bottom,transparent,#000 40px,#000 calc(100% - 40px),transparent)}
  .sidebar-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(55,58,54,.5);padding:0 0 0 26px;margin:0 0 18px}
  .sidebar-group{margin-bottom:22px}
  .sidebar-group:last-of-type{margin-bottom:0}
  .sidebar-group-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--c-dark);padding:0 0 0 26px;margin:0 0 8px}
  .sidebar-list{position:relative;list-style:none;margin:0;padding:0 0 0 14px;display:flex;flex-direction:column;gap:2px}
  .sidebar-list::before{content:"";position:absolute;left:0;top:4px;bottom:4px;width:2px;border-radius:2px;background:rgba(55,58,54,.1)}
  .sidebar-link{display:flex;align-items:center;min-height:36px;padding:7px 12px;font-size:14px;font-weight:500;line-height:1.3;color:rgba(55,58,54,.68);border-radius:8px;text-decoration:none;transition:color .15s ease,background-color .15s ease}
  .sidebar-link:hover{color:var(--c-dark);background:rgba(55,58,54,.05)}
  .sidebar-link.active{color:var(--c-dark);background:rgba(255,218,36,.16)}
  .sidebar-link:focus-visible{position:relative;z-index:1}
  .sidebar-item.is-open>.sidebar-link{color:var(--c-dark)}
  /* Sub-sections reveal under the active section (grid-rows trick: animatable auto height). */
  .sidebar-sub{display:grid;grid-template-rows:0fr;transition:grid-template-rows .32s cubic-bezier(.32,.72,0,1)}
  .sidebar-item.is-open>.sidebar-sub{grid-template-rows:1fr}
  .sidebar-sub-list{list-style:none;margin:0;padding:0;min-height:0;overflow:hidden;display:flex;flex-direction:column;gap:1px}
  .sidebar-sub-list>li:first-child{padding-top:2px}
  .sidebar-sub-list>li:last-child{padding-bottom:6px}
  .sidebar-sublink{display:flex;align-items:center;min-height:32px;padding:5px 12px 5px 24px;font-size:13px;font-weight:500;line-height:1.3;color:rgba(55,58,54,.62);border-radius:8px;text-decoration:none;transition:color .15s ease,background-color .15s ease}
  .sidebar-sublink:hover{color:var(--c-dark);background:rgba(55,58,54,.05)}
  .sidebar-sublink.active{color:var(--c-dark);background:rgba(255,218,36,.16)}
  .sidebar-sublink:focus-visible{position:relative;z-index:1}
  @media(pointer:coarse){.sidebar-link{min-height:44px}.sidebar-sublink{min-height:40px}}
  /* Sliding yellow marker. Script sets --y and --h; it rides the same x as the rails. */
  .sidebar-marker{position:absolute;left:0;top:0;width:3px;height:var(--h,0px);border-radius:3px;background:var(--c-yellow);transform:translate(-.5px,var(--y,0px));opacity:0;pointer-events:none;z-index:1;transition:transform .32s cubic-bezier(.32,.72,0,1),height .32s cubic-bezier(.32,.72,0,1),opacity .2s ease}
  .sidebar-marker.is-ready{opacity:1}
  .sidebar-marker.no-anim{transition:none}
  .sidebar-download{display:flex;align-items:center;gap:10px;margin:22px 0 0 14px;padding:10px 12px;border:1px solid rgba(55,58,54,.12);border-radius:10px;background:#fff;color:var(--c-dark);text-decoration:none;transition:border-color .15s ease,background-color .15s ease,box-shadow .15s ease}
  .sidebar-download:hover{border-color:var(--c-yellow);background:rgba(255,218,36,.1);box-shadow:0 2px 10px rgba(255,218,36,.2)}
  .sidebar-download-icon{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--c-yellow);flex-shrink:0}
  .sidebar-download-text{display:flex;flex-direction:column;font-size:13px;font-weight:600;line-height:1.25}
  .sidebar-download-text small{font-size:11px;font-weight:500;color:rgba(55,58,54,.6);letter-spacing:.02em;margin-top:2px}

  /* Pill bar (tablet + phone). Height in --brand-nav-h keeps anchor offsets in sync. */
  .brand-mobile-nav{--brand-nav-h:52px;display:none;position:sticky;top:var(--header-height);z-index:90;background:var(--c-cream,#FEFCF5);border-bottom:1px solid rgba(55,58,54,.08)}
  .brand-mobile-nav::before,.brand-mobile-nav::after{content:"";position:absolute;top:0;bottom:1px;width:40px;pointer-events:none;z-index:1;transition:opacity .2s ease}
  .brand-mobile-nav::before{left:0;background:linear-gradient(to right,var(--c-cream,#FEFCF5) 30%,rgba(254,252,245,0))}
  .brand-mobile-nav::after{right:0;background:linear-gradient(to left,var(--c-cream,#FEFCF5) 30%,rgba(254,252,245,0))}
  .brand-mobile-nav.at-start::before,.brand-mobile-nav.at-end::after{opacity:0}
  .mobile-nav-scroll{display:flex;align-items:center;gap:6px;height:var(--brand-nav-h);padding:0 16px;margin:0;list-style:none;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;-ms-overflow-style:none}
  .mobile-nav-scroll::-webkit-scrollbar{display:none}
  .mobile-nav-item{display:flex;flex-shrink:0}
  .mobile-nav-item:last-child{padding-right:16px}
  .mobile-nav-group-start{position:relative;margin-left:8px;padding-left:10px}
  .mobile-nav-group-start::before{content:"";position:absolute;left:0;top:50%;width:1px;height:18px;transform:translateY(-50%);background:rgba(55,58,54,.18)}
  .mobile-nav-link{position:relative;display:flex;align-items:center;min-height:36px;padding:0 14px;font-size:13px;font-weight:600;line-height:1;color:rgba(55,58,54,.8);background:rgba(55,58,54,.05);border-radius:100px;text-decoration:none;white-space:nowrap;transition:background-color .15s ease,color .15s ease}
  .mobile-nav-link::after{content:"";position:absolute;inset:-8px 0} /* 52px tall hit area on a 36px pill */
  .mobile-nav-link:hover{background:rgba(55,58,54,.09);color:var(--c-dark)}
  .mobile-nav-link.active{background:var(--c-yellow);color:var(--c-dark)}

  /* Content area */
  .brand-content{flex:1;min-width:0;max-width:900px}
  .brand-section{margin-bottom:80px;scroll-margin-top:16px}
