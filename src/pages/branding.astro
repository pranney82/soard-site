---
/* noindex: brand assets page is for partners/press, not search traffic */
import BaseLayout from '../layouts/BaseLayout.astro';
import media from '../content/site/media.json';
import { getSiteStats } from '../utils/stats';

const stats = await getSiteStats();

const founderParagraphs = media.founderStory.split('\n\n');

/* tiny svg string reused in download buttons */
const dlIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>`;
const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;

/* Cloudflare Images — imagedelivery.net auto-negotiates AVIF/WebP via Accept header */
import { cfRaw, cfSrcset as _cfSrcset, cfLqip } from '../utils/cf-image';
const cfSrc = (id: string, w: number) => cfRaw(id, `w=${w},q=85`);
const cfSrcset = (id: string, widths: number[]) => _cfSrcset(id, widths);

/* Display image IDs on CF Images */
const logos = {
  lightTagline: 'brand-logo-light-bg-tagline-display',
  darkTagline:  'brand-logo-dark-bg-tagline-display',
  circleTagline:'brand-logo-circle-tagline-display',
  light:        'brand-logo-light-bg-display',
  dark:         'brand-logo-dark-bg-display',
  circle:       'brand-logo-circle-display',
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Brand & Media Kit', url: '/branding/' },
];

/* Table of contents. One source feeds the desktop sidebar and the mobile pill bar.
   `label` is the sidebar text, `short` is the pill text. `sub` entries are the
   section's h3 sub-headings; the sidebar reveals them while that section is active. */
const toc = [
  { group: 'Media Kit', items: [
    { id: 'media-bio',      label: 'Bio & Overview',   short: 'Bio' },
    { id: 'media-impact',   label: 'Impact Stats',     short: 'Impact' },
    { id: 'media-mission',  label: 'Mission',          short: 'Mission' },
    { id: 'media-founders', label: "Founder's Story",  short: 'Founders' },
    { id: 'media-photos',   label: 'Photography',      short: 'Photos' },
    { id: 'media-contact',  label: 'Contact & Social', short: 'Contact' },
  ]},
  { group: 'Brand Guidelines', items: [
    { id: 'logos',        label: 'Logos',        short: 'Logos',
      sub: [{ id: 'logos-primary', label: 'Primary Logos' }, { id: 'logos-alternate', label: 'Alternate Logos' }] },
    { id: 'logo-usage',   label: 'Logo Usage',   short: 'Usage',
      sub: [{ id: 'usage-guidelines', label: 'Logo Guidelines' }, { id: 'usage-examples', label: 'Visual Examples' }] },
    { id: 'colors',       label: 'Colors',       short: 'Colors' },
    { id: 'typography',   label: 'Typography',   short: 'Typography',
      sub: [{ id: 'type-web', label: 'Web Fonts' }, { id: 'type-print', label: 'Print & Brand Fonts' }] },
    { id: 'naming',       label: 'Naming',       short: 'Naming' },
    { id: 'voice',        label: 'Voice & Tone', short: 'Voice' },
    { id: 'social-specs', label: 'Social Specs', short: 'Social Specs' },
  ]},
];
const kitSize = '2.6 MB'; /* public/SOARD-Logo-Kit.zip */

const jsonLd = {
  '@type': 'WebPage',
  name: 'Brand & Media Kit — Sunshine on a Ranney Day',
  description: media.metaDescription,
  mainEntity: {
    '@type': 'Organization',
    name: 'Sunshine on a Ranney Day',
    url: 'https://sunshineonaranneyday.com',
  },
};
---
<BaseLayout title="Brand & Media Kit" description={media.metaDescription} breadcrumbs={breadcrumbs} jsonLd={jsonLd} noindex={true}>

  <!-- ═══ DARK HERO ═══ -->
  <section class="brand-hero">
    <div class="container">
      <p class="brand-hero-label">Brand & Media Resources</p>
      <h1>Brand & Media Kit</h1>
      <p class="brand-hero-sub">Official brand assets, logos, and press-ready information for representing Sunshine on a Ranney Day.</p>
      <div class="brand-hero-actions">
        <a href="/SOARD-Logo-Kit.zip" download class="hero-btn hero-btn-primary" aria-label="Download full media kit ZIP">
          <Fragment set:html={dlIcon} />Download Full Media Kit
        </a>
      </div>
    </div>
  </section>

  <!-- Tablet + phone: sticky pill bar (shown at 1024px and below) -->
  <nav class="brand-mobile-nav" aria-label="On this page" data-toc-bar>
    <ul class="mobile-nav-scroll" data-toc-strip>
      {toc.map((g, gi) => g.items.map((item, i) => (
        <li class:list={['mobile-nav-item', { 'mobile-nav-group-start': gi > 0 && i === 0 }]}>
          <a href={`#${item.id}`} class="mobile-nav-link" data-toc-link={item.id}>{item.short}</a>
        </li>
      )))}
    </ul>
  </nav>

  <div class="brand-layout">
    <nav class="brand-sidebar" aria-label="On this page">
      <div class="sidebar-inner" data-toc-side>
        <p class="sidebar-label">Contents</p>
        <span class="sidebar-marker" data-toc-marker aria-hidden="true"></span>
        {toc.map(g => (
          <div class="sidebar-group">
            <p class="sidebar-group-label">{g.group}</p>
            <ul class="sidebar-list">
              {g.items.map(item => (
                <li class="sidebar-item">
                  <a href={`#${item.id}`} class="sidebar-link" data-toc-link={item.id}>{item.label}</a>
                  {item.sub && (
                    <div class="sidebar-sub" data-toc-sub={item.id}>
                      <ul class="sidebar-sub-list">
                        {item.sub.map(s => (
                          <li><a href={`#${s.id}`} class="sidebar-sublink" data-toc-sublink={s.id} data-toc-parent={item.id}>{s.label}</a></li>
                        ))}
                      </ul>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
        <a href="/SOARD-Logo-Kit.zip" download class="sidebar-download" aria-label={`Download logo kit, ZIP, ${kitSize}`}>
          <span class="sidebar-download-icon" aria-hidden="true"><Fragment set:html={dlIcon} /></span>
          <span class="sidebar-download-text">Download logo kit<small>ZIP · {kitSize}</small></span>
        </a>
      </div>
    </nav>

    <div class="brand-content">

      <!-- ═══ MEDIA KIT — moved to top ═══ -->

      <section id="media-bio" class="brand-section">
        <h2>Bio & Overview</h2>
        <p class="section-desc">Press-ready organization information. Click any block to copy text to clipboard.</p>

        <div class="media-card" data-copy>
          <div class="media-card-header">
            <h3>Organization Bio</h3>
            <button class="copy-btn" aria-label="Copy to clipboard"><Fragment set:html={copyIcon} />Copy</button>
          </div>
          <p class="media-copy-text">{media.bio.boilerplate}</p>
        </div>

        <div class="media-details-grid">
          <div class="media-detail">
            <span class="media-detail-label">Organization</span>
            <span class="media-detail-value">{media.bio.orgName}</span>
          </div>
          <div class="media-detail">
            <span class="media-detail-label">Founded</span>
            <span class="media-detail-value">{media.bio.founded}</span>
          </div>
          <div class="media-detail">
            <span class="media-detail-label">Founders</span>
            <span class="media-detail-value">{media.bio.founders}</span>
          </div>
          <div class="media-detail">
            <span class="media-detail-label">Location</span>
            <span class="media-detail-value">{media.bio.location}</span>
          </div>
          <div class="media-detail">
            <span class="media-detail-label">EIN</span>
            <span class="media-detail-value">{media.bio.ein}</span>
          </div>
          <div class="media-detail">
            <span class="media-detail-label">Website</span>
            <span class="media-detail-value">{media.bio.website}</span>
          </div>
        </div>
      </section>

      <section id="media-impact" class="brand-section">
        <h2>Impact Stats</h2>
        <p class="section-desc">Key numbers for press materials, grant applications, and partnership proposals.</p>

        <div class="impact-stats-grid">
          <div class="impact-stat-card">
            <span class="impact-stat-num">{stats.totalRooms}+</span>
            <span class="impact-stat-label">Room Makeovers</span>
          </div>
          <div class="impact-stat-card">
            <span class="impact-stat-num">{stats.totalKids}+</span>
            <span class="impact-stat-label">Children Served</span>
          </div>
          <div class="impact-stat-card">
            <span class="impact-stat-num">{stats.years}</span>
            <span class="impact-stat-label">Years of Impact</span>
          </div>
          <div class="impact-stat-card impact-stat-card--highlight">
            <span class="impact-stat-num">$0</span>
            <span class="impact-stat-label">Cost to Families</span>
            <span class="impact-stat-sub">every makeover is 100% free</span>
          </div>
        </div>

        <div class="info-box"><p><strong>Note:</strong> These numbers are auto-calculated from our records and stay current. Feel free to use them in press materials. They reflect our impact as of today.</p></div>
      </section>

      <section id="media-mission" class="brand-section">
        <h2>Mission Statement</h2>
        <p class="section-desc">Our official mission statement for press materials and publications.</p>

        <div class="media-card" data-copy>
          <div class="media-card-header">
            <h3>Mission</h3>
            <button class="copy-btn" aria-label="Copy to clipboard"><Fragment set:html={copyIcon} />Copy</button>
          </div>
          <p class="media-copy-text">{media.mission}</p>
        </div>

        <div class="media-card" data-copy>
          <div class="media-card-header">
            <h3>Who We Are</h3>
            <button class="copy-btn" aria-label="Copy to clipboard"><Fragment set:html={copyIcon} />Copy</button>
          </div>
          <p class="media-copy-text">{media.who}</p>
        </div>
      </section>

      <section id="media-founders" class="brand-section">
        <h2>Founder's Story</h2>
        <p class="section-desc">Background on how Sunshine on a Ranney Day began.</p>

        <div class="media-card" data-copy>
          <div class="media-card-header">
            <h3>Founder's Story</h3>
            <button class="copy-btn" aria-label="Copy to clipboard"><Fragment set:html={copyIcon} />Copy</button>
          </div>
          <div class="media-copy-text">
            {founderParagraphs.map((p: string) => <p>{p}</p>)}
          </div>
        </div>
      </section>

      {(media.brandingPhotos?.length ?? 0) > 0 && (
        <section id="media-photos" class="brand-section">
          <div class="section-header-row">
            <div>
              <h2>Photography</h2>
              <p>Press-ready photos from our makeovers. Download individually or grab the full set.</p>
            </div>
            <a href="/api/download-branding-photos" download class="download-all-btn" aria-label="Download all branding photos as ZIP">
              <Fragment set:html={dlIcon} />Download All Photos
            </a>
          </div>

          <div class="branding-photos-grid">
            {media.brandingPhotos.map((bp: { cfId: string; caption: string; kidSlug: string }, i: number) => (
              <div class="branding-photo-card">
                <div class="branding-photo-wrap" style={`background-image:url(${cfLqip(bp.cfId)});background-size:cover;background-position:center`}>
                  <img
                    src={cfRaw(bp.cfId, 'w=600,q=85,fit=cover,gravity=face')}
                    srcset={_cfSrcset(bp.cfId, [400, 600, 900], { fit: 'cover', gravity: 'face' })}
                    sizes="(max-width: 768px) 90vw, (max-width: 1024px) 45vw, 420px"
                    alt={bp.caption || 'SOARD makeover photo'}
                    width="600"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  />
                </div>
                <div class="branding-photo-footer">
                  {bp.caption && <p class="branding-photo-caption">{bp.caption}</p>}
                  <a href={`/api/download-branding-photos?photo=${i}`} download class="branding-photo-dl" aria-label={`Download photo of ${bp.caption || 'makeover'}`}>
                    <Fragment set:html={dlIcon} />
                  </a>
                </div>
              </div>
            ))}
          </div>

          <div class="info-box" style="margin-top:24px;">
            <p><strong>Usage:</strong> These photos are provided for press, media, and editorial use in connection with coverage of Sunshine on a Ranney Day. Each download includes a <code>credits.txt</code> with photographer attribution and usage rights. For additional images or specific requests, contact <a href={`mailto:${media.contactEmail}`}>{media.contactEmail}</a>.</p>
          </div>
        </section>
      )}

      <section id="media-contact" class="brand-section">
        <h2>Contact & Social</h2>
        <p class="section-desc">Official contact information and social media links for press inquiries.</p>

        <div class="media-details-grid">
          <div class="media-detail">
            <span class="media-detail-label">Press Contact</span>
            <span class="media-detail-value"><a href={`mailto:${media.contactEmail}`}>{media.contactEmail}</a></span>
          </div>
          {media.socialLinks.facebook && (
            <div class="media-detail">
              <span class="media-detail-label">Facebook</span>
              <span class="media-detail-value"><a href={media.socialLinks.facebook} target="_blank" rel="noopener">{media.socialLinks.facebook.replace('https://www.facebook.com/', 'facebook.com/')}</a></span>
            </div>
          )}
          {media.socialLinks.instagram && (
            <div class="media-detail">
              <span class="media-detail-label">Instagram</span>
              <span class="media-detail-value"><a href={media.socialLinks.instagram} target="_blank" rel="noopener">{media.socialLinks.instagram.replace('https://www.instagram.com/', 'instagram.com/')}</a></span>
            </div>
          )}
          {media.socialLinks.youtube && (
            <div class="media-detail">
              <span class="media-detail-label">YouTube</span>
              <span class="media-detail-value"><a href={media.socialLinks.youtube} target="_blank" rel="noopener">YouTube Channel</a></span>
            </div>
          )}
        </div>
      </section>

      <!-- ═══ BRAND GUIDELINES ═══ -->

      <div class="brand-divider">
        <span class="brand-divider-label">Brand Guidelines</span>
      </div>

      <section id="logos" class="brand-section">
        <div class="section-header-row">
          <div><h2>Logos</h2><p>Download our official logos in various formats and variations.</p></div>
          <a href="/SOARD-Logo-Kit.zip" download class="download-all-btn" aria-label="Download all logo assets as ZIP"><Fragment set:html={dlIcon} />Download All Logos</a>
        </div>

        <h3 class="logo-subhead" id="logos-primary">Primary Logos</h3>
        <p class="section-desc">Main logos with the "Dreams Built Here" tagline.</p>
        <div class="logo-grid logo-grid-3">
          <div class="card"><div class="card-preview bg-light"><img src={cfSrc(logos.lightTagline, 400)} srcset={cfSrcset(logos.lightTagline, [200, 400, 600])} sizes="(max-width: 768px) 80vw, 200px" alt="Sunshine on a Ranney Day logo with Dreams Built Here tagline on white background" class="logo-img" width="600" height="600" loading="lazy" decoding="async"/></div><div class="card-body"><h3>White Background</h3><p>Logo with tagline for light backgrounds</p><div class="btn-row"><a href="/api/download-logo?id=brand-logo-light-bg-tagline-download" download class="dl-btn" aria-label="Download white background logo with tagline as PNG"><Fragment set:html={dlIcon} />PNG</a></div></div></div>
          <div class="card"><div class="card-preview bg-dark"><img src={cfSrc(logos.darkTagline, 400)} srcset={cfSrcset(logos.darkTagline, [200, 400, 600])} sizes="(max-width: 768px) 80vw, 200px" alt="Sunshine on a Ranney Day logo with Dreams Built Here tagline on dark background" class="logo-img" width="600" height="600" loading="lazy" decoding="async"/></div><div class="card-body"><h3>Dark Background</h3><p>Logo with tagline for dark backgrounds</p><div class="btn-row"><a href="/api/download-logo?id=brand-logo-dark-bg-tagline-download" download class="dl-btn" aria-label="Download dark background logo with tagline as PNG"><Fragment set:html={dlIcon} />PNG</a></div></div></div>
          <div class="card"><div class="card-preview bg-light"><img src={cfSrc(logos.circleTagline, 400)} srcset={cfSrcset(logos.circleTagline, [200, 400, 600])} sizes="(max-width: 768px) 80vw, 200px" alt="Sunshine on a Ranney Day circle logo with Dreams Built Here tagline" class="logo-img logo-img-circle" width="600" height="600" loading="lazy" decoding="async"/></div><div class="card-body"><h3>Circle</h3><p>Circle logo with tagline</p><div class="btn-row"><a href="/api/download-logo?id=brand-logo-circle-tagline-download" download class="dl-btn" aria-label="Download circle logo with tagline as PNG"><Fragment set:html={dlIcon} />PNG</a></div></div></div>
        </div>

        <h3 class="logo-subhead" id="logos-alternate">Alternate Logos</h3>
        <p class="section-desc">Logos without the tagline for smaller uses.</p>
        <div class="logo-grid logo-grid-3">
          <div class="card"><div class="card-preview bg-light"><img src={cfSrc(logos.light, 400)} srcset={cfSrcset(logos.light, [200, 400, 600])} sizes="(max-width: 768px) 80vw, 200px" alt="Sunshine on a Ranney Day logo without tagline on white background" class="logo-img" width="600" height="600" loading="lazy" decoding="async"/></div><div class="card-body"><h3>White Background</h3><p>Logo without tagline for light backgrounds</p><div class="btn-row"><a href="/api/download-logo?id=brand-logo-light-bg-download" download class="dl-btn" aria-label="Download white background logo without tagline as PNG"><Fragment set:html={dlIcon} />PNG</a></div></div></div>
          <div class="card"><div class="card-preview bg-dark"><img src={cfSrc(logos.dark, 400)} srcset={cfSrcset(logos.dark, [200, 400, 600])} sizes="(max-width: 768px) 80vw, 200px" alt="Sunshine on a Ranney Day logo without tagline on dark background" class="logo-img" width="600" height="600" loading="lazy" decoding="async"/></div><div class="card-body"><h3>Dark Background</h3><p>Logo without tagline for dark backgrounds</p><div class="btn-row"><a href="/api/download-logo?id=brand-logo-dark-bg-download" download class="dl-btn" aria-label="Download dark background logo without tagline as PNG"><Fragment set:html={dlIcon} />PNG</a></div></div></div>
          <div class="card"><div class="card-preview bg-light"><img src={cfSrc(logos.circle, 400)} srcset={cfSrcset(logos.circle, [200, 400, 600])} sizes="(max-width: 768px) 80vw, 200px" alt="Sunshine on a Ranney Day circle logo without tagline" class="logo-img logo-img-circle" width="600" height="600" loading="lazy" decoding="async"/></div><div class="card-body"><h3>Circle</h3><p>Circle logo without tagline</p><div class="btn-row"><a href="/api/download-logo?id=brand-logo-circle-download" download class="dl-btn" aria-label="Download circle logo without tagline as PNG"><Fragment set:html={dlIcon} />PNG</a></div></div></div>
        </div>
      </section>

      <section id="logo-usage" class="brand-section">
        <h2>Logo Usage</h2>
        <p class="section-desc">Guidelines for proper logo implementation and presentation.</p>
        <div class="usage-grid">
          <div class="usage-card"><div class="usage-label">Light Background</div><div class="usage-preview bg-light"><img src={cfSrc(logos.lightTagline, 400)} srcset={cfSrcset(logos.lightTagline, [200, 400, 600])} sizes="(max-width: 768px) 80vw, 270px" alt="Logo correctly placed on light background" class="logo-img" width="600" height="600" loading="lazy" decoding="async"/></div><p class="usage-text">Use the primary logo on light backgrounds. Ensure adequate contrast and clear space.</p></div>
          <div class="usage-card"><div class="usage-label">Dark Background</div><div class="usage-preview bg-dark"><img src={cfSrc(logos.darkTagline, 400)} srcset={cfSrcset(logos.darkTagline, [200, 400, 600])} sizes="(max-width: 768px) 80vw, 270px" alt="Logo correctly placed on dark background" class="logo-img" width="600" height="600" loading="lazy" decoding="async"/></div><p class="usage-text">Use the dark background version on dark backgrounds. Maintain strong contrast.</p></div>
        </div>
        <h3 id="usage-guidelines">Logo Guidelines</h3>
        <div class="dodont-grid">
          <div class="dodont-card do"><h4>✓ Do</h4><ul><li><span class="chk">✓</span>Maintain clear space around logo</li><li><span class="chk">✓</span>Scale proportionally</li><li><span class="chk">✓</span>Ensure sufficient contrast</li><li><span class="chk">✓</span>Min. 1.25" print, 75px digital</li></ul></div>
          <div class="dodont-card dont"><h4>✗ Don't</h4><ul><li><span class="x">✗</span>Distort or rotate the logo</li><li><span class="x">✗</span>Change logo colors</li><li><span class="x">✗</span>Add effects or shadows</li><li><span class="x">✗</span>Modify or recreate</li></ul></div>
        </div>
        <h3 id="usage-examples">Visual Examples</h3>
        <div class="vis-grid">
          <div class="vis-card ok"><div class="vis-badge ok">Correct</div><div class="vis-preview bg-light"><img src={cfSrc(logos.lightTagline, 260)} srcset={cfSrcset(logos.lightTagline, [130, 260])} sizes="130px" alt="Logo displayed correctly with proper proportions" class="vis-logo" width="600" height="600" loading="lazy" decoding="async"/></div><p>Proper proportions and clear space</p></div>
          <div class="vis-card bad"><div class="vis-badge bad">Incorrect</div><div class="vis-preview bg-light"><img src={cfSrc(logos.lightTagline, 260)} srcset={cfSrcset(logos.lightTagline, [130, 260])} sizes="130px" alt="Logo incorrectly stretched horizontally" class="vis-logo" width="600" height="600" loading="lazy" decoding="async" style="transform:scaleX(1.4);"/></div><p>Don't stretch or distort</p></div>
          <div class="vis-card ok"><div class="vis-badge ok">Correct</div><div class="vis-preview bg-dark"><img src={cfSrc(logos.darkTagline, 260)} srcset={cfSrcset(logos.darkTagline, [130, 260])} sizes="130px" alt="Logo displayed correctly on dark background" class="vis-logo" width="600" height="600" loading="lazy" decoding="async"/></div><p>Good contrast with background</p></div>
          <div class="vis-card bad"><div class="vis-badge bad">Incorrect</div><div class="vis-preview" style="background:#e8e0c0;"><img src={cfSrc(logos.lightTagline, 260)} srcset={cfSrcset(logos.lightTagline, [130, 260])} sizes="130px" alt="Logo incorrectly placed on low-contrast background" class="vis-logo" width="600" height="600" loading="lazy" decoding="async" style="opacity:0.3;"/></div><p>Don't use on low-contrast backgrounds</p></div>
        </div>
      </section>

      <section id="colors" class="brand-section">
        <h2>Color Palette</h2>
        <p class="section-desc">Our color system ensures visual consistency and brand recognition. Click any swatch to copy its hex value.</p>
        <div class="color-grid">
          <div class="color-card" data-hex="#FFDA24"><div class="color-swatch" style="background:#FFDA24;"><span class="swatch-hover">Click to copy</span></div><div class="color-body"><h3>Sunshine Yellow</h3><p class="color-usage">CTAs, brand accents</p><div class="color-vals"><span class="pms">PMS 116 C</span><span class="hex">#FFDA24</span><span>RGB 254, 217, 37</span><span>CMYK 0, 6, 87, 0</span></div></div></div>
          <div class="color-card" data-hex="#373A36"><div class="color-swatch" style="background:#373A36;"><span class="swatch-hover">Click to copy</span></div><div class="color-body"><h3>SOARD Dark</h3><p class="color-usage">Primary text, headings</p><div class="color-vals"><span class="pms">PMS 447 C</span><span class="hex">#373A36</span><span>RGB 55, 58, 54</span><span>CMYK 50, 30, 40, 90</span></div></div></div>
