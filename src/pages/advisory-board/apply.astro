---
/**
 * /advisory-board/apply/ — the Advisory Board application (replaced the
 * Jotform one, Oct 2026). Five steps from functions/api/_advisory-form.js,
 * which the server checks again. Answers save on this device as people go,
 * so leaving and coming back keeps them. Sends to /api/advisory-apply; staff
 * read applications in Admin → People → Applications.
 * Applications are always open: no deadline language here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteSettings from '../../content/site/settings.json';
import { cfRaw, cfLqip } from '../../utils/cf-image';
import { ADVISORY_STEPS, OVERVIEW_PDF } from '../../../functions/api/_advisory-form.js';
import AdvField from '../../components/advisory/AdvField.astro';

const SITE_URL = 'https://sunshineonaranneyday.com';
const email = siteSettings.email;
const ab = (siteSettings as any).advisoryBoardPhotos || {};
const photoId = ab.apply || ab.hero || 'kids/karter/1774384957640-Karter-Reveal-People-9.jpg';
const breadcrumbs = [
  { name: 'Home', url: `${SITE_URL}/` },
  { name: 'Advisory Board', url: `${SITE_URL}/advisory-board/` },
  { name: 'Apply', url: `${SITE_URL}/advisory-board/apply/` },
];
const total = ADVISORY_STEPS.length;
// Two short questions to a row where there's room (email beside phone); never one with a hint, a
// follow-up, or one that another question follows
const PAIRS = new Set(['text', 'email', 'tel', 'url']);
const pairable = (f: any, led: Set<string>) => f && PAIRS.has(f.type) && !f.hint && !f.showIf && !led.has(f.id) && f.label.length <= 40;
const unitsOf = (fields: any[]) => {
  const led = new Set(fields.flatMap((f: any) => Object.keys(f.showIf || {})));
  const out: any[] = [];
  for (let i = 0; i < fields.length; i++) {
    if (pairable(fields[i], led) && pairable(fields[i + 1], led)) { out.push({ pair: [fields[i], fields[i + 1]] }); i++; } else out.push({ field: fields[i] });
  }
  return out;
};
const logo = 'brand-logo-light-bg-display';
---

<BaseLayout
  title="Apply to the Advisory Board"
  description="Apply to join the SOARD Advisory Board: advocates, connectors, and fundraisers who fund a room makeover every year. Applications are always open."
  breadcrumbs={breadcrumbs}
>
  <link slot="head" rel="preload" as="image" imagesrcset={`${cfRaw(photoId, 'w=360,h=450,fit=cover,gravity=face,q=65')} 360w, ${cfRaw(photoId, 'w=560,h=700,fit=cover,gravity=face,q=65')} 560w`} imagesizes="(max-width:768px) 60vw, 340px" fetchpriority="high" />

  <!-- ══════ HERO — Editorial Split ══════ -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-eyebrow"><a href="/advisory-board/">Advisory Board</a></p>
        <h1 class="hero-headline">Apply to join the <em>Advisory Board</em></h1>
        <p class="hero-lead">Tell us who you are, what you’d bring, and why the mission speaks to you. It takes about 20 minutes, with a reference in mind. Applications are <strong>always open</strong>.</p>
        <div class="hero-trust">
          <span class="hero-trust-item"><svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>About 20 minutes</span>
          <span class="hero-trust-item"><svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M17 21v-8H7v8M7 3v5h8" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>Saves on this device as you go</span>
          <span class="hero-trust-item"><svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M14 2v6h6M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><a href={OVERVIEW_PDF} target="_blank" rel="noopener noreferrer">Read the overview first</a></span>
        </div>
      </div>
      <div class="hero-photo-wrap">
        <div class="hero-frame" style={`background-image:url('${cfLqip(photoId)}')`}>
          <img
            src={cfRaw(photoId, 'w=560,h=700,fit=cover,gravity=face,q=65')}
            srcset={`${cfRaw(photoId, 'w=360,h=450,fit=cover,gravity=face,q=65')} 360w, ${cfRaw(photoId, 'w=560,h=700,fit=cover,gravity=face,q=65')} 560w`}
            sizes="(max-width:768px) 60vw, 340px"
            alt="Volunteers and family celebrating at a SOARD room reveal"
            width="560" height="700" fetchpriority="high" loading="eager" decoding="sync"
          />
        </div>
        <div class="hero-accent" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- ══════ THE APPLICATION ══════ -->
  <section class="adv" id="application" aria-label="Advisory Board application">
    <div class="adv-app" data-adv data-total={total}>
      <noscript><p class="adv-note">The application needs JavaScript. If you can’t turn it on, email <a href={`mailto:${email}`}>{email}</a> and we’ll send it another way.</p></noscript>

      <!-- Once started, the application has the screen to itself (html.adv-focus), like the makeover
           application: this bar, a segment per step, a screen of questions at a time, Back and
           Continue held at the bottom. -->
      <header class="adv-top" data-adv-top>
        <div class="adv-top-inner">
          <span class="adv-top-brand">
            <img class="adv-top-logo" src={cfRaw(logo, 'w=160,q=85')} srcset={`${cfRaw(logo, 'w=112,q=85')} 1x, ${cfRaw(logo, 'w=224,q=85')} 2x`} alt="Sunshine on a Ranney Day" width="56" height="56" loading="lazy" decoding="async" />
            <span class="adv-top-text">
              <span class="adv-top-title">Advisory Board Application</span>
              <span class="adv-top-save" id="adv-saved" aria-live="polite"></span>
            </span>
          </span>
          <button type="button" class="adv-top-exit" id="adv-exit">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
            <span>Save and exit</span>
          </button>
        </div>
        <ol class="adv-segs" aria-hidden="true">
          {[...ADVISORY_STEPS, { id: 'review' }].map(() => <li class="adv-seg"><span></span></li>)}
        </ol>
      </header>

      <!-- On the page: every step and how long it takes, what's kept on this device, the way in -->
      <section class="adv-card adv-hub" id="adv-hub" aria-labelledby="adv-hub-title">
        <p class="adv-hub-eyebrow">Your application</p>
        <h2 class="adv-hub-title" id="adv-hub-title" tabindex="-1">Five steps, about 20 minutes</h2>
        <p class="adv-hub-lead" id="adv-hub-lead">Have a reference in mind. Your answers save on this device as you go.</p>
        <div class="adv-hub-go-row">
          <button type="button" class="btn btn-primary adv-hub-go" id="adv-go"><span id="adv-go-label">Start the application</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5L10.5 8 6 12.5" /></svg></button>
          <button type="button" class="adv-linkbtn" id="adv-start-over" hidden>Start over</button>
        </div>
        <ol class="adv-hub-list" id="adv-hub-list">
          {[...ADVISORY_STEPS.map((s) => s.title), 'Review and send'].map((t, i) => (
            <li><button type="button" class="adv-hub-row" data-goto={i} disabled={i > 0}>
              <span class="adv-mark" aria-hidden="true">{i + 1}</span>
              <span class="adv-hub-name"><strong>{t}</strong><span class="adv-hub-sub"></span></span>
              <span class="adv-hub-meta"></span>
            </button></li>
          ))}
        </ol>
        <p class="adv-hub-help">Questions? Write to <a href={`mailto:${email}`}>{email}</a>.</p>
      </section>

      <form id="adv-form" class="adv-card adv-form" novalidate data-total={total}>
        <div class="adv-stage" id="adv-stage">
          <div class="adv-head">
            <p class="adv-kicker"><span id="adv-step-text">Step 1 of {total + 1}</span><span class="adv-part" id="adv-part"></span></p>
            <h2 id="adv-title" tabindex="-1">{ADVISORY_STEPS[0].title}</h2>
          </div>
          {ADVISORY_STEPS.map((s, i) => (
            <section class="adv-page" data-step={i} data-step-id={s.id} hidden={i !== 0} aria-label={s.title}>
              <p class="adv-intro">{s.intro}</p>
              <div class="adv-summary" data-summary role="alert" hidden></div>
              {unitsOf(s.fields).map((u) => u.pair
                ? <div class="adv-pair">{u.pair.map((f: any) => <AdvField f={f} />)}</div>
                : <AdvField f={u.field} />)}
              {i === total - 1 && <p class="adv-date">Signed today, <span id="adv-today"></span></p>}
            </section>
          ))}
          <!-- Review: a row per step with its answers in a line, opened for the details -->
          <section class="adv-page adv-page--review" data-step={total} data-step-id="review" hidden aria-label="Review and send">
            <div class="adv-review-top">
              <p class="adv-intro">Look over your answers. Change anything you like, then send.</p>
              <button type="button" class="adv-linkbtn" id="adv-review-all" aria-expanded="false">Show all answers</button>
            </div>
            <div class="adv-review" id="adv-review"></div>
            <div class="adv-turnstile" id="adv-turnstile" hidden><div class="cf-turnstile"></div></div>
          </section>

          <!-- Left empty by people; bots fill it in -->
          <div class="adv-hp" aria-hidden="true">
            <label for="adv-website">Website</label>
            <input id="adv-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
        </div>

        <footer class="adv-nav">
          <p class="adv-send-error" id="adv-send-error" role="alert" hidden></p>
          <div class="adv-nav-row">
            <button type="button" class="btn btn-outline-dark adv-back" id="adv-back" hidden><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8l4.5 4.5" /></svg>Back</button>
            <button type="submit" class="btn btn-primary adv-next" id="adv-next">Continue</button>
          </div>
        </footer>
      </form>

      <div class="adv-card adv-done" id="adv-done" hidden tabindex="-1">
        <div class="adv-done-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
        <h2>Thank you<span id="adv-done-name"></span>.</h2>
        <p>We have your application, and a copy is on its way to your inbox. We review applications on a rolling basis and will be in touch soon.</p>
        <div class="adv-done-links">
          <a class="btn btn-dark" href="/advisory-board/">Back to the Advisory Board</a>
          <a class="btn btn-outline-dark" href={OVERVIEW_PDF} target="_blank" rel="noopener noreferrer">The overview (PDF)</a>
        </div>
        <p class="adv-done-note">Questions? Write to <a href={`mailto:${email}`}>{email}</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The highlighter under an emphasised word: a thick flat underline drawn behind the letters */
  :is(h1, h2) em { font-style: italic; padding: 0 0.05em; text-decoration: underline; text-decoration-color: var(--c-yellow-soft); text-decoration-thickness: .42em; text-underline-offset: -.3em; text-decoration-skip-ink: none; }

  /* ── Buttons (the Advisory Board page's) ── */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--font-body); font-weight: 600; font-size: 16px; padding: 14px 32px; border: none; border-radius: 100px; cursor: pointer; text-decoration: none; min-height: 52px; transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s cubic-bezier(0.16,1,0.3,1), background 0.25s ease, color 0.25s ease; }
  .btn:hover { transform: translateY(-2px); }
  .btn:disabled { opacity: 0.6; cursor: default; transform: none; }
  .btn-primary { background: var(--c-yellow); color: var(--c-dark); }
  .btn-primary:hover { box-shadow: 0 8px 24px var(--c-yellow-glow); }
  .btn-dark { background: var(--c-dark); color: #fff; }
  .btn-outline-dark { background: transparent; color: var(--c-dark); border: 2px solid var(--c-dark); }
  .btn-outline-dark:hover { background: var(--c-dark); color: var(--c-yellow); }

  /* ── Hero: editorial split (matches /advisory-board/) ── */
  .hero { background: var(--c-cream); padding: clamp(40px, 7vh, 88px) 0 clamp(32px, 5vh, 56px); overflow: hidden; }
  .hero-inner { max-width: var(--max-width-wide, 1400px); margin: 0 auto; padding: 0 var(--page-padding); display: grid; grid-template-columns: 1.25fr 0.75fr; gap: clamp(32px, 5vw, 80px); align-items: center; }
  .hero-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-muted); margin-bottom: 24px; }
  .hero-eyebrow a { color: inherit; text-decoration: none; }
  .hero-eyebrow a:hover { text-decoration: underline; }
  .hero-headline { font-size: clamp(38px, 5.4vw, 72px); line-height: 1.05; letter-spacing: -0.035em; color: var(--c-dark); margin-bottom: 24px; }
  .hero-lead { font-size: clamp(16px, 1.3vw, 19px); line-height: 1.7; color: var(--c-text); max-width: 540px; margin-bottom: 24px; }
  .hero-trust { display: flex; gap: 12px 22px; flex-wrap: wrap; }
  .hero-trust-item { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; color: var(--c-text-muted); }
  .hero-trust-item a { color: inherit; text-decoration: underline; text-decoration-color: var(--c-yellow); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .hero-trust-icon { width: 16px; height: 16px; flex-shrink: 0; }
  .hero-photo-wrap { position: relative; max-width: 360px; justify-self: end; width: 100%; }
  .hero-frame { position: relative; border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 5; background-size: cover; background-position: center; box-shadow: 0 32px 80px rgba(0,0,0,0.12), 0 8px 24px rgba(0,0,0,0.06); }
  .hero-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-accent { position: absolute; z-index: -1; bottom: -16px; right: -16px; width: 55%; height: 55%; border-radius: 20px; background: var(--c-yellow); opacity: 0.35; }

  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; gap: 28px; }
    .hero-photo-wrap { order: -1; max-width: 200px; justify-self: start; }
    .hero-frame { aspect-ratio: 1; border-radius: 20px; }
    .hero-accent { bottom: -10px; right: -10px; }
    .hero-headline { font-size: clamp(34px, 9vw, 48px); }
  }
  @media (pointer: coarse) { .btn:hover { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .btn { transition: none; } .btn:hover { transform: none; } }
</style>

<style is:global>
  /* ── The application ── */
  .adv { --adv-ease: cubic-bezier(.2, .8, .2, 1); --adv-line: #D6D4CC; background: var(--c-cream); padding: 0 var(--page-padding) clamp(64px, 9vw, 120px); scroll-margin-top: calc(var(--header-height, 84px) + 16px); }
  .adv-app { max-width: 780px; margin: 0 auto; }
  .adv-app [hidden] { display: none !important; }
  .adv-card { background: #fff; border: 1px solid var(--c-border); border-radius: 24px; padding: clamp(22px, 4.5vw, 48px); box-shadow: 0 12px 40px rgba(0,0,0,0.05); }
  .adv-note { padding: 12px 16px; border-radius: 12px; background: var(--c-warm-gray); font-size: 15px; margin-bottom: 20px; }
  .adv-linkbtn { background: none; border: 0; padding: 6px 2px; font: inherit; font-weight: 600; color: var(--c-dark); text-decoration: underline; text-decoration-color: rgba(55,58,54,.35); text-underline-offset: 4px; cursor: pointer; min-height: 44px; }
  .adv-linkbtn:hover { text-decoration-color: var(--c-dark); }

  /* Before starting (and after Save and exit): the overview; the form waits */
  .adv-app:not(.is-focus) .adv-form, .adv-top { display: none; }
  .adv-hub-eyebrow { margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--c-text-muted); }
  .adv-hub-title { margin: 0 0 8px; font-size: clamp(24px, 3vw, 32px); line-height: 1.2; outline: none; text-wrap: balance; }
  .adv-hub-lead { margin: 0 0 22px; font-size: 16px; line-height: 1.6; color: var(--c-text); }
  .adv-hub-go-row { display: flex; align-items: center; gap: 10px 20px; flex-wrap: wrap; margin-bottom: 26px; }
  .adv-hub-go { min-width: 240px; }
  .adv-hub-go svg, .adv-back svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .adv-hub-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .adv-hub-row {
    width: 100%; display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; gap: 14px; align-items: center; min-height: 58px; padding: 10px 16px 10px 12px;
    font: inherit; text-align: left; color: var(--c-dark); background: #fff; border: 1px solid var(--c-border); border-radius: 16px; cursor: pointer;
    transition: border-color .15s var(--adv-ease), background-color .15s var(--adv-ease);
  }
  .adv-hub-row:hover:not(:disabled) { border-color: #A9A79F; background: #FDFCF8; }
  .adv-hub-row:focus-visible { outline: 3px solid var(--c-dark); outline-offset: 2px; }
  .adv-hub-row:disabled { cursor: default; }
  .adv-hub-row:disabled strong { color: #6E6F74; font-weight: 600; }
  .adv-hub-row[data-state="now"] { border-color: var(--c-dark); box-shadow: inset 0 0 0 .5px var(--c-dark); }
  .adv-hub-name { display: grid; gap: 2px; min-width: 0; }
  .adv-hub-name strong { font-size: 16px; line-height: 1.35; }
  .adv-hub-sub { font-size: 14px; line-height: 1.4; color: var(--c-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .adv-hub-sub:empty { display: none; }
  .adv-hub-meta { font-size: 13.5px; font-weight: 600; color: var(--c-text-muted); white-space: nowrap; }
  .adv-hub-help { margin: 18px 0 0; font-size: 14px; color: var(--c-text-muted); }
  .adv-hub-help a { color: var(--c-dark); font-weight: 600; }
  /* A step's mark: its number, a check once done, yellow while it's on */
  .adv-mark { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font-size: 13px; font-weight: 700; border: 1.5px solid var(--adv-line); background: #fff; color: var(--c-text-muted); font-variant-numeric: tabular-nums; }
  .adv-mark svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  [data-state="done"] > .adv-mark, .adv-review-section:not([data-missing]) .adv-mark { background: var(--c-dark); border-color: var(--c-dark); color: var(--c-yellow); }
  [data-state="now"] > .adv-mark { background: var(--c-yellow); border-color: var(--c-dark); color: var(--c-dark); }
  .adv-review-section[data-missing] .adv-mark { background: #FFF6D6; border-color: #8A7200; color: #5C4A00; }

  /* ── On its own screen (html.adv-focus): the site's header, footer and hero step aside ── */
  html.adv-focus, html.adv-focus body { background: #fff; }
  html.adv-focus body { padding-bottom: 0; }
  html.adv-focus { scroll-padding-top: 92px; scroll-padding-bottom: 104px; }
  html.adv-focus body > :not(main):not(dialog) { display: none !important; }
  html.adv-focus main > :not(#application) { display: none !important; }
  html.adv-focus .adv { padding: 0; background: #fff; }
  html.adv-focus .adv-app { max-width: none; display: flex; flex-direction: column; min-height: 100dvh; }
  html.adv-focus .adv-hub { display: none; }
  .adv-top { position: sticky; top: 0; z-index: 1000; background: rgba(255,255,255,.97); }
  html.adv-focus .adv-top { display: block; }
  @supports (backdrop-filter: blur(1px)) { .adv-top { background: rgba(255,255,255,.88); backdrop-filter: saturate(1.4) blur(14px); } }
  .adv-top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 68px; padding: 0 20px 0 16px; }
  .adv-top-brand { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .adv-top-logo { width: 56px; height: 56px; flex-shrink: 0; object-fit: contain; }
  .adv-top-text { display: grid; gap: 1px; min-width: 0; }
  .adv-top-title { font-size: 15px; font-weight: 700; line-height: 1.3; color: var(--c-dark); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .adv-top-save { min-height: 17px; font-size: 12.5px; line-height: 17px; color: var(--c-text-muted); }
  .adv-top-exit {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px 0 13px; border-radius: 999px; cursor: pointer; flex-shrink: 0;
    font: inherit; font-size: 14.5px; font-weight: 600; color: var(--c-dark); background: #fff; border: 1.5px solid var(--adv-line);
  }
  .adv-top-exit:hover { border-color: var(--c-dark); }
  .adv-top-exit:focus-visible { outline: 3px solid var(--c-dark); outline-offset: 2px; }
  .adv-top-exit svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .adv-segs { display: flex; gap: 3px; height: 4px; margin: 0; padding: 0; list-style: none; }
  .adv-seg { flex: 1; position: relative; overflow: hidden; background: #E9E5DA; }
  .adv-seg span { position: absolute; inset: 0; background: var(--c-yellow); transform-origin: left; transform: scaleX(0); transition: transform .4s var(--adv-ease); }
  .adv-seg[data-state="done"] span { background: #F2C200; }
  html.adv-focus .adv-form { flex: 1 0 auto; display: flex; flex-direction: column; border: 0; border-radius: 0; box-shadow: none; padding: 0; background: none; }
  html.adv-focus .adv-done { width: calc(100% - 32px); max-width: 720px; margin: clamp(20px, 5vh, 48px) auto 48px; }
  .adv-stage { flex: 1 0 auto; width: 100%; max-width: 720px; margin: 0 auto; padding: clamp(20px, 4.5vh, 48px) 24px 24px; container-type: inline-size; }
  html:not(.adv-focus) .adv-stage { padding: 0; }
  .adv-head { margin-bottom: 8px; }
