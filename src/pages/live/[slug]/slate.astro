---
/** /live/<kid>/slate/ — the kid's starting-soon screen. See SlateScreen.astro. */
import SlateScreen from '../../../components/live/SlateScreen.astro';
import { getPublishedKids } from '../../../utils/collections';

export async function getStaticPaths() {
  const kids = await getPublishedKids();
  return kids.map(kid => ({ params: { slug: kid.data.slug }, props: { kid: kid.data } }));
}

const { kid } = Astro.props as { kid: any };
---

<SlateScreen kid={kid} />
