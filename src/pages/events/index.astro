    position: relative;
    z-index: 1;
    color: rgba(255, 255, 255, 0.22);
    animation: ev-float 6s ease-in-out infinite;
  }
  .hero-event-card__icon :global(svg) {
    width: 110px;
    height: 110px;
  }
  @media (min-width: 768px) {
    .hero-event-card__icon :global(svg) { width: 160px; height: 160px; }
  }
  @keyframes ev-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-event-card__logo { animation: none; }
    .hero-event-card__icon { animation: none; }
    .hero-event-card { transition: none; }
  }
  /* When view-transition is about to start, JS adds this class so the
     snapshot is taken at the rest position — prevents the logo jumping. */
  .hero-event-card__logo.vt-freeze {
    animation: none !important;
    transform: translateY(0) !important;
  }

  /* Mini date card overlay */
  .hero-date-card {
    position: absolute;
    bottom: var(--space-lg);
    right: var(--space-lg);
    z-index: 2;
    background: #fff;
    border-radius: 14px;
    padding: 0.6rem 0.85rem;
    text-align: center;
    min-width: 64px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
  }
  .hero-date-card__month {
    display: block;
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-text-muted);
    line-height: 1;
    margin-bottom: 2px;
  }
  .hero-date-card__day {
    display: block;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1;
    color: var(--c-dark);
  }
  .hero-date-card__year {
    display: block;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--c-text-light);
    margin-top: 2px;
  }

  @media (max-width: 767px) {
    .hero { padding: var(--space-xl) 0 var(--space-2xl); }
    .hero-frame { order: -1; }
    .hero-photo { max-width: 280px; aspect-ratio: 3 / 4; }
    .hero-accent { width: 55%; height: 55%; top: -8px; right: -8px; }
    .hero-event-card { max-width: 280px; aspect-ratio: 1 / 1; }
    .hero-inner { text-align: center; }
    .hero-meta { align-items: center; }
    .hero-ctas { justify-content: center; }
    .hero-badges { justify-content: center; }
    .hero-sub { margin-inline: auto; }
  }

  /* ═══════════════════════════════════════════
     RECAP HERO — a look back at the latest year:
     real photos from its events, the site's split
     pattern (big photo, small overlapping photo,
     yellow accent, stat badge)
     ═══════════════════════════════════════════ */
  .hero-frame--recap {
    display: block;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
  }
  .hero--recap .hero-accent {
    top: auto;
    bottom: -16px;
    right: -16px;
    opacity: 0.35;
  }
  .hero-photo--link {
    display: block;
    color: inherit;
    cursor: zoom-in;
  }
  .hero-frame--wide { max-width: 520px; }
  .hero-photo.hero-photo--wide { aspect-ratio: 4 / 3; max-width: none; }
  .hero-photo--link img,
  .hero-photo--small img {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-photo--link:hover img,
  .hero-photo--small:hover img { transform: scale(1.03); }
  .hero-photo--link:focus-visible,
  .hero-photo--small:focus-visible {
    outline: 3px solid var(--c-yellow);
    outline-offset: 4px;
  }
  .hero-photo--small {
    position: absolute;
    left: -36px;
    bottom: -28px;
    z-index: 2;
    display: block;
    width: 40%;
    max-width: 180px;
    aspect-ratio: 5 / 6;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    border: 4px solid var(--c-cream);
    background-size: cover;
    background-position: center;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.06), 0 12px 36px rgba(0, 0, 0, 0.14);
    cursor: zoom-in;
  }
  .hero-photo--small img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Hangs off the photo's corner, mostly outside it, so it never sits on a face or a sign */
  .hero-stat {
    position: absolute;
    right: -44px;
    bottom: -40px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-radius: var(--border-radius-lg);
    background: var(--c-dark);
    color: #fff;
    text-align: left;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08), 0 16px 48px rgba(0, 0, 0, 0.18);
  }
  /* Below wide desktops the frame sits near the screen edge: keep the badge on it */
  @media (max-width: 1279px) {
    .hero-stat { right: -12px; }
  }
  .hero-stat__num {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    line-height: 1;
    color: var(--c-yellow);
  }
  .hero-stat__label {
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }
  @media (max-width: 767px) {
    .hero--recap .hero-inner { gap: var(--space-3xl); }
    .hero-frame--recap { max-width: 280px; }
    .hero-frame--wide { max-width: 340px; }
    .hero-photo.hero-photo--wide { aspect-ratio: 4 / 3; max-width: none; }
    /* Phones keep one photo, like the other heroes on the site */
    .hero-photo--small { display: none; }
    .hero-stat { right: -8px; bottom: -36px; padding: 10px 14px; }
    .hero--recap .hero-accent { bottom: -10px; right: -10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo--link img, .hero-photo--small img { transition: none; }
    .hero-photo--link:hover img, .hero-photo--small:hover img { transform: none; }
  }

  /* ═══════════════════════════════════════════
     SECTION LABELS (shared)
     ═══════════════════════════════════════════ */
  .ev-section-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin-bottom: var(--space-sm);
  }
  .ev-section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 400;
    color: var(--c-dark);
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .ev-section-sub {
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.7;
    color: var(--c-text-muted);
    max-width: 52ch;
    margin-top: var(--space-sm);
  }

  /* ═══════════════════════════════════════════
     UPCOMING REVEALS (cards are built by script, hence :global)
     ═══════════════════════════════════════════ */
  .ev-reveals {
    padding: var(--space-4xl) 0;
    background: var(--c-cream);
  }
  .ev-reveals__header { margin-bottom: var(--space-2xl); }
  .ev-reveals__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
  @media (min-width: 640px) {
    .ev-reveals__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .ev-reveals__grid { grid-template-columns: repeat(3, 1fr); }
  }
  :global(.ev-reveal-card) {
    display: flex;
    flex-direction: column;
    background: var(--c-white);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 8px 28px rgba(0, 0, 0, 0.06);
    animation: ev-reveal-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes ev-reveal-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  :global(.ev-reveal-card__media) {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--c-dark) 0%, var(--c-dark-deep) 100%);
  }
  :global(.ev-reveal-card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  :global(.ev-reveal-card__icon) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--c-yellow);
  }
  :global(.ev-reveal-card__chip) {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 6px 14px;
    border-radius: 100px;
    background: var(--c-yellow);
    color: var(--c-dark);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  :global(.ev-reveal-card__body) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-lg);
    flex: 1;
  }
  :global(.ev-reveal-card__when) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }
  :global(.ev-reveal-card__time)::before {
    content: '·';
    margin-right: 10px;
    opacity: 0.5;
  }
  :global(.ev-reveal-card__name) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.25;
    color: var(--c-dark);
  }
  :global(.ev-reveal-card__name a) {
    color: inherit;
    text-decoration: none;
  }
  :global(.ev-reveal-card__name a:hover) {
    text-decoration: underline;
    text-decoration-color: var(--c-yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  :global(.ev-reveal-card__actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: auto;
    padding-top: var(--space-md);
  }
  :global(.ev-reveal-card__watch) {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.4rem;
    border-radius: 100px;
    background: var(--c-yellow);
    color: var(--c-dark);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 200ms, box-shadow 200ms;
  }
  :global(.ev-reveal-card__watch:hover) {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px var(--c-yellow-glow);
  }
  :global(.ev-reveal-card__cal) {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-dark);
    text-decoration: underline;
    text-decoration-color: var(--c-border);
    text-underline-offset: 4px;
  }
  :global(.ev-reveal-card__cal:hover) { text-decoration-color: var(--c-yellow); }
  @media (prefers-reduced-motion: reduce) {
    :global(.ev-reveal-card) { animation: none; }
  }

  /* ═══════════════════════════════════════════
     UPCOMING EVENTS
     ═══════════════════════════════════════════ */
  .ev-upcoming {
    padding: var(--space-4xl) 0;
    background: var(--c-white);
  }
  .ev-upcoming__header {
    margin-bottom: var(--space-2xl);
  }
  .ev-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
  @media (min-width: 640px) {
    .ev-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .ev-grid { grid-template-columns: repeat(3, 1fr); }
  }
  /* ═══════════════════════════════════════════
     EMPTY STATE
     ═══════════════════════════════════════════ */
  .ev-empty {
    padding: var(--space-5xl) 0;
    background: var(--c-white);
  }
  .ev-empty__box {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
  }
  .ev-empty__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--c-warm-gray);
    color: var(--c-text-muted);
    margin-bottom: var(--space-lg);
  }
  .ev-empty__box h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--c-dark);
    margin-bottom: var(--space-sm);
  }
  .ev-empty__box p {
    color: var(--c-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  /* ═══════════════════════════════════════════
     IMPACT TRUST SECTION (dark editorial split)
     ═══════════════════════════════════════════ */
  .ev-impact {
    position: relative;
    padding: var(--space-3xl) 0;
    background: var(--c-dark-deep, #1E1F25);
    overflow: hidden;
  }
  .ev-impact__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 10% 85%, var(--c-yellow-glow) 0%, transparent 50%),
      radial-gradient(ellipse 40% 40% at 90% 15%, rgba(255, 255, 255, 0.03) 0%, transparent 50%);
    pointer-events: none;
  }
  .ev-impact__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (min-width: 900px) {
    .ev-impact__inner {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-3xl);
    }
  }
  .ev-section-label--light {
    color: rgba(255, 255, 255, 0.45);
  }
  .ev-impact__heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 400;
    color: #fff;
    line-height: 1.15;
    text-wrap: balance;
    margin-bottom: var(--space-md);
  }
  .ev-impact__desc {
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.55);
    max-width: 44ch;
    margin-bottom: var(--space-lg);
    text-wrap: pretty;
  }
  .ev-impact__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }
  @media (min-width: 560px) {
    .ev-impact__stats { grid-template-columns: repeat(3, 1fr); }
  }
  .ev-impact__card {
    padding: var(--space-md);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--border-radius-lg);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ev-impact__card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 218, 36, 0.25);
  }
  .ev-impact__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 218, 36, 0.12);
    color: var(--c-yellow);
    margin-bottom: var(--space-sm);
  }
  .ev-impact__big {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 0.15rem;
  }
  .ev-impact__label {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-yellow);
    margin-bottom: var(--space-xs);
  }
  .ev-impact__card p {
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .ev-impact__card { transition: none; }
  }

  /* ═══════════════════════════════════════════
     PAST EVENTS SHOWCASE
     ═══════════════════════════════════════════ */
  .ev-past {
    padding: var(--space-4xl) 0;
    background: var(--c-warm-gray);
  }
  .ev-past__header {
    margin-bottom: var(--space-2xl);
  }

  /* The year at a glance: plain numbers, no counting animation */
  .ev-year {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    margin: 0 0 var(--space-4xl);
    background: var(--c-border);
    border: 1px solid var(--c-border);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
  }
  .ev-year__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 8px;
    padding: 22px 24px;
    background: var(--c-white);
  }
  .ev-year dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--c-dark);
  }
  .ev-year dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }
  @media (max-width: 599px) {
    .ev-year { grid-template-columns: 1fr 1fr; }
    .ev-year__item { padding: 18px; }
  }

  /* One chapter per event: photos on one side, the story on the other */
  .ev-chapters {
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }
  .ev-chapter {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
  @media (min-width: 900px) {
    .ev-chapter {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-3xl);
      align-items: center;
    }
    .ev-chapter--flip { grid-template-columns: 1fr 1.1fr; }
    .ev-chapter--flip .ev-chapter__media { order: 2; }
  }

  .ev-mosaic {
    display: grid;
    gap: 8px;
    aspect-ratio: 4 / 3;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .ev-mosaic--1 { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  .ev-mosaic--2 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr; }
  .ev-mosaic--3 { grid-template-columns: 2fr 1fr; }
  .ev-mosaic--3 .ev-mosaic__tile:first-child,
  .ev-mosaic--4 .ev-mosaic__tile:first-child,
  .ev-mosaic--5 .ev-mosaic__tile:first-child { grid-row: 1 / span 2; }
  .ev-mosaic--4 .ev-mosaic__tile:last-child { grid-column: 2 / span 2; }
  /* A landscape first photo: full width on top, the rest in a row under it */
  .ev-mosaic--wide {
    aspect-ratio: auto;
    grid-template-columns: repeat(var(--n), 1fr);
    grid-template-rows: auto;
  }
  .ev-mosaic--wide .ev-mosaic__tile { aspect-ratio: 1; grid-row: auto; grid-column: auto; }
  .ev-mosaic--wide .ev-mosaic__tile:first-child { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 3 / 2; }
  .ev-mosaic__tile {
    position: relative;
    display: block;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 10px;
    background: var(--c-border);
    cursor: zoom-in;
  }
  .ev-mosaic__tile:first-child { border-radius: var(--border-radius-lg); }
  .ev-mosaic__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ev-mosaic__tile:hover img { transform: scale(1.04); }
  .ev-mosaic__tile:focus-visible {
    outline: 3px solid var(--c-yellow);
    outline-offset: 2px;
  }
  .ev-mosaic__more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(20, 20, 22, 0.55);
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    pointer-events: none;
  }
  .ev-chapter__placeholder {
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border-radius: var(--border-radius-lg);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ev-chapter__placeholder-icon :global(svg) { width: 44px; height: 44px; }

  .ev-chapter__kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 var(--space-sm);
    font-size: 0.82rem;
    color: var(--c-text-muted);
  }
  .ev-chapter__cat {
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--cat) 16%, var(--c-white));
    color: var(--c-dark);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ev-chapter__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--c-dark);
    text-wrap: balance;
  }
  .ev-chapter__theme {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--c-text-muted);
  }
  .ev-chapter__loc {
    display: flex;
