<!-- ═══════════════════════════════════════════
     CLIENT-SIDE: Reveals, countdown, newsletter link
     ═══════════════════════════════════════════ -->
<script>
  /* ── Upcoming reveals (confirmed in JobTread, via /api/reveals) ── */
  import { loadReveals, revealDay, revealTime, revealCalendarUrl, type Reveal } from '../../utils/reveals-client';

  function daysAway(r: Reveal): string {
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(new Date());
    const days = Math.round((Date.parse(`${r.date}T12:00:00Z`) - Date.parse(`${today}T12:00:00Z`)) / 86_400_000);
    return days <= 0 ? 'Today' : days === 1 ? 'Tomorrow' : `${days} days away`;
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) {
    const node = document.createElement(tag);
    node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function revealCard(r: Reveal): HTMLElement {
    const card = el('article', 'ev-reveal-card');

    const media = el('a', 'ev-reveal-card__media');
    media.href = r.kidUrl;
    media.setAttribute('aria-label', `Meet ${r.name}`);
    if (r.image) {
      const img = el('img', 'ev-reveal-card__img');
      img.src = r.image;
      img.alt = r.name;
      img.width = 640;
      img.height = 480;
      img.loading = 'lazy';
      img.decoding = 'async';
      media.append(img);
    } else {
      const icon = el('span', 'ev-reveal-card__icon');
      icon.innerHTML = '<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/></svg>';
      media.append(icon);
    }
    media.append(el('span', 'ev-reveal-card__chip', daysAway(r)));

    const body = el('div', 'ev-reveal-card__body');
    const when = el('p', 'ev-reveal-card__when', revealDay(r));
    const time = revealTime(r);
    if (time) when.append(el('span', 'ev-reveal-card__time', time));
    const name = el('h3', 'ev-reveal-card__name');
    const nameLink = el('a', '', `${r.name}'s Reveal Day`);
    nameLink.href = r.kidUrl;
    name.append(nameLink);

    const actions = el('div', 'ev-reveal-card__actions');
    const watch = el('a', 'ev-reveal-card__watch', 'Watch live');
    watch.href = r.liveUrl;
    const cal = el('a', 'ev-reveal-card__cal', 'Add to calendar');
    cal.href = revealCalendarUrl(r);
    cal.target = '_blank';
    cal.rel = 'noopener noreferrer';
    actions.append(watch, cal);

    body.append(when, name, actions);
    card.append(media, body);
    return card;
  }

  async function showUpcomingReveals() {
    const section = document.querySelector<HTMLElement>('[data-upcoming-reveals]');
    const grid = section?.querySelector('[data-upcoming-reveals-grid]');
    if (!section || !grid) return;
    const reveals = await loadReveals();
    if (!reveals.length || !section.isConnected) return;
    grid.replaceChildren(...reveals.map(revealCard));
    section.hidden = false;
  }

  document.addEventListener('astro:page-load', showUpcomingReveals);

  /* ── Live countdown badges ── */
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach(el => {
    const target = new Date(el.dataset.countdown + 'T00:00:00');
    const end = new Date((el.dataset.countdownEnd || el.dataset.countdown) + 'T23:59:59');
    const now = new Date();
    const days = Math.ceil((target.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));

    if (now.getTime() > end.getTime()) {
      el.textContent = 'Recently passed';
    } else if (days > 1) {
      el.textContent = `${days} days away`;
    } else if (days === 1) {
      el.textContent = 'Tomorrow!';
    } else if (days === 0) {
      el.textContent = 'Today!';
    } else {
      el.textContent = 'Happening now!';
    }
  });

  /* ── Freeze golf logo float animation before view-transition snapshot ── */
  document.addEventListener('astro:before-preparation', () => {
    document.querySelectorAll('.hero-event-card__logo').forEach(el => el.classList.add('vt-freeze'));
  });

  /* In-page links (#past, #next) are left to Astro's router, which keeps the
     back button working; a hand-rolled pushState here used to break it. */

  /* ── "Get the dates first": the footer's newsletter signup, ready to type ── */
  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest?.('[data-newsletter-focus]');
    if (!link) return;
    const input = document.getElementById('newsletter-email') as HTMLInputElement | null;
    if (!input) return;
    e.preventDefault();
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    input.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' });
    input.focus({ preventScroll: true });
  }, true); // capture: runs before Astro's router, which then leaves the click alone
</script>

