---
/**
 * Events Page — Sunshine on a Ranney Day
 * Premium editorial layout: split hero, flagship spotlight with live countdown,
 * interactive upcoming grid with Add-to-Calendar, and the past events told as
 * chapters (photos, achievements, sponsors, a real quote) with a full-screen
 * photo tour.
 *
 * With nothing scheduled the page becomes a look back at the latest year:
 * the hero thanks everyone with real photos from those events and the rooms
 * finished that year, then one chapter per event. Everything comes from the
 * event records and the Gala/Golf page settings (public/admin/events-shared.js
 * decides which photos and sponsors belong to which event), so a new year
 * fills in with no code change.
 *
 * PERF: CF Images w/ srcset, LQIP blur-up, LCP preload, scoped CSS, contain
 * SEO:  Breadcrumbs, semantic HTML5, Event JSON-LD via detail pages
 * A11Y: ARIA roles, keyboard nav, prefers-reduced-motion, focus-visible
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/events/EventCard.astro';
import PhotoTour from '../../components/events/PhotoTour.astro';
import { getCollection, getEntry } from 'astro:content';
import { cfRaw, cfSrcset, cfLqip, cfId } from '../../utils/cf-image';
import { getSiteStats } from '../../utils/stats';
import { getPublishedKids } from '../../utils/collections';
import siteSettings from '../../content/site/settings.json';
import photoShapes from '../../data/dimensions-events.json';
import {
  SERIES, seriesOf, isOver, dayIn, yearOf, eventPath, hasOwnPage, isLatest,
  recapPhotos, recapSponsors, sponsorCount, splitSponsors, cleanHighlights, displayName, fmtDay as fmtWhen,
} from '../../../public/admin/events-shared.js';

/* ── Fetch & sort events ── */
const allEvents = await getCollection('events');
/* Atlanta time: an event is over from the day after its last day */
const today = dayIn();
const eventData = allEvents.map(e => e.data);

const events = allEvents.map(e => ({
  ...e,
  data: {
    ...e.data,
    // Multi-day events stay "upcoming" through their last day
    status: e.data.status === 'cancelled' ? 'cancelled' : isOver(e.data, today) ? 'past' : 'upcoming',
  },
}));

const upcoming = events
  .filter(e => e.data.status === 'upcoming')
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const past = events
  .filter(e => e.data.status === 'past')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const featured = upcoming.filter(e => e.data.featured);

/* ── Detail page routing (public/admin/events-shared.js) ──
   The gala and golf tournament are series: the newest event of each lives at
   /events/gala/ or /events/golf/, an older one at its year page
   (/events/gala/2026/) once it's over. Anything else has /events/<slug>/
   when it has content of its own or is over. */
const detailPages: Record<string, string> = {};
for (const e of events) {
  const path = eventPath(e.data, eventData, today);
  if (path !== `/events/${e.data.slug}/` || hasOwnPage(e.data, eventData, today)) detailPages[e.data.slug] = path;
}

/* ── Past events: what each one's recap shows ──
   Photos and sponsors follow the shared rules (an event's own, else the ones
   on its Gala/Golf page that belong to it). The quote is the event page's
   testimonial while that page still describes this event. Highlights are the
   numbers staff add in the Event editor ("$412,000" raised). */
const pageDocs: Record<string, any> = {};
for (const s of SERIES) pageDocs[s.key] = (await getEntry('site', s.doc as any))?.data ?? null;

type Photo = { id: string; alt: string };
type SponsorTier = { tier: string; size: string; names: Array<{ name: string; logo?: string; scale?: number }> };
interface Recap {
  name: string;
  photos: Photo[];
  sponsors: SponsorTier[];
  sponsorTotal: number;
  highlights: Array<{ value: string; label: string }>;
  quote: { text: string; cite: string } | null;
  lead: string;
}
const recaps: Record<string, Recap> = {};
for (const e of events.filter(e => e.data.status === 'past')) {
  const d = e.data as any;
  const s = seriesOf(d);
  const doc = s ? pageDocs[s.key] : null;
  const photos = recapPhotos(d, eventData, doc) as Photo[];
  const sponsors = recapSponsors(d, eventData, doc) as SponsorTier[];
  const sponsorTotal = sponsorCount(sponsors);
  const t = doc && isLatest(d, eventData) ? doc.testimonial : null;
  const when = s?.key === 'gala' || /\bp\.?m\b/i.test(d.time || '') ? 'night' : 'day';
  const day = fmtWhen(d.date, { month: 'long', day: 'numeric' });
  /* "our Title Sponsor, Real Floors Commercial": the first tier, when it's the largest size */
  const top = sponsors.find(tier => tier.size === 'xl') || null;
  const topNames = (top?.names || []).map(n => n.name.trim()).filter(Boolean);
  const topThanks = top && topNames.length
    ? `, and to our ${top.tier.replace(/\s+sponsors?$/i, '').trim()} ${topNames.length > 1 ? 'Sponsors' : 'Sponsor'}, ${topNames.length > 1 ? `${topNames.slice(0, -1).join(', ')} and ${topNames[topNames.length - 1]}` : topNames[0]}`
    : '';
  recaps[d.slug] = {
    name: displayName(d),
    photos,
    sponsors,
    sponsorTotal,
    highlights: cleanHighlights(d.highlights),
    quote: t?.quote?.trim() ? { text: t.quote.trim(), cite: [t.name, t.title].map((x: string) => (x || '').trim()).filter(Boolean).join(', ') } : null,
    lead: (d.recapNote || '').trim()
      || `Thank you to everyone who joined us at ${d.location.trim()} on ${day}${topThanks}.${photos.length ? '' : ` Photos from the ${when} are on the way.`}`,
  };
}

/* Photo shapes (scripts/generate-event-dimensions.js) → width / height */
const shapes = photoShapes as Record<string, [number, number]>;
function ratioOf(id: string): number {
  const s = shapes[cfId(id)];
  return s && s[0] > 0 && s[1] > 0 ? Math.round((s[0] / s[1]) * 1000) / 1000 : 4 / 3;
}
/* The first upright (portrait or square) photo among the first dozen, for frames that are taller than wide */
function uprightPhoto(photos: Photo[], skip?: string): Photo | undefined {
  const pool = photos.filter(p => p.id !== skip);
  return pool.slice(0, 12).find(p => ratioOf(p.id) <= 1.05) || pool[0];
}

/* Past-card link label: only promise photos when the recap has them */
function pastLinkLabel(ev: { slug: string; photos: Array<{ id: string }>; streamVideoId?: string | null; videoUrl?: string | null }): string {
  const hasMedia = (recaps[ev.slug]?.photos.length ?? ev.photos.length) > 0 || !!ev.streamVideoId || !!ev.videoUrl;
  return hasMedia ? 'See the Full Recap' : 'View Details';
}

/* ── Flagship = soonest featured upcoming event, else soonest upcoming.
   No detail page required — the hero CTA falls back to tickets/calendar. ── */
const flagshipEvent = featured[0] ?? upcoming[0];
const allOther = upcoming.filter(e => e !== flagshipEvent);
const heroEvent = flagshipEvent;

/* ── Looking back: the events of the latest year that has a past event are
   told as chapters; older years are smaller cards. With nothing scheduled the
   hero looks back at that year instead of showing an empty state. ── */
const recapYear = past.length ? String(yearOf(past[0].data)) : '';
const chapterEvents = past.filter(e => String(yearOf(e.data)) === recapYear);
const olderEvents = past.filter(e => String(yearOf(e.data)) !== recapYear);
const heroIsRecap = !flagshipEvent && chapterEvents.length > 0;
const recapIsThisYear = recapYear === today.slice(0, 4);

/* What that year added up to: rooms finished (kids marked completed, by
   room, the same count as the site stats), rooms underway, sponsors thanked */
const yearKids = recapYear ? (await getPublishedKids()).filter(k => String(k.data.year) === recapYear) : [];
const roomsFinished = yearKids.filter(k => k.data.status === 'completed').reduce((n, k) => n + (k.data.roomCount || 1), 0);
const roomsUnderway = yearKids.filter(k => k.data.status === 'in-progress').reduce((n, k) => n + (k.data.roomCount || 1), 0);
const yearSponsors = sponsorCount(chapterEvents.flatMap(e => recaps[e.data.slug]?.sponsors ?? []));
const yearPhotos = chapterEvents.reduce((n, e) => n + (recaps[e.data.slug]?.photos.length ?? 0), 0);

/* Recap hero words: where we were together, then what it built */
const monthOf = (d: string) => fmtWhen(d, { month: 'long' });
const places = [...chapterEvents].reverse().map(e => `${e.data.location.trim()} in ${monthOf(e.data.date)}`);
const placeList = places.length > 1 ? `${places.slice(0, -1).join(', ')} and ${places[places.length - 1]}` : places[0] || '';
const recapThanks = placeList ? `Thank you for joining us at ${placeList}.` : '';
const recapBuilt = roomsFinished
  ? `Every ticket, sponsorship and bid helps build rooms for kids with special needs. We finished ${roomsFinished} of them ${recapIsThisYear ? 'this year' : `in ${recapYear}`}${roomsUnderway ? `, and ${roomsUnderway} more are underway` : ''}.`
  : 'Every ticket, sponsorship and bid helps build rooms for kids with special needs.';

/* The year the next events fall in ("Hear About 2027 First") */
const nextYear = Math.max(Number(recapYear || 0) + 1, Number(today.slice(0, 4)));

/* Recap hero photos: the latest event's first photo (the one staff put
   first), framed wide when it's a landscape shot, and a smaller upright one
   from the event before it (or another from the same event) */
const recapLatest = chapterEvents[0];
const recapMain = recapLatest ? recaps[recapLatest.data.slug].photos[0] : undefined;
const recapMainWide = !!recapMain && ratioOf(recapMain.id) > 1.05;
const recapSecondEvent = chapterEvents[1];
const recapSmall = recapSecondEvent && recaps[recapSecondEvent.data.slug].photos.length
  ? uprightPhoto(recaps[recapSecondEvent.data.slug].photos)
  : recapLatest ? uprightPhoto(recaps[recapLatest.data.slug].photos, recapMain?.id) : undefined;
const recapSmallEvent = recapSecondEvent && recaps[recapSecondEvent.data.slug].photos.length ? recapSecondEvent : recapLatest;
const recapSmallShown = recapSmall && recapSmall.id !== recapMain?.id ? recapSmall : undefined;
/* Without photos, the latest event's poster stands in */
const recapMainId = recapMain?.id || recapLatest?.data.image || '';
const recapMainSrcset = recapMainId ? cfSrcset(recapMainId, [400, 640, 800, 1024], { fit: 'cover', gravity: 'auto', aspectRatio: recapMainWide ? 0.75 : 1.25 }) : '';
const recapMainSizes = recapMainWide ? '(max-width: 767px) 340px, (max-width: 1200px) 42vw, 520px' : '(max-width: 767px) 280px, (max-width: 1200px) 38vw, 420px';
/* Index of a photo inside its event's recap, for opening the tour at it */
const photoIndex = (slug: string, id?: string) => Math.max(0, recaps[slug]?.photos.findIndex(p => p.id === id) ?? 0);

/* Hero link target: detail page → ticket link (upcoming only) → none */
const heroUrl = heroEvent
  ? detailPages[heroEvent.data.slug] || heroEvent.data.ticketUrl || null
  : null;
const heroIsExternal = !!heroEvent && !detailPages[heroEvent.data.slug] && !!heroEvent.data.ticketUrl;

/* ── Photo tour: every past event with photos, newest first ── */
const tourGroups = past
  .filter(e => recaps[e.data.slug]?.photos.length)
  .map(e => {
    const d = e.data as any;
    const r = recaps[d.slug];
    return {
      key: d.slug,
      title: seriesOf(d) ? `${r.name} ${yearOf(d)}` : r.name,
      subtitle: [fmtWhen(d.date, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }), d.location.trim(), d.photographer?.trim() ? `Photos by ${d.photographer.trim()}` : '']
        .filter(Boolean).join(' · '),
      photos: r.photos.map(p => ({ ...p, ratio: ratioOf(p.id) })),
    };
  });

/* ── Labels & colors ── */
const catLabel: Record<string, string> = {
  fundraiser: 'Fundraiser', volunteer: 'Volunteer',
  reveal: 'Room Reveal', community: 'Community', other: 'Event',
};
const catColor: Record<string, string> = {
  fundraiser: '#d4a017', volunteer: '#2e7d32',
  reveal: '#6a3de8', community: '#1976d2', other: '#5A5B61',
};
const catGradient: Record<string, string> = {
  fundraiser: 'linear-gradient(135deg, #7a5a00 0%, #b8860b 40%, #d4a017 80%, #e6b422 100%)',
  volunteer:  'linear-gradient(135deg, #1a472a 0%, #2e7d32 40%, #388e3c 70%, #43a047 100%)',
  reveal:     'linear-gradient(135deg, #2d1b69 0%, #4a2d8a 40%, #6a3de8 70%, #7c4dff 100%)',
  community:  'linear-gradient(135deg, #0d3b66 0%, #1565c0 40%, #1976d2 70%, #2196f3 100%)',
  other:      'linear-gradient(135deg, #2c2c2c 0%, #4a4a4a 40%, #5A5B61 70%, #6D6E74 100%)',
};
const catIcon: Record<string, string> = {
  fundraiser: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></svg>',
  volunteer:  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m15 12-9.373 9.373a1 1 0 0 1-3.001-3L12 9"/><path d="m18 15 4-4"/><path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"/></svg>',
  reveal:     '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/></svg>',
  community:  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/></svg>',
  other:      '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>',
};

/* ── Per-family branding (matches dedicated event detail page accents),
   slug-pattern matched so future years inherit it automatically.
   logo: shown when event has no poster/photos yet — a branded stand-in. */
const brandFamilies: Array<{ pattern: RegExp; gradient: string; logo?: string }> = [
  {
    pattern: /fairway|golf/,
    gradient: 'linear-gradient(145deg, #0d2818 0%, #1a472a 30%, #2e7d32 60%, #1b5e20 100%)',
    logo: 'golf-logo-dark',
  },
];
const slugBrandOf = (slug: string) => brandFamilies.find(b => b.pattern.test(slug));
function eventGradient(ev: { slug: string; category: string }): string {
  return slugBrandOf(ev.slug)?.gradient || catGradient[ev.category];
}
/* Cover image precedence: a photo from the event (past events) → explicit
   poster → first gallery photo → branded logo fallback → none */
function coverImage(ev: { slug: string; image?: string | null; photos?: Array<{ id: string }> }): string | null {
  return recaps[ev.slug]?.photos[0]?.id || ev.image || ev.photos?.[0]?.id || slugBrandOf(ev.slug)?.logo || null;
}
/* Is the cover image a branded logo (render with contain) vs a real photo (render with cover)? */
function coverIsLogo(ev: { slug: string; image?: string | null; photos?: Array<{ id: string }> }): boolean {
  return !recaps[ev.slug]?.photos.length && !ev.image && !ev.photos?.length && !!slugBrandOf(ev.slug)?.logo;
}

/* ── Date helpers ── */
function fmtDate(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
function fmtWeekday(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'long' });
}
function fmtMonth(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-US', { month: 'short' }).toUpperCase();
}
function fmtDay(d: string) {
  return new Date(d + 'T00:00:00').getDate().toString();
}
function fmtYear(d: string) {
  return new Date(d + 'T00:00:00').getFullYear().toString();
}

/* ── Google Calendar link builder ── */
function googleCalUrl(ev: { title: string; date: string; endDate?: string; location: string; address?: string; description: string }) {
  const start = ev.date.replace(/-/g, '');
  // Google all-day ranges use an EXCLUSIVE end date, so the day after the
  // event's last day — for both single-day and explicit-endDate events.
  const lastDay = ev.endDate || ev.date;
  const endExclusive = (() => {
    const d = new Date(lastDay + 'T00:00:00');
    d.setDate(d.getDate() + 1);
    return d.toISOString().split('T')[0];
  })();
  const end = endExclusive.replace(/-/g, '');
  const params = new URLSearchParams({
    action: 'TEMPLATE',
    text: ev.title,
    dates: `${start}/${end}`,
    location: ev.address || ev.location,
    details: ev.description,
  });
  return `https://calendar.google.com/calendar/render?${params}`;
}

/* ── Impact stats for trust section ── */
const computed = await getSiteStats();
const yearsOfImpact = computed.years;
const totalKidsServed = computed.totalKids;
const totalPartners = (await getCollection('partners')).length;

/* ── Hero visual (upcoming event): poster image → branded logo (slugBrand)
   → category icon card. LCP preload only when there's an actual image to paint. ── */
const heroImageId = heroEvent ? heroEvent.data.image || undefined : undefined;
const heroHasImage = !!heroImageId;
const heroLogo = !heroHasImage && heroEvent ? slugBrandOf(heroEvent.data.slug)?.logo : undefined;
const heroImageSrc = heroImageId || heroLogo || '';
const heroSrcset = heroHasImage
  ? cfSrcset(heroImageSrc, [400, 600, 800], { fit: 'contain' })
  : heroLogo
    ? cfSrcset(heroImageSrc, [280, 400])
    : '';
const heroSizes = heroHasImage
  ? '(max-width: 767px) 280px, 440px'
  : '(max-width: 767px) 200px, 320px';
const heroAlt = heroEvent?.data.title || 'Featured event';
const heroGradient = heroEvent ? eventGradient(heroEvent.data) : catGradient.other;

/* Fallback hero photo when there are no events at all */
const sp = siteSettings.sectionPhotos || {};
const fallbackPhotoId = sp.missionMain || 'kids/eli/photo-01';
const fallbackSrcset = cfSrcset(fallbackPhotoId, [400, 640, 800], { fit: 'cover', gravity: 'face' });
const fallbackSizes = '(max-width: 768px) 85vw, (max-width: 1200px) 38vw, 420px';

/* Hero frame is a link when the hero event has somewhere to go */
const HeroFrame = heroUrl ? 'a' : 'div';
const heroFrameAttrs = heroUrl
  ? { href: heroUrl, ...(heroIsExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : {};
---

<BaseLayout
  title="Events — Fundraisers, Reveals & Volunteer Days"
  description={heroIsRecap
    ? `Photos and highlights from ${placeList ? `our ${recapYear} events at ${placeList}` : `our ${recapYear} events`}, and how to hear about ${nextYear} first.`
    : 'Join us at upcoming fundraisers, room reveals, and volunteer build days in Atlanta. See how you can help build dream rooms for kids with special needs.'}
  ogImage={heroIsRecap && recapMainId ? cfRaw(recapMainId, 'w=1200,h=630,fit=cover,gravity=auto,q=82') : undefined}
  breadcrumbs={[{ name: 'Events', url: '/events/' }]}
>
  {/* LCP preload */}
  {heroEvent ? (
    heroSrcset && <link slot="head" rel="preload" as="image" imagesrcset={heroSrcset} imagesizes={heroSizes} fetchpriority="high" />
  ) : heroIsRecap ? (
    recapMainSrcset && <link slot="head" rel="preload" as="image" imagesrcset={recapMainSrcset} imagesizes={recapMainSizes} fetchpriority="high" />
  ) : (
    <link slot="head" rel="preload" as="image" imagesrcset={fallbackSrcset} imagesizes={fallbackSizes} fetchpriority="high" />
  )}

  <!-- ═══════════════════════════════════════════
       HERO — Editorial split: the next upcoming event,
       else a look back at the latest year of events
       ═══════════════════════════════════════════ -->
  {heroEvent ? (
    <section class="hero hero--event">
      <div class="hero-inner">
        <div class="hero-text">
          <div class="hero-badges">
            <p class="hero-eyebrow">{heroEvent.data.featured ? 'Featured Event' : 'Next Up'}</p>
            <span class="hero-countdown" data-countdown={heroEvent.data.date} data-countdown-end={heroEvent.data.endDate || heroEvent.data.date} aria-live="polite"></span>
          </div>
          <h1 class="hero-headline">{heroEvent.data.title}</h1>
          <p class="hero-sub">{heroEvent.data.shortDescription || heroEvent.data.description}</p>
          <div class="hero-meta">
            <div class="hero-meta__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
              <time datetime={heroEvent.data.date}>{fmtWeekday(heroEvent.data.date)}, {fmtDate(heroEvent.data.date)}</time>
            </div>
            <div class="hero-meta__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
              {heroEvent.data.location}
            </div>
            {heroEvent.data.time && (
              <div class="hero-meta__item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                {heroEvent.data.time}
              </div>
            )}
          </div>
          {(
            <div class="hero-ctas">
              {detailPages[heroEvent.data.slug] ? (
                <a href={detailPages[heroEvent.data.slug]} class="btn btn-primary btn-lg">
                  View Details & Register
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              ) : heroEvent.data.ticketUrl ? (
                <a href={heroEvent.data.ticketUrl} class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
                  Get Tickets
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                </a>
              ) : null}
              <a href={googleCalUrl(heroEvent.data)} class={heroUrl ? 'btn btn-dark' : 'btn btn-primary btn-lg'} target="_blank" rel="noopener noreferrer" title="Add to Google Calendar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                Add to Calendar
              </a>
            </div>
          )}
        </div>
        <HeroFrame class="hero-frame" {...heroFrameAttrs}>
          <div class="hero-event-card" style={`--hero-card-gradient: ${heroGradient}`}>
            <div class="hero-event-card__bg" aria-hidden="true"></div>
            <div class="hero-event-card__gradient" aria-hidden="true"></div>
            <div class="hero-event-card__pattern" aria-hidden="true"></div>
            {heroHasImage || heroLogo ? (
              <img
                src={heroHasImage
                  ? cfRaw(heroImageSrc, 'w=600,fit=contain,q=85')
                  : cfRaw(heroImageSrc, 'w=400,q=85')}
                srcset={heroSrcset}
                sizes={heroSizes}
                alt={heroAlt}
                transition:name="event-hero"
                width={heroHasImage ? 600 : 400}
                height={heroHasImage ? 600 : 400}
                loading="eager" decoding="async" fetchpriority="high"
                class={heroHasImage ? 'hero-event-card__photo' : 'hero-event-card__logo'}
              />
            ) : (
              <div class="hero-event-card__icon" aria-hidden="true" set:html={catIcon[heroEvent.data.category]} />
            )}
            {/* Mini date card overlay */}
            <div class="hero-date-card">
              <time datetime={heroEvent.data.date}>
                <span class="hero-date-card__month">{fmtMonth(heroEvent.data.date)}</span>
                <span class="hero-date-card__day">{fmtDay(heroEvent.data.date)}</span>
                <span class="hero-date-card__year">{fmtYear(heroEvent.data.date)}</span>
              </time>
            </div>
          </div>
        </HeroFrame>
      </div>
    </section>
  ) : heroIsRecap ? (
    <section class="hero hero--recap">
      <div class="hero-inner">
        <div class="hero-text">
          <div class="hero-badges">
            <p class="hero-eyebrow">Looking Back at {recapYear}</p>
          </div>
          <h1 class="hero-headline">{recapYear} {recapIsThisYear ? 'Has Been' : 'Was'} Full of <em class="highlight">Sunshine</em></h1>
          <p class="hero-sub">{recapThanks} {recapBuilt}</p>
          <div class="hero-ctas">
            {yearPhotos > 0 ? (
              <a href="#past" class="btn btn-primary btn-lg" data-photo-tour>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
                See All {yearPhotos} Photos
              </a>
            ) : (
              <a href="#past" class="btn btn-primary btn-lg">Look Back at {recapYear}</a>
            )}
            <a href="#newsletter-email" class="btn btn-dark" data-newsletter-focus>Hear About {nextYear} First</a>
          </div>
        </div>
        <div class={`hero-frame hero-frame--recap${recapMainWide ? ' hero-frame--wide' : ''}`}>
          <div class="hero-accent" aria-hidden="true"></div>
          {recapMainId ? (
            <a
              class={`hero-photo hero-photo--link${recapMainWide ? ' hero-photo--wide' : ''}`}
              href={recapMain && detailPages[recapLatest.data.slug] ? `${detailPages[recapLatest.data.slug]}#photo-${photoIndex(recapLatest.data.slug, recapMain.id) + 1}` : '#past'}
              {...(recapMain ? { 'data-photo-tour': recapLatest.data.slug, 'data-photo-index': photoIndex(recapLatest.data.slug, recapMain.id) } : {})}
              aria-label={recapMain ? `Open the photos from ${recaps[recapLatest.data.slug].name}` : `Look back at ${recaps[recapLatest.data.slug].name}`}
              style={`background-image:url('${cfLqip(recapMainId)}')`}
            >
              <img
                src={cfRaw(recapMainId, recapMainWide ? 'w=800,h=600,fit=cover,gravity=auto,q=82' : 'w=640,h=800,fit=cover,gravity=auto,q=82')}
                srcset={recapMainSrcset}
                sizes={recapMainSizes}
                alt={recapMain?.alt || `${recaps[recapLatest.data.slug].name}, ${monthOf(recapLatest.data.date)} ${recapYear}`}
                width={recapMainWide ? 800 : 640} height={recapMainWide ? 600 : 800}
                loading="eager" decoding="async" fetchpriority="high"
                class="hero-photo__img"
              />
            </a>
          ) : (
            <div class="hero-photo" style={`background-image:url('${cfLqip(fallbackPhotoId)}')`}>
              <img
                src={cfRaw(fallbackPhotoId, 'w=640,h=800,fit=cover,gravity=face,q=82')}
                srcset={fallbackSrcset}
                sizes={fallbackSizes}
                alt="A child smiling in their new dream room"
                width="640" height="800"
                loading="eager" decoding="async" fetchpriority="high"
                class="hero-photo__img"
              />
            </div>
          )}
          {recapSmallShown && recapSmallEvent && (
            <a
              class="hero-photo hero-photo--small"
              href={detailPages[recapSmallEvent.data.slug] ? `${detailPages[recapSmallEvent.data.slug]}#photo-${photoIndex(recapSmallEvent.data.slug, recapSmallShown.id) + 1}` : '#past'}
              data-photo-tour={recapSmallEvent.data.slug}
              data-photo-index={photoIndex(recapSmallEvent.data.slug, recapSmallShown.id)}
              aria-label={`Open the photos from ${recaps[recapSmallEvent.data.slug].name}`}
              style={`background-image:url('${cfLqip(recapSmallShown.id)}')`}
            >
              <img
                src={cfRaw(recapSmallShown.id, 'w=360,h=432,fit=cover,gravity=auto,q=78')}
                srcset={cfSrcset(recapSmallShown.id, [240, 360, 480], { fit: 'cover', gravity: 'auto', aspectRatio: 1.2, quality: 78 })}
                sizes="180px"
                alt={recapSmallShown.alt || `${recaps[recapSmallEvent.data.slug].name}, ${monthOf(recapSmallEvent.data.date)} ${yearOf(recapSmallEvent.data)}`}
                width="360" height="432"
                loading="eager" decoding="async"
              />
            </a>
          )}
          <div class="hero-stat">
            {roomsFinished > 0 ? (
              <>
                <span class="hero-stat__num">{roomsFinished}</span>
                <span class="hero-stat__label">rooms finished<br />in {recapYear}</span>
              </>
            ) : (
              <>
                <span class="hero-stat__num">{totalKidsServed}+</span>
                <span class="hero-stat__label">children served<br />since 2012</span>
              </>
            )}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-text">
          <p class="hero-eyebrow">Events & Fundraisers</p>
          <h1 class="hero-headline">Where Community Comes Together for <em class="highlight">Something&nbsp;Big</em></h1>
          <p class="hero-sub">Every gala, build day, and room reveal brings us one step closer to transforming the life of a child with special needs.</p>
          <div class="hero-ctas">
            <a href="#upcoming" class="btn btn-primary btn-lg">See Upcoming Events</a>
            <a href="#past" class="btn btn-dark">Past Highlights</a>
          </div>
        </div>
        <div class="hero-frame">
          <div class="hero-accent" aria-hidden="true"></div>
          <div class="hero-photo" style={`background-image:url('${cfLqip(fallbackPhotoId)}')`}>
            <img
              src={cfRaw(fallbackPhotoId, 'w=640,h=800,fit=cover,gravity=face,q=82')}
              srcset={fallbackSrcset}
              sizes={fallbackSizes}
              alt="A child smiling in their new dream room"
              width="640" height="800"
              loading="eager" decoding="async" fetchpriority="high"
              class="hero-photo__img lqip-img"
            />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════
       UPCOMING EVENTS
       ═══════════════════════════════════════════ -->
  <!-- Confirmed reveal days, filled in by script from /api/reveals (JobTread).
       Stays hidden until at least one reveal is confirmed. -->
  <section class="ev-reveals" id="reveals" data-upcoming-reveals hidden>
    <div class="container">
      <div class="ev-reveals__header">
        <p class="ev-section-label">Room Reveals</p>
        <h2 class="ev-section-heading">Watch a Room <em class="highlight">Reveal</em> Live</h2>
        <p class="ev-section-sub">Join online for the moment a child walks into their finished room for the first time.</p>
      </div>
      <div class="ev-reveals__grid" data-upcoming-reveals-grid></div>
    </div>
  </section>

  {allOther.length > 0 && (
    <section class="ev-upcoming" id="upcoming">
      <div class="container">
        <div class="ev-upcoming__header" data-reveal>
          <p class="ev-section-label">What's Coming Up</p>
          <h2 class="ev-section-heading">More Ways to <em class="highlight">Get Involved</em></h2>
          <p class="ev-section-sub">Each event is an opportunity to change a child's world. Pick one that speaks to you.</p>
        </div>

        <div class="ev-grid">
          {allOther.map((event, i) => (
            <EventCard
              event={event.data}
              detailUrl={detailPages[event.data.slug]}
              calendarUrl={googleCalUrl(event.data)}
              index={i}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════
       EMPTY STATE (only when there are no events at all —
       otherwise the hero recaps the latest past event)
       ═══════════════════════════════════════════ -->
  {upcoming.length === 0 && past.length === 0 && (
    <section class="ev-empty" id="upcoming">
      <div class="container">
        <div class="ev-empty__box" data-reveal>
          <div class="ev-empty__icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
          </div>
          <h2>Something Special is Brewing</h2>
          <p>We're planning our next events. Follow us on social media to be the first to know!</p>
          <a href="/donate/" class="ev-btn ev-btn--gold">Support Our Mission</a>
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════
       LOOKING BACK — the latest year's events as
       chapters (photos, achievements, quote, sponsors),
       earlier years as smaller cards
       ═══════════════════════════════════════════ -->
  {past.length > 0 && (
    <section class="ev-past" id="past" aria-labelledby="past-heading">
      <div class="container">
        <div class="ev-past__header" data-reveal>
          <p class="ev-section-label">{heroIsRecap ? `${recapYear} in Review` : 'Looking Back'}</p>
          <h2 id="past-heading" class="ev-section-heading">Moments That <em class="highlight">Mattered</em></h2>
          <p class="ev-section-sub">{heroIsRecap
            ? `Here's how ${chapterEvents.length === 1 ? 'the day' : 'each day'} went, with the people and sponsors who made ${chapterEvents.length === 1 ? 'it' : 'them'} happen.`
            : 'Every event we host writes another chapter in our story of impact.'}</p>
        </div>

        {chapterEvents.length > 0 && (
          <dl class="ev-year" aria-label={`${recapYear} at a glance`} data-reveal>
            {roomsFinished > 0 && (
              <div class="ev-year__item"><dt>Rooms finished in {recapYear}</dt><dd>{roomsFinished}</dd></div>
            )}
            {yearSponsors > 0 && (
              <div class="ev-year__item"><dt>Sponsors thanked</dt><dd>{yearSponsors}</dd></div>
            )}
            <div class="ev-year__item"><dt>{chapterEvents.length === 1 ? 'Event' : 'Events'} in {recapYear}</dt><dd>{chapterEvents.length}</dd></div>
            {yearPhotos > 0 && (
              <div class="ev-year__item"><dt>Photos</dt><dd>{yearPhotos}</dd></div>
            )}
          </dl>
        )}

        <div class="ev-chapters">
          {chapterEvents.map((event, ci) => {
            const d = event.data as any;
            const r = recaps[d.slug];
            const url = detailPages[d.slug];
            /* The hero already shows this event's first photo; start the mosaic after it */
            const skip = heroIsRecap && event === recapLatest && recapMain && r.photos.length > 5 ? 1 : 0;
            const tiles = r.photos.slice(skip, skip + 5);
            const wide = tiles.length > 0 && ratioOf(tiles[0].id) > 1.05;
            const more = r.photos.length - skip - tiles.length;
            const { levels } = splitSponsors(r.sponsors) as { levels: SponsorTier[] };
            const logos = levels.flatMap(t => t.names.filter(n => n.logo)).slice(0, 8);
            const unlisted = r.sponsorTotal - logos.length;
            const headingId = `recap-${d.slug}-heading`;
            return (
              <article class={`ev-chapter${ci % 2 ? ' ev-chapter--flip' : ''}`} id={`recap-${d.slug}`} aria-labelledby={headingId} data-reveal>
                <div class="ev-chapter__media">
                  {tiles.length > 0 ? (
                    <div class={`ev-mosaic ev-mosaic--${tiles.length}${wide ? ' ev-mosaic--wide' : ''}`} style={`--n:${Math.max(1, tiles.length - 1)}`}>
                      {tiles.map((p, i) => (
                        <a
                          class="ev-mosaic__tile"
                          href={url ? `${url}#photo-${skip + i + 1}` : '#past'}
                          data-photo-tour={d.slug}
                          data-photo-index={skip + i}
                          aria-label={`Open photo ${skip + i + 1} of ${r.photos.length} from ${r.name}`}
                        >
                          <img
                            src={cfRaw(p.id, i === 0 ? (wide ? 'w=960,h=640,fit=cover,gravity=auto,q=82' : 'w=720,h=960,fit=cover,gravity=auto,q=82') : 'w=360,h=360,fit=cover,gravity=auto,q=78')}
                            srcset={i === 0
                              ? cfSrcset(p.id, [480, 720, 960, 1280], { fit: 'cover', gravity: 'auto', aspectRatio: wide ? 2 / 3 : 4 / 3, quality: 82 })
                              : cfSrcset(p.id, [240, 360, 480], { fit: 'cover', gravity: 'auto', aspectRatio: 1, quality: 78 })}
                            sizes={i === 0 ? (wide ? '(max-width: 899px) 92vw, 600px' : '(max-width: 899px) 60vw, 360px') : '(max-width: 899px) 23vw, 150px'}
                            alt={p.alt || ''}
                            width={i === 0 ? (wide ? 960 : 720) : 360} height={i === 0 ? (wide ? 640 : 960) : 360}
                            loading="lazy" decoding="async"
                          />
                          {i === tiles.length - 1 && more > 0 && (
                            <span class="ev-mosaic__more" aria-hidden="true">+{more}</span>
                          )}
                        </a>
                      ))}
                    </div>
                  ) : (
                    <div class="ev-chapter__placeholder" style={`background: ${eventGradient(d)}`}>
                      <div class="ev-chapter__placeholder-icon" aria-hidden="true" set:html={catIcon[d.category]} />
                      <span>Photos on the way</span>
                    </div>
                  )}
                </div>

                <div class="ev-chapter__body">
                  <p class="ev-chapter__kicker">
                    <span class="ev-chapter__cat" style={`--cat: ${catColor[d.category]}`}>{seriesOf(d) ? seriesOf(d).kind.replace(/\b\w/g, (c: string) => c.toUpperCase()) : catLabel[d.category]}</span>
                    <time datetime={d.date}>{fmtDate(d.date)}</time>
                  </p>
                  <h3 id={headingId} class="ev-chapter__title">{r.name}</h3>
                  {d.theme?.trim() && <p class="ev-chapter__theme">{d.theme.trim()}</p>}
                  <p class="ev-chapter__loc">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                    {d.location}
                  </p>
                  <p class="ev-chapter__lead">{r.lead}</p>

                  {r.highlights.length > 0 && (
                    <dl class="ev-chapter__stats">
                      {r.highlights.map(h => (
                        <div class="ev-chapter__stat"><dt>{h.label}</dt><dd>{h.value}</dd></div>
                      ))}
                    </dl>
                  )}

                  {r.quote && (
                    <blockquote class="ev-chapter__quote">
                      <p>{r.quote.text}</p>
                      {r.quote.cite && <cite>{r.quote.cite}</cite>}
                    </blockquote>
                  )}

                  {logos.length > 0 && (
                    <div class="ev-chapter__sponsors">
                      <p class="ev-chapter__sponsors-label">Made possible by {r.sponsorTotal} sponsors</p>
                      <ul class="ev-chapter__logos" role="list">
                        {logos.map(n => (
                          <li class="ev-chapter__logo" style={n.scale ? `--logo-scale:${n.scale}` : undefined}>
                            <img
                              src={cfRaw(n.logo!, 'w=240,h=120,fit=contain,q=88')}
                              alt={n.name}
                              width="240" height="120"
                              loading="lazy" decoding="async"
                            />
                          </li>
                        ))}
                        {unlisted > 0 && (
                          <li class="ev-chapter__logo ev-chapter__logo--more">
                            {url ? <a href={url}>+{unlisted} more</a> : <span>+{unlisted} more</span>}
                          </li>
                        )}
                      </ul>
                    </div>
                  )}

                  <div class="ev-chapter__actions">
                    {r.photos.length > 0 && (
                      <a href={url ? `${url}#photos` : '#past'} class="ev-btn ev-btn--gold" data-photo-tour={d.slug}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
                        See All {r.photos.length} Photos
                      </a>
                    )}
                    {url && (
                      <a href={url} class="ev-chapter__link">
                        {pastLinkLabel(d)}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        {/* Earlier years: smaller cards */}
        {olderEvents.length > 0 && (
          <h3 class="ev-older__heading" data-reveal>Earlier Events</h3>
        )}
        {olderEvents.length > 0 && (
          <div class="ev-memories">
            {olderEvents.map((event, i) => (
              <article class="ev-memory" data-reveal data-delay={String(Math.min(i, 3))}>
                <div class="ev-memory__visual" style={`background: ${eventGradient(event.data)}`}>
                  {(() => {
                    const cov = coverImage(event.data);
                    const isLogo = coverIsLogo(event.data);
                    if (!cov) {
                      return (
                        <>
                          <div class="ev-memory__pattern" aria-hidden="true"></div>
                          <div class="ev-memory__glow" aria-hidden="true"></div>
                          <div class="ev-memory__placeholder">
                            <div class="ev-memory__icon" set:html={catIcon[event.data.category]} />
                            <span class="ev-memory__placeholder-label">Photos Coming Soon</span>
                          </div>
                        </>
                      );
                    }
                    if (isLogo) {
                      return (
                        <img
                          src={cfRaw(cov, 'w=520,fit=contain,q=85')}
                          srcset={cfSrcset(cov, [360, 520, 720], { fit: 'contain' })}
                          sizes="(max-width: 639px) 100vw, (max-width: 959px) 50vw, 33vw"
                          alt={event.data.title}
                          width="520" height="260"
                          loading="lazy" decoding="async"
                          class="ev-memory__img ev-memory__img--logo"
                        />
                      );
                    }
                    return (
                      <img
                        src={cfRaw(cov, 'w=520,h=260,fit=cover,q=82')}
                        srcset={cfSrcset(cov, [360, 520, 720], { height: 260, fit: 'cover' })}
                        sizes="(max-width: 639px) 100vw, (max-width: 959px) 50vw, 33vw"
                        alt={event.data.title}
                        width="520" height="260"
                        loading="lazy" decoding="async"
                        class="ev-memory__img"
                      />
                    );
                  })()}
                  <div class="ev-memory__date-badge">
                    <span class="ev-memory__month">{fmtMonth(event.data.date)}</span>
                    <span class="ev-memory__day">{fmtDay(event.data.date)}</span>
                    <span class="ev-memory__year">{fmtYear(event.data.date)}</span>
                  </div>
                  {recaps[event.data.slug]?.photos.length > 0 && (
                    <span class="ev-memory__count">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
                      {recaps[event.data.slug].photos.length} photos
                    </span>
                  )}
                </div>
                <div class="ev-memory__content">
                  <div class="ev-memory__top">
                    <span class="ev-memory__cat" style={`--cat: ${catColor[event.data.category]}`}>{catLabel[event.data.category]}</span>
                  </div>
                  <h3 class="ev-memory__title">{event.data.title}</h3>
                  <p class="ev-memory__loc">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                    {event.data.location}
                  </p>
                  <p class="ev-memory__desc">{recaps[event.data.slug]?.lead || event.data.shortDescription || event.data.description}</p>
                  {(() => {
                    /* Mini gallery row — skip the photo already used as the card cover */
                    const thumbs = (recaps[event.data.slug]?.photos ?? []).slice(1, 4);
                    if (thumbs.length === 0) return null;
                    return (
                      <div class="ev-memory__thumbs">
                        {thumbs.map((p, ti) => (
                          <a href={detailPages[event.data.slug] ? `${detailPages[event.data.slug]}#photo-${ti + 2}` : '#past'} class="ev-memory__thumb" data-photo-tour={event.data.slug} data-photo-index={ti + 1} aria-label={`Open photo ${ti + 2} from ${event.data.title}`}>
                            <img
                              src={cfRaw(p.id, 'w=200,h=150,fit=cover,q=78')}
                              srcset={cfSrcset(p.id, [150, 200, 300], { height: 150, fit: 'cover' })}
                              sizes="90px"
                              alt={p.alt || event.data.title}
                              width="200" height="150"
                              loading="lazy" decoding="async"
                            />
                          </a>
                        ))}
                      </div>
                    );
                  })()}
                  {detailPages[event.data.slug] && (
                    <a href={detailPages[event.data.slug]} class="ev-memory__link">
                      {pastLinkLabel(event.data)}
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════
       IMPACT TRUST SECTION (dark editorial split)
       ═══════════════════════════════════════════ -->
  <section class="ev-impact">
    <div class="ev-impact__glow" aria-hidden="true"></div>
    <div class="container">
