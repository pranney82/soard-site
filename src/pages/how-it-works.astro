    display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: start;
  }
  .rail { position: sticky; top: calc(var(--hdr, 84px) + 20px); padding: 40px 0; min-width: 0; }
  .rail__label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-light); margin: 0 0 14px; }
  .rail__list { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--c-border); position: relative; max-width: 100%; }
  /* Progress: the yellow line fills from the top down to the chapter in view */
  .rail__list::before {
    content: ''; position: absolute; left: -2px; top: 0; width: 2px;
    height: var(--rail-progress, 0%); background: var(--c-yellow);
