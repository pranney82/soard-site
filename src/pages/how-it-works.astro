---
/**
 * How It Works · /how-it-works/
 *
 * The process page for donors, partners, and funders. Instead of a generic
 * four-step list, it follows ONE real project from application to reveal using
 * the artifacts that project already has on file: the designer's presentation
 * boards, the dimensioned floor plans, the partner roster, the site photos,
 * the reveal video, and the before/after pair.
 *
 * Featured project: siteSettings.howItWorks.kidSlug (Admin → Kids on Site),
 * falling back to the most recent kid that has drawings and a video.
 *
 * PERF: hero LCP preload, lazy media below the fold, click-to-load video.
 * SEO:  HowTo + VideoObject JSON-LD, breadcrumbs.
 * A11Y: chapter rail is a real nav, video facade and slider are keyboard-operable.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPublishedKids } from '../utils/collections';
import { getSiteStats } from '../utils/stats';
import { CF_BASE as CF, cfId, cfRaw, cfSrcset, cfLqip } from '../utils/cf-image';
import { getVideoSchema } from '../utils/schema';
import siteSettings from '../content/site/settings.json';
import financialSnapshot from '../content/site/financial-snapshot.json';
import dimsManifest from '../data/dimensions-kids.json';
const dimsMap: Record<string, [number, number]> = dimsManifest;

const SITE = 'https://sunshineonaranneyday.com';
const pageUrl = `${SITE}/how-it-works/`;

/* ── Featured project ── */
const allKids = await getPublishedKids();
const hasCaseFile = (k: any) => (k.data.plans?.length || 0) > 0 && (k.data.streamVideoId || k.data.videoUrl);
const pinnedSlug = (siteSettings as any).howItWorks?.kidSlug || 'amari';
const kid =
  allKids.find(k => k.data.slug === pinnedSlug && hasCaseFile(k)) ||
  allKids.filter(hasCaseFile).sort((a, b) => (b.data.year || 0) - (a.data.year || 0))[0] ||
  allKids.find(k => k.data.slug === pinnedSlug) ||
  allKids[0];
const k = kid.data;
const name = k.name;
const year = k.year || new Date().getFullYear();
const rooms = (k.roomTypes || []).map(r => r.toLowerCase());
const roomsText = rooms.length > 1 ? `${rooms.slice(0, -1).join(', ')} and ${rooms[rooms.length - 1]}` : (rooms[0] || 'dream room');

const heroId = cfId(k.heroImage || '') || `kids/${k.slug}/hero`;
const portraitId = cfId(k.accentImage || '') || heroId;
const bioText = (k.bio || '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
const bioSentences = bioText.split(/(?<=[.!?])\s+/).filter(Boolean);
const storyExcerpt = bioSentences.slice(0, 3).join(' ');

/* ── The drawings ──
   Designers upload three kinds of files under "plans": presentation boards
   (PNG), floor plans (PNG, labeled Before/After or Existing/Proposed), and
   site photos from the build app (JPG). Sort them by those conventions. */
const plans: Array<{ url: string; label: string; type: string }> = k.plans || [];
const isPng = (p: { url: string }) => /\.png(\/|$)/i.test(p.url);
const isFloorPlan = (p: { label: string }) => /(before|after|existing|existi|proposed|layout|floor\s*plan)/i.test(p.label || '');
const floorPlans = plans.filter(isFloorPlan);
/* Existing first, proposed second. Labels usually say which; when a designer
   exports both pages under one name ("Existing - Proposed.pdf", "-2"), the
   first is the existing plan and the second the proposed one. */
const existingPlan = floorPlans.find(p => /(before|existing|existi)/i.test(p.label) && !/^(after|proposed)/i.test(p.label)) || floorPlans[0] || null;
const proposedPlan = floorPlans.find(p => p !== existingPlan && /(after|proposed)/i.test(p.label)) || floorPlans.find(p => p !== existingPlan) || null;
/* Floor plans carry a title block along the bottom edge with the family's
   street address. Serve every plan URL as a top-anchored crop that drops the
   bottom ~10%, the same rule the kid profile page applies. */
const TITLE_BLOCK = 0.10;
function planRatio(url: string): number {
  const known = dimsMap[cfId(url)];
  return (known ? known[1] / known[0] : 768 / 1187) * (1 - TITLE_BLOCK);
}
const planSrc = (url: string, w: number) => cfRaw(url, `w=${w},h=${Math.round(w * planRatio(url))},fit=cover,gravity=top,q=80`);
const planSet = (url: string) => cfSrcset(url, [600, 1000, 1400], { fit: 'cover', gravity: 'top', aspectRatio: planRatio(url), quality: 80 });
const boards = plans.filter(p => isPng(p) && !isFloorPlan(p));
const sitePhotos = plans.filter(p => !isPng(p) && !isFloorPlan(p));
/* Five survey photos spread across the set so one corner doesn't repeat:
   lead + four small tiles fill the grid exactly at every breakpoint. */
const pickSpread = (arr: typeof sitePhotos) => {
  const n = arr.length;
  if (n <= 5) return arr;
  const idx = [Math.floor(n * 0.4), 1, Math.floor(n * 0.55), Math.floor(n * 0.7), Math.floor(n * 0.9)];
  return [...new Set(idx)].map(i => arr[i]);
};
const buildPhotos = pickSpread(sitePhotos);

/* ── The crew: match the project's partner logos to the partners collection ── */
const partnerCollection = await getCollection('partners');
const byLogo = new Map(partnerCollection.filter(p => p.data.logo).map(p => [cfId(p.data.logo!), p.data]));
type Crew = { name: string; logo: string; role: string };
const roleOf = (cats: string[]) =>
  cats.includes('design') ? 'design' : cats.includes('funding') ? 'funding' : cats.includes('build') ? 'build' : 'community';
const crew: Crew[] = [];
for (const pl of k.partnerLogos || []) {
  const id = cfId(pl.url);
  let match = byLogo.get(id);
  if (!match) for (const [lid, data] of byLogo) { if (id.startsWith(lid) || lid.startsWith(id)) { match = data; break; } }
  if (match) crew.push({ name: match.name, logo: id, role: roleOf(match.category as string[]) });
  else crew.push({ name: '', logo: id, role: 'build' });
}
const roleGroups = [
  { key: 'funding', title: 'Funded it', blurb: 'Sponsors and foundations who covered what nobody could donate.' },
  { key: 'design', title: 'Designed it', blurb: 'Designers who drew the room and picked every finish.' },
  { key: 'build', title: 'Built and supplied it', blurb: 'Manufacturers, suppliers, and trades who gave materials and labor.' },
  { key: 'community', title: 'Showed up for it', blurb: 'Photographers, caterers, and neighbors who made reveal day.' },
].map(g => ({ ...g, members: crew.filter(c => c.role === g.key) })).filter(g => g.members.length > 0);

/* ── Video + before/after ── */
const streamId = k.streamVideoId || null;
const ytMatch = (k.videoUrl || '').match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([a-zA-Z0-9_-]{11})/);
const ytId = !streamId && ytMatch ? ytMatch[1] : null;
const hasVideo = !!(streamId || ytId);
const pair = (k.beforeAfterPhotos || [])[0] || null;

/* ── Scale ── */
const stats = await getSiteStats();
const partnerCount = partnerCollection.length;
const perYear = Math.round(stats.totalRooms / Math.max(stats.years, 1));
const programPct = financialSnapshot.programPct;

/* ── Chapters (drive the rail, the anchors, and the HowTo schema) ── */
const chapters = [
  { id: 'apply', num: '01', short: 'Apply', title: "It starts with a family's story.", schema: 'A family applies online, shares photos, and records a video walkthrough of the space. Applications are read by the selection committee, followed by an interview and a home visit.' },
  { id: 'design', num: '02', short: 'Design', title: 'Drawn three ways, then walked at full scale.', schema: 'Design partners measure the space and draw several layouts. Three go to the family, who walk them at full size at Walk Your Plans before choosing one. Only then are the theme, colors, and finishes chosen.' },
  { id: 'crew', num: '03', short: 'Crew', title: 'Then the crew assembles.', schema: 'The drawings become a materials list. Manufacturers and suppliers donate materials, sponsors fund the rest, and trade partners donate labor.' },
  { id: 'build', num: '04', short: 'Build', title: 'Walls come down.', schema: 'The contractor documents the existing space, then runs a full renovation: demolition, framing, plumbing, electrical, and finishes. Build time varies by project.' },
  { id: 'reveal', num: '05', short: 'Reveal', title: 'The child walks in.', schema: 'The finished room is revealed to the child and family, filmed, and often streamed live.' },
  { id: 'scale', num: '06', short: 'Scale', title: 'Every room since 2012 has followed these steps.', schema: 'The same six steps have produced hundreds of rooms across greater Atlanta since 2012.' },
];

const breadcrumbs = [
  { name: 'Home', url: `${SITE}/` },
  { name: 'How It Works', url: pageUrl },
];
const howToSchema = {
  '@type': 'HowTo',
  name: 'How Sunshine on a Ranney Day builds a room',
  description: `The six steps every SOARD room follows, from a family's application to the reveal, shown through ${name}'s ${roomsText} completed in ${year}.`,
  image: `${CF}/${heroId}/w=1200,h=630,fit=cover,gravity=face`,
  step: chapters.map((c, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: c.title,
    text: c.schema,
    url: `${pageUrl}#${c.id}`,
  })),
};
const videoSchema = hasVideo ? getVideoSchema({
  name: `${name}'s room reveal`,
  description: `The reveal of ${name}'s ${roomsText}, built by Sunshine on a Ranney Day and its partners.`,
  pageUrl,
  streamVideoId: streamId || undefined,
  videoUrl: k.videoUrl || undefined,
  uploadDate: `${year}-01-01`,
}) : null;
const jsonLd = videoSchema ? [howToSchema, videoSchema] : [howToSchema];

const heroTransforms = 'fit=cover,gravity=face,q=72';
const heroSrcset = cfSrcset(heroId, [400, 640, 800, 1024], { fit: 'cover', gravity: 'face', aspectRatio: 1.25, quality: 72 });
const heroSizes = '(max-width: 768px) 85vw, (max-width: 1200px) 38vw, 440px';
---

<BaseLayout
  title="How a Room Gets Built"
  description={`Every SOARD room follows the same six steps, from a family's application to the reveal. Follow ${name}'s ${roomsText} start to finish: the drawings, the partners, the build, and the moment it was revealed.`}
  ogImage="/og/how-it-works.png"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <link slot="head" rel="preload" as="image" imagesrcset={heroSrcset} imagesizes={heroSizes} fetchpriority="high" />

  <!-- ══════ HERO · Editorial split ══════ -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-eyebrow">How It Works</p>
        <h1>How a room <em>gets built</em>.</h1>
        <p class="hero-lead">Every room we build follows the same six steps, from a family's first application to the moment a child walks in. This is one real project, start to finish: {name}'s {roomsText}, completed in {year}.</p>
        <div class="hero-ctas">
          <a href="#apply" class="btn btn-primary btn-lg">Follow the build <span aria-hidden="true">&darr;</span></a>
          <a href="/donate/" class="btn btn-outline-dark">Fund a Room</a>
        </div>
      </div>
      <div class="hero-frame">
        <div class="hero-accent" aria-hidden="true"></div>
        <div class="hero-photo" style={`background-image:url('${cfLqip(heroId)}')`}>
          <img
            src={cfRaw(heroId, `w=640,h=800,${heroTransforms}`)}
            srcset={heroSrcset}
            sizes={heroSizes}
            alt={`${name} in the finished room built by Sunshine on a Ranney Day`}
            width="640" height="800"
            class="lqip-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num">{stats.totalRooms}+</span>
          <span class="hero-stat-label">rooms built<br/>this way</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════ CASE FILE · rail + chapters ══════ -->
  <div class="case" id="case">
    <nav class="rail" aria-label="Chapters">
      <p class="rail__label">The case file</p>
      <ol class="rail__list">
        {chapters.map(c => (
          <li><a href={`#${c.id}`} class="rail__link" data-rail={c.id}><span class="rail__num">{c.num}</span><span class="rail__text">{c.short}</span></a></li>
        ))}
      </ol>
      <p class="rail__project">Project<br/><strong>{name}, {year}</strong></p>
    </nav>

    <div class="chapters">

      <!-- 01 APPLY -->
      <section class="chapter" id="apply" data-chapter="apply" aria-labelledby="h-apply">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num">01</span>
          <h2 id="h-apply">{chapters[0].title}</h2>
        </div>
        <div class="chapter__grid">
          <div class="chapter__text" data-reveal>
            <p>Families apply online in about fifteen minutes. They tell us about their child, share photos, and record a short video walking us through the space so we can see it the way they do. Every application is read by a real person.</p>
            <p>The ones that move forward get an interview, then a home visit, before the selection committee makes its decision. The committee weighs four things:</p>
            <ul class="criteria">
              <li><strong>Daily impact and safety.</strong> How the current space limits the child's independence or puts them at risk.</li>
              <li><strong>Financial circumstances.</strong> Families who could not otherwise afford the work come first.</li>
              <li><strong>Potential for transformation.</strong> Whether a new space would change how the child lives, plays, or heals.</li>
              <li><strong>Scope and feasibility.</strong> Whether the right room can be built inside the home's existing footprint.</li>
            </ul>
          </div>
          <aside class="file" data-reveal data-delay="1">
            <div class="file__photo" style={`background-image:url('${cfLqip(portraitId)}')`}>
              <img src={cfRaw(portraitId, 'w=640,h=520,fit=cover,gravity=face,q=75')} srcset={cfSrcset(portraitId, [400, 640, 900], { fit: 'cover', gravity: 'face', aspectRatio: 0.8125, quality: 75 })} sizes="(max-width: 900px) 90vw, 400px" alt={`${name}`} width="640" height="520" loading="lazy" decoding="async" class="lqip-img" />
            </div>
            <div class="file__body">
              <span class="file__tag">From the file</span>
              <h3 class="file__title">{name}'s application, {year}</h3>
              {storyExcerpt && <p class="file__story">{storyExcerpt}</p>}
              <dl class="file__meta">
                {k.diagnosis && <><dt>Diagnosis</dt><dd>{k.diagnosis}</dd></>}
                <dt>Requested</dt><dd>{(k.roomTypes || []).join(' + ')}</dd>
                {k.age && <><dt>Age</dt><dd>{Array.isArray(k.age) ? k.age.join(', ') : k.age}</dd></>}
              </dl>
            </div>
          </aside>
        </div>
      </section>

      <!-- 02 DESIGN -->
      <section class="chapter" id="design" data-chapter="design" aria-labelledby="h-design">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num">02</span>
          <h2 id="h-design">{chapters[1].title}</h2>
        </div>
        <div class="chapter__text chapter__text--wide" data-reveal>
          <p>Design starts with the space, not the theme. Our designers measure the room and draw several layouts, because where a wheelchair turns, where a shower drains, and where a bed sits decide whether the room works for years. Three layouts go to the family, who walk them at full scale at Walk Your Plans, a partner facility where the plan is laid out life-size so you can stand inside it before anything is built. The family picks one, we make their edits, and only then do the theme, the colors, and the finishes come in.</p>
        </div>
        {existingPlan && proposedPlan && (
          <div class="design-part">
            <p class="chapter__kicker" data-reveal>First, the layout</p>
          <div class="plans" data-reveal data-delay="2">
            <figure class="plan">
              <div class="plan__paper">
                <img src={planSrc(existingPlan.url, 1000)} srcset={planSet(existingPlan.url)} sizes="(max-width: 900px) 92vw, 480px" alt={`Existing floor plan of ${name}'s space`} width="1000" height={Math.round(1000 * planRatio(existingPlan.url))} loading="lazy" decoding="async" />
              </div>
              <figcaption><span class="plan__tag">Existing</span> The space as the family lived in it.</figcaption>
            </figure>
            <div class="plans__arrow" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></div>
            <figure class="plan">
              <div class="plan__paper plan__paper--proposed">
                <img src={planSrc(proposedPlan.url, 1000)} srcset={planSet(proposedPlan.url)} sizes="(max-width: 900px) 92vw, 480px" alt={`Proposed floor plan of ${name}'s new space`} width="1000" height={Math.round(1000 * planRatio(proposedPlan.url))} loading="lazy" decoding="async" />
              </div>
              <figcaption><span class="plan__tag plan__tag--yes">Proposed</span> The layout the family chose after walking three options at full scale.</figcaption>
            </figure>
          </div>
          </div>
        )}
        {boards.length > 0 && (
          <div class="design-part">
            <p class="chapter__kicker" data-reveal>Then, the theme and finishes</p>
          <div class="boards" data-reveal data-delay="1">
            <p class="boards__hint" aria-hidden="true">Swipe through the boards <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></p>
            <div class="boards__scroll" tabindex="0" aria-label="Design presentation boards, scroll sideways">
              {boards.map((b, i) => (
                <figure class="board">
                  <div class="board__paper">
                    <img src={cfRaw(cfId(b.url), 'w=900,q=80')} srcset={cfSrcset(cfId(b.url), [600, 900, 1300], { quality: 80 })} sizes="(max-width: 700px) 86vw, 620px" alt={`Design presentation board ${i + 1} for ${name}'s room`} width="900" height="532" loading="lazy" decoding="async" />
                  </div>
                  <figcaption>Presentation board {String(i + 1).padStart(2, '0')}</figcaption>
                </figure>
              ))}
            </div>
          </div>
          </div>
        )}
      </section>

      <!-- 03 CREW -->
      <section class="chapter" id="crew" data-chapter="crew" aria-labelledby="h-crew">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num">03</span>
          <h2 id="h-crew">{chapters[2].title}</h2>
        </div>
        <div class="chapter__text chapter__text--wide" data-reveal>
          <p>The drawings become a materials list, and partners fill it. Manufacturers donate flooring, tile, and fixtures. Sponsors fund what nobody donates. Trades donate their labor. {crew.length > 0 && <>On this project, <strong>{crew.length} partners</strong> signed on.</>}</p>
        </div>
        {roleGroups.length > 0 && (
          <div class="crew">
            {roleGroups.map((g, gi) => (
              <div class="crew__group" data-reveal data-delay={String(Math.min(gi + 1, 3))}>
                <div class="crew__group-head">
                  <h3>{g.title}</h3>
                  <p>{g.blurb}</p>
                </div>
                <ul class="crew__logos" role="list">
                  {g.members.map(m => (
                    <li class="crew__logo" title={m.name || undefined}>
                      <img src={`${CF}/${m.logo}/w=220,h=110,fit=contain,trim=10,q=80`} srcset={`${CF}/${m.logo}/w=220,h=110,fit=contain,trim=10,q=80 1x, ${CF}/${m.logo}/w=440,h=220,fit=contain,trim=10,q=80 2x`} alt={m.name || 'Partner logo'} width="220" height="110" loading="lazy" decoding="async" onerror="this.closest('li').style.display='none'" />
                      {m.name && <span class="crew__name">{m.name}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </section>

      <!-- 04 BUILD -->
      <section class="chapter" id="build" data-chapter="build" aria-labelledby="h-build">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num">04</span>
          <h2 id="h-build">{chapters[3].title}</h2>
        </div>
        <div class="chapter__text chapter__text--wide" data-reveal>
          <p>Before the first wall comes down, the contractor photographs every inch of the existing space. Then the build runs like any other renovation: demolition, framing, plumbing, electrical, and finishes. Every build runs on its own schedule, and the family stays somewhere else until it is done.</p>
        </div>
        {buildPhotos.length > 0 && (
          <div class="site" data-reveal data-delay="1">
            {buildPhotos.map((p, i) => (
              <figure class={`site__shot ${i === 0 ? 'site__shot--lead' : ''}`}>
                <img src={cfRaw(cfId(p.url), i === 0 ? 'w=1000,h=780,fit=cover,q=78' : 'w=600,h=450,fit=cover,q=78')} srcset={cfSrcset(cfId(p.url), i === 0 ? [600, 1000, 1400] : [400, 600, 900], { fit: 'cover', aspectRatio: i === 0 ? 0.78 : 0.75, quality: 78 })} sizes={i === 0 ? '(max-width: 700px) 92vw, 46vw' : '(max-width: 700px) 45vw, 23vw'} alt={`Existing-conditions photo ${i + 1} from ${name}'s home before construction`} width={i === 0 ? 1000 : 600} height={i === 0 ? 780 : 450} loading="lazy" decoding="async" />
              </figure>
            ))}
            <span class="site__stamp"><span class="site__stamp-dot" aria-hidden="true"></span>Site survey, {year}</span>
          </div>
        )}
        {buildPhotos.length > 0 && (
          <p class="site__caption" data-reveal>The existing space, photographed by the contractor before demolition day.</p>
        )}
      </section>

      <!-- 05 REVEAL -->
      <section class="chapter chapter--dark" id="reveal" data-chapter="reveal" aria-labelledby="h-reveal">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num chapter__num--light">05</span>
          <h2 id="h-reveal">{chapters[4].title}</h2>
        </div>
        <div class="chapter__text chapter__text--wide chapter__text--light" data-reveal>
          <p>Everyone who touched the room is there. The reveal is filmed, often streamed live, and it is the moment every partner and donor is working toward.</p>
        </div>
        {hasVideo && (
          <figure class="video" data-reveal data-delay="1">
            <div class="video__frame">
              {streamId ? (
                <div class="facade" id="video-facade" data-stream={streamId} role="button" tabindex="0" aria-label={`Play ${name}'s reveal video`}>
                  <img
                    src={`https://videodelivery.net/${streamId}/thumbnails/thumbnail.jpg?time=2s&width=1280&height=720&fit=crop`}
                    srcset={[640, 960, 1280, 1600].map(w => `https://videodelivery.net/${streamId}/thumbnails/thumbnail.jpg?time=2s&width=${w}&height=${Math.round(w * 9 / 16)}&fit=crop ${w}w`).join(', ')}
                    sizes="(max-width: 900px) 92vw, 760px"
                    alt="" width="1280" height="720" loading="lazy" decoding="async" class="facade__poster" />
                  <span class="facade__play" aria-hidden="true"><span class="facade__ring"></span><svg viewBox="0 0 24 28" fill="none"><path d="M2 1.5v25l20-12.5L2 1.5z" fill="currentColor"/></svg></span>
                </div>
              ) : (
                <div class="facade" id="video-facade" data-yt={ytId} role="button" tabindex="0" aria-label={`Play ${name}'s reveal video`}>
                  <img src={`https://i.ytimg.com/vi/${ytId}/maxresdefault.jpg`} alt="" width="1280" height="720" loading="lazy" decoding="async" class="facade__poster" />
                  <span class="facade__play" aria-hidden="true"><span class="facade__ring"></span><svg viewBox="0 0 24 28" fill="none"><path d="M2 1.5v25l20-12.5L2 1.5z" fill="currentColor"/></svg></span>
                </div>
              )}
            </div>
            <figcaption>{name}'s reveal, {year}.</figcaption>
          </figure>
        )}
        {pair && (
          <div class="ba" data-reveal data-delay="2">
            <div class="ba__container" style="--ba-pos: 50%" data-ba>
              <img class="ba__after lqip-img" src={cfRaw(cfId(pair.after), 'w=1200,q=82')} srcset={cfSrcset(cfId(pair.after), [600, 900, 1200, 1600], { quality: 82 })} sizes="(max-width: 900px) 92vw, 760px" alt={pair.afterAlt || `${name}'s space after the build`} width="1200" height="900" loading="lazy" decoding="async" style={`--lqip:url('${cfLqip(cfId(pair.after))}')`} />
              <div class="ba__before-clip">
                <img class="ba__before lqip-img" src={cfRaw(cfId(pair.before), 'w=1200,q=82')} srcset={cfSrcset(cfId(pair.before), [600, 900, 1200, 1600], { quality: 82 })} sizes="(max-width: 900px) 92vw, 760px" alt={pair.beforeAlt || `${name}'s space before the build`} width="1200" height="900" loading="lazy" decoding="async" style={`--lqip:url('${cfLqip(cfId(pair.before))}')`} />
              </div>
              <input type="range" min="0" max="100" value="50" class="ba__range" aria-label="Compare before and after" />
              <div class="ba__handle" aria-hidden="true"><span class="ba__line"></span><span class="ba__knob"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12H4m0 0l3-3m-3 3l3 3M16 12h4m0 0l-3-3m3 3l-3 3"/></svg></span></div>
              <span class="ba__label ba__label--before" data-ba-label="before">Before</span>
              <span class="ba__label ba__label--after" data-ba-label="after">After</span>
            </div>
            <p class="ba__hint">Drag to compare {pair.room ? pair.room.toLowerCase() : 'the space'} before and after.</p>
          </div>
        )}
      </section>

      <!-- 06 SCALE -->
      <section class="chapter" id="scale" data-chapter="scale" aria-labelledby="h-scale">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num">06</span>
          <h2 id="h-scale">{chapters[5].title}</h2>
        </div>
        <div class="chapter__text chapter__text--wide" data-reveal>
          <p>That is {stats.totalKids}+ children and {stats.totalRooms}+ rooms across greater Atlanta. The process is the same every time. The room never is.</p>
        </div>
        <div class="scale" data-reveal data-delay="1">
          <div class="scale__stat"><span class="scale__num">{stats.totalRooms}+</span><span class="scale__label">rooms built since 2012</span></div>
          <div class="scale__stat"><span class="scale__num">{perYear}</span><span class="scale__label">rooms a year, on average</span></div>
          <div class="scale__stat"><span class="scale__num">{partnerCount}+</span><span class="scale__label">partners who have joined a build</span></div>
          <div class="scale__stat scale__stat--accent"><span class="scale__num">{programPct}<span class="scale__cent">&cent;</span></span><span class="scale__label">of every dollar goes to programs</span></div>
        </div>
        <p class="scale__foot" data-reveal data-delay="2">The numbers above come from our project records and audited financials. <a href="/about/financials/">See where the money goes</a>.</p>
      </section>

    </div>
  </div>

  <!-- ══════ CLOSING ══════ -->
  <section class="close">
    <div class="close__inner">
      <div class="close__head" data-reveal>
