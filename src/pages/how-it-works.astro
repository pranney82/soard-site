---
/**
 * How It Works · /how-it-works/
 *
 * The process page for donors, partners, and funders. Instead of a generic
 * four-step list, it follows ONE real project from application to reveal using
 * the artifacts that project already has on file: the designer's presentation
 * boards, the dimensioned floor plans, the partner roster, the site photos,
 * the reveal video, and the before/after pair.
 *
 * Featured project: siteSettings.howItWorks.kidSlug (Admin → Kids on Site),
 * falling back to the most recent kid that has drawings and a video.
 *
 * MOTION: the chapter rail's line fills as you read and its bead rides the tip;
 *   chapter heads rise out of a mask; the active chapter's numeral lights up;
 *   photos and logos settle in sequence; the before/after handle sweeps once to
 *   show it moves; the rooms-per-year columns grow from the baseline. All of it
 *   stops under prefers-reduced-motion. No number counters.
 * PERF: hero LCP preload, lazy media below the fold, click-to-load video.
 * SEO:  HowTo + VideoObject JSON-LD, breadcrumbs.
 * A11Y: chapter rail is a real nav with aria-current, plan toggle and board
 *   controls are buttons, the image viewer is a modal <dialog>, the chart has a
 *   table twin, the video facade and slider are keyboard-operable.
 * Browser test: scripts/test-how-it-works.mjs
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPublishedKids } from '../utils/collections';
import { getSiteStats } from '../utils/stats';
import { CF_BASE as CF, cfId, cfRaw, cfSrcset, cfLqip } from '../utils/cf-image';
import { getVideoSchema } from '../utils/schema';
import siteSettings from '../content/site/settings.json';
import financialSnapshot from '../content/site/financial-snapshot.json';
import dimsManifest from '../data/dimensions-kids.json';
const dimsMap: Record<string, [number, number]> = dimsManifest;

const SITE = 'https://sunshineonaranneyday.com';
const pageUrl = `${SITE}/how-it-works/`;

/* ── Featured project ── */
const allKids = await getPublishedKids();
const hasCaseFile = (k: any) => (k.data.plans?.length || 0) > 0 && (k.data.streamVideoId || k.data.videoUrl);
const pinnedSlug = (siteSettings as any).howItWorks?.kidSlug || 'amari';
const kid =
  allKids.find(k => k.data.slug === pinnedSlug && hasCaseFile(k)) ||
  allKids.filter(hasCaseFile).sort((a, b) => (b.data.year || 0) - (a.data.year || 0))[0] ||
  allKids.find(k => k.data.slug === pinnedSlug) ||
  allKids[0];
const k = kid.data;
const name = k.name;
const year = k.year || new Date().getFullYear();
const rooms = (k.roomTypes || []).map(r => r.toLowerCase());
const roomsText = rooms.length > 1 ? `${rooms.slice(0, -1).join(', ')} and ${rooms[rooms.length - 1]}` : (rooms[0] || 'dream room');

const heroId = cfId(k.heroImage || '') || `kids/${k.slug}/hero`;
const portraitId = cfId(k.accentImage || '') || heroId;
const bioText = (k.bio || '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
const bioSentences = bioText.split(/(?<=[.!?])\s+/).filter(Boolean);
const storyExcerpt = bioSentences.slice(0, 3).join(' ');

/* ── The drawings ──
   Designers upload three kinds of files under "plans": presentation boards
   (PNG), floor plans (PNG, labeled Before/After or Existing/Proposed), and
   site photos from the build app (JPG). Sort them by those conventions. */
const plans: Array<{ url: string; label: string; type: string }> = k.plans || [];
const isPng = (p: { url: string }) => /\.png(\/|$)/i.test(p.url);
const isFloorPlan = (p: { label: string }) => /(before|after|existing|existi|proposed|layout|floor\s*plan)/i.test(p.label || '');
const floorPlans = plans.filter(isFloorPlan);
/* Existing first, proposed second. Labels usually say which; when a designer
   exports both pages under one name ("Existing - Proposed.pdf", "-2"), the
   first is the existing plan and the second the proposed one. */
const existingPlan = floorPlans.find(p => /(before|existing|existi)/i.test(p.label) && !/^(after|proposed)/i.test(p.label)) || floorPlans[0] || null;
const proposedPlan = floorPlans.find(p => p !== existingPlan && /(after|proposed)/i.test(p.label)) || floorPlans.find(p => p !== existingPlan) || null;
/* Floor plans carry a title block along the bottom edge with the family's
   street address. Serve every plan URL as a top-anchored crop that drops the
   bottom ~10%, the same rule the kid profile page applies. The image viewer
   uses the same crop. */
const TITLE_BLOCK = 0.10;
function planRatio(url: string): number {
  const known = dimsMap[cfId(url)];
  return (known ? known[1] / known[0] : 768 / 1187) * (1 - TITLE_BLOCK);
}
const planSrc = (url: string, w: number) => cfRaw(url, `w=${w},h=${Math.round(w * planRatio(url))},fit=cover,gravity=top,q=80`);
const planSet = (url: string, widths = [600, 1000, 1400]) => cfSrcset(url, widths, { fit: 'cover', gravity: 'top', aspectRatio: planRatio(url), quality: 80 });
const boards = plans.filter(p => isPng(p) && !isFloorPlan(p));
const sitePhotos = plans.filter(p => !isPng(p) && !isFloorPlan(p));
/* A board's name comes from its file label: "Adrian 2025_Dream Bedroom Design
   Board" reads "Dream Bedroom". Bare numbers fall back to "Presentation board 01". */
const escRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const boardTitle = (label: string, i: number) => {
  const t = (label || '')
    .replace(/^.*_/, '')
    .replace(/\.(png|jpe?g|pdf)$/i, '')
    .replace(new RegExp(`\\b${escRe(name)}\\b`, 'gi'), '')
    .replace(/\b(final|design|presentation|mood|boards?)\b/gi, '')
    .replace(/\b(19|20)\d{2}\b/g, '')
    .replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
  return t && !/^\d+$/.test(t) ? t : `Presentation board ${String(i + 1).padStart(2, '0')}`;
};
/* Five survey photos spread across the set so one corner doesn't repeat:
   lead + four small tiles fill the grid exactly at every breakpoint. */
const pickSpread = (arr: typeof sitePhotos) => {
  const n = arr.length;
  if (n <= 5) return arr;
  const idx = [Math.floor(n * 0.4), 1, Math.floor(n * 0.55), Math.floor(n * 0.7), Math.floor(n * 0.9)];
  return [...new Set(idx)].map(i => arr[i]);
};
const buildPhotos = pickSpread(sitePhotos);

/* ── Video + before/after ── */
const streamId = k.streamVideoId || null;
const ytMatch = (k.videoUrl || '').match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([a-zA-Z0-9_-]{11})/);
const ytId = !streamId && ytMatch ? ytMatch[1] : null;
const hasVideo = !!(streamId || ytId);
const pair = (k.beforeAfterPhotos || [])[0] || null;

/* ── The application photo ──
   The application chapter shows the space as the family lived in it: a survey
   photo the build chapter doesn't already use (and that isn't the before/after
   photo saved for the reveal), else the before photo, else the accent photo. */
const stem = (u: string) => (cfId(u).split('/').pop() || '').replace(/^(plan|ba-before|ba-after)-\d+-/, '');
const shownStems = new Set([...buildPhotos.map(p => stem(p.url)), ...(pair ? [stem(pair.before)] : [])]);
const sparePhoto = sitePhotos.find(p => !shownStems.has(stem(p.url)));
const filePhotoId = sparePhoto ? cfId(sparePhoto.url) : pair ? cfId(pair.before) : portraitId;
const filePhotoIsBefore = !!(sparePhoto || pair);

/* ── The crew: match the project's partner logos to the partners collection ── */
const partnerCollection = await getCollection('partners');
const byLogo = new Map(partnerCollection.filter(p => p.data.logo).map(p => [cfId(p.data.logo!), p.data]));
type Crew = { name: string; logo: string; role: string };
const roleOf = (cats: string[]) =>
  cats.includes('design') ? 'design' : cats.includes('funding') ? 'funding' : cats.includes('build') ? 'build' : 'community';
const crew: Crew[] = [];
for (const pl of k.partnerLogos || []) {
  const id = cfId(pl.url);
  let match = byLogo.get(id);
  if (!match) for (const [lid, data] of byLogo) { if (id.startsWith(lid) || lid.startsWith(id)) { match = data; break; } }
  if (match) crew.push({ name: match.name, logo: id, role: roleOf(match.category as string[]) });
  else crew.push({ name: '', logo: id, role: 'build' });
}
const roleGroups = [
  { key: 'funding', title: 'Funded it', blurb: 'Sponsors and foundations who covered what nobody could donate.' },
  { key: 'design', title: 'Designed it', blurb: 'Designers who drew the room and picked every finish.' },
  { key: 'build', title: 'Built and supplied it', blurb: 'Manufacturers, suppliers, and trades who gave materials and labor.' },
  { key: 'community', title: 'Showed up for it', blurb: 'Photographers, caterers, and neighbors who made reveal day.' },
].map(g => ({ ...g, members: crew.filter(c => c.role === g.key) })).filter(g => g.members.length > 0);

/* ── Scale ── */
const stats = await getSiteStats();
const partnerCount = partnerCollection.length;
const programPct = financialSnapshot.programPct;

/* Rooms per year: the same roomCount sum stats.ts uses, split by project year,
   so the columns add up to the rooms-built total. */
const thisYear = new Date().getFullYear();
const roomsByYear = new Map<number, number>();
for (const kd of allKids) {
  const y = Number(kd.data.year);
  if (y) roomsByYear.set(y, (roomsByYear.get(y) || 0) + (kd.data.roomCount || 1));
}
const firstYear = Math.min(2012, ...roomsByYear.keys());
const lastYear = Math.max(thisYear, ...roomsByYear.keys());
const yearCols = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => {
  const y = firstYear + i;
  return { y, n: roomsByYear.get(y) || 0, featured: y === year, partial: y === thisYear };
});
const yMax = Math.max(10, Math.ceil(Math.max(...yearCols.map(c => c.n)) / 10) * 10);
const yTicks = Array.from({ length: yMax / 10 }, (_, i) => (i + 1) * 10);
const featuredCol = yearCols.find(c => c.featured);

/* ── Chapters (drive the rail, the anchors, and the HowTo schema) ── */
const chapters = [
  { id: 'apply', num: '01', short: 'Apply', title: "It starts with a family's story.", who: ['The family', 'Selection committee'], schema: 'A family applies online, shares photos, and records a video walkthrough of the space. Applications are read by the selection committee, followed by an interview and a home visit.' },
  { id: 'design', num: '02', short: 'Design', title: 'Drawn three ways, then walked at full scale.', who: ['Design partners', 'The family', 'Walk Your Plans'], schema: 'Design partners measure the space and draw several layouts. Three go to the family, who walk them at full size at Walk Your Plans before choosing one. Only then are the theme, colors, and finishes chosen.' },
  { id: 'crew', num: '03', short: 'Crew', title: 'Then the crew assembles.', who: ['Sponsors', 'Suppliers', 'Trades'], schema: 'The drawings become a materials list. Manufacturers and suppliers donate materials, sponsors fund the rest, and trade partners donate labor.' },
  { id: 'build', num: '04', short: 'Build', title: 'Walls come down.', who: ['Contractor', 'Trade partners'], schema: 'The contractor documents the existing space, then runs a full renovation: demolition, framing, plumbing, electrical, and finishes. Build time varies by project.' },
  { id: 'reveal', num: '05', short: 'Reveal', title: 'The child walks in.', who: ['The family', 'The whole crew', 'Livestream viewers'], schema: 'The finished room is revealed to the child and family, filmed, and often streamed live.' },
  { id: 'scale', num: '06', short: 'Scale', title: 'Every room since 2012 has followed these steps.', who: [] as string[], schema: 'The same six steps have produced hundreds of rooms across greater Atlanta since 2012.' },
];
const ch = Object.fromEntries(chapters.map(c => [c.id, c]));

/* ── Image viewer: every drawing and survey photo opens full size ── */
const lbItem = (src: string, srcset: string, alt: string, caption: string) => ({ src, srcset, alt, caption });
const lightbox = {
  plans: existingPlan && proposedPlan ? [
    lbItem(planSrc(existingPlan.url, 1600), planSet(existingPlan.url, [1000, 1600, 2200]), `Existing floor plan of ${name}'s space`, 'Existing. The space as the family lived in it.'),
    lbItem(planSrc(proposedPlan.url, 1600), planSet(proposedPlan.url, [1000, 1600, 2200]), `Proposed floor plan of ${name}'s new space`, 'Proposed. The layout the family chose after walking three options at full scale.'),
  ] : [],
  boards: boards.map((b, i) => lbItem(
    cfRaw(cfId(b.url), 'w=1600,q=85'),
    cfSrcset(cfId(b.url), [1000, 1600, 2200], { quality: 85 }),
    `${boardTitle(b.label, i)} design board for ${name}'s room`,
    `${boardTitle(b.label, i)} design board`,
  )),
  site: buildPhotos.map((p, i) => lbItem(
    cfRaw(cfId(p.url), 'w=1600,q=82'),
    cfSrcset(cfId(p.url), [1000, 1600, 2200], { quality: 82 }),
    `Existing-conditions photo ${i + 1} from ${name}'s home before construction`,
    `Site survey, ${year}. Photo ${i + 1} of ${buildPhotos.length}.`,
  )),
};
const lightboxJson = JSON.stringify(lightbox).replace(/</g, '\\u003c');

const breadcrumbs = [
  { name: 'Home', url: `${SITE}/` },
  { name: 'How It Works', url: pageUrl },
];
const howToSchema = {
  '@type': 'HowTo',
  name: 'How Sunshine on a Ranney Day builds a room',
  description: `The six steps every SOARD room follows, from a family's application to the reveal, shown through ${name}'s ${roomsText} completed in ${year}.`,
  image: `${CF}/${heroId}/w=1200,h=630,fit=cover,gravity=face`,
  step: chapters.map((c, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: c.title,
    text: c.schema,
    url: `${pageUrl}#${c.id}`,
  })),
};
const videoSchema = hasVideo ? getVideoSchema({
  name: `${name}'s room reveal`,
  description: `The reveal of ${name}'s ${roomsText}, built by Sunshine on a Ranney Day and its partners.`,
  pageUrl,
  streamVideoId: streamId || undefined,
  videoUrl: k.videoUrl || undefined,
  uploadDate: `${year}-01-01`,
}) : null;
const jsonLd = videoSchema ? [howToSchema, videoSchema] : [howToSchema];

const heroTransforms = 'fit=cover,gravity=face,q=72';
const heroSrcset = cfSrcset(heroId, [400, 640, 800, 1024], { fit: 'cover', gravity: 'face', aspectRatio: 1.25, quality: 72 });
const heroSizes = '(max-width: 768px) 85vw, (max-width: 1200px) 38vw, 440px';
const arrow = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const expandIcon = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>';
---

<BaseLayout
  title="How a Room Gets Built"
  description={`Every SOARD room follows the same six steps, from a family's application to the reveal. Follow ${name}'s ${roomsText} start to finish: the drawings, the partners, the build, and the moment it was revealed.`}
  ogImage="/og/how-it-works.png"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <link slot="head" rel="preload" as="image" imagesrcset={heroSrcset} imagesizes={heroSizes} fetchpriority="high" />

  <!-- ══════ HERO · Editorial split ══════ -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-eyebrow">How It Works</p>
        <h1>How a room <em>gets built</em>.</h1>
        <p class="hero-lead">Every room we build follows the same six steps, from a family's first application to the moment a child walks in. This is one real project, start to finish: {name}'s {roomsText}, completed in {year}.</p>
        <div class="hero-ctas">
          <a href="#apply" class="btn btn-primary btn-lg" data-jump="apply">Follow the build <span aria-hidden="true">&darr;</span></a>
          <a href="/donate/" class="btn btn-outline-dark">Fund a Room</a>
        </div>
      </div>
      <div class="hero-frame">
        <div class="hero-accent" aria-hidden="true"></div>
        <div class="hero-photo" style={`background-image:url('${cfLqip(heroId)}')`}>
          <img
            src={cfRaw(heroId, `w=640,h=800,${heroTransforms}`)}
            srcset={heroSrcset}
            sizes={heroSizes}
            alt={`${name} in the finished room built by Sunshine on a Ranney Day`}
            width="640" height="800"
            class="lqip-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num">{stats.totalRooms}+</span>
          <span class="hero-stat-label">rooms built<br/>this way</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════ CASE FILE · rail + chapters ══════ -->
  <div class="case" id="case">
    <nav class="rail" aria-label="Chapters">
      <p class="rail__label">The case file</p>
      <div class="rail__track">
        <ol class="rail__list">
          {chapters.map(c => (
            <li><a href={`#${c.id}`} class="rail__link" data-rail={c.id}><span class="rail__num">{c.num}</span><span class="rail__text">{c.short}</span></a></li>
          ))}
        </ol>
        <span class="rail__fill" aria-hidden="true"></span>
        <span class="rail__bead" aria-hidden="true"></span>
      </div>
      <span class="rail__progress" aria-hidden="true"></span>
      <a class="rail__project" href={`/kids/${k.slug}/`}>
        <img src={cfRaw(heroId, 'w=96,h=96,fit=cover,gravity=face,q=70')} alt="" width="44" height="44" loading="lazy" decoding="async" />
        <span><span class="rail__project-k">Project</span><strong>{name}, {year}</strong><span class="rail__project-go">See the room <Fragment set:html={arrow} /></span></span>
      </a>
    </nav>

    <div class="chapters">

      <!-- 01 APPLY -->
      <section class="chapter" id="apply" data-chapter="apply" aria-labelledby="h-apply">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num" aria-hidden="true">01</span>
          <div class="chapter__titles">
            <h2 id="h-apply">{ch.apply.title}</h2>
            <p class="chapter__who"><span class="chapter__who-k">Who</span>{ch.apply.who.map(w => <span>{w}</span>)}</p>
          </div>
        </div>
        <div class="chapter__grid">
          <div class="chapter__text" data-reveal>
            <p>Families apply online in about fifteen minutes. They tell us about their child, share photos, and record a short video walking us through the space so we can see it the way they do. Every application is read by a real person.</p>
            <p>The ones that move forward get an interview, then a home visit, before the selection committee makes its decision. The committee weighs four things:</p>
            <ul class="criteria">
              <li><strong>Daily impact and safety.</strong> How the current space limits the child's independence or puts them at risk.</li>
              <li><strong>Financial circumstances.</strong> Families who could not otherwise afford the work come first.</li>
              <li><strong>Potential for transformation.</strong> Whether a new space would change how the child lives, plays, or heals.</li>
              <li><strong>Scope and feasibility.</strong> Whether the right room can be built inside the home's existing footprint.</li>
            </ul>
          </div>
          <aside class="file" data-reveal data-delay="1" aria-label={`From ${name}'s application`}>
            <div class="file__photo" style={`background-image:url('${cfLqip(filePhotoId)}')`}>
              <img src={cfRaw(filePhotoId, 'w=640,h=520,fit=cover,gravity=auto,q=75')} srcset={cfSrcset(filePhotoId, [400, 640, 900], { fit: 'cover', gravity: 'auto', aspectRatio: 0.8125, quality: 75 })} sizes="(max-width: 1024px) 90vw, 380px" alt={filePhotoIsBefore ? `${name}'s space before the build` : name} width="640" height="520" loading="lazy" decoding="async" class="lqip-img" />
              {filePhotoIsBefore && <span class="file__stamp">The space, before</span>}
            </div>
            <div class="file__body">
              <span class="file__tag">From the file</span>
              <h3 class="file__title">{name}'s application, {year}</h3>
              {storyExcerpt && <p class="file__story">{storyExcerpt}</p>}
              <dl class="file__meta">
                {k.diagnosis && <><dt>Diagnosis</dt><dd>{k.diagnosis}</dd></>}
                <dt>Requested</dt><dd>{(k.roomTypes || []).join(' + ')}</dd>
                {k.age && <><dt>Age</dt><dd>{Array.isArray(k.age) ? k.age.join(', ') : k.age}</dd></>}
              </dl>
            </div>
          </aside>
        </div>
      </section>

      <!-- 02 DESIGN -->
      <section class="chapter" id="design" data-chapter="design" aria-labelledby="h-design">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num" aria-hidden="true">02</span>
          <div class="chapter__titles">
            <h2 id="h-design">{ch.design.title}</h2>
            <p class="chapter__who"><span class="chapter__who-k">Who</span>{ch.design.who.map(w => <span>{w}</span>)}</p>
          </div>
        </div>
        <div class="chapter__text chapter__text--wide" data-reveal>
          <p>Design starts with the space, not the theme. Our designers measure the room and draw several layouts, because where a wheelchair turns, where a shower drains, and where a bed sits decide whether the room works for years. Three layouts go to the family, who walk them at full scale at Walk Your Plans, a partner facility where the plan is laid out life-size so you can stand inside it before anything is built. The family picks one, we make their edits, and only then do the theme, the colors, and the finishes come in.</p>
        </div>
        {existingPlan && proposedPlan && (
          <div class="design-part">
            <p class="chapter__kicker" data-reveal>First, the layout</p>
            <div class="planview" data-planview data-state="existing" data-reveal data-delay="1">
              <div class="planview__bar">
                <div class="seg" role="group" aria-label="Which floor plan">
                  <span class="seg__thumb" aria-hidden="true"></span>
                  <button type="button" class="seg__btn" data-plan="existing" aria-pressed="true">Existing</button>
                  <button type="button" class="seg__btn" data-plan="proposed" aria-pressed="false">Proposed</button>
                </div>
                <button type="button" class="planview__zoom" data-lb-open="plans" data-lb-index="0"><Fragment set:html={expandIcon} />Enlarge</button>
              </div>
              <button type="button" class="planview__paper" data-lb-open="plans" data-lb-index="0" aria-label="Enlarge the existing floor plan">
                <img class="planview__img planview__img--existing" src={planSrc(existingPlan.url, 1000)} srcset={planSet(existingPlan.url)} sizes="(max-width: 1024px) 92vw, 860px" alt={`Existing floor plan of ${name}'s space`} width="1000" height={Math.round(1000 * planRatio(existingPlan.url))} loading="lazy" decoding="async" />
                <img class="planview__img planview__img--proposed" src={planSrc(proposedPlan.url, 1000)} srcset={planSet(proposedPlan.url)} sizes="(max-width: 1024px) 92vw, 860px" alt={`Proposed floor plan of ${name}'s new space`} width="1000" height={Math.round(1000 * planRatio(proposedPlan.url))} loading="lazy" decoding="async" />
              </button>
              <p class="planview__caption" aria-live="polite">
                <span data-cap="existing"><span class="plan__tag">Existing</span>The space as the family lived in it.</span>
                <span data-cap="proposed" hidden><span class="plan__tag plan__tag--yes">Proposed</span>The layout the family chose after walking three options at full scale.</span>
              </p>
            </div>
          </div>
        )}
        {boards.length > 0 && (
          <div class="design-part">
            <p class="chapter__kicker" data-reveal>Then, the theme and finishes</p>
            <div class={`boards ${boards.length === 1 ? 'boards--single' : ''}`} data-boards data-reveal data-delay="1">
              <div class="boards__scroll" tabindex="0" role="region" aria-label="Design boards. Scroll sideways or use the arrows.">
                {boards.map((b, i) => (
                  <figure class={`board ${i === 0 ? 'is-current' : ''}`}>
                    <button type="button" class="board__paper" data-lb-open="boards" data-lb-index={i} aria-label={`Enlarge the ${boardTitle(b.label, i)} board`}>
                      <img src={cfRaw(cfId(b.url), 'w=900,q=80')} srcset={cfSrcset(cfId(b.url), [600, 900, 1300], { quality: 80 })} sizes="(max-width: 700px) 86vw, 620px" alt={`${boardTitle(b.label, i)} design board for ${name}'s room`} width="900" height="532" loading="lazy" decoding="async" />
                    </button>
                    <figcaption><span class="board__num">{String(i + 1).padStart(2, '0')}</span>{boardTitle(b.label, i)}</figcaption>
                  </figure>
                ))}
              </div>
              {boards.length > 1 && (
                <div class="boards__nav">
                  <button type="button" class="boards__btn" data-dir="-1" aria-label="Previous board" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
                  <span class="boards__count" aria-live="polite"><b>1</b> / {boards.length}</span>
                  <button type="button" class="boards__btn" data-dir="1" aria-label="Next board"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
                </div>
              )}
            </div>
          </div>
        )}
      </section>

      <!-- 03 CREW -->
      <section class="chapter" id="crew" data-chapter="crew" aria-labelledby="h-crew">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num" aria-hidden="true">03</span>
          <div class="chapter__titles">
            <h2 id="h-crew">{ch.crew.title}</h2>
            <p class="chapter__who"><span class="chapter__who-k">Who</span>{ch.crew.who.map(w => <span>{w}</span>)}</p>
          </div>
        </div>
        <div class="chapter__text chapter__text--wide" data-reveal>
          <p>The drawings become a materials list, and partners fill it. Manufacturers donate flooring, tile, and fixtures. Sponsors fund what nobody donates. Trades donate their labor. {crew.length > 0 && <>On this project, <strong>{crew.length} partners</strong> signed on.</>}</p>
        </div>
        {roleGroups.length > 0 && (
          <div class="crew">
            {roleGroups.map(g => (
              <div class="crew__group" data-reveal>
                <div class="crew__group-head">
                  <h3>{g.title} <span class="crew__count">{g.members.length}</span></h3>
                  <p>{g.blurb}</p>
                </div>
                <ul class="crew__logos" role="list">
                  {g.members.map((m, i) => (
                    <li class="crew__logo" style={`--i:${Math.min(i, 10)}`}>
                      <img src={`${CF}/${m.logo}/w=240,h=120,fit=contain,trim=10,q=80`} srcset={`${CF}/${m.logo}/w=240,h=120,fit=contain,trim=10,q=80 1x, ${CF}/${m.logo}/w=480,h=240,fit=contain,trim=10,q=80 2x`} alt={m.name || 'Partner logo'} width="240" height="120" loading="lazy" decoding="async" onerror="this.closest('li').style.display='none'" />
                      {m.name && <span class="crew__name">{m.name}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </section>

      <!-- 04 BUILD -->
      <section class="chapter" id="build" data-chapter="build" aria-labelledby="h-build">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num" aria-hidden="true">04</span>
          <div class="chapter__titles">
            <h2 id="h-build">{ch.build.title}</h2>
            <p class="chapter__who"><span class="chapter__who-k">Who</span>{ch.build.who.map(w => <span>{w}</span>)}</p>
          </div>
        </div>
        <div class="chapter__text chapter__text--wide" data-reveal>
          <p>Before the first wall comes down, the contractor photographs every inch of the existing space. Then the build runs like any other renovation: demolition, framing, plumbing, electrical, and finishes. Every build runs on its own schedule, and the family stays somewhere else until it is done.</p>
        </div>
        {buildPhotos.length > 0 && (
          <div class="site" data-reveal>
            {buildPhotos.map((p, i) => (
              <figure class={`site__shot ${i === 0 ? 'site__shot--lead' : ''}`} style={`--i:${i}`}>
                <button type="button" class="site__open" data-lb-open="site" data-lb-index={i} aria-label={`Enlarge survey photo ${i + 1} of ${buildPhotos.length}`}>
                  <img src={cfRaw(cfId(p.url), i === 0 ? 'w=1000,h=780,fit=cover,q=78' : 'w=600,h=450,fit=cover,q=78')} srcset={cfSrcset(cfId(p.url), i === 0 ? [600, 1000, 1400] : [400, 600, 900], { fit: 'cover', aspectRatio: i === 0 ? 0.78 : 0.75, quality: 78 })} sizes={i === 0 ? '(max-width: 700px) 92vw, 46vw' : '(max-width: 700px) 45vw, 23vw'} alt={`Existing-conditions photo ${i + 1} from ${name}'s home before construction`} width={i === 0 ? 1000 : 600} height={i === 0 ? 780 : 450} loading="lazy" decoding="async" />
                </button>
              </figure>
            ))}
            <span class="site__stamp"><span class="site__stamp-dot" aria-hidden="true"></span>Site survey, {year}</span>
          </div>
        )}
        {buildPhotos.length > 0 && (
          <p class="site__caption" data-reveal>The existing space, photographed by the contractor before demolition day. Tap any photo to see it full size.</p>
        )}
      </section>

      <!-- 05 REVEAL -->
      <section class="chapter chapter--dark" id="reveal" data-chapter="reveal" aria-labelledby="h-reveal">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num chapter__num--light" aria-hidden="true">05</span>
          <div class="chapter__titles">
            <h2 id="h-reveal">{ch.reveal.title}</h2>
            <p class="chapter__who"><span class="chapter__who-k">Who</span>{ch.reveal.who.map(w => <span>{w}</span>)}</p>
          </div>
        </div>
        <div class="chapter__text chapter__text--wide chapter__text--light" data-reveal>
          <p>Everyone who touched the room is there. The reveal is filmed, often streamed live, and it is the moment every partner and donor is working toward.</p>
        </div>
        {hasVideo && (
          <figure class="video" data-reveal data-delay="1">
            <div class="video__frame">
              {streamId ? (
                <div class="facade" id="video-facade" data-stream={streamId} role="button" tabindex="0" aria-label={`Play ${name}'s reveal video`}>
                  <img
                    src={`https://videodelivery.net/${streamId}/thumbnails/thumbnail.jpg?time=2s&width=1280&height=720&fit=crop`}
                    srcset={[640, 960, 1280, 1600].map(w => `https://videodelivery.net/${streamId}/thumbnails/thumbnail.jpg?time=2s&width=${w}&height=${Math.round(w * 9 / 16)}&fit=crop ${w}w`).join(', ')}
                    sizes="(max-width: 900px) 92vw, 860px"
                    alt="" width="1280" height="720" loading="lazy" decoding="async" class="facade__poster" />
                  <span class="facade__play" aria-hidden="true"><span class="facade__ring"></span><svg viewBox="0 0 24 28" fill="none"><path d="M2 1.5v25l20-12.5L2 1.5z" fill="currentColor"/></svg></span>
                </div>
              ) : (
                <div class="facade" id="video-facade" data-yt={ytId} role="button" tabindex="0" aria-label={`Play ${name}'s reveal video`}>
                  <img src={`https://i.ytimg.com/vi/${ytId}/maxresdefault.jpg`} alt="" width="1280" height="720" loading="lazy" decoding="async" class="facade__poster" />
                  <span class="facade__play" aria-hidden="true"><span class="facade__ring"></span><svg viewBox="0 0 24 28" fill="none"><path d="M2 1.5v25l20-12.5L2 1.5z" fill="currentColor"/></svg></span>
                </div>
              )}
            </div>
            <figcaption>{name}'s reveal, {year}.</figcaption>
          </figure>
        )}
        {pair && (
          <div class="ba" data-reveal data-delay="1">
            <div class="ba__container" style="--ba-pos: 50%" data-ba>
              <img class="ba__after lqip-img" src={cfRaw(cfId(pair.after), 'w=1200,q=82')} srcset={cfSrcset(cfId(pair.after), [600, 900, 1200, 1600], { quality: 82 })} sizes="(max-width: 900px) 92vw, 860px" alt={pair.afterAlt || `${name}'s space after the build`} width="1200" height="900" loading="lazy" decoding="async" style={`--lqip:url('${cfLqip(cfId(pair.after))}')`} />
              <div class="ba__before-clip">
                <img class="ba__before lqip-img" src={cfRaw(cfId(pair.before), 'w=1200,q=82')} srcset={cfSrcset(cfId(pair.before), [600, 900, 1200, 1600], { quality: 82 })} sizes="(max-width: 900px) 92vw, 860px" alt={pair.beforeAlt || `${name}'s space before the build`} width="1200" height="900" loading="lazy" decoding="async" style={`--lqip:url('${cfLqip(cfId(pair.before))}')`} />
              </div>
              <input type="range" min="0" max="100" value="50" class="ba__range" aria-label="Compare before and after" />
              <div class="ba__handle" aria-hidden="true"><span class="ba__line"></span><span class="ba__knob"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12H4m0 0l3-3m-3 3l3 3M16 12h4m0 0l-3-3m3 3l-3 3"/></svg></span></div>
              <span class="ba__label ba__label--before" data-ba-label="before">Before</span>
              <span class="ba__label ba__label--after" data-ba-label="after">After</span>
            </div>
            <p class="ba__hint">Drag to compare {pair.room ? pair.room.toLowerCase() : 'the space'} before and after.</p>
          </div>
        )}
      </section>

      <!-- 06 SCALE -->
      <section class="chapter" id="scale" data-chapter="scale" aria-labelledby="h-scale">
        <div class="chapter__head" data-reveal>
          <span class="chapter__num" aria-hidden="true">06</span>
          <div class="chapter__titles">
            <h2 id="h-scale">{ch.scale.title}</h2>
          </div>
        </div>
        <div class="chapter__text chapter__text--wide" data-reveal>
          <p>That is {stats.totalKids}+ children and {stats.totalRooms}+ rooms across greater Atlanta. The process is the same every time. The room never is.</p>
        </div>
        <div class="scale">
          <figure class="yrs" data-yrs data-reveal aria-labelledby="yrs-title">
            <figcaption class="yrs__head">
              <h3 id="yrs-title">Rooms built each year</h3>
              {featuredCol && <p>{name}'s room is one of {featuredCol.n} built in {year}{featuredCol.partial ? ' so far' : ''}.</p>}
            </figcaption>
            <div class="yrs__plot" aria-hidden="true">
              <div class="yrs__grid">
                {yTicks.map(t => <span class="yrs__tick" style={`--v:${t / yMax}`}><em>{t}</em></span>)}
              </div>
              <ol class="yrs__cols" style={`--n:${yearCols.length}`}>
                {yearCols.map((c, i) => (
                  <li class={`yrs__col ${c.featured ? 'is-featured' : ''}`} style={`--v:${c.n / yMax};--i:${i}`} data-year={c.y} data-n={c.n} data-partial={c.partial ? '1' : undefined}>
                    <span class="yrs__bar">
                      {c.featured && <span class="yrs__note">{c.n}</span>}
                    </span>
                    <span class="yrs__yr">{`'${String(c.y).slice(2)}`}</span>
                  </li>
                ))}
              </ol>
              <div class="yrs__tip" aria-hidden="true"></div>
            </div>
            <table class="sr-only">
              <caption>Rooms built each year, {firstYear} to {lastYear}</caption>
              <thead><tr><th scope="col">Year</th><th scope="col">Rooms</th></tr></thead>
              <tbody>{yearCols.map(c => <tr><th scope="row">{c.y}{c.partial ? ' (so far)' : ''}</th><td>{c.n}</td></tr>)}</tbody>
            </table>
          </figure>
          <div class="scale__stat" data-reveal data-delay="1"><span class="scale__num">{stats.totalRooms}+</span><span class="scale__label">rooms built since 2012</span></div>
          <div class="scale__stat" data-reveal data-delay="2"><span class="scale__num">{partnerCount}+</span><span class="scale__label">partners who have joined a build</span></div>
          <div class="scale__stat scale__stat--accent" data-reveal data-delay="3"><span class="scale__num">{programPct}<span class="scale__cent">&cent;</span></span><span class="scale__label">of every dollar goes to programs</span></div>
        </div>
        <p class="scale__foot" data-reveal>The numbers above come from our project records and audited financials. <a href="/about/financials/">See where the money goes</a>.</p>
      </section>

    </div>
  </div>

  <!-- ══════ CLOSING ══════ -->
  <section class="close">
    <div class="close__inner">
      <div class="close__head" data-reveal>
        <div class="section-label">The Next Room</div>
        <h2>The next room is waiting on <em>two things</em>.</h2>
      </div>
      <div class="close__grid">
        <a href="/donate/" class="close__card" data-reveal data-delay="1">
          <span class="close__kicker">A gift</span>
          <span class="close__title">Fund a room</span>
          <span class="close__text">Your donation covers what partners cannot donate: the fixtures, the specialty equipment, the gaps in the materials list.</span>
          <span class="close__cta">Donate <Fragment set:html={arrow} /></span>
        </a>
        <a href="/partners/" class="close__card close__card--dark" data-reveal data-delay="2">
          <span class="close__kicker">A crew</span>
          <span class="close__title">Join a build</span>
          <span class="close__text">Designers, contractors, suppliers, and sponsors carry four of the six steps. There is a place for your company on the next one.</span>
          <span class="close__cta">Become a partner <Fragment set:html={arrow} /></span>
        </a>
      </div>
      <p class="close__note" data-reveal data-delay="3">
        Featured project: <a href={`/kids/${k.slug}/`}>{name}, {year}</a>{k.photographer ? `. Photos by ${k.photographer}.` : '.'}
      </p>
    </div>
  </section>

  <!-- ══════ IMAGE VIEWER (modal dialog, top layer above the site header) ══════ -->
  <dialog class="lb" id="hiw-lb" aria-label="Image viewer">
    <div class="lb__top">
      <p class="lb__count" aria-live="polite"></p>
      <button type="button" class="lb__close" aria-label="Close"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <figure class="lb__stage">
      <img class="lb__img" alt="" decoding="async" />
      <figcaption class="lb__cap"></figcaption>
    </figure>
    <button type="button" class="lb__nav lb__nav--prev" data-dir="-1" aria-label="Previous image"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
    <button type="button" class="lb__nav lb__nav--next" data-dir="1" aria-label="Next image"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
  </dialog>
  <script is:inline type="application/json" id="hiw-lb-data" set:html={lightboxJson}></script>

</BaseLayout>

<style>
  /* ── LQIP ── */
  .hero-photo, .file__photo { background-size: cover; background-position: center; }
  .lqip-img.lqip-pending { opacity: 0; }
  .lqip-img:not(.lqip-pending) { transition: opacity 0.4s ease; }

  /* Motion tokens */
  .case, .close, .lb { --ease-out: cubic-bezier(0.16, 1, 0.3, 1); --ease-io: cubic-bezier(0.65, 0, 0.35, 1); }

  /* ══════ HERO (editorial split, same family as apply/community) ══════ */
  .hero {
    background: var(--c-cream);
    padding: clamp(72px, 9vw, 128px) 0 clamp(64px, 8vw, 100px);
    position: relative; contain: layout style; overflow: hidden;
  }
  .hero-inner {
    max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-xl);
    display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(40px, 5vw, 80px); align-items: center;
  }
  .hero-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-muted);
    margin-bottom: 20px; display: flex; align-items: center; gap: 12px;
  }
  .hero-eyebrow::before { content: ''; width: 28px; height: 2px; background: currentColor; }
  .hero-text h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: -0.035em; line-height: 1.04; color: var(--c-text); margin-bottom: 28px;
    animation: heroSlide 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-text h1 em {
    font-style: italic;
    background-image: linear-gradient(transparent 52%, var(--c-yellow-soft) 52%);
    background-repeat: no-repeat; background-size: 100% 100%; padding: 0 0.05em;
  }
  .hero-lead { font-size: clamp(16px, 1.6vw, 18px); color: var(--c-text-muted); line-height: 1.7; margin-bottom: 36px; max-width: 520px; opacity: 0; animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; opacity: 0; animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both; }
  .hero-frame { position: relative; animation: heroPhotoIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-accent { position: absolute; bottom: -16px; right: -16px; width: 65%; height: 50%; background: var(--c-yellow); border-radius: 24px; z-index: 0; opacity: 0; animation: accentIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.7s both; }
  .hero-photo { position: relative; z-index: 1; aspect-ratio: 4 / 5; border-radius: 24px; overflow: hidden; box-shadow: 0 32px 80px rgba(0,0,0,0.12), 0 8px 24px rgba(0,0,0,0.06); }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-stat {
    position: absolute; bottom: 28px; left: -28px; z-index: 3;
    background: var(--c-dark); color: #fff; padding: 16px 22px; border-radius: var(--border-radius-lg);
    display: flex; align-items: center; gap: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.08), 0 16px 48px rgba(0,0,0,0.15);
  }
  .hero-stat-num { font-family: var(--font-display); font-size: clamp(28px, 3vw, 40px); font-weight: 700; color: var(--c-yellow); line-height: 1; }
  .hero-stat-label { font-size: 12px; font-weight: 600; line-height: 1.35; color: rgba(255,255,255,0.65); text-transform: uppercase; letter-spacing: 0.06em; }
  @keyframes heroUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes heroSlide { from { transform: translateY(16px); } to { transform: none; } }
  @keyframes heroPhotoIn { from { transform: translateY(12px) scale(0.98); } to { transform: none; } }
  @keyframes accentIn { from { opacity: 0; transform: translate(12px, 12px); } to { opacity: 1; transform: none; } }

  /* ══════ CASE FILE LAYOUT ══════ */
  .case {
    --ch-pad: clamp(56px, 7vw, 96px);
    max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-xl);
    display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: start;
  }

  /* Rail: the line fills as you read; the bead rides its tip */
  .rail { position: sticky; top: calc(var(--header-height) + 20px); padding: 40px 0; min-width: 0; }
  .rail__label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-light); margin: 0 0 14px; }
  .rail__track { position: relative; }
  .rail__list { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--c-border); }
  .rail__fill {
    position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--c-yellow);
    transform-origin: top; transform: scaleY(var(--fill, 0)); will-change: transform; pointer-events: none;
  }
  .rail__bead {
    position: absolute; left: -5px; top: 0; width: 12px; height: 12px; margin-top: -6px; border-radius: 50%;
    background: var(--c-yellow); box-shadow: 0 0 0 3px var(--c-cream), 0 0 0 4px rgba(45,46,51,0.12);
    transform: translateY(var(--bead, 0px)); will-change: transform; pointer-events: none;
    opacity: 0; transition: opacity 0.4s ease;
  }
  .rail.is-live .rail__bead { opacity: 1; }
  .rail__link {
    display: flex; align-items: baseline; gap: 12px; padding: 9px 0 9px 18px;
    color: var(--c-text-muted); text-decoration: none; font-weight: 600; font-size: 15px;
    transition: color 0.3s ease, transform 0.45s var(--ease-out);
  }
  .rail__num { font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: var(--c-text-light); width: 22px; transition: color 0.3s ease; }
  .rail__link:hover { color: var(--c-dark); }
  .rail__link.is-active { color: var(--c-dark); transform: translateX(4px); }
  .rail__link.is-active .rail__num { color: var(--c-dark); }
  .rail__link:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; border-radius: 6px; }
  .rail__progress { display: none; }
  .rail__project {
    display: flex; align-items: center; gap: 12px; margin: 28px 0 0; padding: 12px; border-radius: 14px;
    text-decoration: none; color: inherit; border: 1px solid var(--c-border); background: #fff;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.35s var(--ease-out);
  }
  .rail__project:hover { border-color: var(--c-yellow); box-shadow: 0 10px 24px rgba(0,0,0,0.06); transform: translateY(-2px); }
  .rail__project:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; }
  .rail__project img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: var(--c-warm-gray); }
  .rail__project > span { display: flex; flex-direction: column; min-width: 0; }
  .rail__project-k { font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-text-light); }
  .rail__project strong { font-size: 14px; color: var(--c-dark); line-height: 1.3; }
  .rail__project-go { display: inline-flex; align-items: center; gap: 4px; margin-top: 2px; font-size: 12px; font-weight: 600; color: var(--c-text-muted); }
  .rail__project-go :global(svg) { width: 12px; height: 12px; transition: transform 0.3s var(--ease-out); }
  .rail__project:hover .rail__project-go :global(svg) { transform: translateX(3px); }

  .chapters { min-width: 0; }
  .chapter {
    padding: var(--ch-pad) 0; border-top: 1px solid var(--c-border);
    /* Anchor jumps seat the heading just under the sticky chrome, not the section's top padding */
    scroll-margin-top: calc(var(--rail-h, 0px) - var(--ch-pad) + 20px);
  }
  .chapter:first-child { border-top: none; padding-top: 40px; scroll-margin-top: calc(var(--rail-h, 0px) - 20px); }
  .chapter__head { display: flex; align-items: flex-start; gap: 20px; margin-bottom: 24px; }
  .chapter__num {
    font-family: var(--font-display); font-style: italic; font-size: clamp(40px, 5vw, 64px); line-height: 0.9; color: #E0DDD6; flex-shrink: 0;
    transition: color 0.6s ease;
  }
  .chapter.is-current .chapter__num { color: var(--c-yellow); }
  .chapter__num--light { color: rgba(255,255,255,0.18); }
  .chapter__titles { min-width: 0; padding-top: 0.25em; }
  .chapter h2 { font-size: clamp(26px, 3.2vw, 40px); line-height: 1.15; letter-spacing: -0.02em; margin: 0; text-wrap: balance; }
  .chapter__who { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 14px 0 0; font-size: 12.5px; font-weight: 600; color: var(--c-dark); }
  .chapter__who > span { display: inline-flex; align-items: center; min-height: 26px; padding: 0 11px; border-radius: 100px; background: #fff; border: 1px solid var(--c-border); white-space: nowrap; }
  .chapter__who > .chapter__who-k { font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; background: var(--c-yellow); border-color: var(--c-yellow); padding: 0 9px; }
  .chapter--dark .chapter__who > span:not(.chapter__who-k) { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.16); color: rgba(255,255,255,0.85); }
  .chapter__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr); gap: clamp(28px, 4vw, 56px); align-items: start; }
  .chapter__text p { font-size: 17px; line-height: 1.75; color: var(--c-text-muted); margin: 0 0 16px; max-width: 62ch; }
  .chapter__text--wide { margin-bottom: 32px; }
  .chapter__text--light p { color: rgba(255,255,255,0.7); }
  .chapter__text strong { color: var(--c-text); }
  .chapter__text--light strong { color: #fff; }

  /* Chapter heads: the numeral slides in, the title rises out of a mask, the who-line follows */
  .chapter__head[data-reveal] { opacity: 1; transform: none; }
  .chapter__head .chapter__num { transition: color 0.6s ease, opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out); }
  .chapter__head h2 { clip-path: inset(-20% -4% -30% -4%); transition: clip-path 0.9s var(--ease-out) 0.08s, transform 0.9s var(--ease-out) 0.08s; }
  .chapter__head .chapter__who { transition: opacity 0.7s ease 0.3s, transform 0.7s var(--ease-out) 0.3s; }
  .chapter__head[data-reveal]:not(.is-visible) .chapter__num { opacity: 0; transform: translateX(-14px); }
  .chapter__head[data-reveal]:not(.is-visible) h2 { clip-path: inset(0 -4% 100% -4%); transform: translateY(0.45em); }
  .chapter__head[data-reveal]:not(.is-visible) .chapter__who { opacity: 0; transform: translateY(8px); }

  .criteria { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 12px; }
  .criteria li { position: relative; padding-left: 22px; font-size: 15px; line-height: 1.6; color: var(--c-text-muted); }
  .criteria li::before { content: ''; position: absolute; left: 0; top: 8px; width: 10px; height: 10px; border-radius: 50%; background: var(--c-yellow); }
  .criteria strong { color: var(--c-text); }

  /* From the file: the application card, set down like a page on a desk */
  .file { background: #fff; border: 1px solid var(--c-border); border-radius: 20px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.06); }
  .file[data-reveal] { transform-origin: 30% 100%; }
  .file[data-reveal]:not(.is-visible) { transform: translateY(36px) rotate(-1.6deg); }
  .file__photo { position: relative; aspect-ratio: 16 / 13; }
  .file__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .file__stamp { position: absolute; left: 14px; bottom: 14px; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; background: rgba(30,31,37,0.72); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); padding: 6px 11px; border-radius: 100px; }
  .file__body { padding: 22px 26px 26px; }
  .file__tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-dark); background: var(--c-yellow); padding: 4px 10px; border-radius: 6px; margin-bottom: 12px; }
  .file__title { font-size: 20px; margin: 0 0 10px; line-height: 1.25; }
  .file__story { font-size: 14.5px; line-height: 1.65; color: var(--c-text-muted); margin: 0 0 16px; }
  .file__meta { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; font-size: 13px; }
  .file__meta dt { font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-size: 11px; color: var(--c-text-light); padding-top: 2px; }
  .file__meta dd { margin: 0; color: var(--c-text); }

  /* Design chapter is two parts: layout, then finishes */
  .design-part + .design-part { margin-top: 56px; }
  .chapter__kicker { display: flex; align-items: center; gap: 12px; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-light); margin: 0 0 16px; }
  .chapter__kicker::before { content: ''; width: 22px; height: 2px; background: var(--c-yellow); }

  /* Floor plans: one sheet, two states */
  .planview__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .seg { position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: 100px; background: #fff; border: 1px solid var(--c-border); box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
  .seg__thumb {
    position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: 100px; background: var(--c-dark);
    transition: transform 0.45s var(--ease-out), background-color 0.45s ease;
  }
  [data-state="proposed"] .seg__thumb { transform: translateX(100%); background: var(--c-yellow); }
  .seg__btn {
    position: relative; z-index: 1; appearance: none; border: 0; background: none; cursor: pointer;
    min-height: 40px; padding: 0 20px; border-radius: 100px; font: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.04em;
    color: var(--c-text-muted); transition: color 0.3s ease;
  }
  .seg__btn[aria-pressed="true"] { color: #fff; }
  [data-state="proposed"] .seg__btn[aria-pressed="true"] { color: var(--c-dark); }
  .seg__btn:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; }
  [data-state="existing"] .seg__btn[data-plan="existing"]:focus-visible { outline-color: var(--c-dark); }
  .planview__zoom {
    display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px; border-radius: 100px;
    border: 1px solid var(--c-border); background: #fff; color: var(--c-dark); font: inherit; font-size: 13px; font-weight: 700; cursor: pointer;
    transition: border-color 0.25s ease, transform 0.35s var(--ease-out);
  }
  .planview__zoom:hover { border-color: var(--c-dark); }
  .planview__zoom:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; }
  .planview__paper {
    display: grid; width: 100%; padding: 12px; margin: 0; cursor: zoom-in; appearance: none; font: inherit;
    background: #fff; border: 1px solid var(--c-border); border-radius: 16px;
    box-shadow: 0 14px 40px rgba(0,0,0,0.07);
    transition: border-color 0.45s ease, box-shadow 0.45s ease;
  }
  [data-state="proposed"] .planview__paper { border-color: rgba(255,218,36,0.9); box-shadow: 0 14px 40px rgba(0,0,0,0.07), 0 0 0 4px var(--c-yellow-soft); }
  .planview__paper:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 4px; }
  .planview__img { grid-area: 1 / 1; width: 100%; height: auto; display: block; border-radius: 8px; transition: opacity 0.55s var(--ease-io), transform 0.7s var(--ease-out); }
  .planview__img--proposed { opacity: 0; transform: scale(0.985); }
  [data-state="proposed"] .planview__img--existing { opacity: 0; transform: scale(1.015); }
  [data-state="proposed"] .planview__img--proposed { opacity: 1; transform: none; }
  .planview__caption { font-size: 13.5px; color: var(--c-text-muted); margin: 14px 0 0; min-height: 1.6em; }
  .planview__caption > span { animation: capIn 0.45s var(--ease-out); }
  @keyframes capIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .plan__tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-text-muted); border: 1px solid var(--c-border); padding: 3px 9px; border-radius: 100px; margin-right: 10px; }
  .plan__tag--yes { color: var(--c-dark); background: var(--c-yellow); border-color: var(--c-yellow); }

  /* Boards: a paper strip with real controls */
  .boards { margin: 0 calc(var(--space-xl) * -1) 0 0; position: relative; }
  .boards:not(.boards--single)::after { content: ''; position: absolute; top: 0; right: 0; height: calc(100% - 56px); width: 72px; background: linear-gradient(90deg, rgba(254,252,245,0), var(--c-cream)); pointer-events: none; transition: opacity 0.3s ease; }
  .boards.at-end::after { opacity: 0; }
  .boards__scroll { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px 0 12px; scrollbar-width: none; overscroll-behavior-x: contain; }
  .boards__scroll::-webkit-scrollbar { display: none; }
  .boards__scroll:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 4px; border-radius: 12px; }
  .board { flex: 0 0 min(620px, 86vw); scroll-snap-align: start; margin: 0; transition: opacity 0.5s ease; }
  .boards:not(.boards--single) .board:not(.is-current) { opacity: 0.5; }
  .boards--single .board { flex-basis: 100%; }
  .board__paper {
    display: block; width: 100%; padding: 10px; margin: 0; appearance: none; cursor: zoom-in;
    background: #fff; border: 1px solid var(--c-border); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    transition: transform 0.45s var(--ease-out), box-shadow 0.45s ease;
  }
  .board__paper:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(0,0,0,0.1); }
  .board__paper:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 3px; }
  .board__paper img { width: 100%; height: auto; display: block; border-radius: 6px; }
  .board figcaption { display: flex; align-items: baseline; gap: 10px; font-size: 14px; font-weight: 600; color: var(--c-dark); margin-top: 12px; }
  .board__num { font-family: var(--font-display); font-style: italic; font-size: 13px; color: var(--c-text-light); }
  .boards__nav { display: flex; align-items: center; gap: 14px; margin-top: 10px; }
  .boards__btn {
    width: 44px; height: 44px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    border: 1px solid var(--c-border); background: #fff; color: var(--c-dark);
    transition: background-color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease, transform 0.3s var(--ease-out);
  }
  .boards__btn:hover:not(:disabled) { background: var(--c-yellow); border-color: var(--c-yellow); }
  .boards__btn:active:not(:disabled) { transform: scale(0.94); }
  .boards__btn:disabled { opacity: 0.35; cursor: default; }
  .boards__btn:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; }
  .boards__count { font-size: 13px; font-weight: 600; color: var(--c-text-muted); font-variant-numeric: tabular-nums; min-width: 3.2em; text-align: center; }
  .boards__count b { color: var(--c-dark); }

  /* Crew: logos grouped by role */
  .crew { display: grid; gap: 26px; }
  .crew__group { border-top: 1px solid var(--c-border); padding-top: 22px; display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 24px; }
  .crew__group[data-reveal] { opacity: 1; transform: none; }
  .crew__group-head h3 { font-size: 19px; margin: 0 0 6px; }
  .crew__count { vertical-align: 3px; margin-left: 6px; display: inline-flex; align-items: center; justify-content: center; min-width: 26px; height: 22px; padding: 0 7px; border-radius: 100px; background: var(--c-warm-gray); border: 1px solid var(--c-border); font-family: var(--font-body, inherit); font-size: 12px; font-weight: 700; color: var(--c-dark); }
  .crew__group-head p { font-size: 14px; line-height: 1.55; color: var(--c-text-muted); margin: 0; }
  .crew__logos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(138px, 1fr)); gap: 10px; }
  .crew__logo {
    background: #fff; border: 1px solid var(--c-border); border-radius: 12px; padding: 14px 12px 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: 104px;
    transition: border-color 0.25s ease, box-shadow 0.35s ease, transform 0.45s var(--ease-out), opacity 0.6s var(--ease-out);
    transition-delay: 0s, 0s, 0s, calc(var(--i, 0) * 45ms);
  }
  .crew__group[data-reveal]:not(.is-visible) .crew__logo { opacity: 0; transform: translateY(14px); transition-delay: 0s, 0s, calc(var(--i, 0) * 45ms), calc(var(--i, 0) * 45ms); }
  .crew__group.is-visible .crew__logo { transition-delay: 0s, 0s, calc(var(--i, 0) * 45ms), calc(var(--i, 0) * 45ms); }
  .crew__group.is-settled .crew__logo { transition-delay: 0s; }
  .crew__logo:hover { border-color: var(--c-yellow); box-shadow: 0 10px 24px rgba(0,0,0,0.07); transform: translateY(-3px); }
  .crew__logo img { width: 100%; height: 52px; object-fit: contain; }
  .crew__name { font-size: 11.5px; font-weight: 600; color: var(--c-text-muted); text-align: center; line-height: 1.3; }

  /* Site photos: laid down one after another */
  .site { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(0, auto); gap: 12px; }
  .site[data-reveal] { opacity: 1; transform: none; }
  .site__shot { margin: 0; border-radius: 14px; overflow: hidden; background: var(--c-warm-gray); aspect-ratio: 4 / 3; transition: opacity 0.7s var(--ease-out), transform 0.8s var(--ease-out); transition-delay: calc(var(--i, 0) * 80ms); }
  .site[data-reveal]:not(.is-visible) .site__shot { opacity: 0; transform: translateY(18px) scale(0.97); }
  .site__shot--lead { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; min-height: 0; }
  .site__open { display: block; width: 100%; height: 100%; padding: 0; margin: 0; border: 0; background: none; cursor: zoom-in; }
  .site__open:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: -3px; border-radius: 14px; }
  .site__shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s var(--ease-out); }
  .site__shot:hover img { transform: scale(1.04); }
  .site__stamp { position: absolute; top: 16px; left: 16px; z-index: 2; display: inline-flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; background: rgba(30,31,37,0.72); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); padding: 7px 12px; border-radius: 100px; pointer-events: none; }
  .site__stamp-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-yellow); }
  .site__caption { font-size: 13px; color: var(--c-text-muted); margin: 12px 0 0; }

  /* Reveal (dark) */
  .chapter--dark { background: var(--c-dark-deep); color: #fff; border-top: none; margin: 0 calc(var(--space-xl) * -1); padding-left: var(--space-xl); padding-right: var(--space-xl); border-radius: 28px; }
  .chapter--dark h2 { color: #fff; }
  .chapter--dark.is-current .chapter__num { color: var(--c-yellow); }
  .video { margin: 0 0 32px; }
  .video__frame { position: relative; border-radius: 16px; overflow: hidden; box-shadow: 0 24px 64px rgba(0,0,0,0.45), 0 0 0 1px rgba(255,255,255,0.06); background: #000; }
  .facade { position: relative; aspect-ratio: 16 / 9; cursor: pointer; }
  .facade__poster { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s var(--ease-out); }
  .facade:hover .facade__poster { transform: scale(1.02); }
  .facade__play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 92px; height: 92px; display: flex; align-items: center; justify-content: center; color: #fff; }
  .facade__ring { position: absolute; inset: 0; border: 2px solid rgba(255,255,255,0.9); border-radius: 50%; background: rgba(255,255,255,0.08); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); animation: breathe 3s ease-in-out infinite; transition: background 0.3s ease, border-color 0.3s ease; }
  .facade:hover .facade__ring, .facade:focus-visible .facade__ring { background: var(--c-yellow); border-color: var(--c-yellow); }
  .facade:hover .facade__play, .facade:focus-visible .facade__play { color: var(--c-dark); }
  .facade__play svg { width: 22px; height: 26px; margin-left: 4px; position: relative; }
  .facade:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 4px; }
  @keyframes breathe { 0%, 100% { transform: scale(1); opacity: 0.85; } 50% { transform: scale(1.06); opacity: 1; } }
  .video figcaption { font-size: 13px; color: rgba(255,255,255,0.5); margin-top: 12px; }

  .ba__container { position: relative; border-radius: 16px; overflow: hidden; aspect-ratio: 3 / 2; cursor: ew-resize; user-select: none; -webkit-user-select: none; touch-action: pan-y pinch-zoom; box-shadow: 0 24px 64px rgba(0,0,0,0.45); background: #111; }
  .ba__container:focus-within { outline: 3px solid var(--c-yellow); outline-offset: 3px; }
  .ba__after, .ba__before { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ba__after { position: absolute; inset: 0; }
  .ba__before-clip { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--ba-pos)) 0 0); z-index: 2; }
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 6; opacity: 0; margin: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; touch-action: pan-y; }
  .ba__handle { position: absolute; top: 0; bottom: 0; left: calc(var(--ba-pos) - 24px); width: 48px; z-index: 5; display: flex; align-items: center; justify-content: center; pointer-events: none; }
  .ba__line { position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 12px rgba(0,0,0,0.4); }
  .ba__knob { position: relative; width: 48px; height: 48px; border-radius: 50%; background: var(--c-yellow); color: var(--c-dark); display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 20px rgba(0,0,0,0.35); transition: transform 0.3s var(--ease-out); }
  .ba__container.is-dragging .ba__knob { transform: scale(1.1); }
  .ba__knob svg { width: 22px; height: 22px; }
  .ba__label { position: absolute; bottom: 14px; z-index: 4; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; background: rgba(30,31,37,0.7); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); padding: 6px 12px; border-radius: 100px; transition: opacity 0.25s ease; }
  .ba__label--before { left: 14px; }
  .ba__label--after { right: 14px; }
  .ba__label[data-fade] { opacity: 0; }
  .ba__hint { font-size: 13px; color: rgba(255,255,255,0.5); margin: 12px 0 0; }

  /* Scale: the year chart beside three figures */
  .scale { display: grid; grid-template-columns: minmax(0, 1.85fr) minmax(0, 1fr); grid-auto-rows: auto; gap: 14px; }
  .yrs { grid-row: span 3; margin: 0; background: #fff; border: 1px solid var(--c-border); border-radius: 16px; padding: 22px 22px 18px; display: flex; flex-direction: column; }
  .yrs[data-reveal] { opacity: 1; transform: none; }
  .yrs__head { margin: 0 0 22px; }
  .yrs__head h3 { font-size: 17px; margin: 0 0 4px; }
  .yrs__head p { font-size: 13.5px; line-height: 1.5; color: var(--c-text-muted); margin: 0; }
  .yrs__plot { --plot-h: 220px; position: relative; margin-top: auto; padding: 34px 0 24px 24px; }
  .yrs__grid { position: absolute; left: 24px; right: 0; bottom: 24px; height: var(--plot-h); border-bottom: 1px solid #CFCBC1; pointer-events: none; }
  .yrs__tick { position: absolute; left: 0; right: 0; bottom: calc(var(--v) * 100%); border-top: 1px solid #F0EEE8; }
  .yrs__tick em { position: absolute; left: -24px; top: -7px; width: 18px; text-align: right; font-style: normal; font-size: 10.5px; line-height: 1; color: var(--c-text-light); font-variant-numeric: tabular-nums; }
  .yrs__cols { position: relative; list-style: none; margin: 0; padding: 0; height: var(--plot-h); display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); align-items: end; }
  .yrs__col { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; cursor: default; }
  .yrs__bar {
    position: relative; width: min(24px, 62%); height: calc(var(--v) * 100%); min-height: 2px;
    background: #D7D2C6; border-radius: 4px 4px 0 0;
    transform-origin: bottom; transition: transform 0.9s var(--ease-out), background-color 0.25s ease;
    transition-delay: calc(var(--i, 0) * 40ms), 0s;
  }
  .yrs[data-reveal]:not(.is-visible) .yrs__bar { transform: scaleY(0); }
  .yrs__col:hover .yrs__bar, .yrs__col.is-hot .yrs__bar { background: #B9B3A5; }
  .yrs__col.is-featured .yrs__bar, .yrs__col.is-featured:hover .yrs__bar { background: var(--c-yellow); }
  .yrs__yr { position: absolute; bottom: -22px; font-size: 10.5px; font-weight: 600; color: var(--c-text-light); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .yrs__col.is-featured .yrs__yr { color: var(--c-dark); font-weight: 800; }
  .yrs__note { position: absolute; bottom: calc(100% + 5px); left: 50%; transform: translateX(-50%); font-size: 13px; font-weight: 800; line-height: 1; color: var(--c-dark); font-variant-numeric: tabular-nums; transition: opacity 0.5s ease calc(var(--n, 15) * 40ms + 0.4s); }
  .yrs[data-reveal]:not(.is-visible) .yrs__note { opacity: 0; }
  .yrs__tip {
    position: absolute; top: 0; left: 0; z-index: 3; pointer-events: none; white-space: nowrap;
    background: var(--c-dark); color: #fff; font-size: 12px; font-weight: 600; padding: 6px 10px; border-radius: 8px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.18);
    opacity: 0; transform: translate(var(--tx, 0px), calc(var(--ty, 0px) + 4px)); transition: opacity 0.15s ease, transform 0.2s var(--ease-out);
  }
  .yrs__tip.is-on { opacity: 1; transform: translate(var(--tx, 0px), var(--ty, 0px)); }
  .scale__stat { background: #fff; border: 1px solid var(--c-border); border-radius: 16px; padding: 22px; display: flex; flex-direction: column; justify-content: center; }
  .scale__stat--accent { background: var(--c-dark); border-color: var(--c-dark); color: #fff; }
  .scale__num { display: block; font-family: var(--font-display); font-size: clamp(30px, 3.2vw, 40px); font-weight: 700; line-height: 1; margin-bottom: 8px; color: var(--c-dark); }
  .scale__stat--accent .scale__num { color: var(--c-yellow); }
  .scale__cent { font-size: 0.6em; }
  .scale__label { font-size: 13px; line-height: 1.45; color: var(--c-text-muted); }
  .scale__stat--accent .scale__label { color: rgba(255,255,255,0.7); }
  .scale__foot { font-size: 14px; color: var(--c-text-muted); margin: 20px 0 0; }
  .scale__foot a { color: var(--c-dark); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--c-yellow); }

  /* Closing */
  .close { background: var(--c-yellow); padding: clamp(64px, 8vw, 96px) 0; margin-top: clamp(56px, 7vw, 96px); }
  .close__inner { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-xl); }
  .close__head { max-width: 640px; margin-bottom: 32px; }
  .close__head .section-label { color: rgba(45,46,51,0.7); }
  .close__head h2 { font-size: clamp(28px, 4vw, 44px); line-height: 1.15; letter-spacing: -0.02em; margin: 0; }
  .close__head h2 em { font-style: italic; }
  .close__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .close__card { display: flex; flex-direction: column; gap: 10px; padding: 32px; border-radius: 20px; background: rgba(255,255,255,0.7); color: var(--c-dark); text-decoration: none; border: 1px solid rgba(45,46,51,0.08); transition: transform 0.35s var(--ease-out), box-shadow 0.35s ease, background 0.35s ease; }
  .close__card:hover { transform: translateY(-4px); box-shadow: 0 20px 48px rgba(45,46,51,0.15); background: #fff; }
  .close__card--dark { background: var(--c-dark); color: #fff; border-color: var(--c-dark); }
  .close__card--dark:hover { background: var(--c-dark-deep); }
  .close__card:focus-visible { outline: 3px solid var(--c-dark); outline-offset: 4px; }
  .close__kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7; }
  .close__title { font-family: var(--font-display); font-size: 26px; font-weight: 700; line-height: 1.15; }
  .close__text { font-size: 15px; line-height: 1.65; opacity: 0.8; }
  .close__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; font-size: 14px; font-weight: 700; }
  .close__cta :global(svg) { transition: transform 0.35s var(--ease-out); }
  .close__card:hover .close__cta :global(svg) { transform: translateX(4px); }
  .close__card--dark .close__cta { color: var(--c-yellow); }
  .close__note { margin: 28px 0 0; font-size: 13px; color: rgba(45,46,51,0.75); }
  .close__note a { color: var(--c-dark); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  /* ══════ Image viewer ══════ */
  .lb {
    position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgba(18,19,24,0.96); color: #fff; overflow: hidden;
    opacity: 0; transition: opacity 0.3s ease, overlay 0.3s allow-discrete, display 0.3s allow-discrete;
  }
  .lb[open] { opacity: 1; display: grid; grid-template-rows: auto minmax(0, 1fr); }
  @starting-style { .lb[open] { opacity: 0; } }
  .lb::backdrop { background: transparent; }
  .lb__top { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px 6px 24px; }
  .lb__count { margin: 0; font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.65); font-variant-numeric: tabular-nums; }
  .lb__close, .lb__nav {
    display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 50%; cursor: pointer;
    border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.06); color: #fff;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .lb__close:hover, .lb__nav:hover { background: var(--c-yellow); border-color: var(--c-yellow); color: var(--c-dark); }
  .lb__close:focus-visible, .lb__nav:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; }
  .lb__stage { margin: 0; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 8px clamp(16px, 7vw, 96px) 24px; touch-action: pan-y pinch-zoom; }
  .lb__img {
    display: block; max-width: 100%; max-height: calc(100dvh - 150px); width: auto; height: auto; object-fit: contain;
    border-radius: 8px; background: #fff; box-shadow: 0 30px 80px rgba(0,0,0,0.5);
    transition: opacity 0.3s ease, transform 0.45s var(--ease-out);
  }
  .lb__img.is-loading { opacity: 0; transform: scale(0.97); }
  .lb__cap { font-size: 14px; color: rgba(255,255,255,0.75); text-align: center; max-width: 70ch; }
  .lb__nav { position: absolute; top: 50%; margin-top: -24px; }
  .lb__nav--prev { left: 16px; }
  .lb__nav--next { right: 16px; }
  .lb[data-single] .lb__nav, .lb[data-single] .lb__count { visibility: hidden; }
  :global(html.hiw-lb-open) { overflow: hidden; }

  /* Reveals */
  [data-reveal] { opacity: 0; transform: translateY(28px); transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1); }
  [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  [data-delay="1"] { transition-delay: 0.1s; }
  [data-delay="2"] { transition-delay: 0.2s; }
  [data-delay="3"] { transition-delay: 0.3s; }

  /* ══════ Responsive ══════ */
  @media (max-width: 1024px) {
    .case { grid-template-columns: minmax(0, 1fr); gap: 0; }
    /* Sticky pill row directly under the site header; bleeds edge to edge */
    .rail {
      position: sticky; top: var(--header-height); z-index: 20;
      margin: 0 calc(var(--space-xl) * -1); padding: 10px var(--space-xl);
      background: rgba(254, 252, 245, 0.94);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--c-border);
    }
    .rail__label, .rail__project, .rail__fill, .rail__bead { display: none; }
    .rail__list { border-left: none; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 0; scroll-snap-type: x proximity; }
    .rail__list::-webkit-scrollbar { display: none; }
    .rail__list li { flex: 0 0 auto; scroll-snap-align: center; }
    .rail__link { padding: 8px 14px; border: 1px solid var(--c-border); border-radius: 100px; white-space: nowrap; font-size: 13px; margin: 0; gap: 8px; background: var(--c-white, #fff); min-height: 40px; align-items: center; transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease; }
    .rail__link.is-active { transform: none; border-color: var(--c-yellow); background: var(--c-yellow); color: var(--c-dark); }
    .rail__num { width: auto; }
    .rail__progress {
      display: block; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--c-yellow);
      transform-origin: left; transform: scaleX(var(--fill, 0)); will-change: transform;
    }
    .chapter__grid { grid-template-columns: 1fr; }
    .crew__group { grid-template-columns: 1fr; gap: 14px; }
    .scale { grid-template-columns: 1fr 1fr 1fr; }
    .yrs { grid-column: 1 / -1; grid-row: auto; }
  }
  @media (max-width: 900px) {
    .hero { padding: 64px 0 56px; }
    .hero-inner { grid-template-columns: 1fr; gap: 40px; }
    .hero-frame { max-width: 420px; margin: 0 auto; width: 100%; }
    .hero-stat { left: 12px; bottom: 16px; padding: 12px 16px; }
    .site { grid-template-columns: repeat(2, 1fr); }
    .site__shot--lead { grid-column: span 2; grid-row: auto; aspect-ratio: 4 / 3; }
    .chapter--dark { border-radius: 20px; }
  }
  @media (max-width: 600px) {
    .close__grid { grid-template-columns: 1fr; }
    .scale { grid-template-columns: 1fr 1fr; gap: 10px; }
    .scale__stat { padding: 18px 16px; }
    .scale__stat--accent { grid-column: 1 / -1; }
    .yrs { padding: 18px 16px 14px; }
    .yrs__plot { --plot-h: 170px; }
    .yrs__yr { font-size: 9.5px; }
    .yrs__col:nth-child(even):not(.is-featured) .yrs__yr { visibility: hidden; }
    .chapter__num { font-size: 32px; }
    .chapter__head { gap: 14px; }
    .chapter__who { font-size: 12.5px; }
    .boards { margin-right: calc(var(--space-xl) * -1); }
    .planview__bar { flex-wrap: wrap; }
    .seg__btn { padding: 0 16px; }
    .planview__paper { padding: 6px; border-radius: 12px; }
    .ba__container { aspect-ratio: 1 / 1; }
    .crew__logos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .crew__logo { min-height: 92px; padding: 12px 10px 10px; }
    .crew__logo img { height: 44px; }
    .lb__nav { top: auto; bottom: 18px; margin-top: 0; }
    .lb__stage { padding: 8px 12px 84px; }
    .lb__img { max-height: calc(100dvh - 220px); }
  }
  @media print {
    .rail, .facade__play, .ba__handle, .ba__range, .ba__label, .boards__nav, .planview__bar, .hero-ctas, .close, .lb { display: none !important; }
    .case { display: block; }
    .chapter--dark { background: #fff; color: #000; margin: 0; border-radius: 0; }
    .chapter--dark h2, .chapter__text--light p { color: #000; }
    .chapter { break-inside: avoid; }
    .boards__scroll { flex-wrap: wrap; overflow: visible; }
    .board { opacity: 1 !important; }
    .planview__img--proposed { display: none; }
    [data-reveal], [data-reveal] * { opacity: 1 !important; transform: none !important; clip-path: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal], [data-reveal] * { transition: none !important; }
    [data-reveal] { opacity: 1; transform: none; }
    .chapter__head[data-reveal]:not(.is-visible) .chapter__num,
    .chapter__head[data-reveal]:not(.is-visible) .chapter__who,
    .crew__group[data-reveal]:not(.is-visible) .crew__logo,
    .site[data-reveal]:not(.is-visible) .site__shot,
    .yrs[data-reveal]:not(.is-visible) .yrs__note { opacity: 1; transform: none; }
    .chapter__head[data-reveal]:not(.is-visible) h2 { clip-path: none; transform: none; }
    .yrs[data-reveal]:not(.is-visible) .yrs__bar { transform: none; }
    .hero-text h1, .hero-lead, .hero-ctas, .hero-frame, .hero-accent { animation: none; opacity: 1; transform: none; }
    .facade__ring { animation: none; }
    .lqip-img.lqip-pending { opacity: initial; }
    .site__shot img, .facade__poster, .planview__img, .seg__thumb, .rail__link, .rail__bead, .lb, .lb__img, .board, .board__paper, .crew__logo, .chapter__num { transition: none; }
    .planview__caption > span { animation: none; }
    .rail__link.is-active { transform: none; }
  }
</style>

<noscript>
  <style>
    .hero-lead, .hero-ctas, .hero-accent { opacity: 1 !important; animation: none !important; }
    [data-reveal], [data-reveal] * { opacity: 1 !important; transform: none !important; clip-path: none !important; }
    .planview__bar { display: none !important; }
    .planview__img--proposed { display: none !important; }
    .boards__nav { display: none !important; }
    .board { opacity: 1 !important; }
  </style>
</noscript>

<script>
  import { navigate } from 'astro:transitions/client';

  type LbItem = { src: string; srcset: string; alt: string; caption: string };
  let _cleanup: (() => void) | null = null;

  function initHowItWorks() {
    _cleanup?.();
    _cleanup = null;
    const caseEl = document.getElementById('case');
    if (!caseEl) return;

    const ac = new AbortController();
    const { signal } = ac;
    const observers: IntersectionObserver[] = [];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const pillMode = matchMedia('(max-width: 1024px)');
    const scrollBehavior = (): ScrollBehavior => (reduce.matches ? 'auto' : 'smooth');

    /* ══ Chapter rail ══
       The active chapter is the last one whose top has crossed a reading line
       just under the sticky chrome (the bottom of the page selects the last).
       The line fills continuously: between two chapters, the bead sits as far
       between their links as you are between their tops. */
    const header = document.querySelector<HTMLElement>('.site-header');
    const rail = caseEl.querySelector<HTMLElement>('.rail');
    const railList = caseEl.querySelector<HTMLElement>('.rail__list');
    const track = caseEl.querySelector<HTMLElement>('.rail__track');
    const links = Array.from(caseEl.querySelectorAll<HTMLAnchorElement>('[data-rail]'));
    const chapters = Array.from(caseEl.querySelectorAll<HTMLElement>('[data-chapter]'));
    let activeId = '';
    let locked = false;
    let navigating = false;
    let raf = 0;
    let rideRaf = 0;

    const railH = () => (pillMode.matches && rail ? rail.getBoundingClientRect().height : 0);
    const setRailH = () => caseEl.style.setProperty('--rail-h', `${Math.round(railH())}px`);
    const chromeBottom = () => (header ? Math.max(0, header.getBoundingClientRect().bottom) : 0) + railH();
    const readingLine = () => { const cb = chromeBottom(); return cb + Math.min(120, (window.innerHeight - cb) * 0.25) + 1; };
    const atBottom = () => window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;

    const centerPill = (a: HTMLElement, instant: boolean) => {
      if (!pillMode.matches || !railList) return;
      const left = a.parentElement!.offsetLeft - railList.offsetLeft;
      const target = left + a.offsetWidth / 2 - railList.clientWidth / 2;
      railList.scrollTo({ left: Math.max(0, target), behavior: instant ? 'auto' : scrollBehavior() });
    };
    const setActive = (id: string, instant = false) => {
      if (id === activeId) return;
      activeId = id;
      for (const a of links) {
        const on = a.dataset.rail === id;
        a.classList.toggle('is-active', on);
        if (on) { a.setAttribute('aria-current', 'location'); centerPill(a, instant); }
        else a.removeAttribute('aria-current');
      }
      for (const c of chapters) c.classList.toggle('is-current', c.dataset.chapter === id);
    };
    const computeActive = () => {
      if (atBottom()) return chapters[chapters.length - 1].dataset.chapter || '';
      const line = readingLine();
      let current = chapters[0].dataset.chapter || '';
      for (const c of chapters) { if (c.getBoundingClientRect().top <= line) current = c.dataset.chapter || ''; else break; }
      return current;
    };
    const paintProgress = () => {
      if (!rail) return;
      const line = readingLine();
      const tops = chapters.map(c => c.getBoundingClientRect().top);
      const end = chapters[chapters.length - 1].getBoundingClientRect().bottom;
      // Overall progress through the case file (pill bar underline)
      let overall = atBottom() ? 1 : (line - tops[0]) / Math.max(1, end - tops[0]);
      overall = Math.min(1, Math.max(0, overall));
      rail.style.setProperty('--fill', overall.toFixed(4));
      if (pillMode.matches || !track) return;
      // Sidebar: map scroll position onto link centers
      const trackTop = track.getBoundingClientRect().top;
      const centers = links.map(a => { const r = a.getBoundingClientRect(); return r.top - trackTop + r.height / 2; });
      const trackH = track.getBoundingClientRect().height;
      let y = centers[0];
      if (atBottom()) y = centers[centers.length - 1];
      else {
        for (let i = 0; i < chapters.length; i++) {
          const from = tops[i];
          const to = i + 1 < chapters.length ? tops[i + 1] : end;
          if (line < from) break;
          const f = Math.min(1, Math.max(0, (line - from) / Math.max(1, to - from)));
          const nextC = i + 1 < centers.length ? centers[i + 1] : centers[i];
          y = centers[i] + f * (nextC - centers[i]);
        }
      }
      track.style.setProperty('--fill', (y / Math.max(1, trackH)).toFixed(4));
      track.style.setProperty('--bead', `${y.toFixed(1)}px`);
    };
    const tick = () => {
      raf = 0;
      if (!locked) setActive(computeActive());
      paintProgress();
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(tick); };

    /* Click: Astro's router owns history. navigate('#id') runs synchronously,
       pushes a real entry, and lands the chapter where scroll-padding and
       scroll-margin put it. Take that landing, restore the origin before paint,
       then glide there in one native smooth scroll with the spy locked. */
    const unlock = () => { cancelAnimationFrame(rideRaf); rideRaf = 0; locked = false; tick(); };
    const jumpTo = (id: string) => {
      const target = document.getElementById(id);
      if (!target) return false;
      cancelAnimationFrame(rideRaf);
      const startY = window.scrollY;
      navigating = true;
      navigate(`#${id}`);
      navigating = false;
      const endY = window.scrollY;
      const expectedTop = target.getBoundingClientRect().top;
      locked = true;
      setActive(id);
      if (scrollBehavior() === 'auto' || Math.abs(endY - startY) < 2) { unlock(); return true; }
      window.scrollTo({ top: startY, behavior: 'instant' as ScrollBehavior });
      window.scrollTo({ top: endY, behavior: 'smooth' });
      const t0 = performance.now();
      let last = window.scrollY, still = 0;
      const watch = (now: number) => {
        const y = window.scrollY;
        const arrived = Math.abs(y - endY) < 1;
        still = Math.abs(y - last) < 0.5 ? still + 1 : 0;
        last = y;
        paintProgress();
        if (arrived || (still >= 6 && now - t0 > 250) || now - t0 > 2000) {
          const drift = target.getBoundingClientRect().top - expectedTop;
          if (arrived && Math.abs(drift) > 1) window.scrollTo({ top: window.scrollY + drift, behavior: 'instant' as ScrollBehavior });
          unlock();
          return;
        }
        rideRaf = requestAnimationFrame(watch);
      };
      rideRaf = requestAnimationFrame(watch);
      return true;
    };
    const jumpLinks = [...links, ...Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-jump]'))];
    for (const a of jumpLinks) {
      a.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        const id = a.dataset.rail || a.dataset.jump || '';
        if (!id) return;
        e.preventDefault();
        if (jumpTo(id)) {
          const h = document.getElementById(`h-${id}`);
          h?.setAttribute('tabindex', '-1');
          h?.focus({ preventScroll: true });
        }
      }, { signal });
    }
    const cancelRide = () => { if (rideRaf) unlock(); };
    window.addEventListener('wheel', cancelRide, { passive: true, signal });
    window.addEventListener('touchstart', cancelRide, { passive: true, signal });
    window.addEventListener('keydown', (e) => { if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(e.key) && !(e.target as HTMLElement)?.closest?.('dialog')) cancelRide(); }, { signal });
    const onHistory = () => { if (!navigating) unlock(); };
    window.addEventListener('popstate', onHistory, { signal });
    window.addEventListener('hashchange', onHistory, { signal });
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', () => { setRailH(); onScroll(); }, { passive: true, signal });
    setRailH();
    setActive(computeActive(), true);
    paintProgress();
    requestAnimationFrame(() => rail?.classList.add('is-live'));
    document.fonts?.ready.then(() => { setRailH(); paintProgress(); });

    /* ══ Image viewer ══ */
    const dlg = document.getElementById('hiw-lb') as HTMLDialogElement | null;
    const lbData: Record<string, LbItem[]> = (() => { try { return JSON.parse(document.getElementById('hiw-lb-data')?.textContent || '{}'); } catch { return {}; } })();
    let lbGroup: LbItem[] = [];
    let lbIdx = 0;
    let lbOpener: HTMLElement | null = null;
    const lbImg = dlg?.querySelector<HTMLImageElement>('.lb__img');
    const lbCap = dlg?.querySelector<HTMLElement>('.lb__cap');
    const lbCount = dlg?.querySelector<HTMLElement>('.lb__count');
    const lbShow = (i: number) => {
      if (!dlg || !lbImg || !lbGroup.length) return;
      lbIdx = (i + lbGroup.length) % lbGroup.length;
      const it = lbGroup[lbIdx];
      lbImg.classList.add('is-loading');
      lbImg.onload = () => lbImg.classList.remove('is-loading');
      lbImg.sizes = 'min(100vw, 1600px)';
      lbImg.srcset = it.srcset;
      lbImg.src = it.src;
      lbImg.alt = it.alt;
      if (lbImg.complete && lbImg.naturalWidth) lbImg.classList.remove('is-loading');
      if (lbCap) lbCap.textContent = it.caption;
      if (lbCount) lbCount.textContent = `${lbIdx + 1} / ${lbGroup.length}`;
      dlg.toggleAttribute('data-single', lbGroup.length < 2);
      // Warm the neighbors so arrowing is instant
      for (const d of [1, -1]) { const n = lbGroup[(lbIdx + d + lbGroup.length) % lbGroup.length]; if (n) { const p = new Image(); p.sizes = lbImg.sizes; p.srcset = n.srcset; p.src = n.src; } }
    };
    const lbOpen = (group: string, i: number, opener: HTMLElement) => {
      if (!dlg || !lbData[group]?.length) return;
      lbGroup = lbData[group];
      lbOpener = opener;
      lbShow(i);
      dlg.showModal();
      document.documentElement.classList.add('hiw-lb-open');
      dlg.querySelector<HTMLElement>('.lb__close')?.focus();
    };
    if (dlg) {
      document.querySelectorAll<HTMLElement>('[data-lb-open]').forEach(el => {
        el.addEventListener('click', () => {
          let idx = Number(el.dataset.lbIndex || 0);
          const pv = el.closest<HTMLElement>('[data-planview]');
          if (pv) idx = pv.dataset.state === 'proposed' ? 1 : 0;
          lbOpen(el.dataset.lbOpen || '', idx, el);
        }, { signal });
      });
      dlg.querySelector('.lb__close')?.addEventListener('click', () => dlg.close(), { signal });
      dlg.querySelectorAll<HTMLElement>('.lb__nav').forEach(b => b.addEventListener('click', () => lbShow(lbIdx + Number(b.dataset.dir)), { signal }));
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); lbShow(lbIdx + 1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); lbShow(lbIdx - 1); }
      }, { signal });
      // Clicking the dark surround (not the picture or a control) closes
      dlg.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t === dlg || t.classList.contains('lb__stage') || t.classList.contains('lb__top')) dlg.close();
      }, { signal });
      let sx = 0, sy = 0, swiping = false;
      dlg.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') { sx = e.clientX; sy = e.clientY; swiping = true; } }, { signal });
      dlg.addEventListener('pointerup', (e) => {
        if (!swiping) return;
        swiping = false;
        const dx = e.clientX - sx, dy = e.clientY - sy;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5 && lbGroup.length > 1) lbShow(lbIdx + (dx < 0 ? 1 : -1));
      }, { signal });
      dlg.addEventListener('close', () => {
        document.documentElement.classList.remove('hiw-lb-open');
        lbOpener?.focus({ preventScroll: true });
      }, { signal });
    }

    /* ══ Floor plan: one sheet, Existing ⇄ Proposed ══ */
    const pv = caseEl.querySelector<HTMLElement>('[data-planview]');
    if (pv) {
      const btns = Array.from(pv.querySelectorAll<HTMLButtonElement>('[data-plan]'));
      const paper = pv.querySelector<HTMLElement>('.planview__paper');
      const caps = Array.from(pv.querySelectorAll<HTMLElement>('[data-cap]'));
      const set = (state: string) => {
        if (pv.dataset.state === state) return;
        pv.dataset.state = state;
        btns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.plan === state)));
        caps.forEach(c => { c.hidden = c.dataset.cap !== state; });
        paper?.setAttribute('aria-label', `Enlarge the ${state} floor plan`);
      };
      btns.forEach(b => b.addEventListener('click', () => set(b.dataset.plan || 'existing'), { signal }));
    }

    /* ══ Design boards: snap strip with arrows and a counter ══ */
    const boardsEl = caseEl.querySelector<HTMLElement>('[data-boards]');
    const scroller = boardsEl?.querySelector<HTMLElement>('.boards__scroll');
    const boardEls = boardsEl ? Array.from(boardsEl.querySelectorAll<HTMLElement>('.board')) : [];
    if (boardsEl && scroller && boardEls.length > 1) {
      const prev = boardsEl.querySelector<HTMLButtonElement>('[data-dir="-1"]');
      const next = boardsEl.querySelector<HTMLButtonElement>('[data-dir="1"]');
      const count = boardsEl.querySelector<HTMLElement>('.boards__count b');
      let cur = 0;
      const offsetOf = (i: number) => boardEls[i].offsetLeft - boardEls[0].offsetLeft;
      const sync = () => {
        const maxLeft = scroller.scrollWidth - scroller.clientWidth;
        let i = 0, best = Infinity;
        boardEls.forEach((_, j) => { const d = Math.abs(offsetOf(j) - scroller.scrollLeft); if (d < best) { best = d; i = j; } });
        const atEnd = scroller.scrollLeft >= maxLeft - 2;
        if (atEnd) i = boardEls.length - 1;
        boardsEl.classList.toggle('at-end', atEnd);
        cur = i;
        boardEls.forEach((b, j) => b.classList.toggle('is-current', j === i));
        if (count) count.textContent = String(i + 1);
        if (prev) prev.disabled = i === 0;
        if (next) next.disabled = i === boardEls.length - 1;
      };
      const go = (i: number) => scroller.scrollTo({ left: offsetOf(Math.max(0, Math.min(boardEls.length - 1, i))), behavior: scrollBehavior() });
      prev?.addEventListener('click', () => go(cur - 1), { signal });
      next?.addEventListener('click', () => go(cur + 1), { signal });
      let sr = 0;
      scroller.addEventListener('scroll', () => { if (!sr) sr = requestAnimationFrame(() => { sr = 0; sync(); }); }, { passive: true, signal });
      scroller.addEventListener('keydown', (e) => {
        if (e.target !== scroller) return;
        if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
      }, { signal });
      sync();
    }

    /* ══ Crew: once the logos have settled, hover responds without the stagger ══ */
    caseEl.querySelectorAll<HTMLElement>('.crew__group').forEach(g => {
      const mo = new MutationObserver(() => {
        if (g.classList.contains('is-visible')) { mo.disconnect(); window.setTimeout(() => g.classList.add('is-settled'), 1200); }
      });
      mo.observe(g, { attributes: true, attributeFilter: ['class'] });
      if (g.classList.contains('is-visible')) { mo.disconnect(); g.classList.add('is-settled'); }
      signal.addEventListener('abort', () => mo.disconnect());
    });

    /* ══ Video facade: load the player on demand ══ */
    const facade = document.getElementById('video-facade');
    if (facade) {
      const play = () => {
        const stream = facade.dataset.stream;
        const yt = facade.dataset.yt;
        const iframe = document.createElement('iframe');
        iframe.src = stream
          ? `https://iframe.videodelivery.net/${stream}?autoplay=true&preload=true`
          : `https://www.youtube-nocookie.com/embed/${yt}?autoplay=1&rel=0`;
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = 'Reveal video';
        iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
        const wrap = document.createElement('div');
        wrap.style.cssText = 'position:relative;aspect-ratio:16/9;background:#000';
        wrap.appendChild(iframe);
        facade.replaceWith(wrap);
      };
      facade.addEventListener('click', play, { signal });
      facade.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); play(); } }, { signal });
    }

    /* ══ Before / after slider, with one sweep to show it moves ══ */
    const ba = caseEl.querySelector<HTMLElement>('[data-ba]');
    if (ba) {
      const range = ba.querySelector<HTMLInputElement>('.ba__range');
      const before = ba.querySelector<HTMLElement>('[data-ba-label="before"]');
      const after = ba.querySelector<HTMLElement>('[data-ba-label="after"]');
      let peekRaf = 0;
      const stopPeek = () => { cancelAnimationFrame(peekRaf); peekRaf = 0; };
      const set = (v: number) => {
        const p = Math.max(0, Math.min(100, v));
        ba.style.setProperty('--ba-pos', `${p}%`);
        if (range) range.value = String(Math.round(p));
        before?.toggleAttribute('data-fade', p < 18);
        after?.toggleAttribute('data-fade', p > 82);
      };
      range?.addEventListener('input', () => { stopPeek(); set(Number(range.value)); }, { signal });
      let dragging = false;
      const fromX = (x: number) => { const r = ba.getBoundingClientRect(); return ((x - r.left) / r.width) * 100; };
      ba.addEventListener('pointerdown', (e) => { stopPeek(); dragging = true; ba.classList.add('is-dragging'); set(fromX(e.clientX)); }, { signal });
      window.addEventListener('pointermove', (e) => { if (dragging) set(fromX(e.clientX)); }, { passive: true, signal });
      window.addEventListener('pointerup', () => { dragging = false; ba.classList.remove('is-dragging'); }, { signal });
      if (!reduce.matches && 'IntersectionObserver' in window) {
        /* Only once the reader has stopped on it: a glide past (a rail jump, a fling)
           doesn't spend the hint. */
        let dwell = 0;
        const mostlyInView = () => { const r = ba.getBoundingClientRect(); const seen = Math.min(r.bottom, innerHeight) - Math.max(r.top, 0); return seen >= r.height * 0.6; };
        const io = new IntersectionObserver((entries) => {
          clearTimeout(dwell);
          if (!entries[0]?.isIntersecting) return;
          dwell = window.setTimeout(() => {
            if (dragging || signal.aborted || !mostlyInView()) return;
            io.disconnect();
            const t0 = performance.now(), D = 1700;
            const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
            const step = (now: number) => {
              const t = Math.min(1, (now - t0) / D);
              const e = ease(t);
              set(50 - 26 * Math.sin(e * Math.PI * 2) * (1 - e * 0.35));
              if (t < 1) peekRaf = requestAnimationFrame(step); else { peekRaf = 0; set(50); }
            };
            peekRaf = requestAnimationFrame(step);
          }, 700);
        }, { threshold: [0, 0.6, 1] });
        io.observe(ba);
        observers.push(io);
        signal.addEventListener('abort', () => clearTimeout(dwell));
      }
      signal.addEventListener('abort', stopPeek);
    }

    /* ══ Rooms-per-year chart: hover tooltip ══ */
    const plot = caseEl.querySelector<HTMLElement>('.yrs__plot');
    const tip = plot?.querySelector<HTMLElement>('.yrs__tip');
    if (plot && tip) {
      const cols = Array.from(plot.querySelectorAll<HTMLElement>('.yrs__col'));
      let hot: HTMLElement | null = null;
      const show = (col: HTMLElement) => {
        if (hot === col) return;
        hot?.classList.remove('is-hot');
        hot = col;
        col.classList.add('is-hot');
        const n = Number(col.dataset.n || 0);
        tip.textContent = `${col.dataset.year}${col.dataset.partial ? ' so far' : ''}: ${n} room${n === 1 ? '' : 's'}`;
        const pr = plot.getBoundingClientRect();
        const bar = col.querySelector<HTMLElement>('.yrs__bar')!.getBoundingClientRect();
        const w = tip.offsetWidth, h = tip.offsetHeight;
        const x = Math.min(pr.width - w, Math.max(0, bar.left - pr.left + bar.width / 2 - w / 2));
        const y = Math.max(-8, bar.top - pr.top - h - 10);
        tip.style.setProperty('--tx', `${x}px`);
        tip.style.setProperty('--ty', `${y}px`);
        tip.classList.add('is-on');
      };
      const hide = () => { hot?.classList.remove('is-hot'); hot = null; tip.classList.remove('is-on'); };
      plot.addEventListener('pointermove', (e) => {
        const c = cols.find(col => { const r = col.getBoundingClientRect(); return e.clientX >= r.left && e.clientX < r.right; });
        if (c) show(c); else hide();
      }, { signal });
      plot.addEventListener('pointerleave', hide, { signal });
    }

    _cleanup = () => {
      ac.abort();
      observers.forEach(o => o.disconnect());
      cancelAnimationFrame(raf);
      cancelAnimationFrame(rideRaf);
      if (dlg?.open) dlg.close();
      document.documentElement.classList.remove('hiw-lb-open');
    };
  }

  document.addEventListener('astro:page-load', initHowItWorks);
  document.addEventListener('astro:before-swap', () => { _cleanup?.(); _cleanup = null; });
</script>
