  .site__stamp-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-yellow); }
  .site__caption { font-size: 13px; color: var(--c-text-muted); margin: 12px 0 0; }

  /* Reveal (dark) */
  .chapter--dark { background: var(--c-dark-deep); color: #fff; border-top: none; margin: 0 calc(var(--space-xl) * -1); padding-left: var(--space-xl); padding-right: var(--space-xl); border-radius: 28px; }
  .chapter--dark h2 { color: #fff; }
  .video { margin: 0 0 28px; }
  .video__frame { position: relative; border-radius: 16px; overflow: hidden; box-shadow: 0 24px 64px rgba(0,0,0,0.45), 0 0 0 1px rgba(255,255,255,0.06); background: #000; }
  .facade { position: relative; aspect-ratio: 16 / 9; cursor: pointer; }
  .facade__poster { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s cubic-bezier(0.16,1,0.3,1); }
  .facade:hover .facade__poster { transform: scale(1.02); }
  .facade__play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 92px; height: 92px; display: flex; align-items: center; justify-content: center; color: #fff; }
  .facade__ring { position: absolute; inset: 0; border: 2px solid rgba(255,255,255,0.9); border-radius: 50%; background: rgba(255,255,255,0.08); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); animation: breathe 3s ease-in-out infinite; transition: background 0.3s ease, border-color 0.3s ease; }
  .facade:hover .facade__ring, .facade:focus-visible .facade__ring { background: var(--c-yellow); border-color: var(--c-yellow); }
  .facade:hover .facade__play, .facade:focus-visible .facade__play { color: var(--c-dark); }
  .facade__play svg { width: 22px; height: 26px; margin-left: 4px; position: relative; }
  .facade:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 4px; }
  @keyframes breathe { 0%, 100% { transform: scale(1); opacity: 0.85; } 50% { transform: scale(1.06); opacity: 1; } }
  .video figcaption { font-size: 13px; color: rgba(255,255,255,0.5); margin-top: 12px; }

  .ba { max-width: 760px; }
  .ba__container { position: relative; border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 3; cursor: ew-resize; user-select: none; -webkit-user-select: none; touch-action: pan-y pinch-zoom; box-shadow: 0 24px 64px rgba(0,0,0,0.45); background: #111; }
  .ba__container:focus-within { outline: 3px solid var(--c-yellow); outline-offset: 3px; }
  .ba__after, .ba__before { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ba__after { position: absolute; inset: 0; }
  .ba__before-clip { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--ba-pos)) 0 0); z-index: 2; }
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 6; opacity: 0; margin: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; touch-action: pan-y; }
  .ba__handle { position: absolute; top: 0; bottom: 0; left: calc(var(--ba-pos) - 24px); width: 48px; z-index: 5; display: flex; align-items: center; justify-content: center; pointer-events: none; }
  .ba__line { position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 12px rgba(0,0,0,0.4); }
  .ba__knob { position: relative; width: 44px; height: 44px; border-radius: 50%; background: var(--c-yellow); color: var(--c-dark); display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 20px rgba(0,0,0,0.35); }
  .ba__knob svg { width: 22px; height: 22px; }
  .ba__label { position: absolute; bottom: 14px; z-index: 4; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; background: rgba(30,31,37,0.7); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); padding: 6px 12px; border-radius: 100px; transition: opacity 0.25s ease; }
  .ba__label--before { left: 14px; }
  .ba__label--after { right: 14px; }
  .ba__label[data-fade] { opacity: 0; }
  .ba__hint { font-size: 13px; color: rgba(255,255,255,0.5); margin: 12px 0 0; }

  /* Scale */
  .scale { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .scale__stat { background: #fff; border: 1px solid var(--c-border); border-radius: 16px; padding: 24px 22px; }
  .scale__stat--accent { background: var(--c-dark); border-color: var(--c-dark); color: #fff; }
  .scale__num { display: block; font-family: var(--font-display); font-size: clamp(30px, 3.4vw, 44px); font-weight: 700; line-height: 1; margin-bottom: 8px; color: var(--c-dark); font-variant-numeric: tabular-nums; }
  .scale__stat--accent .scale__num { color: var(--c-yellow); }
  .scale__cent { font-size: 0.6em; }
  .scale__label { font-size: 13px; line-height: 1.45; color: var(--c-text-muted); }
  .scale__stat--accent .scale__label { color: rgba(255,255,255,0.7); }
  .scale__foot { font-size: 14px; color: var(--c-text-muted); margin: 20px 0 0; }
  .scale__foot a { color: var(--c-dark); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--c-yellow); }

  /* Closing */
  .close { background: var(--c-yellow); padding: clamp(64px, 8vw, 96px) 0; margin-top: clamp(56px, 7vw, 96px); }
  .close__inner { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-xl); }
  .close__head { max-width: 640px; margin-bottom: 32px; }
  .close__head .section-label { color: rgba(45,46,51,0.7); }
  .close__head h2 { font-size: clamp(28px, 4vw, 44px); line-height: 1.15; letter-spacing: -0.02em; margin: 0; }
  .close__head h2 em { font-style: italic; }
  .close__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .close__card { display: flex; flex-direction: column; gap: 10px; padding: 32px; border-radius: 20px; background: rgba(255,255,255,0.7); color: var(--c-dark); text-decoration: none; border: 1px solid rgba(45,46,51,0.08); transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s ease, background 0.35s ease; }
  .close__card:hover { transform: translateY(-4px); box-shadow: 0 20px 48px rgba(45,46,51,0.15); background: #fff; }
  .close__card--dark { background: var(--c-dark); color: #fff; border-color: var(--c-dark); }
  .close__card--dark:hover { background: var(--c-dark-deep); }
  .close__card:focus-visible { outline: 3px solid var(--c-dark); outline-offset: 4px; }
  .close__kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7; }
  .close__title { font-family: var(--font-display); font-size: 26px; font-weight: 700; line-height: 1.15; }
  .close__text { font-size: 15px; line-height: 1.65; opacity: 0.8; }
  .close__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; font-size: 14px; font-weight: 700; }
  .close__card--dark .close__cta { color: var(--c-yellow); }
  .close__note { margin: 28px 0 0; font-size: 13px; color: rgba(45,46,51,0.75); }
  .close__note a { color: var(--c-dark); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  /* Reveals */
  [data-reveal] { opacity: 0; transform: translateY(28px); transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1); }
  [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  [data-delay="1"] { transition-delay: 0.1s; }
  [data-delay="2"] { transition-delay: 0.2s; }
  [data-delay="3"] { transition-delay: 0.3s; }

  /* ══════ Responsive ══════ */
  @media (max-width: 1024px) {
    .case { grid-template-columns: minmax(0, 1fr); gap: 0; }
    /* Sticky pill row directly under the site header; bleeds edge to edge */
    .rail {
      position: sticky; top: var(--hdr, 72px); z-index: 20;
      margin: 0 calc(var(--space-xl) * -1); padding: 10px var(--space-xl);
      background: rgba(254, 252, 245, 0.92);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--c-border);
    }
    .rail__label, .rail__project { display: none; }
    .rail__list { border-left: none; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 0; scroll-snap-type: x proximity; }
    .rail__list::before { display: none; }
    .rail__list::-webkit-scrollbar { display: none; }
    .rail__list li { flex: 0 0 auto; scroll-snap-align: center; }
    .rail__link { padding: 8px 14px; border: 1px solid var(--c-border); border-radius: 100px; white-space: nowrap; font-size: 13px; margin: 0; gap: 8px; background: var(--c-white); }
    .rail__link.is-active { padding-left: 14px; border-color: var(--c-yellow); background: var(--c-yellow); color: var(--c-dark); }
    .rail__num { width: auto; }
    .chapter { scroll-margin-top: 0; }
    .chapter__grid { grid-template-columns: 1fr; }
    .crew__group { grid-template-columns: 1fr; gap: 14px; }
    .scale { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 900px) {
    .hero { padding: 64px 0 56px; }
    .hero-inner { grid-template-columns: 1fr; gap: 40px; }
    .hero-frame { max-width: 420px; margin: 0 auto; width: 100%; }
    .hero-stat { left: 12px; bottom: 16px; padding: 12px 16px; }
    .plans { grid-template-columns: 1fr; }
    .plans__arrow { transform: rotate(90deg); justify-self: center; }
    .site { grid-template-columns: repeat(2, 1fr); }
    .site__shot--lead { grid-column: span 2; grid-row: auto; aspect-ratio: 4 / 3; }
    .chapter--dark { border-radius: 20px; }
  }
  @media (max-width: 600px) {
    .close__grid { grid-template-columns: 1fr; }
    .scale { grid-template-columns: 1fr 1fr; gap: 10px; }
    .scale__stat { padding: 18px 16px; }
    .chapter__num { font-size: 32px; }
    .chapter__head { gap: 14px; }
    .boards { margin-right: calc(var(--space-xl) * -1); }
  }
  @media print {
    .rail, .facade__play, .ba__handle, .ba__range, .ba__label, .boards__hint, .hero-ctas, .close { display: none !important; }
    .case { display: block; }
    .chapter--dark { background: #fff; color: #000; margin: 0; border-radius: 0; }
    .chapter--dark h2, .chapter__text--light p { color: #000; }
    .chapter { break-inside: avoid; }
    .boards__scroll { flex-wrap: wrap; overflow: visible; }
    [data-reveal] { opacity: 1 !important; transform: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .rail__list::before { transition: none; }
    .hero-text h1, .hero-lead, .hero-ctas, .hero-frame, .hero-accent { animation: none; opacity: 1; transform: none; }
    .facade__ring { animation: none; }
    .lqip-img.lqip-pending { opacity: initial; }
    .site__shot img, .facade__poster { transition: none; }
  }
</style>

<noscript>
  <style>
    .hero-lead, .hero-ctas, .hero-accent { opacity: 1 !important; animation: none !important; }
    [data-reveal] { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<script>
  function initHowItWorks() {
    const caseEl = document.getElementById('case');
    if (!caseEl) return;

    /* ── Site header height → CSS var (sticky offsets + anchor scroll margins) ── */
    const header = document.querySelector<HTMLElement>('header');
    const setHdr = () => { if (header) document.documentElement.style.setProperty('--hdr', `${Math.round(header.getBoundingClientRect().height)}px`); };
    setHdr();
    window.addEventListener('resize', setHdr, { passive: true });

    /* ── Chapter rail: highlight the chapter in view, fill progress, keep the pill visible ── */
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail]'));
    const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
    const railList = document.querySelector<HTMLElement>('.rail__list');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let railObs: IntersectionObserver | null = null;
    if (links.length && chapters.length && 'IntersectionObserver' in window) {
      const setActive = (id: string) => {
        links.forEach(l => l.classList.toggle('is-active', l.dataset.rail === id));
        const idx = Math.max(0, links.findIndex(l => l.dataset.rail === id));
        railList?.style.setProperty('--rail-progress', `${((idx + 1) / links.length) * 100}%`);
        const active = links[idx];
        if (railList && active && railList.scrollWidth > railList.clientWidth) {
          railList.scrollTo({ left: active.offsetLeft - (railList.clientWidth - active.offsetWidth) / 2, behavior: reduced ? 'auto' : 'smooth' });
        }
      };
      railObs = new IntersectionObserver((entries) => {
        const visible = entries.filter(e => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive((visible[0].target as HTMLElement).dataset.chapter || '');
      }, { rootMargin: '-35% 0px -55% 0px', threshold: 0 });
      chapters.forEach(c => railObs!.observe(c));
      setActive(chapters[0].dataset.chapter || '');
    }

    /* ── Video facade: load the player on demand ── */
    const facade = document.getElementById('video-facade');
    if (facade) {
      const play = () => {
        const stream = facade.dataset.stream;
        const yt = facade.dataset.yt;
        const iframe = document.createElement('iframe');
        iframe.src = stream
          ? `https://iframe.videodelivery.net/${stream}?autoplay=true&preload=true`
          : `https://www.youtube-nocookie.com/embed/${yt}?autoplay=1&rel=0`;
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = 'Reveal video';
        iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
        const wrap = document.createElement('div');
        wrap.style.cssText = 'position:relative;aspect-ratio:16/9;background:#000';
        wrap.appendChild(iframe);
        facade.replaceWith(wrap);
      };
      facade.addEventListener('click', play);
      facade.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); play(); } });
    }

    /* ── Before / after slider ── */
    const ba = document.querySelector<HTMLElement>('[data-ba]');
    if (ba) {
      const range = ba.querySelector<HTMLInputElement>('.ba__range');
      const before = ba.querySelector<HTMLElement>('[data-ba-label="before"]');
      const after = ba.querySelector<HTMLElement>('[data-ba-label="after"]');
      const set = (v: number) => {
        const p = Math.max(0, Math.min(100, v));
        ba.style.setProperty('--ba-pos', `${p}%`);
        if (range) range.value = String(p);
        before?.toggleAttribute('data-fade', p < 18);
        after?.toggleAttribute('data-fade', p > 82);
      };
      range?.addEventListener('input', () => set(Number(range.value)));
      let dragging = false;
      const fromX = (x: number) => { const r = ba.getBoundingClientRect(); return ((x - r.left) / r.width) * 100; };
      ba.addEventListener('pointerdown', (e) => { dragging = true; ba.classList.add('is-dragging'); set(fromX(e.clientX)); });
      window.addEventListener('pointermove', (e) => { if (dragging) set(fromX(e.clientX)); }, { passive: true });
      window.addEventListener('pointerup', () => { dragging = false; ba.classList.remove('is-dragging'); });
    }

    document.addEventListener('astro:before-swap', () => { railObs?.disconnect(); }, { once: true });
  }
  document.addEventListener('astro:page-load', initHowItWorks);
</script>
