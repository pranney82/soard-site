  .rail__link:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; border-radius: 6px; }
  .rail__project { margin: 24px 0 0; padding-left: 16px; font-size: 12px; line-height: 1.6; color: var(--c-text-light); text-transform: uppercase; letter-spacing: 0.08em; }
  .rail__project strong { color: var(--c-dark); font-size: 13px; letter-spacing: 0.02em; text-transform: none; }

  .chapters { min-width: 0; }
  .chapter { padding: clamp(56px, 7vw, 96px) 0; border-top: 1px solid var(--c-border); scroll-margin-top: 0; }
  .chapter:first-child { border-top: none; padding-top: 40px; }
  .chapter__head { display: flex; align-items: baseline; gap: 20px; margin-bottom: 20px; }
  .chapter__num { font-family: var(--font-display); font-style: italic; font-size: clamp(40px, 5vw, 64px); line-height: 0.9; color: #E0DDD6; flex-shrink: 0; }
  .chapter__num--light { color: rgba(255,255,255,0.18); }
  .chapter h2 { font-size: clamp(26px, 3.2vw, 40px); line-height: 1.15; letter-spacing: -0.02em; margin: 0; text-wrap: balance; }
  .chapter__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr); gap: clamp(28px, 4vw, 56px); align-items: start; }
  .chapter__text p { font-size: 17px; line-height: 1.75; color: var(--c-text-muted); margin: 0 0 16px; max-width: 62ch; }
  .chapter__text--wide { margin-bottom: 32px; }
  .chapter__text--light p { color: rgba(255,255,255,0.7); }
  .chapter__text strong { color: var(--c-text); }
  .chapter__text--light strong { color: #fff; }

  .criteria { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 12px; }
  .criteria li { position: relative; padding-left: 22px; font-size: 15px; line-height: 1.6; color: var(--c-text-muted); }
  .criteria li::before { content: ''; position: absolute; left: 0; top: 8px; width: 10px; height: 10px; border-radius: 50%; background: var(--c-yellow); }
  .criteria strong { color: var(--c-text); }

  /* From the file: the application card */
  .file { background: #fff; border: 1px solid var(--c-border); border-radius: 20px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.06); }
  .file__photo { aspect-ratio: 16 / 13; }
  .file__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .file__body { padding: 22px 26px 26px; }
  .file__tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-dark); background: var(--c-yellow); padding: 4px 10px; border-radius: 6px; margin-bottom: 12px; }
  .file__title { font-size: 20px; margin: 0 0 10px; line-height: 1.25; }
  .file__story { font-size: 14.5px; line-height: 1.65; color: var(--c-text-muted); margin: 0 0 16px; }
  .file__meta { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; font-size: 13px; }
  .file__meta dt { font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-size: 11px; color: var(--c-text-light); padding-top: 2px; }
  .file__meta dd { margin: 0; color: var(--c-text); }

  /* Design chapter is two parts: layout, then finishes */
  .design-part + .design-part { margin-top: 44px; }
  .chapter__kicker { display: flex; align-items: center; gap: 12px; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-light); margin: 0 0 16px; }
  .chapter__kicker::before { content: ''; width: 22px; height: 2px; background: var(--c-yellow); }

  /* Boards: horizontal paper strip */
  .boards { margin: 0 calc(var(--space-xl) * -1) 0 0; position: relative; }
  .boards::after { content: ''; position: absolute; top: 0; right: 0; bottom: 20px; width: 72px; background: linear-gradient(90deg, rgba(254,252,245,0), var(--c-cream)); pointer-events: none; }
  .boards__hint { display: none; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-text-light); margin: 0 0 12px; }
  @media (hover: none) { .boards__hint { display: inline-flex; } }
  .boards__scroll { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px 0 20px; scrollbar-width: thin; }
  .boards__scroll:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 4px; border-radius: 12px; }
  .board { flex: 0 0 min(620px, 86vw); scroll-snap-align: start; margin: 0; }
  .board__paper { background: #fff; border: 1px solid var(--c-border); border-radius: 12px; padding: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); }
  .board__paper img { width: 100%; height: auto; display: block; border-radius: 6px; }
  .board figcaption, .plan figcaption { font-size: 13px; color: var(--c-text-muted); margin-top: 10px; }

  /* Floor plans: existing → proposed */
  .plans { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 20px; align-items: center; }
  .plan { margin: 0; }
  .plan__paper { position: relative; background: #fff; border: 1px solid var(--c-border); border-radius: 12px; padding: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); }
  .plan__paper--proposed { border-color: rgba(255,218,36,0.9); box-shadow: 0 10px 30px rgba(0,0,0,0.06), 0 0 0 4px var(--c-yellow-soft); }
  .plan__paper img { width: 100%; height: auto; display: block; border-radius: 6px; }
  .plan__tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-text-muted); border: 1px solid var(--c-border); padding: 3px 9px; border-radius: 100px; margin-right: 8px; }
  .plan__tag--yes { color: var(--c-dark); background: var(--c-yellow); border-color: var(--c-yellow); }
  .plans__arrow { color: var(--c-text-light); }

  /* Crew: logos grouped by role */
  .crew { display: grid; gap: 28px; }
  .crew__group { border-top: 1px solid var(--c-border); padding-top: 22px; display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 24px; }
  .crew__group-head h3 { font-size: 19px; margin: 0 0 6px; }
  .crew__group-head p { font-size: 14px; line-height: 1.55; color: var(--c-text-muted); margin: 0; }
