  .site__shot { margin: 0; border-radius: 14px; overflow: hidden; background: var(--c-warm-gray); aspect-ratio: 4 / 3; }
  .site__shot--lead { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; min-height: 0; }
