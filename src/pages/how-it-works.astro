    border-left: 2px solid transparent; color: var(--c-text-muted); text-decoration: none; font-weight: 600; font-size: 15px;
    transition: color 0.25s ease, border-color 0.25s ease, padding-left 0.25s ease;
  }
  .rail__num { font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: var(--c-text-light); width: 22px; }
  .rail__link:hover { color: var(--c-dark); }
  .rail__link.is-active { color: var(--c-dark); border-left-color: var(--c-yellow); padding-left: 20px; }
