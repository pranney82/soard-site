  }
  .hero-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-muted);
    margin-bottom: 20px; display: flex; align-items: center; gap: 12px;
  }
  .hero-eyebrow::before { content: ''; width: 28px; height: 2px; background: currentColor; }
  .hero-text h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: -0.035em; line-height: 1.04; color: var(--c-text); margin-bottom: 28px;
    animation: heroSlide 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
