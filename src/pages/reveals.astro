---
/**
 * /reveals/: every room reveal on video.
 *
 * Built from kid content at build time (src/utils/reveals.ts): one card per
 * unique playable video, live stream replays first, then every recorded
 * reveal with a year filter. Dead Stream uploads never show up here; kids
 * whose Stream copy is gone fall back to their YouTube video.
 *
 * Hero: the same editorial split as apply/donate/home (text left, framed
 * photo right with the yellow accent block). The frame shows what's next:
 * the next child to be revealed, just their photo (a link to their live
 * page), with who and when beside it in the text, above the buttons, never
 * written on the photo (Peter, Nov 9 2026); with nothing coming up, the latest reveal
 * video, its photo with a play button, playing in the page's player ("if we
 * didnt, it should show the last reveal video there"). No stat badge.
 * Drawn from the schedule the build had (src/data/upcoming-reveals.json) and
 * brought up to date from /api/reveals when the page opens.
 *
 * Under the hero, "Coming up" (UpcomingReveals, as on /live/ and the events
 * page): the next reveals, and the every-reveal sign-up by email (no
 * address, ever: the emails say when and link to the live page) or in a
 * calendar. Peter, Nov 9 2026: the page has to let people subscribe right
 * here, so the hero's second button and the closing one go to that card.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import RevealGrid from '../components/reveals/RevealGrid.astro';
import UpcomingReveals from '../components/live/UpcomingReveals.astro';
import RevealInvite from '../components/live/RevealInvite.astro';
import { getReveals } from '../utils/reveals';
import { cfRaw, cfSrcset, cfLqip } from '../utils/cf-image';
import siteSettings from '../content/site/settings.json';
import { upcomingAtBuild } from '../utils/reveals-copy';
import { revealWhen } from '../utils/reveals-client';
import { getPublishedKids } from '../utils/collections';

const reveals = await getReveals();
const live = reveals.filter((r) => r.kind === 'live');
const videos = reveals.filter((r) => r.kind === 'video');

/* ── What's next: the next live reveal if one is planned, else the latest reveal video ── */
const next = upcomingAtBuild()[0] || null;
const nextKid = next ? (await getPublishedKids()).find((k) => k.data.slug === next.slug)?.data : null;
const nextPhoto = (nextKid?.heroImage as string | undefined) || next?.image || null;
// "Wednesday, November 18 at 4:00 PM EST" once it's confirmed, "Mid November" before
const nextWhen = next ? (next.confirmed ? revealWhen(next as any, 'long', 'America/New_York') : next.window?.label || '') : '';
// The newest reveal on video: the latest live replay, else the newest recorded reveal
const latest = live[0] || videos[0] || null;
const latestMeta = latest ? [latest.yearLabel, latest.rooms.join(', ')].filter(Boolean).join(' · ') : '';
const heroMode = next && nextPhoto ? 'next' : latest?.image ? 'latest' : 'photo';

/* ── Hero photos: the two newest reveals with a kid photo ── */
const withPhoto = reveals.filter((r) => r.image);
const heroMain = withPhoto[0];
const fallbackPhoto = (siteSettings as any).heroKidPhotoId || 'kids/braxton/photo-18';
const heroMainId = heroMain?.image || fallbackPhoto;
const heroMainAlt = heroMain ? `Photo of ${heroMain.names}` : 'A child in their new room';

const site = Astro.site?.origin || 'https://sunshineonaranneyday.com';
const breadcrumbs = [
  { name: 'Home', url: `${site}/` },
  { name: 'Reveal Videos', url: `${site}/reveals/` },
];

const description = `Watch kids with special needs see their new dream bedrooms, accessible bathrooms, and therapy rooms for the first time. ${reveals.length} reveal videos${live.length ? ' and live replays' : ''}.`;
const ogImage = cfRaw(heroMainId, 'w=1200,h=630,fit=cover,gravity=face,q=85,metadata=none');
---

<BaseLayout
  title="Room Reveal Videos"
  description={description}
  breadcrumbs={breadcrumbs}
  ogImage={ogImage}
>

  <!-- ══════ HERO: editorial split, no data-reveal (LCP) ══════ -->
  <section class="hero" data-whole>
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-eyebrow">Reveal Videos</p>
        <h1>The moment they see it for the <em>first time</em>.</h1>
        <p class="hero-lead">Every room we build ends with a door opening. Watch past reveals any time, and the next one live, right here.</p>
        <!-- The next live reveal: who and when, beside the photo rather than on it; a link to their live page -->
        <a class="rh-when" href={next?.liveUrl || '/live/'} data-rh-when hidden={!next}>
          <span class="rh-when__kicker"><span class="rh-when__dot" aria-hidden="true"></span>Next live reveal</span>
          <span class="rh-when__line"><strong class="rh-when__name" data-rh-when-name>{next?.name || ''}</strong><span class="rh-when__time" data-rh-when-time>{nextWhen}</span></span>
        </a>
        <div class="hero-ctas">
          <a href={live.length ? '#live-replays' : '#all-reveals'} class="btn btn-primary btn-lg">Watch the reveals</a>
          <!-- The every-reveal email sign-up, right under the hero (the next child's live page is the frame's own link) -->
          <a href="#up-next-mail" class="btn btn-outline-dark" data-rh-signup>Get every reveal by email</a>
        </div>
      </div>
      <div class="hero-frame" data-rh data-mode={heroMode}>
        <div class="hero-accent" aria-hidden="true"></div>
        {/* The next live reveal: that child's photo, nothing on it, linking to their live page */}
        <a class="hero-photo rh-next" href={next?.liveUrl || '/live/'} data-rh-next style={nextPhoto ? `background-image:url('${cfLqip(nextPhoto)}')` : undefined}>
          {nextPhoto && (
            <img
              src={cfRaw(nextPhoto, 'w=640,h=800,fit=cover,gravity=face,q=82,metadata=none')}
              srcset={cfSrcset(nextPhoto, [400, 640, 800, 1024], { fit: 'cover', gravity: 'face', aspectRatio: 1.25 })}
              sizes="(max-width: 768px) 80vw, (max-width: 1200px) 38vw, 420px"
              alt={next ? `${next.name}, whose room reveal is next` : ''}
              width="640" height="800" class="lqip-img" fetchpriority="high" loading="eager" decoding="async"
              data-rh-next-img
            />
          )}
        </a>
        {/* The latest reveal video, when nothing's coming up: its photo and a play button */}
        {latest?.image && (
          <a
            class="hero-photo rh-latest"
            href={latest.watchUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-haspopup="dialog"
            aria-label={`Play the latest reveal: ${latest.title}`}
            data-rv-open
            data-embed={latest.embedUrl}
            data-aspect={String(latest.source.aspect)}
            data-title={latest.title}
            data-meta={latestMeta}
            data-kids={JSON.stringify(latest.kids.map((k) => [k.slug, k.name]))}
            style={`background-image:url('${cfLqip(latest.image)}')`}
          >
            <img
              src={cfRaw(latest.image, 'w=640,h=800,fit=cover,gravity=face,q=82,metadata=none')}
              srcset={cfSrcset(latest.image, [400, 640, 800, 1024], { fit: 'cover', gravity: 'face', aspectRatio: 1.25 })}
              sizes="(max-width: 768px) 80vw, (max-width: 1200px) 38vw, 420px"
              alt={`Photo of ${latest.names}`}
              width="640" height="800" class="lqip-img" loading={heroMode === 'latest' ? 'eager' : 'lazy'} decoding="async"
            />
            <span class="rh-play" aria-hidden="true"><svg viewBox="0 0 24 28" fill="currentColor"><path d="M2 1.5v25l20-12.5L2 1.5z" /></svg></span>
          </a>
        )}
        <div class="hero-photo rh-photo" style={`background-image:url('${cfLqip(heroMainId)}')`}>
          <img
            src={cfRaw(heroMainId, 'w=640,h=800,fit=cover,gravity=face,q=82,metadata=none')}
            srcset={cfSrcset(heroMainId, [400, 640, 800, 1024], { fit: 'cover', gravity: 'face', aspectRatio: 1.25 })}
            sizes="(max-width: 768px) 80vw, (max-width: 1200px) 38vw, 420px"
            alt={heroMainAlt}
            width="640"
            height="800"
            class="lqip-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
    <span data-whole-end hidden></span>
  </section>

  <!-- ══════ COMING UP: the next reveals, and every reveal by email or in a calendar (the same band as /live/ and
       the events page; with nothing scheduled it stays, for the two ways to hear about the next one) ══════ -->
  <UpcomingReveals
    id="up-next"
    where="reveals"
    limit={3}
    emptyLead="The next reveal isn't on the schedule yet. Get it by email or in your calendar, and watch it live right here."
  />

  <!-- ══════ LIVE STREAM REPLAYS ══════ -->
  {live.length > 0 && (
    <section class="section rv-section rv-section--live" id="live-replays" aria-labelledby="live-replays-title">
      <div class="container">
        <header class="rv-head">
          <p class="section-label section-label--yellow">Live stream replays</p>
          <h2 id="live-replays-title" class="rv-head__title">Missed the live reveal? <em>Watch it back.</em></h2>
          <p class="rv-head__lead">The whole live stream, start to finish.</p>
        </header>
        <RevealGrid reveals={live} columns={3} phoneColumns={1} headingLevel="h3" eager={3} label="Live stream replays" />
      </div>
    </section>
  )}

  <!-- ══════ EVERY REVEAL ══════ -->
  {videos.length > 0 && (
    <section class="section rv-section rv-section--all" id="all-reveals" aria-labelledby="all-reveals-title">
      <div class="container">
        <header class="rv-head">
          <p class="section-label section-label--yellow">Reveal videos</p>
          <h2 id="all-reveals-title" class="rv-head__title">Every reveal on video</h2>
          <p class="rv-head__lead">Pick a year and press play.</p>
        </header>
        <RevealGrid
          reveals={videos}
          columns={4}
          headingLevel="h3"
          filter
          syncUrl
          eager={live.length ? 0 : 4}
          label="Recorded reveal videos"
        />
      </div>
    </section>
  )}

  <!-- ══════ CLOSING CTA ══════ -->
  <section class="rv-cta" aria-labelledby="rv-cta-title">
    <div class="rv-cta__inner">
      <div class="rv-cta__text">
        <p class="section-label section-label--light">The next room</p>
        <h2 id="rv-cta-title" class="rv-cta__title">Help open the next <em>door</em>.</h2>
        <p class="rv-cta__lead">Every room on this page was built with gifts. Yours builds the next one.</p>
      </div>
      <div class="rv-cta__actions">
        <a href="/donate/?src=reveals" class="btn btn-primary btn-lg rv-cta__btn">Help build the next room</a>
        <a href="#up-next-mail" class="btn btn-ghost-light rv-cta__btn" data-rh-signup>Get every reveal by email</a>
      </div>
    </div>
  </section>

  <RevealInvite />
</BaseLayout>

<style>
  /* ══════════════════════════════════════════
     HERO (same editorial split as apply.astro)
     ══════════════════════════════════════════ */

  .hero {
    background: var(--c-cream);
    padding: var(--hero-space-top) 0 clamp(64px, 8vw, 100px);
    position: relative;
    contain: layout style;
    min-height: clamp(480px, 70vh, 720px);
    overflow: hidden;
  }
  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-xl);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }
  .hero-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hero-eyebrow::before {
    content: '';
    width: 28px;
    height: 2px;
    background: currentColor;
    flex-shrink: 0;
  }
  .hero-text h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.035em;
    line-height: 1.04;
    color: var(--c-text);
    margin-bottom: 28px;
  }
  .hero-text h1 em {
    font-style: italic;
    background-image: linear-gradient(transparent 52%, var(--c-yellow-soft) 52%);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    padding: 0 0.05em;
  }
  .hero-lead {
    font-size: clamp(16px, 1.6vw, 18px);
    color: var(--c-text-muted);
    line-height: 1.7;
    margin-bottom: 40px;
    max-width: 500px;
  }
  /* The next live reveal, in the text beside its photo */
  .hero-lead:has(+ .rh-when:not([hidden])) { margin-bottom: 22px; }
  .rh-when {
    display: grid; gap: 4px; width: fit-content; max-width: 100%; margin: 0 0 30px; padding: 2px 0 2px 16px;
    border-left: 3px solid var(--c-yellow); color: var(--c-text); text-decoration: none;
  }
  .rh-when[hidden] { display: none; }
  .rh-when__kicker {
    display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--c-text-muted);
  }
  .rh-when__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-yellow); flex-shrink: 0; }
  .rh-when__line { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 10px; row-gap: 2px; }
  .rh-when__name { font-family: var(--font-display); font-size: clamp(19px, 1.7vw, 22px); font-weight: 700; letter-spacing: -0.01em; }
  .rh-when__time { font-size: 16px; color: var(--c-text-muted); }
  .rh-when__time:empty { display: none; }
  .rh-when:hover .rh-when__name { text-decoration: underline; text-decoration-color: var(--c-yellow); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .rh-when:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 4px; border-radius: 4px; }
  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-frame {
    position: relative;
  }
  .hero-accent {
    position: absolute;
    bottom: -16px;
    right: -16px;
    width: 65%;
    height: 50%;
    background: var(--c-yellow);
    border-radius: 24px;
    z-index: 0;
    opacity: 0.35;
  }
  .hero-photo {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    box-shadow:
      0 32px 80px rgba(0, 0, 0, 0.12),
      0 8px 24px rgba(0, 0, 0, 0.06);
  }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-photo--small {
    position: absolute;
    bottom: -24px;
    left: -32px;
    width: 40%;
    aspect-ratio: 5 / 6;
    z-index: 2;
    border: 4px solid var(--c-cream);
    box-shadow:
      0 4px 6px rgba(0, 0, 0, 0.06),
      0 12px 36px rgba(0, 0, 0, 0.12);
  }
  .lqip-img.lqip-pending { opacity: 0; }
  .lqip-img:not(.lqip-pending) { transition: opacity 0.4s ease; }

  /* ── What's next, in the frame: one thing big (the next live reveal, else the latest reveal video, else a photo) ── */
  .hero-frame:not([data-mode='next']) .rh-next,
  .hero-frame:not([data-mode='photo']) .rh-photo,
  .hero-frame:not([data-mode='latest']) .rh-latest { display: none; }
  .rh-next, .rh-latest { display: block; color: inherit; text-decoration: none; }
  .rh-next:focus-visible, .rh-latest:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 4px; }
  .rh-play {
    position: absolute; inset: 0; margin: auto; z-index: 1; width: 76px; height: 76px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(255, 255, 255, 0.94); color: var(--c-dark);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25); transition: transform 0.2s ease;
  }
  .rh-play svg { width: 24px; height: 28px; margin-left: 5px; }
  .rh-latest:hover .rh-play { transform: scale(1.06); }

  /* ══════════════════════════════════════════
     SECTIONS
     ══════════════════════════════════════════ */
  .rv-section--live { background: var(--c-white); }
  .rv-section--all { background: var(--c-cream); }
  .rv-section--live + .rv-section--all { border-top: 1px solid var(--c-border); }
  /* No live replays: keep the grid visually apart from the cream hero */
  .hero + .rv-section--all { background: var(--c-white); }

  .rv-head {
    max-width: 680px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .rv-head__title {
    margin: 0;
    font-size: clamp(1.85rem, 3.2vw + 0.6rem, 2.9rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .rv-head__title em {
    font-style: italic;
    background-image: linear-gradient(transparent 55%, var(--c-yellow-soft) 55%);
    padding: 0 0.04em;
  }
  .rv-head__lead {
    margin: 16px 0 0;
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.7;
    color: var(--c-text-muted);
    max-width: 600px;
  }

  /* ══════════════════════════════════════════
     CLOSING CTA
     ══════════════════════════════════════════ */
  .rv-cta {
    background: var(--c-dark-deep);
    color: var(--c-cream);
    padding: clamp(64px, 9vw, 112px) 0;
    border-top: 4px solid var(--c-yellow);
  }
  .rv-cta__inner {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-xl);
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .rv-cta__title {
    margin: 0;
    color: var(--c-white);
    font-size: clamp(1.9rem, 3.4vw + 0.5rem, 3rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .rv-cta__title em { font-style: italic; color: var(--c-yellow); }
  .rv-cta__lead {
    margin: 18px 0 0;
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.7;
    color: rgba(254, 252, 245, 0.72);
    max-width: 520px;
  }
  .rv-cta__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
  }
  .rv-cta__btn {
    white-space: normal;
    text-align: center;
    line-height: 1.3;
  }

  /* ══════════════════════════════════════════
     RESPONSIVE
     ══════════════════════════════════════════ */
  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; gap: 40px; text-align: center; }
    .hero-eyebrow { justify-content: center; }
    .hero-lead { margin-inline: auto; }
    .hero-ctas { justify-content: center; }
    /* Centred with the text: the yellow mark sits under it instead of beside it */
    .rh-when { margin-inline: auto; padding: 0 0 10px; border-left: 0; border-bottom: 3px solid var(--c-yellow); justify-items: center; }
    .rh-when__line { justify-content: center; }
    /* A set width (the photo's own: sizes says 80vw), so the frame has its 4:5 shape before the photo arrives; centred by
       auto margins alone it shrank to nothing until then, and everything under it jumped */
    .hero-frame { width: min(80vw, 380px); max-width: 380px; margin: 0 auto; }

    .rv-cta__inner { grid-template-columns: 1fr; }
    .rv-cta__actions { max-width: 460px; }
  }

  @media (max-width: 768px) {
    .hero { padding-top: var(--hero-space-top); padding-bottom: var(--space-xl); min-height: auto; }
    .hero-inner { padding: 0 var(--space-lg); }
    .hero-text h1 { font-size: clamp(2rem, 9vw, 3rem); }
    .hero-photo--small { display: none; }
    .hero-photo { border-radius: 18px; }
    .hero-accent { bottom: -12px; right: -12px; border-radius: 18px; }
    .rv-cta__inner { padding: 0 var(--space-lg); }
  }

  @media (max-width: 480px) {
    .hero-ctas .btn { width: 100%; }
  }

  /* ══════════════════════════════════════════
     REDUCED MOTION
     ══════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .hero-lead,
    .hero-ctas,
    .hero-frame { opacity: 1; transform: none; animation: none; }
    .hero-text h1 { animation: none; }
    .hero-accent { opacity: 0.35; animation: none; }
    .btn:hover { transform: none; }
    .rh-play, .rh-latest:hover .rh-play { transition: none; transform: none; }
    .lqip-img:not(.lqip-pending) { transition: none; }
    .lqip-img.lqip-pending { opacity: initial; }
  }
</style>

<script>
  /**
   * The hero's frame, brought up to date when the page opens: the build drew it from the schedule it had, and a reveal
   * may since have been set, moved or passed. /api/reveals (JobTread's schedule) decides: the next live reveal if
   * there is one, else the latest reveal video. A read that fails keeps what the build drew.
   */
  import { readUpcoming, loadSignup, revealWhen } from '../utils/reveals-client';
  import { cfRaw, cfSrcset } from '../utils/cf-image';

  function initRevealsHero() {
    const frame = document.querySelector<HTMLElement>('[data-rh]');
    if (!frame) return;
    // "Get every reveal by email" goes to the band's sign-up under the hero; when that card isn't offered here
    // (sign-ups off, or not known to be on), to the live page's own
    void loadSignup().then((s) => {
      if (s?.email) return;
      for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-rh-signup]')) a.href = '/live/#remind';
    });
    void readUpcoming().then((list) => {
      if (!list || !frame.isConnected) return;
      const n = list[0];
      // Who and when, beside the photo: the schedule as it is now
      const when = document.querySelector<HTMLAnchorElement>('[data-rh-when]');
      if (when) {
        when.hidden = !n;
        if (n) {
          when.href = n.liveUrl;
          const nm = when.querySelector<HTMLElement>('[data-rh-when-name]');
          const tm = when.querySelector<HTMLElement>('[data-rh-when-time]');
          if (nm) nm.textContent = n.name;
          if (tm) tm.textContent = n.confirmed ? revealWhen(n) : n.window.label;
        }
      }
      if (!n) {
        if (frame.querySelector('.rh-latest')) frame.dataset.mode = 'latest';
        return;
      }
      const link = frame.querySelector<HTMLAnchorElement>('[data-rh-next]');
      if (!link) return;
      link.href = n.liveUrl;
      // Another child than the build had: their photo
      let img = link.querySelector<HTMLImageElement>('[data-rh-next-img]');
      if (n.image && img?.dataset.slug !== n.slug && !(img && img.alt.startsWith(`${n.name},`))) {
        const src = /^https?:/.test(n.image) ? n.image : `${location.origin}${n.image}`;
        if (!img) { img = document.createElement('img'); img.width = 640; img.height = 800; img.decoding = 'async'; img.dataset.rhNextImg = ''; link.prepend(img); }
        img.srcset = cfSrcset(src, [400, 640, 800, 1024], { fit: 'cover', gravity: 'face', aspectRatio: 1.25 });
        img.sizes = '(max-width: 768px) 80vw, (max-width: 1200px) 38vw, 420px';
        img.src = cfRaw(src, 'w=640,h=800,fit=cover,gravity=face,q=82,metadata=none');
        img.alt = `${n.name}, whose room reveal is next`;
        img.dataset.slug = n.slug;
      }
      frame.dataset.mode = 'next';
    });
  }
  document.addEventListener('astro:page-load', initRevealsHero);
</script>
