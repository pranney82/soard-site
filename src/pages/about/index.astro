---
/**
 * Our Story — Sunshine on a Ranney Day
 * Editorial long-form page: founding story, milestones, mascot, mission
 * 
 * PERF NOTES:
 * - Hero image: fetchpriority="high", eager loading, explicit dimensions
 * - All below-fold images: loading="lazy"
 * - data-reveal only on below-fold elements
 * - Team photos from CF Images
 */
import PageLayout from '../../layouts/PageLayout.astro';
import FirstScreenEnd from '../../components/global/FirstScreenEnd.astro';
import siteSettings from '../../content/site/settings.json';
import FAQSection from '../../components/ui/FAQSection.astro';
import { getFAQSchema } from '../../utils/schema';
import { getSiteStats } from '../../utils/stats';
import page from '../../content/site/our-story.json';
import faqData from '../../content/site/faq.json';
import FlipBook from '../../components/book/FlipBook.astro';
import { getBook, bookSize } from '../../utils/book';

import { CF_BASE as CF, cfUrl, cfSrcset } from '../../utils/cf-image';

/* ── Auto-computed stats ── */
const computed = await getSiteStats();
const stats = {
  totalKids: computed.totalKids,
  totalRooms: computed.totalRooms,
  years: computed.years,
};
const founderPhotoId = page.images.founder;
// The founders photo is the page's main picture on a phone: the same 5:4 face crop at the sizes it shows
// (phones: the column; computers: 44% up to 528px), and preloaded so it starts with the page
const founderSrcset = [[400, 320], [600, 480], [640, 512], [800, 640], [1000, 800]].map(([w, h]) => `${CF}/${founderPhotoId}/w=${w},h=${h},fit=cover,gravity=face,q=80 ${w}w`).join(', ');
const founderSizes = '(max-width: 768px) calc(100vw - 48px), (max-width: 1200px) 44vw, 528px';
const storePhotoId = page.images.store;
const graciePhotoId = page.images.gracie;
const trippPhotoId = page.images.tripp;
/* A milestone with `award` (who gave it, set in Admin → Site Config → Our Story → Timeline) is an honor:
   it gets a medal on the spine, a laurel on its square and, with no photo, a laurel seal where the photo goes */
const milestones = (page.milestones as Array<{ year: string; title: string; desc: string; detail?: string; image?: string; award?: string }>)
  .map((m) => ({ ...m, award: String(m.award || '').trim() }));
/* People headshots are framed tight, so the wide photo anchors a little above the face to keep the whole head */
const wideGravity = (id: string) => (/^team\//.test(id) ? '0.5x0.3' : 'face') as 'face' | `${number}x${number}`;
/* The laurel: two branches on a circle of radius 24 in a 64×64 box, a pair of pointed leaves
   at each step (one leaning out, one in) and a leaf at each tip; drawn once at build time */
const LAUREL_STEM = 'M26.19 55.29A24 24 0 0 1 20 11.22M37.81 55.29A24 24 0 0 0 44 11.22';
const LAUREL_LEAF = 'M0 0C2.4-2.5 6.2-2.6 8.6 0C6.2 2.6 2.4 2.5 0 0Z';
const LAUREL_LEAVES = (() => {
  const leaves: string[] = [];
  const put = (deg: number, turn: number, len = 1) => {
    const a = (deg * Math.PI) / 180;
    const x = 32 + 24 * Math.cos(a);
    const y = 32 + 24 * Math.sin(a);
    const dir = deg + 90 + turn; /* along the branch toward its tip, leaning by `turn` */
    leaves.push(`translate(${x.toFixed(2)} ${y.toFixed(2)}) rotate(${dir}) scale(${len})`);
    leaves.push(`translate(${(64 - x).toFixed(2)} ${y.toFixed(2)}) rotate(${180 - dir}) scale(${len})`);
  };
  for (let deg = 116; deg <= 221; deg += 15) { put(deg, -38, 0.92); put(deg, 38, 0.82); }
  put(238, 0, 1);
  return leaves;
})();
/* The anniversary book (Admin → Site Config → Anniversary book), after the milestones once it's on the site */
const book = getBook();
const bookOn = !!book?.live;
const bookPdfSize = bookOn && book?.pdf ? bookSize(book.pdf.bytes) : '';

/* ── Breadcrumbs (BaseLayout emits WebPage + BreadcrumbList schema) ── */
const aboutDesc = `From one family's dream to ${stats.totalRooms}+ rooms transformed. See how Sunshine on a Ranney Day builds free bedrooms, bathrooms, and therapy spaces for kids with special needs in Atlanta.`;
const breadcrumbs = [
  { name: 'Home', url: 'https://sunshineonaranneyday.com/' },
  { name: 'Our Story', url: 'https://sunshineonaranneyday.com/about/' },
];
const aboutFaqs = faqData.items
  .filter(item => item.category === 'about' || item.category === 'rooms')
  .sort((a, b) => {
    if (a.category !== b.category) return a.category === 'about' ? -1 : 1;
    return (a.order || 0) - (b.order || 0);
  });
const jsonLd = getFAQSchema(aboutFaqs);
---

<PageLayout
  title="Our Story — A Family That Builds Dreams"
  description={aboutDesc}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  heroLabel="About"
  heroTitle={'Our <em class="highlight">Story</em>'}
  heroSubtitle="How it all started and where we're headed"
  firstScreenEnd
>
  <link slot="head" rel="preload" as="image" imagesrcset={founderSrcset} imagesizes={founderSizes} fetchpriority="high" />

  <!-- ══════ FOUNDERS — The Beginning ══════ -->
  <section class="founders" id="our-story" aria-labelledby="founders-heading">
    <div class="founders-inner">
      <div class="founders-photo">
        {/* Always 5:4, cropped around faces: its space is right before it loads, whatever photo is set */}
        <img src={`${CF}/${founderPhotoId}/w=600,h=480,fit=cover,gravity=face,q=80`} srcset={founderSrcset} sizes={founderSizes} alt="Peter and Holly Ranney, founders of Sunshine on a Ranney Day" width="600" height="480" loading="eager" decoding="async" fetchpriority="high" />
      </div>
      <div class="founders-text" data-reveal>
        <div class="section-label">{page.founders.label}</div>
        <h2 id="founders-heading" set:html={page.founders.heading} />
        {page.founders.paragraphs.map((p: string) => <p set:html={p} />)}
      </div>
    </div>
  </section>
  {/* The founders' photo sits centred beside their story: half the story painted moved it 110px when the rest came */}
  <FirstScreenEnd />

  <!-- ══════ TRIPP — The Turning Point ══════ -->
  <section class="turning-point" aria-labelledby="tripp-heading">
    <div class="turning-point-inner">
      <div class="turning-point-text" data-reveal>
        <div class="section-label">{page.turningPoint.label}</div>
        <h2 id="tripp-heading" set:html={page.turningPoint.heading} />
        {page.turningPoint.paragraphs.map((p: string) => <p set:html={p} />)}
      </div>
      <div class="turning-point-photo" data-reveal data-delay="1">
        <img src={`${CF}/${trippPhotoId}/w=600,q=80`} srcset={`${CF}/${trippPhotoId}/w=400,q=80 400w, ${CF}/${trippPhotoId}/w=600,q=80 600w, ${CF}/${trippPhotoId}/w=800,q=80 800w`} sizes="(max-width:768px) calc(100vw - 48px), 460px" alt="The Halstead family — Tripp's story inspired millions and helped expand SOARD's mission" width="600" height="807" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- ══════ GRACIE — The Mascot ══════ -->
  <section class="mascot" aria-labelledby="mascot-heading">
    <div class="mascot-inner">
      <div class="mascot-text" data-reveal>
        <div class="section-label">{page.mascot.label}</div>
        <h2 id="mascot-heading" set:html={page.mascot.heading} />
        {page.mascot.paragraphs.map((p: string) => <p set:html={p} />)}
        <p class="mascot-tagline" set:html={page.mascot.tagline} />
      </div>
      <div class="mascot-visual" data-reveal data-delay="1">
        <div class="mascot-photo">
          <img src={`${CF}/${graciePhotoId}/w=600,q=80`} srcset={`${CF}/${graciePhotoId}/w=400,q=80 400w, ${CF}/${graciePhotoId}/w=600,q=80 600w, ${CF}/${graciePhotoId}/w=800,q=80 800w`} sizes="(max-width:768px) calc(100vw - 48px), 460px" alt="Gracie the Pig — the real pot-bellied pig that inspired SOARD's mascot" width="600" height="400" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════ SUNNY & RANNEY — The Store ══════ -->
  <section class="store-section" aria-labelledby="store-heading">
    <div class="store-inner">
      <div class="store-photo" data-reveal>
        <img src={`${CF}/${storePhotoId}/w=600,q=80`} srcset={`${CF}/${storePhotoId}/w=400,q=80 400w, ${CF}/${storePhotoId}/w=600,q=80 600w, ${CF}/${storePhotoId}/w=800,q=80 800w`} sizes="(max-width:768px) calc(100vw - 48px), 460px" alt="Sunny & Ranney, a nonprofit home furnishings store in Roswell, Georgia" width="600" height="450" loading="lazy" decoding="async" />
      </div>
      <div class="store-text" data-reveal data-delay="1">
        <div class="section-label">{page.store.label}</div>
        <h2 id="store-heading" set:html={page.store.heading} />
        {page.store.paragraphs.map((p: string) => <p set:html={p} />)}
        <a href="https://sunnyandranney.com" target="_blank" rel="noopener noreferrer" class="btn btn-dark">Shop Sunny & Ranney →</a>
      </div>
    </div>
  </section>

  <!-- ══════ TIMELINE ══════ -->
  <section class="timeline-section" aria-labelledby="timeline-heading">
    <div class="timeline-header" data-reveal>
      <div class="section-label section-label--yellow">Milestones</div>
      <h2 id="timeline-heading">{stats.years} years of building <em>dreams</em>.</h2>
      <p class="timeline-subtitle">Every room starts with a story. Here's ours.</p>
      <button class="tl-expand-all" type="button" data-tl-expand-all>Expand all</button>
    </div>
    <noscript><style>.tl-panel{grid-template-rows:1fr !important}.tl-panel-inner{opacity:1 !important;transform:none !important;visibility:visible !important}.tl-expand-all,.tl-chevron{display:none !important}.tl-toggle{cursor:default !important}</style></noscript>
    <div class="timeline" id="timeline">
      <!-- Spine -->
      <div class="tl-track" aria-hidden="true">
        <div class="tl-track-fill"></div>
        <div class="tl-cursor"></div>
      </div>
      {milestones.map((m, i) => (
        <div class={`tl-item ${i % 2 === 0 ? 'tl-item--left' : 'tl-item--right'}${m.award ? ' tl-item--award' : ''}`} data-tl-item>
          <div class="tl-dot" aria-hidden="true">
            <span class="tl-dot-ring"></span>
            {m.award ? (
              <span class="tl-medal">
                <span class="tl-burst">{[0, 1, 2, 3, 4, 5, 6, 7].map((n) => <i style={`--n:${n}`}></i>)}</span>
                <svg width="14" height="14" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z"/></svg>
              </span>
            ) : (
              <span class="tl-dot-core"></span>
            )}
          </div>
          <div class="tl-connector" aria-hidden="true"></div>
          <article class={`tl-card ${i === 0 ? 'is-open' : ''}`} data-tl-card>
            <h3 class="tl-heading">
              <button class="tl-toggle" type="button" id={`tl-toggle-${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`tl-panel-${i}`} aria-label={`${m.year} ${m.title}${m.award ? `, awarded by ${m.award}` : ''}`}>
                {m.image ? (
                  <span class={`tl-thumb${m.award ? ' tl-thumb--award' : ''}`}>
                    <img
                      src={cfUrl(m.image, { w: 160, h: 160, fit: 'cover', gravity: 'face', q: 75 })}
                      srcset={cfSrcset(m.image, [96, 160, 240], { fit: 'cover', gravity: 'face', quality: 75, aspectRatio: 1 })}
                      sizes="64px"
                      alt=""
                      width="64" height="64"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    {m.award && (
                      <span class="tl-thumb-medal" aria-hidden="true">
                        <svg width="11" height="11" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z"/></svg>
                      </span>
                    )}
                  </span>
                ) : m.award ? (
                  <span class="tl-thumb tl-thumb--laurel" aria-hidden="true">
                    <svg class="tl-laurel" viewBox="0 0 64 64" width="56" height="56">
                      <path d={LAUREL_STEM} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                      {LAUREL_LEAVES.map((t) => <path d={LAUREL_LEAF} transform={t} fill="currentColor" />)}
                    </svg>
                    <svg class="tl-laurel-star" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z"/></svg>
                  </span>
                ) : (
                  <span class="tl-thumb tl-thumb--empty" aria-hidden="true">{String(m.year).slice(-2)}</span>
                )}
                <span class="tl-head">
                  <span class="tl-year">{m.year}</span>
                  <span class="tl-title">{m.title}</span>
                  {m.award && (
                    <span class="tl-award-by">
                      <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z"/></svg>
                      {m.award}
                    </span>
                  )}
                </span>
                <span class="tl-chevron" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </span>
              </button>
            </h3>
            <div class="tl-panel" id={`tl-panel-${i}`}>
              <div class="tl-panel-inner">
                {m.image && (
                  <div class="tl-image">
                    <img
                      src={cfUrl(m.image, { w: 480, h: 280, fit: 'cover', gravity: wideGravity(m.image), q: 75 })}
                      srcset={cfSrcset(m.image, [320, 480, 640, 960, 1400], { fit: 'cover', gravity: wideGravity(m.image), quality: 75, aspectRatio: 280/480 })}
                      sizes="(max-width:640px) calc(100vw - 72px), (max-width:960px) calc(100vw - 100px), 420px"
                      alt=""
                      width="480"
                      height="280"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="lqip-img"
                    />
                  </div>
                )}
                {!m.image && m.award && (
                  <div class="tl-seal" aria-hidden="true">
                    <span class="tl-seal-wreath">
                      <svg class="tl-laurel" viewBox="0 0 64 64" width="148" height="148">
                        <path d={LAUREL_STEM} fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
                        {LAUREL_LEAVES.map((t) => <path d={LAUREL_LEAF} transform={t} fill="currentColor" />)}
                      </svg>
                      <svg class="tl-laurel-star" width="44" height="44" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z"/></svg>
                    </span>
                  </div>
                )}
                <div class="tl-content">
                  <p class="tl-desc">{m.desc}</p>
                  {m.detail && <p class="tl-detail">{m.detail}</p>}
                </div>
              </div>
            </div>
          </article>
        </div>
      ))}
      <!-- End beacon -->
      <div class="tl-cap" aria-hidden="true">
        <div class="tl-cap-year">{new Date().getFullYear()}+</div>
        <span class="tl-cap-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        </span>
        <div class="tl-cap-label">And counting</div>
      </div>
    </div>
  </section>

  <!-- ══════ THE ANNIVERSARY BOOK: the whole story, to read here ══════ -->
  {bookOn && book && (
    <section class="book-section" id="book" aria-labelledby="book-heading">
      <div class="book-header" data-reveal>
        <div class="book-header-text">
          <div class="section-label">{book.eyebrow}</div>
          <h2 id="book-heading" set:html={book.titleHtml} />
          <p>{book.description}</p>
        </div>
        {book.pdf && (
          <a href={book.pdf.url} download={book.pdf.name} class="btn btn-outline-dark book-download">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5V15M7.5 10.5 12 15l4.5-4.5M4 19.5h16" /></svg>
            Download the PDF{bookPdfSize && <span class="book-size">{bookPdfSize}</span>}
          </a>
        )}
      </div>
      <div class="book-room">
        <FlipBook book={book} embedded heading={`${book.titleText}, the book. Turn the pages with the arrow keys.`} />
      </div>
    </section>
  )}

  <!-- ══════ IMPACT RIBBON ══════ -->
  <section class="ribbon" aria-label="Impact numbers">
    <div class="ribbon-inner">
      <div class="ribbon-stat" data-reveal>
        <span class="ribbon-num">{stats.totalRooms}+</span>
        <span class="ribbon-label">Room Makeovers</span>
      </div>
      <div class="ribbon-divider" role="presentation"></div>
      <div class="ribbon-stat" data-reveal data-delay="1">
        <span class="ribbon-num">{stats.totalKids}+</span>
        <span class="ribbon-label">Children Served</span>
      </div>
      <div class="ribbon-divider" role="presentation"></div>
      <div class="ribbon-stat" data-reveal data-delay="2">
        <span class="ribbon-num">{stats.years}</span>
        <span class="ribbon-label">Years of Impact</span>
      </div>
    </div>
  </section>

  <!-- ══════ WHERE WE ARE TODAY ══════ -->
  <section class="today-section" aria-labelledby="today-heading">
    <div class="today-inner" data-reveal>
      <div class="section-label">{page.today.label}</div>
      <h2 id="today-heading" set:html={page.today.heading} />
      {String(page.today.body || '').split(/\n\s*\n/).map((para) => para.trim()).filter(Boolean).map((para) => <p class="today-body" set:html={para} />)}
      <div class="today-links">
        <a href="/about/leadership/" class="btn btn-dark">Meet Our Team →</a>
        <a href="/about/financials/" class="btn btn-outline-dark">View Financials →</a>
      </div>
    </div>
  </section>

  <!-- ══════ FINAL CTA ══════ -->
  <!-- ══════ FAQ ══════ -->
  <FAQSection
    heading='Common questions about <em class="highlight-dark">our mission</em>.'
    body="Learn more about who we are, what we build, and how it all works."
    ctaLabel="See All FAQs →"
    ctaHref="/faq/"
    items={aboutFaqs}
    accordionName="about-faq"
    id="faq"
  />

  <section class="story-finale">
    <div class="story-finale-inner">
      <h2 data-reveal set:html={page.finale.heading} />
      <p data-reveal data-delay="1" set:html={page.finale.body} />
      <div class="story-finale-ctas" data-reveal data-delay="2">
        <a href="/donate/" class="btn btn-dark btn-lg">Donate Today</a>
        <a href="/kids/" class="btn btn-outline-dark">Meet the Kids</a>
      </div>
      <p class="story-finale-note" data-reveal data-delay="3">501(c)(3) · EIN {siteSettings.ein} · All donations tax-deductible · <a href="/publicity/" style="color: inherit; text-decoration: underline;">See our press coverage</a></p>
    </div>
  </section>

</PageLayout>

<style>
  /* ─── Page-specific overrides ──────────── */
  h2 em:not(.highlight) { font-style: italic; color: #8A7200; }

  /* ══════════════════════════════════════════
     FOUNDERS — Split layout
     ══════════════════════════════════════════ */
  .founders {
    background: var(--c-warm-gray);
    padding-block: var(--space-5xl) var(--space-4xl);
  }

  .founders-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
  }

  .founders-photo {
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .founders-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    display: block;
  }

  .founders-text h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: var(--space-xl);
  }

  .founders-text p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--c-text);
    margin-bottom: var(--space-md);
  }

  .founders-text p:last-of-type {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--c-text-muted);
  }

  @media (max-width: 768px) {
    .founders { padding-block: var(--space-3xl); }
    .founders-inner {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }

  /* ══════════════════════════════════════════
     TURNING POINT — Reversed split
     ══════════════════════════════════════════ */
  .turning-point {
    background: var(--c-warm-gray);
    padding-block: var(--space-4xl);
  }

  .turning-point-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
  }

  .turning-point-text h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: var(--space-xl);
  }

  .turning-point-text p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--c-text);
    margin-bottom: var(--space-md);
  }

  .turning-point-photo {
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .turning-point-photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .turning-point { padding-block: var(--space-3xl); }
    .turning-point-inner {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
    .turning-point-text { order: 1; }
    .turning-point-photo { order: 2; }
  }

  /* ══════════════════════════════════════════
     TIMELINE — Scroll-driven cinematic
     ══════════════════════════════════════════ */
  .timeline-section {
    --tl-gutter: 60px;
    background: var(--c-dark);
    color: var(--c-white);
    padding-block: var(--space-5xl) 0;
    overflow: hidden;
    overflow: clip; /* hidden still lets scrollIntoView scroll the section inside itself */
    position: relative;
  }

  .timeline-header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-5xl);
    padding-inline: var(--space-lg);
    position: relative;
    z-index: 2;
  }

  .timeline-header .section-label { justify-content: center; }

  .timeline-header h2 em { color: var(--c-yellow); }
  .timeline-header h2 {
    color: var(--c-white);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .timeline-subtitle {
    margin-top: var(--space-md);
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.6;
  }

  /* ── Track container ── */
  .timeline {
    position: relative;
    max-width: 1060px;
    margin-inline: auto;
    padding-inline: var(--space-lg);
    padding-bottom: var(--space-5xl);
  }

  /* ── Central spine ── */
  .tl-track {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.05);
    z-index: 0;
  }

  .tl-track-fill {
    position: absolute;
    inset: 0;
    background: var(--c-yellow);
    opacity: 0.7;
    transform-origin: top;
  }

  .tl-ready .tl-track-fill {
    transform: scaleY(0);
    will-change: transform;
  }

  /* ── CSS scroll-driven fill — compositor thread, zero JS ──
   * .timeline gets a named view-timeline. Children reference it
   * so animation progress tracks the *timeline section* scrolling
   * through the viewport, not the individual element. */
  @supports (animation-timeline: view()) {
    .timeline.tl-ready {
      view-timeline-name: --tl;
      view-timeline-axis: block;
    }

    @keyframes tl-fill-scroll {
      from { transform: scaleY(0); }
      to   { transform: scaleY(1); }
    }

    .tl-ready .tl-track-fill {
      animation: tl-fill-scroll linear both;
      animation-timeline: --tl;
      animation-range: entry 0% exit 60%;
    }

    @keyframes tl-cursor-scroll {
      0%   { transform: translateY(0%); opacity: 0; }
      5%   { opacity: 1; }
      95%  { opacity: 1; }
      100% { transform: translateY(100%); opacity: 0; }
    }

    .tl-ready .tl-cursor {
      animation: tl-cursor-scroll linear both;
      animation-timeline: --tl;
      animation-range: entry 0% exit 60%;
      transition: none;
    }
  }

  /* ── Scroll cursor — rides the fill line ── */
  /* height: 100% makes translateY(%) parent-relative → compositable */
  .tl-cursor {
    position: absolute;
    left: 50%;
    top: 0;
    width: 0;
    height: 100%;
    transform: translateY(0%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 3;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .tl-cursor::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-yellow);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 3px rgba(255, 218, 36, 0.25);
  }

  .tl-cursor.is-visible {
    opacity: 1;
  }

  /* ── Each milestone item ── */
  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr var(--tl-gutter) 1fr;
    gap: 0;
    align-items: start;
    margin-bottom: 40px;
    z-index: 1;
  }

  .tl-item:last-of-type { margin-bottom: 0; }

  /* Alternating sides */
  .tl-item--left .tl-card      { grid-column: 1; grid-row: 1; justify-self: end; }
  .tl-item--left .tl-dot       { grid-column: 2; grid-row: 1; }
  /* An absolutely placed grid child with only a start line runs to the container's edge,
     so the connector names both lines to sit in the gutter between its card and the dot */
  .tl-item--left .tl-connector { grid-column: 2 / 3; grid-row: 1; }
  .tl-item--right .tl-card     { grid-column: 3; grid-row: 1; justify-self: start; }
  .tl-item--right .tl-dot      { grid-column: 2; grid-row: 1; }
  .tl-item--right .tl-connector{ grid-column: 2 / 3; grid-row: 1; }

  /* ── Dot ── */
  .tl-dot {
    display: flex;
    align-items: start;
    justify-content: center;
    padding-top: 28px;
    position: relative;
    z-index: 2;
  }

  .tl-dot-ring {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid rgba(255, 218, 36, 0.15);
    top: 19px;
    left: 50%;
    transform: translateX(-50%) scale(1);
    opacity: 1;
    transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tl-ready .tl-dot-ring {
    transform: translateX(-50%) scale(0.4);
    opacity: 0;
  }

  .tl-dot-core {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c-yellow);
    border: 2px solid var(--c-yellow);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    z-index: 1;
  }

  .tl-ready .tl-dot-core {
    background: #424541;
    border-color: #4c4f4b;
  }

  /* Active dot */
  .tl-item.is-active .tl-dot-core {
    background: var(--c-yellow);
    border-color: var(--c-yellow);
    box-shadow: 0 0 0 4px rgba(255, 218, 36, 0.2);
    transform: scale(1.1);
  }

  .tl-item.is-active .tl-dot-ring {
    opacity: 1;
    transform: translateX(-50%) scale(1);
    border-color: rgba(255, 218, 36, 0.3);
    animation: tl-ring-pulse 3s ease-in-out infinite;
  }

  @keyframes tl-ring-pulse {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.5; }
    50%      { transform: translateX(-50%) scale(1.6); opacity: 0; }
  }

  /* ── Connector ── */
  .tl-connector {
    position: absolute;
    top: 34px;
    height: 2px;
    background: rgba(255, 218, 36, 0.25);
    transition: background 0.5s ease, width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    width: calc(var(--tl-gutter) / 2);
  }

  .tl-ready .tl-connector {
    background: rgba(255, 218, 36, 0.12);
    width: 0;
  }

  .tl-item--left .tl-connector  { right: 50%; transform-origin: right; }
  .tl-item--right .tl-connector { left: 50%; transform-origin: left; }

  .tl-item.is-active .tl-connector {
    background: rgba(255, 218, 36, 0.25);
    width: calc(var(--tl-gutter) / 2);
  }

  /* ── Card ── */
  .tl-card {
    max-width: 440px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s ease,
                box-shadow 0.35s ease,
                background 0.35s ease;
  }

  /* Only hide cards once JS has confirmed it can reveal them */
  .tl-ready .tl-card {
    opacity: 0;
  }
  .tl-ready .tl-item--left .tl-card  { transform: translateY(40px) translateX(30px); }
  .tl-ready .tl-item--right .tl-card { transform: translateY(40px) translateX(-30px); }

  .tl-ready .tl-item.is-active .tl-card {
    opacity: 1;
    transform: translateY(0) translateX(0);
  }

  /* Hover (mouse only): lift + border + shadow */
  @media (hover: hover) {
  .tl-card:hover {
    border-color: rgba(255, 218, 36, 0.25);
    background: rgba(255, 255, 255, 0.06);
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 218, 36, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transform: translateY(-3px) !important;
  }
  }

  /* ── Card image ── */
  .tl-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 480 / 280; /* the shape Cloudflare crops to, so the photo isn't cropped twice */
  }

  .tl-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .tl-card:hover .tl-image img { transform: scale(1.04); }
  }

  /* ── Card content ── */
  .tl-content {
    padding: 22px 26px 26px;
  }

  .tl-year {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--c-yellow);
    background: rgba(255, 218, 36, 0.1);
    padding: 5px 14px;
    border-radius: 100px;
    margin-bottom: 14px;
  }

  .tl-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--c-white);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .tl-desc {
    font-size: 0.93rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.76);
  }

  .tl-detail {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-yellow);
    letter-spacing: 0.02em;
    opacity: 0.85;
  }

  /* ── Collapsible cards (tap to open; first milestone open by default) ── */
  .tl-heading { margin: 0; font-size: inherit; }
  .tl-toggle {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 14px 16px 14px 14px;
    background: none;
    border: none;
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .tl-toggle:focus-visible {
    outline: 3px solid var(--c-yellow);
    outline-offset: -3px;
    border-radius: 16px;
  }
  .tl-thumb {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--c-yellow);
    flex-shrink: 0;
  }
  .tl-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tl-head { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; min-width: 0; }
  .tl-head .tl-year { margin-bottom: 0; }
  .tl-head .tl-title { margin: 0; font-size: 1.08rem; }
  .tl-chevron {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.75);
    flex-shrink: 0;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  @media (hover: hover) {
    .tl-toggle:hover .tl-chevron { border-color: rgba(255, 218, 36, 0.5); color: var(--c-yellow); }
  }
  /* Restoring opened cards on Back happens at once, with no animation */
  .tl-instant .tl-panel, .tl-instant .tl-panel-inner, .tl-instant .tl-chevron { transition: none !important; }
  .tl-card.is-open .tl-chevron {
    transform: rotate(180deg);
    background: var(--c-yellow);
    border-color: var(--c-yellow);
    color: var(--c-dark);
  }
  .tl-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tl-panel-inner {
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.35s ease, transform 0.35s ease, visibility 0s linear 0.5s;
  }
  .tl-card.is-open .tl-panel { grid-template-rows: 1fr; }
  .tl-card.is-open .tl-panel-inner { opacity: 1; visibility: visible; transform: none; transition-delay: 0.08s, 0.08s, 0s; }
  .tl-panel .tl-image { margin: 2px 14px 0; border-radius: 12px; }
  .tl-panel .tl-content { padding: 16px 18px 20px; }
  .tl-expand-all {
    margin-top: 20px;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.8);
    border-radius: 100px;
    padding: 9px 20px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .tl-expand-all:hover { transform: translateY(-1px); border-color: var(--c-yellow); color: var(--c-yellow); }
  .tl-expand-all[data-all-open] { background: var(--c-yellow); color: var(--c-dark); border-color: var(--c-yellow); }
  .tl-expand-all:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .tl-panel, .tl-panel-inner, .tl-chevron, .tl-expand-all { transition: none; }
  }

  /* ── End cap ── */
  .tl-cap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-top: var(--space-3xl);
    position: relative;
    z-index: 2;
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tl-ready .tl-cap {
    opacity: 0;
    transform: translateY(20px);
  }

  .tl-ready .tl-cap.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .tl-cap-year {
    position: relative;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--c-yellow);
    letter-spacing: 0.05em;
    background: var(--c-dark);
    padding: 2px 10px;
  }

  .tl-cap-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--c-yellow);
    color: var(--c-dark);
    box-shadow: 0 0 0 6px rgba(255, 218, 36, 0.16), 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .tl-cap.is-active .tl-cap-icon {
    animation: tl-cap-float 3s ease-in-out infinite;
  }

  @keyframes tl-cap-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }

  .tl-cap-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.68);
  }

  /* ══════ AWARDS — a milestone with `award` is an honor ══════
   * Spine: a yellow medal that stamps in with a burst when its card arrives.
   * Card: a yellow edge, a star on its square and who gave it under the title.
   * No photo: a laurel seal with the year where the photo would be. Flat fills only. */
  .tl-medal {
    position: relative;
    z-index: 1;
    width: 30px;
    height: 30px;
    margin-top: -8px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-yellow);
    color: var(--c-dark);
    border: 2px solid var(--c-dark);
    box-shadow: 0 0 0 2px var(--c-yellow), 0 0 0 7px rgba(255, 218, 36, 0.16);
    transition: background 0.5s ease, color 0.5s ease, box-shadow 0.5s ease;
  }
  .tl-item--award .tl-dot-ring { width: 48px; height: 48px; top: 11px; }

  .tl-ready .tl-medal {
    background: #424541;
    color: #7a7c78;
    box-shadow: 0 0 0 2px #4c4f4b;
  }
  .tl-ready .tl-item--award.is-active .tl-medal {
    background: var(--c-yellow);
    color: var(--c-dark);
    box-shadow: 0 0 0 2px var(--c-yellow), 0 0 0 7px rgba(255, 218, 36, 0.16);
    animation: tl-stamp 0.75s cubic-bezier(0.22, 1.5, 0.36, 1) both;
  }
  @keyframes tl-stamp {
    0%   { transform: scale(2.4) rotate(-30deg); opacity: 0; }
    55%  { transform: scale(0.88) rotate(4deg); opacity: 1; }
    100% { transform: scale(1) rotate(0); opacity: 1; }
  }

  /* The burst: eight short rays fly out once as the medal lands */
  .tl-burst { position: absolute; inset: 0; pointer-events: none; }
  .tl-burst i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3px;
    height: 9px;
    margin: -4.5px 0 0 -1.5px;
    border-radius: 2px;
    background: var(--c-yellow);
    opacity: 0;
    transform: rotate(calc(var(--n) * 45deg)) translateY(0);
  }
  .tl-ready .tl-item--award.is-active .tl-burst i {
    animation: tl-ray 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.32s both;
  }
  @keyframes tl-ray {
    0%   { opacity: 0; transform: rotate(calc(var(--n) * 45deg)) translateY(-10px) scaleY(0.4); }
    25%  { opacity: 1; }
    100% { opacity: 0; transform: rotate(calc(var(--n) * 45deg)) translateY(-34px) scaleY(1); }
  }

  .tl-item--award .tl-card {
    border-color: rgba(255, 218, 36, 0.32);
    background: rgba(255, 218, 36, 0.05);
  }
  @media (hover: hover) {
    .tl-item--award .tl-card:hover {
      border-color: rgba(255, 218, 36, 0.6);
      background: rgba(255, 218, 36, 0.08);
    }
  }
  .tl-item--award .tl-year { background: var(--c-yellow); color: var(--c-dark); }

  .tl-award-by {
    display: inline-flex;
    align-items: flex-start;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-yellow);
    line-height: 1.3;
  }
  .tl-award-by svg { flex-shrink: 0; margin-top: 0.1em; }

  .tl-thumb--award { position: relative; overflow: visible; }
  .tl-thumb--award img { border-radius: 12px; }
  .tl-thumb-medal {
    position: absolute;
    right: -5px;
    bottom: -5px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-yellow);
    color: var(--c-dark);
    border: 2px solid var(--c-dark);
  }

  .tl-thumb--laurel {
    position: relative;
    background: rgba(255, 218, 36, 0.12);
    color: var(--c-yellow);
  }
  .tl-thumb--laurel .tl-laurel { position: absolute; inset: 4px; }


  .tl-seal {
    margin: 2px 14px 0;
    border-radius: 12px;
    aspect-ratio: 480 / 280;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: rgba(255, 218, 36, 0.08);
    border: 1px solid rgba(255, 218, 36, 0.22);
    color: var(--c-yellow);
  }
  .tl-seal-wreath {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 148px;
    height: 148px;
  }
  .tl-seal-wreath .tl-laurel { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tl-laurel-star { position: relative; }
  .tl-card.is-open .tl-seal-wreath { animation: tl-seal-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both; }
  @keyframes tl-seal-in {
    from { transform: scale(0.85) rotate(-8deg); opacity: 0; }
    to   { transform: none; opacity: 1; }
  }

  /* ══════ TIMELINE — Tablet (≤960px) ══════ */
  @media (max-width: 960px) {
    .timeline-section { --tl-gutter: 44px; }

    .timeline {
      padding-left: 0;
      padding-right: var(--space-lg);
      margin-left: var(--space-lg);
    }

    /* The spine runs down the middle of the dot column, so each dot sits on it */
    .tl-track {
      left: calc(var(--tl-gutter) / 2);
      transform: translateX(-50%);
    }

    .tl-cursor { left: 50%; }

    .tl-cap {
      flex-direction: row;
      justify-content: flex-start;
      gap: 12px;
      margin-left: calc(var(--tl-gutter) / 2 - 24px);
    }
    .tl-cap-icon { order: -1; flex-shrink: 0; }

    .tl-item {
      grid-template-columns: var(--tl-gutter) 1fr;
      margin-bottom: 28px;
    }

    .tl-item--left .tl-card,
    .tl-item--right .tl-card {
      grid-column: 2;
      grid-row: 1;
      justify-self: start;
      max-width: 100%;
    }

    .tl-item--left .tl-dot,
    .tl-item--right .tl-dot {
      grid-column: 1;
      grid-row: 1;
    }

    /* One column: every connector runs right from the dot to its card */
    .tl-item--left .tl-connector,
    .tl-item--right .tl-connector { grid-column: 1 / 2; left: 50%; right: auto; }

    .tl-ready .tl-item--left .tl-card,
    .tl-ready .tl-item--right .tl-card {
      transform: translateY(28px) translateX(-16px);
    }

    .tl-ready .tl-item.is-active .tl-card {
      transform: translateY(0) translateX(0);
    }
  }

  /* ══════ TIMELINE — Narrow phones (≤400px): a smaller square leaves the words room ══════ */
  @media (max-width: 400px) {
    .tl-toggle { grid-template-columns: 48px 1fr auto; gap: 12px; padding: 12px 12px 12px 10px; }
