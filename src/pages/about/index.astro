<script>
  function initTimeline() {
    const timeline = document.getElementById('timeline');
    if (!timeline) return;

    const fill = timeline.querySelector<HTMLElement>('.tl-track-fill');
    const cursor = timeline.querySelector<HTMLElement>('.tl-cursor');
    const items = timeline.querySelectorAll<HTMLElement>('[data-tl-item]');
    const cap = timeline.querySelector<HTMLElement>('.tl-cap');
    if (!fill || !items.length) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ── Collapsible milestone cards ── */
    const cards = Array.from(timeline.querySelectorAll<HTMLElement>('[data-tl-card]'));
    const expandAll = document.querySelector<HTMLButtonElement>('[data-tl-expand-all]');
    const setOpen = (card: HTMLElement, open: boolean) => {
      card.classList.toggle('is-open', open);
      card.querySelector<HTMLButtonElement>('.tl-toggle')?.setAttribute('aria-expanded', String(open));
    };
    /* The cards a visitor opened, and where they were on the page, come back with Back or Forward.
     * Kept per history entry (this tab only); a reload or a fresh visit starts with just the first one open. */
    /* This visit's history entry, read now: by the time a Back or Forward away from here runs, history.state is already the next page's */
    const myKey = `soard-about-open:${(history.state && history.state.index) ?? 'page'}`;
    const entryKey = () => myKey;
    const remember = () => {
      try { sessionStorage.setItem(entryKey(), JSON.stringify({ open: cards.map(c => c.classList.contains('is-open')), y: Math.round(window.scrollY) })); } catch { /* private mode */ }
    };
    try {
      const saved = cameBack() ? JSON.parse(sessionStorage.getItem(entryKey()) || 'null') : null;
      if (saved && Array.isArray(saved.open) && saved.open.length === cards.length) {
        /* Open them at once (no animation), then put the page back where it was: the browser's own
         * restore ran while they were still closed, so it landed too far down */
        timeline.classList.add('tl-instant');
        cards.forEach((c, i) => setOpen(c, !!saved.open[i]));
        void timeline.offsetHeight;
        const back = () => window.scrollTo({ top: saved.y, behavior: 'instant' as ScrollBehavior });
        back();
        requestAnimationFrame(() => { back(); timeline.classList.remove('tl-instant'); });
        setTimeout(back, 60);
      } else {
        sessionStorage.removeItem(entryKey());
      }
    } catch { /* nothing saved */ }
    /* Leaving the page: note what's open and where the visitor was, for Back */
    const onLeave = () => remember();
    document.addEventListener('astro:before-preparation', onLeave);
    window.addEventListener('pagehide', onLeave);
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('astro:before-preparation', onLeave);
      window.removeEventListener('pagehide', onLeave);
    }, { once: true });
    const syncExpandAll = () => {
      if (!expandAll) return;
      const allOpen = cards.length > 0 && cards.every(c => c.classList.contains('is-open'));
      expandAll.toggleAttribute('data-all-open', allOpen);
      expandAll.textContent = allOpen ? 'Collapse all' : 'Expand all';
    };
    cards.forEach(card => {
      card.querySelector<HTMLButtonElement>('.tl-toggle')?.addEventListener('click', () => {
        setOpen(card, !card.classList.contains('is-open'));
        syncExpandAll();
        remember();
      });
    });
    expandAll?.addEventListener('click', () => {
      const open = !expandAll.hasAttribute('data-all-open');
      cards.forEach(c => setOpen(c, open));
      syncExpandAll();
      remember();
    });
    syncExpandAll();
    expandAll?.setAttribute('aria-controls', cards.map(c => c.querySelector('.tl-panel')?.id).filter(Boolean).join(' '));

    /* The line ends at the end marker's icon instead of running past it */
    const track = timeline.querySelector<HTMLElement>('.tl-track');
    const capIcon = cap?.querySelector<HTMLElement>('.tl-cap-icon');
    const placeTrackEnd = () => {
      if (!track || !cap || !capIcon) return;
      const iconCenter = cap.offsetTop + capIcon.offsetTop + capIcon.offsetHeight / 2;
      track.style.bottom = `${Math.max(0, timeline.clientHeight - iconCenter)}px`;
    };
    placeTrackEnd();
    let resizeFrame = 0;
    const onResize = () => { cancelAnimationFrame(resizeFrame); resizeFrame = requestAnimationFrame(placeTrackEnd); };
    window.addEventListener('resize', onResize, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('resize', onResize), { once: true });

    if (prefersReduced) {
      items.forEach(el => el.classList.add('is-active'));
      cap?.classList.add('is-active');
      return; /* no .tl-ready — content stays visible as-is */
    }

    /* ── Progressive enhancement gate ──
     * Only hide elements AFTER confirming JS will reveal them.
     * If JS never reaches this point, content stays visible. */
    timeline.classList.add('tl-ready');

    /* ── Track fill + cursor ──
     * CSS animation-timeline handles this on the compositor thread
     * when supported. JS scroll listener is the fallback only. */
    const cssScrollDriven = CSS.supports('animation-timeline', 'view()');
    let onScroll: (() => void) | null = null;

    if (!cssScrollDriven) {
      function updateTrack() {
        const rect = timeline!.getBoundingClientRect();
        const viewH = window.innerHeight;
        const timelineTop = rect.top;
        const timelineH = rect.height;

        if (timelineTop > viewH) {
          fill!.style.transform = 'scaleY(0)';
          if (cursor) { cursor.classList.remove('is-visible'); }
          return;
        }

        const scrolled = viewH * 0.55 - timelineTop;
        const progress = Math.min(Math.max(scrolled / timelineH, 0), 1);
        fill!.style.transform = `scaleY(${progress})`;

        if (cursor) {
          if (progress > 0.01 && progress < 0.99) {
            cursor.classList.add('is-visible');
            cursor.style.transform = `translateY(${progress * 100}%)`;
          } else {
            cursor.classList.remove('is-visible');
          }
        }
      }

      let ticking = false;
      onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            updateTrack();
            ticking = false;
          });
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      updateTrack();
    }

    /* ── Intersection observer for items ── */
    const isMobile = window.innerWidth <= 640;
    let activatedCount = 0;
    const itemObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !entry.target.classList.contains('is-active')) {
          const el = entry.target as HTMLElement;
          const delay = Math.min(activatedCount * 100, 250);
          setTimeout(() => el.classList.add('is-active'), delay);
          activatedCount++;
          itemObserver.unobserve(el);
        }
      });
    }, {
      threshold: isMobile ? 0.08 : 0.15,
      rootMargin: isMobile ? '0px 0px -30px 0px' : '0px 0px -80px 0px',
    });

    items.forEach(el => itemObserver.observe(el));

    /* ── End cap observer ── */
    let capObserver: IntersectionObserver | null = null;
    if (cap) {
      capObserver = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          cap.classList.add('is-active');
          capObserver!.disconnect();
        }
      }, { threshold: 0.3 });
      capObserver.observe(cap);
    }

    /* ── Safety net: reveal anything the observer missed that's already on or above the screen.
     * Items further down wait for the visitor, so their medals still land when they arrive. */
    const safety = setTimeout(() => {
      const fold = window.innerHeight;
      items.forEach(el => {
        if (!el.classList.contains('is-active') && el.getBoundingClientRect().top < fold) {
          el.classList.add('is-active');
          itemObserver.unobserve(el);
        }
      });
      if (cap && !cap.classList.contains('is-active') && cap.getBoundingClientRect().top < fold) cap.classList.add('is-active');
    }, 4000);

    /* ── Cleanup for Astro View Transitions ── */
    document.addEventListener('astro:before-swap', () => {
      if (onScroll) window.removeEventListener('scroll', onScroll);
      itemObserver.disconnect();
      capObserver?.disconnect();
      clearTimeout(safety);
    }, { once: true });
  }

  /* How this page was reached: Back/Forward inside the site (the router's 'traverse'), or a browser-level back_forward load */
  let lastNav = '';
  document.addEventListener('astro:before-preparation', (e) => { lastNav = (e as Event & { navigationType?: string }).navigationType || ''; });
  function cameBack() {
    if (lastNav) return lastNav === 'traverse';
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    return nav?.type === 'back_forward';
  }

  document.addEventListener('astro:page-load', initTimeline);
</script>


