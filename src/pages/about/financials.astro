---
/**
 * Financials — /about/financials/
 * Built as a chaptered transparency report, not a stack of sections:
 * contents page → 01 The Promise (waffle grid + statement) → 02 The Engine
 * (store model) → 03 The Story (annual report) → 04 The Receipts
 * (verification + document ledger).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import financialsData from '../../content/site/financials.json';
import siteSettings from '../../content/site/settings.json';
import { cfUrl, cfSrcset, isCF } from '../../utils/cf-image';

const storefrontImg = 'about/sunny-ranney-storefront';
// Hero photo is admin-managed: Settings → Page Photos → Financials Page
const heroPhoto = (siteSettings as any).financialsPhotos?.hero || 'kids/amari/hero';

// Sort documents by year descending
const docs990 = financialsData.documents
  .filter(d => d.type === '990')
  .sort((a, b) => b.year - a.year);

const docsAudit = financialsData.documents
  .filter(d => d.type === 'audit')
  .sort((a, b) => b.year - a.year);

const docsOther = financialsData.documents
  .filter(d => d.type === 'other')
  .sort((a, b) => b.year - a.year);

const annualReports = (financialsData.annualReports || [])
  .sort((a, b) => b.year - a.year);
const latestReport = annualReports[0];
const olderReports = annualReports.slice(1);

const latest990 = docs990[0];
const latestAudit = docsAudit[0];

// Type-first shelves: each document type gets its designed cover (latest year)
// with the full archive as year pills beneath it.
const shelves = [
  latest990 && { title: '990 Tax Returns', coverLabel: '990 Tax Return', kind: 'Form 990', docs: docs990 },
  latestAudit && { title: 'Audited Financials', coverLabel: 'Audited Financials', kind: 'audited financial statements', docs: docsAudit },
].filter(Boolean);

// Contractor license lives in the "other" documents (managed via admin) — the
// verification chip links whatever the current upload is, not a hardcoded file.
const licenseDoc = docsOther.find(d => /contractor/i.test(d.title));

// Financial snapshot — editable from admin panel
import snapshotData from '../../content/site/financial-snapshot.json';
const snapshot = snapshotData;

const fmtShort = (n: number) =>
  n >= 1_000_000 ? `$${(n / 1_000_000).toFixed(1)}M` : `$${Math.round(n / 1000)}K`;

// 100 pennies of a donated dollar, in fill order: programs, management, fundraising
const pennies = Array.from({ length: 100 }, (_, i) =>
  i < snapshot.programPct ? 'program' : i < snapshot.programPct + snapshot.managementPct ? 'mgmt' : 'fund');

// JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Financials — Sunshine on a Ranney Day",
  "description": "Financial transparency: 990 tax returns, audited financials, and annual reports for Sunshine on a Ranney Day.",
  "url": "https://sunshineonaranneyday.com/about/financials/",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Sunshine on a Ranney Day",
    "url": "https://sunshineonaranneyday.com"
  },
  "about": {
    "@type": "NGO",
    "name": "Sunshine on a Ranney Day",
    "taxID": "45-4773997"
  }
};
---

<PageLayout
  title="Financials — 990s, Audits & Annual Reports"
  description="Full financial transparency: 990 tax returns, audited financials, and annual reports. See exactly where your donation goes."
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Home', url: 'https://sunshineonaranneyday.com/' },
    { name: 'Our Story', url: 'https://sunshineonaranneyday.com/about/' },
    { name: 'Financials', url: 'https://sunshineonaranneyday.com/about/financials/' },
  ]}
>
  <!-- Preload hero LCP image -->
  <link slot="head" rel="preload" as="image" imagesrcset={cfSrcset(heroPhoto, [400, 640, 1024, 1600])} imagesizes="(max-width:768px) 100vw, 50vw" fetchpriority="high" />

  <!-- ══════ HERO — Editorial Split (same pattern as donate/apply) ══════ -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="section-label">Transparency</div>
        <h1>Our books<br/>are <em>open</em>.</h1>
        <p class="hero-lead">990 tax returns, audited financials, and annual reports — posted here for anyone to read, <strong>all the way back to 2012</strong>.</p>
        <div class="hero-ctas">
          {latestReport && (
            <a href={latestReport.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg"
               aria-label={`Read the ${latestReport.year} Impact Report (PDF, opens in new tab)`}>
              Read the {latestReport.year} Report &rarr;
            </a>
          )}
          <a href="#library" class="btn btn-outline-dark">See the Documents</a>
        </div>
        <div class="hero-trust">
          <a class="hero-trust-item" href="#library"><svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Independently audited annually</a>
          <a class="hero-trust-item" href="https://www.guidestar.org/profile/shared/2954b510-8c76-42e4-b589-7e826ca2cc47" target="_blank" rel="noopener noreferrer" aria-label="Candid Platinum Transparency 2026 — view our profile (opens in new tab)"><svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M15.5 13 17 22l-5-3-5 3 1.5-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Candid Platinum 2026</a>
          <a class="hero-trust-item" href="https://www.charitynavigator.org/ein/454773997" target="_blank" rel="noopener noreferrer" aria-label="Charity Navigator 3-Star Rating — view our profile (opens in new tab)"><svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Charity Navigator 3-Star</a>
        </div>
      </div>
      <div class="hero-photo-wrap">
        <div class="hero-frame">
          <img
            src={cfUrl(heroPhoto, { w: 1024, q: 85 })}
            srcset={cfSrcset(heroPhoto, [400, 640, 1024, 1600])}
            sizes="(max-width:768px) 100vw, 50vw"
            alt="A child smiling in their new dream bedroom built by Sunshine on a Ranney Day"
            width="1024"
            height="1280"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="hero-img"
          />
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num">{snapshot.programPct}<span>&cent;</span></span>
          <span class="hero-stat-label">of every donated dollar<br/>goes to programs</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Contents page -->
  <section class="section section--sm section--gray">
    <div class="container container--narrow">
      <p class="fin-intro">
        We believe every dollar you give should make a difference. That's why we complete a
        <span class="highlight">full independent audit</span> each year, maintain the highest transparency standards,
        and post everything here for you to see.
      </p>
      <nav class="jump-row" aria-label="Jump to a section">
        <span class="jump-row__label" aria-hidden="true">Jump to</span>
        <a href="#money">Where the Money Goes</a>
        <a href="#our-model">How We're Funded</a>
        {latestReport && <a href="#annual-reports">Annual Report</a>}
        <a href="#library">Document Library</a>
      </nav>
    </div>
  </section>

  <!-- Where the Money Goes -->
  <section class="section section--dark" id="money">
    <div class="container">
      <div class="sec-head sec-head--center" data-reveal>
        <span class="sec-head__eyebrow">Financial Snapshot &middot; FY {snapshot.year}</span>
        <h2>Where your money goes.</h2>
      </div>

      <div class="promise">
        <div
          data-reveal
          class="waffle"
          role="img"
          aria-label={`A donated dollar as 100 pennies: ${snapshot.programPct} to programs, ${snapshot.managementPct} to management, ${snapshot.fundraisingPct} to fundraising.`}
        >
          {pennies.map(p => <span class={`waffle__cell waffle__cell--${p}`}></span>)}
        </div>
        <div class="promise__copy" data-reveal data-delay="1">
          <span class="promise__cents" aria-hidden="true">{snapshot.programPct}<span class="promise__cents-symbol">&cent;</span></span>
          <p class="promise__lede">
            of every donated dollar goes directly to building rooms and serving children
            with critical illnesses and disabilities.
          </p>
          <div class="promise__legend" aria-hidden="true">
            <span class="promise__key"><span class="promise__dot promise__dot--program"></span>Programs {snapshot.programPct}&cent;</span>
            <span class="promise__key"><span class="promise__dot promise__dot--mgmt"></span>Management {snapshot.managementPct}&cent;</span>
            <span class="promise__key"><span class="promise__dot promise__dot--fund"></span>Fundraising {snapshot.fundraisingPct}&cent;</span>
          </div>
        </div>
      </div>

      <div class="fy-stats" data-reveal>
        <span class="fy-stats__label">FY {snapshot.year} by the numbers</span>
        <div class="fy-stats__grid">
          <div class="fy-stat">
            <span class="fy-stat__num">{fmtShort(snapshot.totalRevenue)}</span>
            <span class="fy-stat__label">Total Revenue</span>
          </div>
          <div class="fy-stat">
            <span class="fy-stat__num">{fmtShort(snapshot.programExpenses)}</span>
            <span class="fy-stat__label">Program Spending</span>
          </div>
          <div class="fy-stat">
            <span class="fy-stat__num">{fmtShort(snapshot.netAssets)}</span>
            <span class="fy-stat__label">Net Assets</span>
          </div>
        </div>
        <p class="fy-stats__note">
          From our audited financial statements &middot; <a href="#library">download the full audit below</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Our Model -->
  <section class="section" id="our-model">
    <div class="container">
      <div class="model-block">
        <div class="model-block__media" data-reveal>
          <img
            src={cfUrl(storefrontImg, { w: 900, h: 700, fit: 'cover', q: 80 })}
            srcset={cfSrcset(storefrontImg, [600, 900, 1200], { fit: 'cover', aspectRatio: 700/900, quality: 80 })}
            sizes="(max-width: 900px) 90vw, 45vw"
            alt="Sunny &amp; Ranney storefront in Roswell, Georgia"
            width="900" height="700"
            loading="lazy" decoding="async"
          />
        </div>
        <div class="model-block__content" data-reveal data-delay="1">
          <span class="model-block__eyebrow">The store behind the model</span>
          <h2>Our store covers most of our overhead.</h2>
          <ol class="model-steps">
            <li class="model-step">
              <span class="model-step__num" aria-hidden="true">1</span>
              <div>
                <span class="model-step__title">The store covers our overhead</span>
                <p>Sales from <a href="https://sunnyandranney.com" target="_blank" rel="noopener noreferrer">Sunny &amp; Ranney</a> — the Roswell furnishings store our founders opened in 2020 — pay the rent, utilities, and most salaries.</p>
              </div>
            </li>
            <li class="model-step">
              <span class="model-step__num" aria-hidden="true">2</span>
              <div>
                <span class="model-step__title">Your gift goes further</span>
                <p>Because the store carries those costs, far more of every donation reaches the mission.</p>
              </div>
            </li>
            <li class="model-step">
              <span class="model-step__num" aria-hidden="true">3</span>
              <div>
                <span class="model-step__title">More of your gift reaches the kids</span>
                <p>See the breakdown above — and every filing below.</p>
              </div>
            </li>
          </ol>
          <div class="engine-stats">
            <div class="engine-stat">
              <span class="engine-stat__num">{fmtShort(snapshot.storeRevenue)}</span>
              <span class="engine-stat__label">Store revenue, FY {snapshot.year}</span>
            </div>
            <div class="engine-stat">
              <span class="engine-stat__num">{snapshot.employees}</span>
              <span class="engine-stat__label">Employees</span>
            </div>
            <div class="engine-stat">
              <span class="engine-stat__num">{snapshot.volunteers}+</span>
              <span class="engine-stat__label">Volunteers</span>
            </div>
          </div>
          <a href="/sunny-and-ranney/" class="model-store-link">
            Visit the Store &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Annual Report -->
  {latestReport && (
    <section class="section section--gray" id="annual-reports">
      <div class="container">
        <div class="report-feature">
          <div class="report-feature__content" data-reveal>
            <span class="report-feature__eyebrow">Annual Report</span>
            <h2>The story behind the numbers</h2>
            <p>
              Our {latestReport.year} Impact Report goes beyond the spreadsheets — the rooms we built,
              the families we met, and what your support made possible this year.
            </p>
            <a
              href={latestReport.url}
              target="_blank"
              rel="noopener noreferrer"
              class="model-store-link"
              aria-label={`Read the ${latestReport.year} Impact Report (PDF, opens in new tab)`}
            >
              Read the {latestReport.year} Report &rarr;
            </a>
          </div>
          <a
            href={latestReport.url}
            target="_blank"
            rel="noopener noreferrer"
            class="report-feature__cover"
            tabindex="-1"
            aria-hidden="true"
            data-reveal
            data-delay="1"
          >
            {latestReport.coverImage ? (
              <div class="doc-page">
                <img
                  src={isCF(latestReport.coverImage) ? cfUrl(latestReport.coverImage, { w: 480, h: 621, fit: 'cover', gravity: 'center', q: 82 }) : latestReport.coverImage}
                  srcset={isCF(latestReport.coverImage) ? cfSrcset(latestReport.coverImage, [280, 420, 560, 840], { fit: 'cover', gravity: 'center', aspectRatio: 11 / 8.5, quality: 82 }) : undefined}
                  sizes={isCF(latestReport.coverImage) ? '(max-width: 900px) min(80vw, 300px), 300px' : undefined}
                  alt=""
                  width="480" height="621" loading="lazy" decoding="async"
                />
              </div>
            ) : (
              <div class="doc-page doc-cover">
                <span class="doc-cover__year">{latestReport.year}</span>
                <span class="doc-cover__label">Annual Report</span>
              </div>
            )}
          </a>
        </div>

        {olderReports.length > 0 && (
          <div class="report-grid">
            {olderReports.map(report => {
              const cfCover = !!report.coverImage && isCF(report.coverImage);
              return (
              <a href={report.url} target="_blank" rel="noopener noreferrer" class="report-card"
                 aria-label={`${report.year} Annual Report (PDF, opens in new tab)`}>
                {report.coverImage ? (
                  <div class="doc-page">
                    <img
                      src={cfCover ? cfUrl(report.coverImage, { w: 480, h: 621, fit: 'cover', gravity: 'center', q: 82 }) : report.coverImage}
                      srcset={cfCover ? cfSrcset(report.coverImage, [280, 420, 560, 840], { fit: 'cover', gravity: 'center', aspectRatio: 11 / 8.5, quality: 82 }) : undefined}
                      sizes={cfCover ? '(max-width: 600px) calc(100vw - 96px), 260px' : undefined}
                      alt=""
                      width="480" height="621" loading="lazy" decoding="async"
                    />
                  </div>
                ) : (
                  <div class="doc-page doc-cover">
                    <span class="doc-cover__year">{report.year}</span>
                    <span class="doc-cover__label">Annual Report</span>
                  </div>
                )}
                <span class="report-card__title">{report.year} Annual Report</span>
                <span class="report-card__label">View Report</span>
              </a>
              );
            })}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Document Library -->
  <section class="section" id="library">
    <div class="container">
      <div class="sec-head" data-reveal>
        <span class="sec-head__eyebrow">Documents &amp; Ratings</span>
        <h2>Document Library</h2>
        <p class="sec-head__desc">
          Independent ratings, every 990 tax return since 2012, and an audit for every year
          we've had one — each completed by an independent CPA firm.
        </p>
      </div>

      <div class="shelves">
        {shelves.map(({ title, coverLabel, kind, docs }, i) => {
          const latest = docs[0];
          return (
          <div class="shelf" data-reveal data-delay={i ? String(i) : undefined}>
            <a href={latest.url} target="_blank" rel="noopener noreferrer" class="shelf__cover"
               aria-label={`${latest.year} ${kind} (PDF, opens in new tab)`}>
              <div class="doc-page doc-cover" aria-hidden="true">
                <span class="doc-cover__org">Sunshine on a Ranney Day</span>
                <span class="doc-cover__year">{latest.year}</span>
                <span class="doc-cover__rule"></span>
                <span class="doc-cover__label">{coverLabel}</span>
              </div>
            </a>
            <h3 class="shelf__title">{title}</h3>
            <ul class="shelf__years">
              {docs.map((doc, i) => (
                <li>
                  <a href={doc.url} target="_blank" rel="noopener noreferrer"
                     class:list={["year-link", { "year-link--latest": i === 0 }]}
                     aria-label={`${doc.year} ${kind} (PDF, opens in new tab)`}>{doc.year}</a>
                </li>
              ))}
            </ul>
          </div>
          );
        })}
      </div>

      {docsOther.length > 0 && (
        <p class="also-file" data-reveal>
          <span class="also-file__label">Also on file</span>
          {docsOther.map(doc => (
            <a href={doc.url} target="_blank" rel="noopener noreferrer" class="year-link"
               aria-label={`${doc.title} (PDF, opens in new tab)`}>{doc.title}</a>
          ))}
        </p>
      )}

      <div class="verify-strip" data-reveal>
        <span class="verify-strip__label">Independently verified</span>
        <div class="verify-row">
          <a href="https://www.guidestar.org/profile/shared/2954b510-8c76-42e4-b589-7e826ca2cc47"
             target="_blank" rel="noopener noreferrer" class="verify" aria-label="View our Candid profile (opens in new tab)">
            <img src="/candid-platinum-2026.svg" alt="" width="44" height="44" loading="lazy" />
            <span class="verify__text">
              <span class="verify__label">Candid</span>
              <span class="verify__detail">Platinum Transparency 2026</span>
            </span>
          </a>
          <a href="https://www.charitynavigator.org/ein/454773997"
             target="_blank" rel="noopener noreferrer" class="verify" aria-label="View our Charity Navigator profile (opens in new tab)">
            <img src="/charity-navigator-3-star.png" alt="" width="44" height="44" loading="lazy" />
            <span class="verify__text">
              <span class="verify__label">Charity Navigator</span>
              <span class="verify__detail">3-Star Rating</span>
            </span>
          </a>
          <div class="verify">
            <span class="verify__text">
              <span class="verify__label">EIN 45-4773997</span>
              <span class="verify__detail">501(c)(3) since 2012</span>
            </span>
          </div>
          <a href={licenseDoc?.url || '/files/financials/ga-contractor-license.pdf'} target="_blank" rel="noopener noreferrer"
             class="verify" aria-label="View Georgia Contractor License (PDF, opens in new tab)">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 12l2 2 4-4"/><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </svg>
            <span class="verify__text">
              <span class="verify__label">Licensed Contractor</span>
              <span class="verify__detail">All projects permitted</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section section--dark" slot="cta">
    <div class="container container--narrow" style="text-align: center;" data-reveal>
      <h2 style="color: var(--c-white);">Questions about our finances?</h2>
      <p style="margin-top: var(--space-md); color: rgba(255,255,255,0.7); max-width: 520px; margin-inline: auto;">
        We believe in complete transparency. If you have any questions about how your donations are used, please don't hesitate to reach out.
      </p>
      <div style="margin-top: var(--space-xl); display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
        <a href="mailto:info@soardcharity.com" class="btn btn-primary">Contact Us</a>
        <a href="/donate/" class="btn cta-ghost">Donate Today</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* ─── Hero — Editorial Split (donate/apply pattern) ── */
  .hero {
    padding: 120px 0 100px;
  }
  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-xl);
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .hero-text { max-width: 540px; }
  .hero-text .section-label {
    opacity: 0;
    animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }
  .hero h1 {
    font-size: clamp(32px, 5.5vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
    animation: heroSlide 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero h1 em {
    font-style: italic;
    color: #8A7200;
  }
  .hero-lead {
    font-size: clamp(16px, 2vw, 18px);
    color: var(--c-text-muted);
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 32px;
    opacity: 0;
    animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  .hero-lead strong { color: var(--c-dark); }
  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    opacity: 0;
    animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }
  .hero-trust {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 24px;
    opacity: 0;
    animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }
  .hero-trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--c-text-light);
    letter-spacing: 0.01em;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  a.hero-trust-item:hover {
    color: var(--c-dark);
    border-bottom-color: var(--c-yellow);
  }
  .hero-trust-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--c-text-muted);
  }
  .hero-photo-wrap {
    position: relative;
    animation: heroPhotoIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-frame {
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.12);
    background-size: cover;
    background-position: center;
