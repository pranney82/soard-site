---
/**
 * Trade partners: the page SOARD sends a company to set up
 *
 * DESIGN: Editorial split hero (the standard hero-* naming, as on
 * home/apply/donate/advisory-board), then one section: what to have handy
 * beside the form. That's the whole page. English and Spanish: the page
 * renders English and the script swaps every [data-t] for the visitor's
 * language.
 *
 * "Get started" takes the company, name, email and phone; their own page
 * (/trade-partners/account/) comes by email, and JobTread is matched or the
 * vendor made with nobody at SOARD approving (functions/api/trade-partner.js,
 * startPartner in ./_trade-partners.js). "Already set up?" is a sign-in by
 * email. The insurance minimums come from the server at load.
 * The hero photo: Admin → Site Config (tradePartnersPhotos.hero).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteSettings from '../../content/site/settings.json';
import { getSiteStats } from '../../utils/stats';
import { cfRaw, cfLqip } from '../../utils/cf-image';

const computed = await getSiteStats();
const SITE_URL = 'https://sunshineonaranneyday.com';
const orgName = siteSettings.name;
const email = siteSettings.email;
const heroPhotoId = (siteSettings as any).tradePartnersPhotos?.hero || 'kids/oakley/photo-15';

const breadcrumbs = [
  { name: 'Home', url: `${SITE_URL}/` },
  { name: 'Trade partners', url: `${SITE_URL}/trade-partners/` },
];
---

<BaseLayout
  title="Trade Partners: Set Up Your Account"
  description="Plumbers, electricians, carpenters, suppliers and crews build SOARD’s bedrooms and bathrooms for children with disabilities. Set up your trade-partner account in about 10 minutes."
  breadcrumbs={breadcrumbs}
>
  <link slot="head" rel="preload" as="image" imagesrcset={`${cfRaw(heroPhotoId, 'w=400,h=500,fit=cover,gravity=face,q=65')} 400w, ${cfRaw(heroPhotoId, 'w=560,h=700,fit=cover,gravity=face,q=65')} 560w, ${cfRaw(heroPhotoId, 'w=800,h=1000,fit=cover,gravity=face,q=65')} 800w`} imagesizes="(max-width:768px) 85vw, 420px" fetchpriority="high" />

  <!-- ══════ HERO — Editorial Split ══════ -->
  <section class="hero" id="tp-top">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="hero-top">
          <p class="hero-eyebrow" data-t="eyebrow">Trade partners</p>
          <button type="button" class="tp-lang" data-lang-switch lang="es">Español</button>
        </div>
        <h1 class="hero-headline" data-t="h1" data-html>Your craft. A child’s <em>room</em>.</h1>
        <p class="hero-lead" data-t="lead">{orgName} builds bedrooms and bathrooms for children with disabilities across greater Atlanta. Set up your account once, and we pay you by direct deposit.</p>
        <div class="hero-ctas">
          <a href="#start" class="btn btn-primary btn-lg" data-t="ctaStart" data-focus="#tp-company">Get started</a>
          <a href="#sign-in" class="btn btn-outline-dark btn-lg" data-t="ctaSignIn" data-focus="#tp-email">Sign in</a>
        </div>
        <div class="hero-trust">
          <span class="hero-trust-item"><svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M2 10h20" stroke="currentColor" stroke-width="1.5"/></svg><span data-t="trust1">Paid by direct deposit</span></span>
          <span class="hero-trust-item"><svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span data-t="trust2">Documents checked in seconds</span></span>
          <span class="hero-trust-item"><svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span data-t="trust3">About 10 minutes</span></span>
        </div>
      </div>
      <div class="hero-photo-wrap">
        <div class="hero-frame" style={`background-image:url('${cfLqip(heroPhotoId)}')`}>
          <img
            src={cfRaw(heroPhotoId, 'w=800,h=1000,fit=cover,gravity=face,q=65')}
            srcset={`${cfRaw(heroPhotoId, 'w=400,h=500,fit=cover,gravity=face,q=65')} 400w, ${cfRaw(heroPhotoId, 'w=560,h=700,fit=cover,gravity=face,q=65')} 560w, ${cfRaw(heroPhotoId, 'w=800,h=1000,fit=cover,gravity=face,q=65')} 800w`}
            sizes="(max-width:768px) 85vw, 420px"
            alt="A girl trying out the handheld shower, grab bar and shower seat in her new accessible bathroom"
            width="800" height="1000" fetchpriority="high" loading="eager" decoding="sync" class="hero-img lqip-img"
          />
        </div>
        <div class="hero-accent" aria-hidden="true"></div>
        <div class="hero-stat">
          <span class="hero-stat-num">{computed.totalRooms}+</span>
          <span class="hero-stat-label" data-t="stat" data-html>rooms built<br />since 2012</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════ SET UP ══════ -->
  <section class="tp-start" id="start" aria-labelledby="tp-start-h">
    <div class="tp-start-inner">
      <div class="tp-need">
        <h2 id="tp-start-h" data-t="startTitle" data-html>Set up your <em>account</em></h2>
        <p class="tp-need-lead" data-t="startLead">Your link comes by email. Then it’s all on one page, so have these handy:</p>
        <ol class="tp-need-list">
          <li><strong data-t="n1t">Your W-9.</strong> <span data-t="n1b">You fill it in and sign it right on the page.</span></li>
          <li><strong data-t="n2t">Your insurance certificate,</strong> <span data-t="n2b">or your agent’s email and we’ll ask them. It needs to show:</span>
            <ul class="tp-reqs" id="tp-reqs"></ul>
          </li>
          <li><strong data-t="n3t">Your bank account,</strong> <span data-t="n3b">for direct deposit. It goes straight to our bank; we keep only the last four digits.</span></li>
        </ol>
      </div>

      <div class="tp-forms">
        <form class="tp-card" id="tp-start" novalidate>
          <div class="tp-grid">
            <label class="tp-field tp-span"><span class="tp-label" data-t="company">Company name</span><input id="tp-company" name="company" autocomplete="organization" required maxlength="120" /></label>
            <label class="tp-field"><span class="tp-label" data-t="name">Your name</span><input name="name" autocomplete="name" required maxlength="80" /></label>
            <label class="tp-field"><span class="tp-label" data-t="phone">Phone</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="20" /></label>
            <label class="tp-field tp-span"><span class="tp-label" data-t="emailLabel">Email address</span><input name="email" type="email" autocomplete="email" inputmode="email" required maxlength="120" /></label>
            <div class="tp-hp" aria-hidden="true"><label>Leave this empty <input name="website2" tabindex="-1" autocomplete="off" /></label></div>
          </div>
          <div class="tp-turnstile" id="tp-turnstile"></div>
          <p class="tp-error" id="tp-start-error" role="alert" hidden></p>
          <button type="submit" class="btn btn-dark btn-lg tp-send" data-t="send">Email me my link</button>
        </form>
        <div class="tp-card tp-sent" id="tp-start-sent" tabindex="-1" hidden>
          <span class="tp-sent-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
          <h3 data-t="sentTitle">Check your email</h3>
          <p id="tp-start-sent-body"></p>
        </div>

        <form class="tp-signin" id="sign-in" novalidate>
          <label class="tp-field">
            <span class="tp-label" data-t="signLabel">Already set up? Sign in with your email</span>
            <input id="tp-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          </label>
          <button type="submit" class="btn btn-outline-dark" data-t="signBtn">Email me a link</button>
          <p class="tp-note" id="tp-signin-note" role="status" aria-live="polite" hidden></p>
        </form>
      </div>
    </div>
    <p class="tp-help"><span data-t="help">Questions?</span> <a href={`mailto:${email}`}>{email}</a> · {orgName} <span data-t="nonprofit">is a 501(c)(3) nonprofit</span></p>
  </section>
</BaseLayout>

<script>
  import { requirementLines, startLang, keepLang, type Lang } from '../../components/trade-partners/words';

  const ES: Record<string, string> = {
    eyebrow: 'Socios comerciales',
    h1: 'Su oficio. El <em>cuarto</em> de un niño.',
    lead: 'Sunshine on a Ranney Day construye cuartos y baños para niños con discapacidades en el área de Atlanta. Configure su cuenta una vez y le pagamos por depósito directo.',
    ctaStart: 'Empezar', ctaSignIn: 'Entrar',
    trust1: 'Pago por depósito directo', trust2: 'Documentos revisados en segundos', trust3: 'Unos 10 minutos',
    stat: 'cuartos construidos<br />desde 2012',
    startTitle: 'Configure su <em>cuenta</em>',
    startLead: 'Su enlace llega por correo. Luego todo está en una sola página, así que tenga esto a la mano:',
    n1t: 'Su W-9.', n1b: 'Lo llena y lo firma en la misma página.',
    n2t: 'Su certificado de seguro,', n2b: 'o el correo de su agente y se lo pedimos. Debe mostrar:',
    n3t: 'Su cuenta bancaria,', n3b: 'para el depósito directo. Va directo a nuestro banco; solo guardamos los últimos cuatro dígitos.',
    company: 'Nombre de la empresa', name: 'Su nombre', phone: 'Teléfono', emailLabel: 'Correo electrónico',
    send: 'Enviarme mi enlace', sentTitle: 'Revise su correo',
    signLabel: '¿Ya tiene cuenta? Entre con su correo', signBtn: 'Enviarme un enlace',
    help: '¿Preguntas?', nonprofit: 'es una organización sin fines de lucro 501(c)(3)',
  };
  const SAY = {
    en: {
      emailBad: 'Type the email address you use with us.',
      signSent: (e: string) => `Check your email. If ${e} is on file with us, your link is on its way. Nothing after a few minutes? Check your spam folder, or set up your account above.`,
      sending: 'Sending…', signBtn: 'Email me a link', send: 'Email me my link',
      sent: (e: string, c: string) => `Your link to set up ${c} is on its way to ${e}. If we already have ${c} under another email address, it went there instead. Nothing after a few minutes? Check your spam folder.`,
      failed: 'That didn’t go through. Check your connection and try again.',
      need: { company: 'Add your company’s name.', name: 'Add your name.', email: 'Add an email address we can reach you at.', phone: 'Add a 10-digit phone number.' } as Record<string, string>,
    },
    es: {
      emailBad: 'Escriba el correo que usa con nosotros.',
      signSent: (e: string) => `Revise su correo. Si ${e} está registrado con nosotros, su enlace va en camino. ¿No llegó en unos minutos? Revise la carpeta de spam o configure su cuenta arriba.`,
      sending: 'Enviando…', signBtn: 'Enviarme un enlace', send: 'Enviarme mi enlace',
      sent: (e: string, c: string) => `Su enlace para configurar ${c} va en camino a ${e}. Si ya tenemos ${c} con otro correo, se envió allí. ¿No llegó en unos minutos? Revise la carpeta de spam.`,
      failed: 'No se pudo enviar. Revise su conexión e intente de nuevo.',
      need: { company: 'Agregue el nombre de su empresa.', name: 'Agregue su nombre.', email: 'Agregue un correo donde podamos escribirle.', phone: 'Agregue un teléfono de 10 dígitos.' } as Record<string, string>,
    },
  };

  const EN = new Map<Element, string>();
  let lang: Lang = 'en';
  let config: any = null;
  let turnstileWidget: string | null = null;

  function paint(next: Lang) {
    lang = next;
    document.documentElement.lang = next;
    for (const el of document.querySelectorAll<HTMLElement>('[data-t]')) {
      if (!EN.has(el)) EN.set(el, el.dataset.html !== undefined ? el.innerHTML : el.textContent || '');
      const words = next === 'es' ? ES[el.dataset.t!] : EN.get(el);
      if (words == null) continue;
      if (el.dataset.html !== undefined) el.innerHTML = words; else el.textContent = words;
    }
    const sw = document.querySelector<HTMLButtonElement>('[data-lang-switch]');
    if (sw) { sw.textContent = next === 'es' ? 'English' : 'Español'; sw.lang = next === 'es' ? 'en' : 'es'; }
    drawRequirements();
  }

  function drawRequirements() {
    const ul = document.getElementById('tp-reqs');
    if (!ul || !config?.minimums) return;
    ul.innerHTML = '';
    for (const line of requirementLines(config.minimums, 'Sunshine on a Ranney Day', lang)) {
      const li = document.createElement('li');
      li.textContent = line;
      ul.append(li);
    }
  }

  const post = (body: any) => fetch('/api/trade-partner', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...body, lang }) })
    .then(async (r) => ({ status: r.status, ...(await r.json().catch(() => ({}))) }));

  function setup() {
    EN.clear();
    paint(startLang());
    document.querySelector('[data-lang-switch]')?.addEventListener('click', () => { const n = lang === 'es' ? 'en' : 'es'; keepLang(n); paint(n); });
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-focus]')) {
      a.addEventListener('click', () => setTimeout(() => document.querySelector<HTMLInputElement>(a.dataset.focus!)?.focus({ preventScroll: true }), 450));
    }
    fetch('/api/trade-partner?config').then((r) => r.json()).then((c) => { config = c; drawRequirements(); loadTurnstile(); }).catch(() => null);

    // Getting started
    const form = document.getElementById('tp-start') as HTMLFormElement | null;
    const err = document.getElementById('tp-start-error')!;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body: any = Object.fromEntries(new FormData(form).entries());
      const missing = ['company', 'name', 'phone', 'email'].find((k) => !String(body[k] || '').trim());
      if (missing) { showError(SAY[lang].need[missing], missing); return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(body.email).trim())) { showError(SAY[lang].need.email, 'email'); return; }
      const w = (window as any).turnstile;
      if (turnstileWidget && w) body.turnstileToken = w.getResponse(turnstileWidget);
      const btn = form.querySelector<HTMLButtonElement>('.tp-send')!;
      btn.disabled = true;
      btn.textContent = SAY[lang].sending;
      err.hidden = true;
      try {
        const r = await post({ action: 'start', ...body });
        if (!r.ok) { showError(r.error || SAY[lang].failed, r.field); if (turnstileWidget && w) w.reset(turnstileWidget); return; }
        form.hidden = true;
        const done = document.getElementById('tp-start-sent')!;
        document.getElementById('tp-start-sent-body')!.textContent = SAY[lang].sent(String(body.email).trim(), String(body.company).trim());
        done.hidden = false;
        done.focus();
      } catch { showError(SAY[lang].failed); } finally {
        btn.disabled = false;
        btn.textContent = SAY[lang].send;
      }
    });
    function showError(words: string, field?: string | null) {
      err.textContent = words;
      err.hidden = false;
      for (const x of form!.querySelectorAll('[aria-invalid]')) x.removeAttribute('aria-invalid');
      const el = field && form!.querySelector<HTMLInputElement>(`[name=${field}]`);
      if (el) { el.setAttribute('aria-invalid', 'true'); el.focus(); }
    }

    // Signing in
    const signForm = document.getElementById('sign-in') as HTMLFormElement | null;
    const note = document.getElementById('tp-signin-note')!;
    signForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = signForm.querySelector<HTMLInputElement>('input[name=email]')!;
      const btn = signForm.querySelector<HTMLButtonElement>('button')!;
      const email = input.value.trim();
      note.hidden = false;
      note.dataset.tone = '';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { note.textContent = SAY[lang].emailBad; note.dataset.tone = 'fix'; input.setAttribute('aria-invalid', 'true'); input.focus(); return; }
      input.removeAttribute('aria-invalid');
      btn.disabled = true;
      btn.textContent = SAY[lang].sending;
      try {
        const r = await post({ action: 'signin', email });
        if (!r.ok) { note.textContent = r.error || SAY[lang].failed; note.dataset.tone = 'fix'; return; }
        note.textContent = SAY[lang].signSent(email);
        note.dataset.tone = 'good';
      } catch { note.textContent = SAY[lang].failed; note.dataset.tone = 'fix'; } finally {
        btn.disabled = false;
        btn.textContent = SAY[lang].signBtn;
      }
    });
  }

  function loadTurnstile() {
    const key = config?.turnstileSiteKey;
    const box = document.getElementById('tp-turnstile');
    if (!key || !box || turnstileWidget) return;
    const draw = () => { turnstileWidget = (window as any).turnstile.render(box, { sitekey: key, theme: 'light', language: lang }); };
    if ((window as any).turnstile) return draw();
    const s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    s.async = true;
    s.onload = draw;
    document.head.append(s);
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  /* ══════ Shared ══════ */
  /* The highlight under an italic word: a flat fill, drawn as an inset shadow */
  :is(h1, h2, h3) :global(em) { font-style: italic; box-shadow: inset 0 -0.42em 0 var(--c-yellow-soft); padding: 0 0.04em; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--font-body); font-weight: 600; font-size: 15px; padding: 14px 32px; border: none; border-radius: 100px; cursor: pointer; text-decoration: none; transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s cubic-bezier(0.16,1,0.3,1), background 0.25s ease, color 0.25s ease; min-height: 48px; }
  .btn:hover { transform: translateY(-3px); }
  .btn:active { transform: translateY(0); }
  .btn:disabled { opacity: 0.6; cursor: progress; transform: none; }
  .btn-lg { font-size: 17px; padding: 18px 44px; }
  .btn-primary { background: var(--c-yellow); color: var(--c-dark); }
  .btn-primary:hover { box-shadow: 0 8px 24px var(--c-yellow-glow); }
  .btn-dark { background: var(--c-dark); color: #fff; }
  .btn-dark:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
  .btn-outline-dark { background: transparent; color: var(--c-dark); border: 2px solid var(--c-dark); }
  .btn-outline-dark:hover { background: var(--c-dark); color: var(--c-yellow); }

  /* ══════ HERO — Editorial Split ══════ */
  .hero { position: relative; background: var(--c-cream); contain: layout style; padding: clamp(40px, 8vh, 100px) 0 56px; overflow: hidden; }
  .hero-inner { max-width: var(--max-width-wide, 1400px); margin: 0 auto; padding: 0 var(--page-padding); display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 5vw, 80px); align-items: center; min-height: clamp(440px, 62vh, 640px); }
  .hero-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  .hero-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-muted); margin: 0; opacity: 0; animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
  .tp-lang { font: 600 13px/1 var(--font-body); color: var(--c-dark); background: #fff; border: 1px solid var(--c-border); border-radius: 100px; padding: 10px 16px; min-height: 40px; cursor: pointer; }
  .tp-lang:hover { border-color: var(--c-dark); }
  .tp-lang:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; }
  .hero-headline { font-size: clamp(42px, 6.5vw, 88px); line-height: 1.04; letter-spacing: -0.035em; color: var(--c-dark); margin-bottom: 28px; animation: heroSlide 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-lead { font-size: clamp(16px, 1.3vw, 19px); line-height: 1.7; color: var(--c-text); max-width: 520px; margin-bottom: 36px; opacity: 0; animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; opacity: 0; animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both; }
  .hero-trust { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 24px; opacity: 0; animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both; }
  .hero-trust-item { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; color: var(--c-text-muted); letter-spacing: 0.01em; }
  .hero-trust-icon { width: 16px; height: 16px; flex-shrink: 0; color: var(--c-text-muted); }
  .hero-photo-wrap { position: relative; animation: heroPhotoIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-frame { display: block; position: relative; border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 5; box-shadow: 0 32px 80px rgba(0, 0, 0, 0.12), 0 8px 24px rgba(0, 0, 0, 0.06); background-size: cover; background-position: center; }
  .hero-frame img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .hero-frame:hover img { transform: scale(1.03); }
  .hero-accent { position: absolute; z-index: -1; bottom: -16px; right: -16px; width: 55%; height: 55%; border-radius: 20px; background: var(--c-yellow); opacity: 0.35; }
  .hero-stat { position: absolute; bottom: -24px; left: -24px; background: var(--c-dark); color: #fff; border-radius: 16px; padding: 20px 28px; text-align: center; box-shadow: 0 16px 48px rgba(0, 0, 0, 0.15); opacity: 0; animation: heroUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both; }
  .hero-stat-num { font-family: var(--font-display); font-size: 40px; font-weight: 700; color: var(--c-yellow); line-height: 1; display: block; }
  .hero-stat-label { display: block; font-size: 12px; font-weight: 500; color: rgba(255, 255, 255, 0.85); margin-top: 4px; line-height: 1.4; }
  @keyframes heroUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes heroSlide { from { transform: translateY(20px); } to { transform: translateY(0); } }
  @keyframes heroPhotoIn { from { opacity: 0; } to { opacity: 1; } }

  /* ══════ SET UP ══════ */
  .tp-start { background: var(--c-warm-gray); padding: 88px 0 56px; scroll-margin-top: calc(var(--header-height, 84px) + 16px); }
  .tp-start-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-xl); display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .tp-need h2 { font-size: clamp(26px, 3vw, 38px); line-height: 1.2; margin: 0 0 12px; }
  .tp-need-lead { font-size: 16px; line-height: 1.6; color: var(--c-text); margin: 0 0 24px; }
  .tp-need-list { margin: 0; padding: 0; list-style: none; counter-reset: need; display: grid; gap: 18px; }
