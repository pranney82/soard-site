---
/**
 * Event page templates for the admin Preview (behind Access with the rest of
 * /admin/, and kept out of the sitemap).
 *
 * The real event page rendered with the made-up events in
 * ../_preview-fixtures.js: upcoming (tickets, time, image, body, Stream video,
 * photos), past (the archive look, YouTube video) and pending (a past event
 * still waiting for photos). public/admin/event-preview.js clones their
 * sections to rebuild an event's page from unsaved edits.
 */
import EventPage from '../../events/[slug].astro';
import { FIXTURES } from '../_preview-fixtures.js';

export function getStaticPaths() {
  return Object.keys(FIXTURES.event).map((variant) => ({ params: { variant } }));
}

const { item } = FIXTURES.event[Astro.params.variant as keyof typeof FIXTURES.event];
---
<EventPage event={{ data: item }} />
