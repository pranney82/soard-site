---
/**
 * Partners page template for the admin Preview (behind Access with the rest
 * of /admin/, and kept out of the sitemap). The real partners page rendered
 * with the made-up partners in ../_preview-fixtures.js, which between them
 * use every card layout. public/admin/partner-preview.js clones its cards to
 * rebuild the page from unsaved edits.
 */
import PartnersPage from '../../partners/index.astro';
import { FIXTURES } from '../_preview-fixtures.js';

export function getStaticPaths() {
  return Object.keys(FIXTURES.partner).map((variant) => ({ params: { variant } }));
}

const { collection } = FIXTURES.partner[Astro.params.variant as keyof typeof FIXTURES.partner];
---
<PartnersPage partners={collection} />
