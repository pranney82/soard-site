---
/**
 * Advisory Board page template for the admin Preview (behind Access with the
 * rest of /admin/, and kept out of the sitemap). The real page rendered with
 * the made-up people in ../_preview-fixtures.js, which between them use every
 * member card. public/admin/advisory-preview.js clones its cards to rebuild
 * the members from unsaved edits.
 */
import AdvisoryBoardPage from '../../advisory-board.astro';
import { FIXTURES } from '../_preview-fixtures.js';

export function getStaticPaths() {
  return Object.keys(FIXTURES.advisory).map((variant) => ({ params: { variant } }));
}

const { collection } = FIXTURES.advisory[Astro.params.variant as keyof typeof FIXTURES.advisory];
---
<AdvisoryBoardPage team={collection} />
