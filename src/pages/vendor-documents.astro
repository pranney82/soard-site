---
/**
 * /vendor-documents/#t=<token> — where a company SOARD pays sends its W-9
 * and certificate of insurance. The link comes in SOARD's email (sent by
 * itself when a bill or a purchase order needs them, or a certificate is
 * about to end; see functions/api/_vendors.js). Each file is checked the
 * moment it's added, so the vendor knows straight away whether anything
 * else is needed; good files go onto the vendor's account in JobTread. The
 * token stays in the fragment so it never reaches a server log or a
 * referrer. No tax ID is ever typed here. Not indexed.
 * API: functions/api/vendor-docs.js.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { cfUrl } from '../utils/cf-image';
---

<BaseLayout title="Your W-9 and insurance for SOARD" description="Send Sunshine on a Ranney Day your W-9 and certificate of insurance." noindex>
  <section class="vd-hero">
    <div class="vd-hero__inner">
      <div class="vd-hero__text">
        <p class="vd-eyebrow">For our trade partners</p>
        <h1 id="vd-title">Your W-9 and <em>insurance</em></h1>
        <p class="vd-lead" id="vd-lead">We keep a W-9 and a current certificate of insurance on file for every company we pay. Add yours here: each file is checked as soon as you add it.</p>
      </div>
      <div class="vd-frame" aria-hidden="true">
        <div class="vd-accent"></div>
        <div class="vd-badge">
          <img src={cfUrl('brand-logo-circle-display', { w: 256 })} alt="" width="256" height="256" />
        </div>
      </div>
    </div>
  </section>

  <section class="vd-body">
    <div class="vd-card">
      <p class="vd-status" id="vd-status" role="status" aria-live="polite">Loading…</p>

      <div id="vd-main" hidden>
        <div class="vd-needs" id="vd-needs" hidden>
          <h2>What we need</h2>
          <ul id="vd-items"></ul>
        </div>

        <div class="vd-done" id="vd-done" hidden tabindex="-1">
          <h2>You’re all set. Thank you.</h2>
          <p id="vd-done-text">Everything we need is on file. If a policy renews, come back to this link (it works for a month) or wait for our email.</p>
        </div>

        <section class="vd-doc" id="vd-doc-coi" data-doc="coi" aria-labelledby="vd-coi-h">
          <div class="vd-doc__head">
            <h2 id="vd-coi-h">Certificate of insurance</h2>
            <span class="vd-tag" data-role="tag"></span>
          </div>
          <p class="vd-help" data-role="have"></p>
          <div data-role="ask">
            <p class="vd-help">From your insurance agent (an ACORD 25), as a PDF or a clear photo. If workers’ compensation is on its own certificate, add both.</p>
            <div class="vd-req">
              <p class="vd-req__title">It needs to show</p>
              <ul id="vd-reqs"></ul>
            </div>
            <label class="btn btn-primary vd-pick">
              <span data-role="pick-label">Add the certificate</span>
              <input type="file" accept="application/pdf,image/*" multiple data-role="file" />
            </label>
          </div>
          <button class="vd-again" type="button" data-role="again" hidden>Send a newer certificate</button>
          <div class="vd-result" data-role="result" role="status" aria-live="polite" hidden></div>
        </section>

        <section class="vd-doc" id="vd-doc-w9" data-doc="w9" aria-labelledby="vd-w9-h">
          <div class="vd-doc__head">
            <h2 id="vd-w9-h">W-9</h2>
            <span class="vd-tag" data-role="tag"></span>
          </div>
          <p class="vd-help" data-role="have"></p>
          <div data-role="ask">
            <p class="vd-help">IRS Form W-9, filled in and signed, as a PDF or a clear photo. We use it for your 1099 in January.</p>
            <label class="btn btn-primary vd-pick">
              <span data-role="pick-label">Add the W-9</span>
              <input type="file" accept="application/pdf,image/*" data-role="file" />
            </label>
          </div>
          <button class="vd-again" type="button" data-role="again" hidden>Send a new W-9</button>
          <div class="vd-result" data-role="result" role="status" aria-live="polite" hidden></div>
        </section>

        <!-- Left empty by people; bots fill it in -->
        <div class="vd-hp" aria-hidden="true">
          <label for="vd-website">Website</label>
          <input id="vd-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <p class="vd-help vd-small">Your files go straight to Sunshine on a Ranney Day and stay private. Up to 15 MB each.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .vd-hero { background: var(--c-cream); padding: clamp(56px, 8vw, 110px) 0 clamp(40px, 6vw, 72px); overflow: hidden; }
  .vd-hero__inner { max-width: 960px; margin: 0 auto; padding: 0 var(--space-xl); display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .vd-eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-muted); }
  .vd-eyebrow::before { content: ''; width: 28px; height: 2px; background: currentColor; }
  .vd-hero h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.08; letter-spacing: -0.03em; margin-bottom: 18px; }
  .vd-hero h1 em { font-style: italic; background-image: linear-gradient(transparent 52%, var(--c-yellow-soft) 52%); padding: 0 0.05em; }
  .vd-lead { font-size: clamp(16px, 1.6vw, 18px); line-height: 1.65; color: var(--c-text-muted); max-width: 460px; }
  .vd-frame { position: relative; max-width: 260px; margin-left: auto; width: 100%; }
  .vd-accent { position: absolute; right: -14px; bottom: -14px; width: 65%; height: 50%; background: var(--c-yellow); border-radius: 22px; opacity: 0.35; }
  .vd-badge { position: relative; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--c-warm-gray); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1); display: grid; place-items: center; }
  .vd-badge img { width: 60%; height: auto; opacity: 0.6; }

  .vd-body { padding: 0 var(--space-xl) clamp(56px, 8vw, 96px); background: var(--c-cream); }
  .vd-card { max-width: 720px; margin: 0 auto; background: #fff; border: 1px solid var(--c-border); border-radius: 20px; padding: clamp(24px, 4vw, 40px); box-shadow: 0 12px 40px rgba(0, 0, 0, 0.05); }
  .vd-status { color: var(--c-text-muted); }
  .vd-status:empty { display: none; }
  .vd-card h2 { font-family: var(--font-display); font-size: 1.35rem; margin: 0; }
  .vd-needs { margin-bottom: 28px; padding: 18px 20px; border-radius: 14px; background: var(--c-cream); }
  .vd-needs h2 { margin-bottom: 10px; }
  /* The list items and results are made by the script below, so their rules are :global (Astro's scoping misses them) */
  .vd-needs ul, .vd-req ul, .vd-result :global(ul) { margin: 0; padding-left: 20px; line-height: 1.6; list-style: disc; }
  .vd-needs :global(li + li), .vd-result :global(li + li) { margin-top: 6px; }
  .vd-done { margin-bottom: 28px; padding: 22px; border-radius: 14px; background: var(--c-yellow-soft); }
  .vd-done h2 { font-size: clamp(1.4rem, 3.5vw, 1.9rem); margin-bottom: 8px; }
  .vd-done p { color: var(--c-text); line-height: 1.6; margin: 0; }
  .vd-done:focus { outline: none; }

  .vd-doc { padding: 24px 0; border-top: 1px solid var(--c-border); }
  .vd-doc__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; }
  .vd-tag { font-size: 0.8rem; font-weight: 700; padding: 4px 10px; border-radius: 99px; background: var(--c-warm-gray); color: var(--c-text); white-space: nowrap; }
  .vd-tag[data-tone="need"] { background: var(--c-yellow); }
  .vd-tag:empty { display: none; }
  .vd-help { font-size: 0.95rem; color: var(--c-text-muted); margin: 0 0 12px; line-height: 1.55; }
  .vd-help:empty { display: none; }
  .vd-small { margin: 20px 0 0; text-align: center; font-size: 0.84rem; }
  .vd-req { margin: 0 0 16px; padding: 14px 16px; border-left: 3px solid var(--c-yellow); background: var(--c-cream); border-radius: 0 12px 12px 0; font-size: 0.95rem; }
  .vd-req__title { font-weight: 700; margin: 0 0 6px; }
  .vd-pick { position: relative; min-height: 48px; justify-content: center; cursor: pointer; }
  .vd-pick input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
  .vd-pick:focus-within { box-shadow: 0 0 0 3px var(--c-yellow-soft), 0 0 0 5px var(--c-text); }
  .vd-pick[aria-disabled="true"] { opacity: 0.6; pointer-events: none; }
  .vd-again { margin-top: 4px; background: none; border: 0; padding: 8px 0; font: inherit; font-weight: 700; color: var(--c-text); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 44px; }
  .vd-result { margin-top: 16px; padding: 14px 16px; border-radius: 12px; background: var(--c-cream); line-height: 1.55; }
  .vd-result[data-tone="good"] { background: #EEF6EE; color: #1F4D2E; }
  .vd-result[data-tone="fix"] { background: #FFF3BF; color: #5C4500; }
  .vd-result :global(p) { margin: 0 0 8px; font-weight: 700; }
  .vd-result :global(p:last-child) { margin-bottom: 0; }
  .vd-result :global(.vd-anyway) { display: inline-block; margin-top: 10px; background: none; border: 0; padding: 6px 0; font: inherit; color: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 44px; }
  .vd-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  @media (max-width: 760px) {
    .vd-hero__inner { grid-template-columns: 1fr; text-align: center; gap: 28px; }
    .vd-eyebrow { justify-content: center; }
    .vd-lead { margin-inline: auto; }
    .vd-frame { order: -1; max-width: 160px; margin: 0 auto; }
    .vd-body { padding-inline: 16px; }
    .vd-pick { width: 100%; }
  }
</style>

<script>
  type Vendor = {
    name: string; needs: string[]; items: { doc: string; text: string }[];
    have: { w9: boolean; glExpires: string | null; wcExpires: string | null };
    requirements: string[]; w9Only: boolean; notNeeded: boolean; preview?: boolean;
  };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const token = new URLSearchParams(location.hash.slice(1)).get('t') || '';
  const status = $('vd-status');
  const long = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const list = (rows: string[]) => `<ul>${rows.map((r) => `<li>${esc(r)}</li>`).join('')}</ul>`;
  let vendor: Vendor;

  function part(doc: string) {
    const box = $(`vd-doc-${doc}`);
    const q = <T extends HTMLElement>(role: string) => box.querySelector(`[data-role="${role}"]`) as T;
    return { box, tag: q('tag'), have: q('have'), ask: q('ask'), again: q<HTMLButtonElement>('again'), result: q('result'), file: q<HTMLInputElement>('file'), pickLabel: q('pick-label') };
  }

  function haveText(doc: string, v: Vendor) {
    if (doc === 'w9') return v.have.w9 ? 'We have your W-9 on file.' : '';
    const bits = [];
    if (v.have.glExpires) bits.push(`general liability through ${long(v.have.glExpires)}`);
    if (v.have.wcExpires) bits.push(`workers’ compensation through ${long(v.have.wcExpires)}`);
    return bits.length ? `On file: ${bits.join(' and ')}.` : '';
  }

  function render(v: Vendor) {
    vendor = v;
    document.title = `${v.name}: W-9 and insurance for SOARD`;
    $('vd-lead').textContent = v.preview
      ? 'A preview of the page a company gets. Files added here are checked the same way, and nothing is kept or sent anywhere.'
      : `For ${v.name}. We keep a W-9 and a current certificate of insurance on file for every company we pay. Add yours here: each file is checked as soon as you add it.`;
    const items = v.items.map((i) => i.text);
    $('vd-items').innerHTML = list(items).replace(/^<ul>|<\/ul>$/g, '');
    $('vd-needs').hidden = !items.length;
    $('vd-reqs').innerHTML = v.requirements.map((r) => `<li>${esc(r)}</li>`).join('');
    $('vd-done').hidden = !!v.needs.length;
    for (const doc of ['coi', 'w9']) {
      const p = part(doc);
      const needed = v.needs.includes(doc);
      const shown = doc === 'w9' ? !v.notNeeded : !v.notNeeded && !v.w9Only;
      p.box.hidden = !shown;
      p.tag.textContent = needed ? 'Needed' : 'On file';
      p.tag.dataset.tone = needed ? 'need' : '';
      p.have.textContent = haveText(doc, v);
      // What's on file stays tucked away behind "Send a newer one"
      p.ask.hidden = !needed;
      p.again.hidden = needed;
    }
  }

  async function load() {
    if (!token) { status.textContent = 'This link is missing its code. Open it again from the email Sunshine on a Ranney Day sent you.'; return; }
    try {
      const res = await fetch(`/api/vendor-docs?token=${encodeURIComponent(token)}`, { cache: 'no-store' });
      const d = await res.json().catch(() => ({}));
      if (!res.ok || !d.ok) { status.textContent = d.error || 'This link didn’t work. Reply to our email and we’ll send a new one.'; return; }
      status.textContent = '';
      $('vd-main').hidden = false;
      render(d.vendor);
      if (!d.vendor.needs.length) $('vd-done').focus();
    } catch {
      status.textContent = 'We couldn’t load this page. Check your connection and refresh.';
    }
  }

  // An iPhone photo (HEIC), by its first bytes as well as its name
  async function isHeic(f: File) {
    if (/^image\/hei[cf]/.test(f.type) || /\.hei[cf]$/i.test(f.name)) return true;
    const s = String.fromCharCode(...new Uint8Array(await f.slice(0, 12).arrayBuffer()));
    return s.slice(4, 8) === 'ftyp' && /^(heic|heix|hevc|mif1|msf1|heif)$/.test(s.slice(8, 12));
  }

  // A photo as a JPEG no bigger than the reader needs (an iPhone photo is 4032 px across).
  // One already small enough goes as it is unless `always`; null when this browser can't draw it.
  const MAX_SIDE = 2400;
  async function toJpeg(f: Blob, name: string, always = false): Promise<File | null> {
    const url = URL.createObjectURL(f);
    try {
      const img = new Image();
      img.src = url;
      await img.decode();
      if (!img.naturalWidth) return null;
      const scale = Math.min(1, MAX_SIDE / Math.max(img.naturalWidth, img.naturalHeight));
      if (scale === 1 && !always && f.size < 4 * 1024 * 1024 && f instanceof File) return f;
      const c = document.createElement('canvas');
      c.width = Math.round(img.naturalWidth * scale);
      c.height = Math.round(img.naturalHeight * scale);
      const ctx = c.getContext('2d');
      if (!ctx) return null;
      // White under it: a JPEG has no see-through, and a transparent PNG would come out black
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, c.width, c.height);
      ctx.drawImage(img, 0, 0, c.width, c.height);
      const blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/jpeg', 0.88));
      return blob ? new File([blob], `${name.replace(/\.[^.]+$/, '') || 'photo'}.jpg`, { type: 'image/jpeg' }) : null;
    } catch {
      return null;
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  // What goes up: a PDF as it is, a photo as a JPEG. The reader can't open HEIC: Safari draws
  // one itself, and any other browser fetches libheif (src/utils/heic-to.js, 3 MB) the first time it's needed.
  // Read into memory here, so a file that moves or changes after it's picked fails now, in words.
  async function prepare(f: File): Promise<File | null> {
    if (await isHeic(f)) {
      const own = await toJpeg(f, f.name, true);
      if (own) return own;
      try {
        const { heicTo } = await import('../utils/heic-to.js');
        return toJpeg(await heicTo({ blob: f, type: 'image/jpeg', quality: 0.92 }), f.name, true);
      } catch {
        return null;
      }
    }
    if (!f.type.startsWith('image/')) return new File([await f.arrayBuffer()], f.name, { type: f.type });
    return (await toJpeg(f, f.name)) || new File([await f.arrayBuffer()], f.name, { type: f.type });
  }

  // A PDF's first pages as pictures, drawn by pdf.js (public/vendor-documents/pdf/, fetched the first
  // time a PDF is added): a W-9's signature and what's typed into a form's boxes aren't in a PDF's text.
  // [] when this browser can't draw it, and the server reads the PDF's text instead.
  const PDF_BASE = '/vendor-documents/pdf/';
  const PAGE_SIDE = 2000;
  let pdfjs: Promise<any> | null = null;
  async function pagePictures(f: File, max: number): Promise<Blob[]> {
    try {
      pdfjs ||= import(/* @vite-ignore */ `${PDF_BASE}pdf.js`).then((m) => {
        m.GlobalWorkerOptions.workerSrc = `${PDF_BASE}pdf.worker.js`;
        return m;
      });
      const lib = await pdfjs;
      const task = lib.getDocument({ data: new Uint8Array(await f.arrayBuffer()), standardFontDataUrl: `${PDF_BASE}standard_fonts/`, wasmUrl: `${PDF_BASE}wasm/`, useWasm: false, enableXfa: false });
      const out: Blob[] = [];
      try {
        const doc = await task.promise;
        for (let n = 1; n <= Math.min(max, doc.numPages); n++) {
          const page = await doc.getPage(n);
          const one = page.getViewport({ scale: 1 });
          const viewport = page.getViewport({ scale: PAGE_SIDE / Math.max(one.width, one.height) });
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(viewport.width);
          canvas.height = Math.round(viewport.height);
          // Print mode: form boxes drawn with what was typed into them
          await page.render({ canvas, viewport, background: 'white', annotationMode: lib.AnnotationMode.ENABLE_STORAGE }).promise;
          const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, 'image/jpeg', 0.85));
          if (blob) out.push(blob);
        }
      } finally {
        task.destroy();
      }
      return out;
    } catch {
      pdfjs = null;
      return [];
    }
  }

  async function send(doc: string, files: File[], anyway = false) {
    const p = part(doc);
    const what = doc === 'w9' ? 'W-9' : files.length > 1 ? 'certificates' : 'certificate';
    p.ask.setAttribute('aria-busy', 'true');
    p.box.querySelector('.vd-pick')?.setAttribute('aria-disabled', 'true');
    show(p, '', `<p>${anyway ? 'Sending it to our team…' : `Checking your ${what}…`}</p>${anyway ? '' : '<span>This takes about half a minute.</span>'}`);
    try {
      const ready: { file: File; pages: Blob[] }[] = [];
      for (const f of files) {
        // Too big before it's read into memory (a photo is shrunk first, so only a PDF or anything else stops here)
        const shrinks = f.type.startsWith('image/') || /\.(hei[cf]|jpe?g|png|webp)$/i.test(f.name);
        if (!shrinks && f.size > 15 * 1024 * 1024) throw new Error(`${f.name} is over 15 MB. Try a smaller copy or a PDF.`);
        const file = await prepare(f).catch(() => { throw new Error(`${f.name} wouldn’t open. Save it again, then add it here.`); });
        if (!file) throw new Error(`${f.name} is an iPhone photo (HEIC) that wouldn’t open. Send a PDF or a JPG instead. A screenshot of the photo works too.`);
        if (file.size > 15 * 1024 * 1024) throw new Error(`${f.name} is over 15 MB. Try a smaller copy or a PDF.`);
        const pdf = !anyway && (file.type === 'application/pdf' || /\.pdf$/i.test(file.name));
        ready.push({ file, pages: pdf ? await pagePictures(file, doc === 'w9' ? 2 : 3) : [] });
      }
      files = ready.map((r) => r.file);
      const body = new FormData();
      body.set('token', token);
      body.set('doc', doc);
      body.set('website', ($('vd-website') as HTMLInputElement).value);
      ready.forEach(({ file, pages }, i) => {
        body.append('file', file);
        pages.forEach((b, n) => body.append(`pages${i}`, b, `page-${n + 1}.jpg`));
      });
      if (anyway) body.set('anyway', '1');
      const res = await fetch('/api/vendor-docs', { method: 'POST', body }).catch(() => {
        throw new Error('That didn’t go through. Check your connection and try again.');
      });
      const d = await res.json().catch(() => ({}));
      if (!res.ok || !d.ok) throw new Error(d.error || 'That didn’t go through. Please try again.');
      if (d.accepted) {
        show(p, 'good', `<p>Got it, and it checks out.</p>${list(d.lines || [])}`);
      } else if (d.look) {
        show(p, 'good', `<p>Thank you. ${anyway ? 'Our team will look at it' : 'Our team will check this one by hand'} and be in touch if anything else is needed.</p>`);
      } else {
        show(p, 'fix', `<p>This one won’t work yet:</p>${list(d.problems || [])}<p>Add a different file above, or ask your insurance agent for an updated one.</p>`
          + `<button type="button" class="vd-anyway">Think it’s right? Send it to our team to check</button>`);
        p.result.querySelector('.vd-anyway')?.addEventListener('click', () => send(doc, files, true));
      }
      if (d.accepted || d.look) {
        // Fresh state from JobTread: what's still needed (a preview keeps nothing, so it's worked out here)
        const r = d.preview
          ? { ok: true, vendor: { ...vendor, needs: vendor.needs.filter((n) => n !== doc), items: vendor.items.filter((i) => i.doc !== doc) } }
          : await fetch(`/api/vendor-docs?token=${encodeURIComponent(token)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null);
        const keep = p.result.innerHTML;
        const tone = p.result.dataset.tone || '';
        if (r?.ok) render(r.vendor);
        show(p, tone, keep);
        p.ask.hidden = true;
        p.again.hidden = false;
        if (r?.ok && !r.vendor.needs.length) $('vd-done').focus();
      }
    } catch (err) {
      show(p, 'fix', `<p>${esc((err as Error).message)}</p>`);
    } finally {
      p.ask.removeAttribute('aria-busy');
      p.box.querySelector('.vd-pick')?.removeAttribute('aria-disabled');
      p.file.value = '';
    }
  }

  function show(p: ReturnType<typeof part>, tone: string, html: string) {
    p.result.dataset.tone = tone;
    p.result.innerHTML = html;
    p.result.hidden = false;
  }

  for (const doc of ['coi', 'w9']) {
    const p = part(doc);
    p.file.addEventListener('change', () => {
      const files = [...(p.file.files || [])].slice(0, doc === 'w9' ? 1 : 3);
      if (files.length) send(doc, files);
    });
    p.again.addEventListener('click', () => {
      p.ask.hidden = false;
      p.again.hidden = true;
      p.result.hidden = true;
      p.file.focus();
    });
  }

  load();
</script>
