---
/**
 * The makeover application — /apply/form/
 *
 * Replaces the Jotform "SOARD Application". Every question comes from
 * functions/api/_application-form.js (the same file the server validates
 * against and the JobTread load reads), rendered here one page at a time by
 * src/components/apply/application-form.client.js. Answers save to
 * /api/apply as the family goes; photos and the video upload in place; a
 * review page comes before Submit. English or Spanish: the switch above the
 * form redraws everything (the hero too) without losing an answer.
 *
 * Open/closed and the season year come from Admin → Applications → Settings
 * (siteSettings.application). While closed, the page says so and
 * points to the Apply page's "notify me" form.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteSettings from '../../content/site/settings.json';
import { getSiteStats } from '../../utils/stats';
import { cfRaw, cfSrcset, cfLqip } from '../../utils/cf-image';
import { applicationForm } from '../../../functions/api/_application-form.js';
import { t } from '../../components/apply/application-render.js';
// The questions are drawn in the browser from the live form (Admin → Applications → Form),
// which functions/apply/form/[[path]].js embeds in this page; the built-in form only sizes the first paint.

const stats = await getSiteStats();
const app = (siteSettings as any).application || {};
const isOpen = app.open === true;
const year = String(app.year || new Date().getFullYear() + 1);
const closedMessage = app.closedMessage || `The ${year} application period is currently closed.`;
const form = applicationForm({ year });
const steps = form.pages.length + 1;
const w = (key: string, vars = {}) => t('en', key, { year, ...vars });

// The Apply page only has a FAQ section when FAQs were written for it; else the site's FAQ page
const faqHref = ((siteSettings as any).applyFaqs || []).length ? '/apply/#faq' : '/faq/';

const ap = (siteSettings as any).applyPhotos || {};
const heroPhotoId = ap.story || 'kids/eli/photo-01';

const site = Astro.site?.origin || 'https://sunshineonaranneyday.com';
const breadcrumbs = [
  { name: 'Home', url: `${site}/` },
  { name: 'Apply', url: `${site}/apply/` },
  { name: 'Application', url: `${site}/apply/form/` },
];
---

<BaseLayout
  title={`${year} Makeover Application`}
  description="Apply for a free dream bedroom, accessible bathroom, therapy room or ramp for a child with special needs in the greater Atlanta area. Saves as you go."
  breadcrumbs={breadcrumbs}
>
  <link slot="head" rel="preload" as="image" imagesrcset={cfSrcset(heroPhotoId, [400, 560, 800], { fit: 'cover', gravity: 'face', aspectRatio: 1.25 })} imagesizes="(max-width:768px) 85vw, 420px" fetchpriority="high" />

  <!-- ══════ HERO — Editorial Split ══════ -->
  <section class="hero" data-af-lang-scope>
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-eyebrow" data-af-t="heroEyebrow">{w('heroEyebrow')}</p>
        <h1 class="hero-headline" data-af-t-html="heroTitleHtml" set:html={w('heroTitleHtml')} />
        <p class="hero-lead" data-af-t-html="heroLeadHtml" set:html={w('heroLeadHtml')} />
        <div class="hero-ctas">
          <!-- Built from the content settings; the script corrects it from the live open/closed switch -->
          {isOpen
            ? <a href="#application" class="btn btn-primary btn-lg btn-glow" data-hero-cta data-af-t="heroStart">{w('heroStart')}</a>
            : <a href="#application" class="btn btn-primary btn-lg" data-hero-cta data-af-t="heroNotify">{w('heroNotify')}</a>}
          <a href={faqHref} class="btn btn-outline-dark btn-lg" data-af-t="heroFaq">{w('heroFaq')}</a>
        </div>
      </div>
      <div class="hero-photo-wrap">
        <div class="hero-frame" style={`background-image:url('${cfLqip(heroPhotoId)}')`}>
          <img
            src={cfRaw(heroPhotoId, 'w=800,h=1000,fit=cover,gravity=face,q=65')}
            srcset={cfSrcset(heroPhotoId, [400, 560, 800], { fit: 'cover', gravity: 'face', aspectRatio: 1.25 })}
            sizes="(max-width:768px) 85vw, 420px"
            alt={w('heroPhotoAlt')}
            data-af-t-alt="heroPhotoAlt"
            width="800" height="1000"
            fetchpriority="high" loading="eager" decoding="async"
            class="hero-img lqip-img"
          />
        </div>
        <div class="hero-accent" aria-hidden="true"></div>
        <div class="hero-stat">
          <span class="hero-stat-num">{stats.totalKids}+</span>
          <span class="hero-stat-label" data-af-t-html="heroStatHtml" set:html={w('heroStatHtml')} />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════ THE APPLICATION ══════ -->
  <section class="af-section" id="application" data-af-lang-scope>
    <div class="af-wrap">
      <!-- Open/closed is decided again in the browser from the live setting (a resume
           link always opens), so a family mid-application can finish after we close
           and an admin toggle takes effect without a Publish. -->
      <div class="af-card af-closed" data-closed hidden={isOpen}>
        <!-- A message staff wrote stays as written; the built-in one follows the language -->
        <h2 data-af-t={app.closedMessage ? undefined : 'closedTitle'}>{closedMessage}</h2>
        <p data-af-t="closedLead">{w('closedLead')}</p>
        <!-- "Tell me when applications open": the same waitlist as the Apply page
             (functions/api/_application-waitlist.js), in the language chosen here -->
        <form class="af-notify" data-notify action="/api/newsletter" method="POST" novalidate>
          <input type="hidden" name="source" value="application-waitlist" />
          <input type="hidden" name="page" value="apply-form" />
          <input type="hidden" name="lang" value="en" data-notify-lang />
          <label class="af-sr" for="af-notify-email" data-af-t="notifyLabel">{w('notifyLabel')}</label>
          <div class="af-notify-row af-field">
            <input id="af-notify-email" type="email" name="email" autocomplete="email" inputmode="email" required placeholder={w('notifyPlaceholder')} data-af-t-placeholder="notifyPlaceholder" />
            <button type="submit" class="btn btn-primary" data-notify-btn>{w('notifyButton')}</button>
          </div>
          <div class="af-sr" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
          <!-- The quick check (src/utils/signup-check.ts): out of sight unless Cloudflare wants a click -->
          <div class="af-notify-check" data-signup-check></div>
          <p class="af-notify-note" data-notify-note role="status" aria-live="polite">{w('notifyNote')}</p>
          <div class="af-lang af-notify-lang" data-closed-lang role="group" aria-label="Language" data-af-t-aria="language">
            <svg class="af-lang-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            <button type="button" class="af-lang-btn" data-lang="en" lang="en" aria-pressed="true">English</button>
            <button type="button" class="af-lang-btn" data-lang="es" lang="es" aria-pressed="false">Español</button>
          </div>
        </form>
      </div>
      <div class="af-app" data-application data-year={year} data-open={isOpen ? '1' : undefined} hidden={!isOpen}>
        <noscript><p class="af-card af-closed">This application needs JavaScript to upload your photos and video. Please turn it on, or email <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a> and we'll help.</p></noscript>

        <div class="af-main">
        <!-- A staff test run (?test=1, Admin → Applications → Form): whose inbox the emails go to,
             sample answers a page at a time, and the way back. Staff words, so English. -->
        <section class="af-testbar" data-testbar aria-label="Test run" lang="en" hidden>
          <div class="af-testbar-top">
            <span class="af-test-badge"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 1.8h4M6.8 1.8v4.1L2.9 12.4A1.2 1.2 0 0 0 4 14.2h8a1.2 1.2 0 0 0 1.1-1.8L9.2 5.9V1.8" /><path d="M4.6 10h6.8" /></svg>Test run</span>
            <a class="af-testbar-end" href="/admin/#applications/form" data-test-end>End test run</a>
          </div>
          <p class="af-testbar-text" data-testbar-text></p>
          <div class="af-testbar-actions">
            <button type="button" class="af-btn af-btn--sm af-testbar-fill" data-test-fill hidden>
              <svg class="af-btn-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 13.5l7-7M9 3.2l.6-1.7.6 1.7 1.7.6-1.7.6-.6 1.7-.6-1.7-1.7-.6zM12.6 7.4l.4-1 .4 1 1 .4-1 .4-.4 1-.4-1-1-.4z" /></svg>
              <span>Fill this page with sample answers</span>
            </button>
            <a class="af-btn af-btn--sm af-testbar-fill" href="/admin/#applications/form" data-test-signin hidden><span>Sign in to the admin</span></a>
            <span class="af-testbar-note" data-test-note role="status"></span>
          </div>
        </section>
        <p class="af-notice" data-notice role="status" hidden></p>

        <form class="af-card af-form" data-form novalidate>
          <header class="af-head">
            <div class="af-head-top">
              <p class="af-step-text" data-step-text>Step 1 of {steps}</p>
              <div class="af-lang" data-lang-switch role="group" aria-label="Language" data-af-t-aria="language" hidden>
                <svg class="af-lang-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                <button type="button" class="af-lang-btn" data-lang="en" lang="en" aria-pressed="true">English</button>
                <button type="button" class="af-lang-btn" data-lang="es" lang="es" aria-pressed="false">Español</button>
              </div>
            </div>
            <h2 class="af-step-title" data-step-title tabindex="-1">{form.pages[0].title}</h2>
            <div class="af-progress" aria-hidden="true"><div class="af-progress-bar" data-progress-bar style={`transform:translateX(${Math.round(100 / steps) - 100}%)`}></div></div>
            <details class="af-steps" data-steps>
              <summary class="af-steps-toggle">
                <span data-af-t="steps">{w('steps')}</span>
                <svg class="af-steps-chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
              </summary>
              <ol class="af-steps-list" data-steps-list></ol>
            </details>
          </header>

          <div class="af-pages" data-pages aria-busy="true">
            <p class="af-loading" data-af-t="loading">{w('loading')}</p>
          </div>

          <div class="af-page af-page--review" data-page="review" hidden>
            <p class="af-review-intro" data-af-t="reviewIntro">{w('reviewIntro')}</p>
            <div class="af-review-summary" data-review-summary></div>
            <div class="af-review" data-review></div>
          </div>

          <!-- People never see this; bots fill it in -->
          <div class="af-hp" aria-hidden="true">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" data-honeypot /></label>
          </div>

          <div class="af-turnstile" data-turnstile hidden><div class="cf-turnstile"></div></div>

          <p class="af-nav-note" data-nav-note hidden></p>
          <footer class="af-nav">
            <button type="button" class="af-btn af-btn--ghost af-btn--back" data-back hidden>
              <svg class="af-btn-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8l4.5 4.5" /></svg>
              <span data-af-t="back">{w('back')}</span>
            </button>
            <button type="submit" class="af-btn af-btn--primary af-btn--next" data-next>
              <span data-next-label>{w('next')}</span>
              <svg class="af-btn-icon af-btn-icon--next" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5L10.5 8 6 12.5" /></svg>
            </button>
          </footer>
          <div class="af-save-row">
            <button type="button" class="af-btn af-btn--link" data-save-later data-af-t="saveLater">{w('saveLater')}</button>
            <span class="af-save-state" data-save-state></span>
          </div>
          <p class="af-sr" data-live aria-live="polite"></p>
        </form>

        <div class="af-card af-stop" data-stop hidden>
          <h2 data-stop-title tabindex="-1"></h2>
          <div class="af-stop-body" data-stop-body></div>
          <!-- The service-area map with the family's home (or an older stop screen's picture), drawn by the script -->
          <div class="af-stop-map" data-stop-map hidden></div>
          <div class="af-stop-actions">
            <button type="button" class="af-btn af-btn--ghost af-btn--back" data-stop-back>
              <svg class="af-btn-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8l4.5 4.5" /></svg>
              <span data-af-t="stopBack">{w('stopBack')}</span>
            </button>
            <a href="/apply/" class="af-btn af-btn--primary" data-af-t="stopApply">{w('stopApply')}</a>
          </div>
        </div>

        <div class="af-card af-done" data-done hidden>
          <div class="af-sun" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <circle class="af-sun-halo" cx="60" cy="60" r="56" />
              <g class="af-sun-rays">
                <path d="M60 10v12M60 98v12M10 60h12M98 60h12M24.6 24.6l8.5 8.5M86.9 86.9l8.5 8.5M24.6 95.4l8.5-8.5M86.9 33.1l8.5-8.5" />
              </g>
              <circle class="af-sun-core" cx="60" cy="60" r="24" />
            </svg>
          </div>
          <h2 data-done-title tabindex="-1" data-af-t="doneTitle">{w('doneTitle')}</h2>
          <p class="af-done-email" data-done-email></p>
          <div class="af-next-up">
            <h3 class="af-next-title" data-af-t="doneNext">{w('doneNext')}</h3>
            <ol class="af-next-list">
              {[1, 2, 3].map((i) => (
                <li class="af-next-step" style={`--i:${i}`}>
                  <span class="af-next-num" aria-hidden="true">{i}</span>
                  <span class="af-next-text"><strong data-af-t={`doneStep${i}`}>{w(`doneStep${i}`)}</strong><span data-af-t={`doneStep${i}Text`}>{w(`doneStep${i}Text`)}</span></span>
                </li>
              ))}
            </ol>
            <p class="af-next-note" data-af-t="doneNote">{w('doneNote')}</p>
          </div>
          <a href="/kids/" class="af-btn af-btn--primary" data-af-t="doneLink">{w('doneLink')}</a>

          <!-- A staff test run: what the real intake does with it, step by step as it happens -->
          <section class="af-trace" data-trace aria-labelledby="af-trace-title" lang="en" hidden>
            <div class="af-trace-head">
              <span class="af-test-badge">Test run</span>
              <h3 id="af-trace-title">Behind the scenes</h3>
              <span class="af-trace-sum" data-trace-sum role="status"></span>
            </div>
            <p class="af-trace-lead" data-trace-lead></p>
            <ol class="af-trace-list" data-trace-list></ol>
            <p class="af-trace-error" data-trace-error hidden></p>
            <div class="af-trace-actions">
              <a class="af-btn af-btn--ghost af-btn--sm" data-trace-admin href="/admin/#applications" target="_blank" rel="noopener">Open it in Applications</a>
              <a class="af-btn af-btn--ghost af-btn--sm" data-trace-jt href="https://app.jobtread.com/" target="_blank" rel="noopener" hidden>Open it in JobTread</a>
              <a class="af-btn af-btn--primary af-btn--sm" href="/apply/form/?test=1" data-trace-again>Start another test run</a>
            </div>
          </section>
        </div>
        </div>

        <!-- On a computer: every step beside the form, how long is left, saving, and who to ask.
             (A phone has "All steps" in the card and the bar that follows it down the page.)
             After the form in the page, so the form comes first for a screen reader; the grid puts it on the left. -->
        <aside class="af-rail" data-rail aria-labelledby="af-rail-title">
          <p class="af-rail-head"><span class="af-rail-title" id="af-rail-title" data-af-t="railTitle">{w('railTitle')}</span><span class="af-test-badge af-test-chip" lang="en">Test run</span></p>
          <nav aria-label={w('railLabel')} data-af-t-aria="railLabel"><ol class="af-rail-list" data-rail-list></ol></nav>
          <div class="af-rail-foot">
            <p class="af-rail-left" data-time-left></p>
            <p class="af-save-state" data-save-state></p>
            <button type="button" class="af-btn af-btn--ghost af-btn--sm af-rail-later" data-save-later data-af-t="saveLater">{w('saveLater')}</button>
            <p class="af-rail-help"><span data-af-t="railHelp">{w('railHelp')}</span>
              <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
              <a href={`tel:${String(siteSettings.phone || '').replace(/[^\d+]/g, '')}`}>{siteSettings.phone}</a></p>
          </div>
        </aside>

        <!-- A phone (or a narrow window): where they are, once the step's heading has scrolled away. A tap goes back up to it. -->
        <button type="button" class="af-mini" data-mini tabindex="-1" aria-hidden="true">
          <span class="af-mini-row"><span class="af-test-badge af-test-chip" lang="en">Test</span><span class="af-mini-step" data-mini-step></span><span class="af-mini-title" data-mini-title></span>
            <svg class="af-mini-up" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4" /></svg></span>
          <span class="af-mini-track"><span class="af-mini-bar" data-mini-bar></span></span>
        </button>

        <dialog class="af-dialog" data-later-dialog aria-labelledby="af-later-title">
          <button type="button" class="af-dialog-close" data-later-close aria-label="Close" data-af-t-aria="close">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
          </button>
          <form data-later-form>
            <h2 id="af-later-title" data-af-t="laterTitle">{w('laterTitle')}</h2>
            <p data-af-t="laterIntro">{w('laterIntro')}</p>
            <label class="af-label" for="af-later-email" data-af-t="email">{w('email')}</label>
            <input type="email" id="af-later-email" required autocomplete="email" inputmode="email" spellcheck="false" />
            <p class="af-dialog-status" data-later-status aria-live="polite"></p>
            <button type="submit" class="af-btn af-btn--primary" data-af-t="laterSend">{w('laterSend')}</button>
          </form>
          <div data-later-sent hidden>
            <h2 data-af-t="sentTitle">{w('sentTitle')}</h2>
            <p data-af-t-html="sentBodyHtml" set:html={w('sentBodyHtml')} />
            <button type="button" class="af-btn af-btn--primary" data-later-done data-af-t="keepGoing">{w('keepGoing')}</button>
          </div>
        </dialog>
      </div>
    </div>
  </section>
</BaseLayout>

<script>import '../../components/apply/application-form.client.js';</script>

<style>
  /* ══════════ Buttons (hero) ══════════ */
  :is(h1, h2, h3) :global(em) {
    font-style: italic;
    background-image: linear-gradient(transparent 52%, var(--c-yellow-soft) 52%);
  }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    font-family: var(--font-body); font-weight: 600; font-size: 15px;
    padding: 14px 32px; border: none; border-radius: 100px; cursor: pointer; text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s cubic-bezier(0.16,1,0.3,1), background 0.25s ease, color 0.25s ease;
    min-height: 48px;
  }
  .btn:hover { transform: translateY(-3px); }
  .btn-lg { font-size: 17px; padding: 18px 40px; }
  .btn-primary { background: var(--c-yellow); color: var(--c-dark); }
  .btn-primary:hover { box-shadow: 0 8px 24px var(--c-yellow-glow); }
  .btn-outline-dark { background: transparent; color: var(--c-dark); border: 2px solid var(--c-dark); }
  .btn-outline-dark:hover { background: var(--c-dark); color: var(--c-yellow); }
  @keyframes pulseGlow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255,218,36,0.3); }
    50% { box-shadow: 0 0 0 10px rgba(255,218,36,0); }
  }
  .btn-glow { animation: pulseGlow 3s ease-in-out infinite; }

  /* ══════════ HERO — Editorial Split (matches apply/donate/advisory-board) ══════════ */
  .hero { position: relative; background: var(--c-cream); padding: clamp(40px, 7vh, 88px) 0 56px; overflow: hidden; }
  .hero-inner {
    max-width: var(--max-width-wide, 1400px); margin: 0 auto; padding: 0 var(--page-padding);
    display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 5vw, 80px); align-items: center;
    min-height: clamp(440px, 62vh, 640px);
  }
  .hero-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-text-muted); margin-bottom: 24px; animation: heroUp 0.8s cubic-bezier(0.16,1,0.3,1) 0.05s both; }
  .hero-headline { font-size: clamp(42px, 6.2vw, 84px); line-height: 1.04; letter-spacing: -0.035em; color: var(--c-dark); margin-bottom: 24px; animation: heroSlide 0.8s cubic-bezier(0.16,1,0.3,1) both; }
  .hero-headline :global(em) { font-style: italic; background-image: linear-gradient(transparent 52%, var(--c-yellow-soft) 52%); padding: 0 0.05em; }
  .hero-lead { font-size: clamp(16px, 1.3vw, 19px); line-height: 1.7; color: var(--c-text); max-width: 500px; margin-bottom: 32px; animation: heroUp 0.8s cubic-bezier(0.16,1,0.3,1) 0.15s both; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; animation: heroUp 0.8s cubic-bezier(0.16,1,0.3,1) 0.25s both; }
  .hero-photo-wrap { position: relative; max-width: 440px; justify-self: end; width: 100%; animation: heroPhotoIn 0.4s cubic-bezier(0.16,1,0.3,1) both; }
  .hero-frame { position: relative; border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 5; box-shadow: 0 32px 80px rgba(0,0,0,0.12), 0 8px 24px rgba(0,0,0,0.06); background-size: cover; background-position: center; }
  .hero-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-accent { position: absolute; z-index: -1; bottom: -16px; right: -16px; width: 55%; height: 55%; border-radius: 20px; background: var(--c-yellow); opacity: 0.35; }
