---
/**
 * BaseLayout.astro
 * Root layout wrapping every page. Handles <html>, <head>, fonts,
 * meta tags, JSON-LD slot, and the global Header/Footer.
 * 
 * SEO FEATURES (top 1%):
 * - Global NonprofitOrganization schema on every page (@graph)
 * - WebPage schema with breadcrumbs on every page
 * - Per-page JSON-LD merged into unified @graph
 * - Open Graph with og:locale, og:type override, image dimensions
 * - Twitter Card with image alt
 * - GeoRegion + ICBM meta for local SEO
 * - theme-color for mobile browsers
 * - Absolute OG image URLs
 */
import { ClientRouter } from 'astro:transitions';
import Header from '../components/global/Header.astro';
import ApplicationBar from '../components/global/ApplicationBar.astro';
import { auctionIsOpen } from '../utils/auction';
import Footer from '../components/global/Footer.astro';
import LiveIndicator from '../components/global/LiveIndicator.astro';
import AuctionBar from '../components/global/AuctionBar.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';
import LqipReveal from '../components/ui/LqipReveal.astro';
import { getOrgSchema, getWebPageSchema, getBreadcrumbSchema, buildSchemaGraph } from '../utils/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object | object[];
  bodyClass?: string;
  breadcrumbs?: { name: string; url: string }[];
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'We build free dream bedrooms, accessible bathrooms, and therapy rooms for children with special needs in Atlanta. 501(c)(3) nonprofit.',
  ogImage,
  ogType = 'website',
  jsonLd,
  bodyClass = '',
  breadcrumbs,
  datePublished,
  dateModified,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, Astro.site);
const fullTitle = title === 'Home'
  ? 'Sunshine on a Ranney Day — Dreams Built Here'
  : `${title} | Sunshine on a Ranney Day`;

// ── Auto-compute OG image from page path ──────────
function computeOgImage(pathname: string): string {
  const clean = pathname.replace(/\/+$/, '') || '/';
  
  // Homepage
  if (clean === '/') return '/og/home.png';
  
  // Kid profiles: /kids/amari/ → /og/kids/amari.png
  const kidMatch = clean.match(/^\/kids\/([^/]+)$/);
  if (kidMatch) return `/og/kids/${kidMatch[1]}.png`;
  
  // Articles: /resources/accessible-home-design/ → /og/resources/accessible-home-design.png
  const artMatch = clean.match(/^\/resources\/([^/]+)$/);
  if (artMatch) return `/og/resources/${artMatch[1]}.png`;

  // Community projects: /community/murphy-harpst/ → /og/community/murphy-harpst.png
  const communityMatch = clean.match(/^\/community\/([^/]+)$/);
  if (communityMatch) return `/og/community/${communityMatch[1]}.png`;

  // Events: /events/some-event/ → /og/events/some-event.png
  const eventMatch = clean.match(/^\/events\/([^/]+)$/);
  if (eventMatch) return `/og/events/${eventMatch[1]}.png`;

  // Static pages: /donate/ → /og/donate.png, /about/leadership/ → /og/leadership.png
  const segments = clean.split('/').filter(Boolean);
  const lastSegment = segments[segments.length - 1];
  return `/og/${lastSegment}.png`;
}

const resolvedOgImage = ogImage || computeOgImage(Astro.url.pathname);

// Resolve OG image to absolute URL
const ogImageAbsolute = resolvedOgImage.startsWith('http')
  ? resolvedOgImage
  : new URL(resolvedOgImage, Astro.site).toString();

// ── Build the JSON-LD @graph for this page ──────────────
const graphSchemas: (Record<string, any> | Record<string, any>[])[] = [
  getOrgSchema(),
  getWebPageSchema({
    url: canonicalURL.toString(),
    title: fullTitle,
    description,
    datePublished,
    dateModified,
    breadcrumbs,
  }),
];

if (breadcrumbs && breadcrumbs.length > 0) {
  graphSchemas.push(getBreadcrumbSchema(breadcrumbs, canonicalURL.toString()));
}

// Merge page-specific JSON-LD into the graph
if (jsonLd) {
  if (Array.isArray(jsonLd)) {
    graphSchemas.push(...jsonLd);
  } else if ((jsonLd as any)['@graph']) {
    graphSchemas.push(...(jsonLd as any)['@graph']);
  } else if ((jsonLd as any)['@context']) {
    // Strip @context from standalone schemas before merging
    const { '@context': _, ...rest } = jsonLd as any;
    graphSchemas.push(rest);
  } else {
    graphSchemas.push(jsonLd as Record<string, any>);
  }
}

const structuredData = buildSchemaGraph(...graphSchemas);

// ── Page content transition animation ─────────────
// Uses transition:animate directive (Astro's intended API) so it:
//   - generates fallback CSS for non-native browsers
//   - differentiates forward vs. backward navigation
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="format-detection" content="telephone=no" />

  {/* SEO */}
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  }

  {/* Local SEO geo signals */}
  <meta name="geo.region" content="US-GA" />
  <meta name="geo.placename" content="Roswell, Georgia" />
  <meta name="geo.position" content="34.0232;-84.3616" />
  <meta name="ICBM" content="34.0232, -84.3616" />

  {/* Open Graph */}
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${title} — Sunshine on a Ranney Day`} />
  <meta property="og:site_name" content="Sunshine on a Ranney Day" />
  {datePublished && <meta property="article:published_time" content={datePublished} />}
  {dateModified && <meta property="article:modified_time" content={dateModified} />}

  {/* Twitter */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbsolute} />
  <meta name="twitter:image:alt" content={`${title} — Sunshine on a Ranney Day`} />

  {/* Theme color — light/dark support for iOS Safari & Android Chrome */}
  <meta name="theme-color" content="#1E1F25" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#FEFCF5" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1E1F25" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  {/* Favicon */}
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  {/* Images route through same origin via /cdn-cgi/imagedelivery/ — no preconnect needed */}
  {/* videodelivery.net preconnect added per-page where needed via <slot name="head" /> */}
  <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
  {/* Cloudflare Web Analytics (real-visitor speed and visits), started once the
       page has finished loading: the beacon Pages injects is a script on a
       second connection that loads beside the page's own photo and fonts. Same
       site token, same data (it reads the page's timings when it starts). Skipped
       if a beacon is already on the page, so a visit is never counted twice.
       Nothing is set on window: the beacon keeps its own settings in
       window.__cfBeacon. Cloudflare's automatic copies are off (the Pages
       project's Web Analytics and the zone's automatic setup, Nov 10 2026). */}
  <script is:inline>addEventListener('load',function(){setTimeout(function(){if(document.querySelector('script[src*="cloudflareinsights.com/beacon"]'))return;var s=document.createElement('script');s.defer=true;s.src='https://static.cloudflareinsights.com/beacon.min.js';s.setAttribute('data-cf-beacon','{"token": "43b83df2d48941e496276682ee4bf0a4"}');document.head.appendChild(s)},0)},{once:true})</script>

  {/* Preload critical fonts: the body's, the headlines', and the italic word nearly every hero headline has ("the first
      time", "room reveal"). Not preloaded, the italic arrived after the hero was drawn and nudged what follows it */}
  <link rel="preload" href="/fonts/outfit-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/libre-baskerville-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/libre-baskerville-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />

  {/* Self-hosted fonts, and their stand-ins until they arrive.
    Metric-matched fallback faces: Georgia and Arial resized to the webfonts'
       advance widths and vertical metrics, one face per style and weight the
       site uses (bold and italic too: a browser faking bold from the regular
       face comes out wider, which wrapped the home headline onto an extra
       line until the real font arrived). Each size-adjust is the middle of
       the range where the fewest blocks of the site's own text change their
       number of lines when the real font replaces the stand-in (25 pages at
       12 widths, 360 to 1920 px, Nov 2026). Matching widths on a sample
       sentence instead left the regular Outfit about 1% narrow on real copy,
       and twice as many paragraphs re-wrapped. Overrides = the webfont's
       ascent 0.97 / descent 0.27 (Libre Baskerville) or 1.00 / 0.26
       (Outfit), divided by the size-adjust, so line heights match exactly. */}
  <style is:inline>
    @font-face {
      font-family: 'Libre Baskerville Fallback';
      font-style: normal;
      font-weight: 400;
      src: local('Georgia');
      size-adjust: 115.60%;
      ascent-override: 83.91%;
      descent-override: 23.36%;
      line-gap-override: 0%;
    }
    @font-face {
      font-family: 'Libre Baskerville Fallback';
      font-style: normal;
      font-weight: 700;
      src: local('Georgia Bold'), local('Georgia-Bold');
      size-adjust: 102.00%;
      ascent-override: 95.10%;
      descent-override: 26.47%;
      line-gap-override: 0%;
    }
    @font-face {
      font-family: 'Libre Baskerville Fallback';
      font-style: italic;
      font-weight: 400;
      src: local('Georgia Italic'), local('Georgia-Italic');
      size-adjust: 101.50%;
      ascent-override: 95.57%;
      descent-override: 26.60%;
      line-gap-override: 0%;
    }
    @font-face {
      font-family: 'Libre Baskerville Fallback';
      font-style: italic;
      font-weight: 700;
      src: local('Georgia Bold Italic'), local('Georgia-BoldItalic');
      size-adjust: 88.76%;
      ascent-override: 109.28%;
      descent-override: 30.42%;
      line-gap-override: 0%;
    }
    @font-face {
      font-family: 'Outfit Fallback';
      font-style: normal;
      font-weight: 100 449;
      src: local('Arial'), local('ArialMT');
      size-adjust: 98.90%;
      ascent-override: 101.11%;
      descent-override: 26.29%;
      line-gap-override: 0%;
    }
    @font-face {
      font-family: 'Outfit Fallback';
      font-style: normal;
      font-weight: 450 549;
      src: local('Arial'), local('ArialMT');
      size-adjust: 99.10%;
      ascent-override: 100.91%;
      descent-override: 26.24%;
      line-gap-override: 0%;
    }
    @font-face {
      font-family: 'Outfit Fallback';
      font-style: normal;
      font-weight: 550 649;
      src: local('Arial Bold'), local('Arial-BoldMT');
      size-adjust: 93.55%;
      ascent-override: 106.89%;
      descent-override: 27.79%;
      line-gap-override: 0%;
    }
    @font-face {
      font-family: 'Outfit Fallback';
      font-style: normal;
      font-weight: 650 749;
      src: local('Arial Bold'), local('Arial-BoldMT');
      size-adjust: 95.45%;
      ascent-override: 104.77%;
      descent-override: 27.24%;
      line-gap-override: 0%;
    }
    @font-face {
      font-family: 'Outfit Fallback';
      font-style: normal;
      font-weight: 750 900;
      src: local('Arial Bold'), local('Arial-BoldMT');
      size-adjust: 96.41%;
      ascent-override: 103.72%;
      descent-override: 26.97%;
      line-gap-override: 0%;
    }
    @font-face {
      font-family: 'Libre Baskerville';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('/fonts/libre-baskerville-latin-400-normal.woff2') format('woff2');
    }
    @font-face {
      font-family: 'Libre Baskerville';
      font-style: italic;
      font-weight: 400;
      font-display: swap;
      src: url('/fonts/libre-baskerville-latin-400-italic.woff2') format('woff2');
    }
    @font-face {
      font-family: 'Libre Baskerville';
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url('/fonts/libre-baskerville-latin-700-normal.woff2') format('woff2');
    }
    @font-face {
      font-family: 'Outfit';
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url('/fonts/outfit-latin-variable.woff2') format('woff2');
    }
  </style>

  {/* Client-side router for smooth page navigation */}
  <ClientRouter />

  {/* JSON-LD: Unified @graph with Organization + WebPage + page-specific schemas */}
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

  {/* YouTube posters ask for the HD frame (maxresdefault). Older videos don't
       have one: YouTube answers with a 120×90 gray placeholder, so swap in the
       standard frame (hqdefault, which every video has). It's 4:3 with black
       bars baked in, so it's shown 16:9 and cropped, which trims the bars.
       Capturing listeners here catch every poster on the page, including ones
       set later.
       Broken images marked data-img-fallback recover here too, in place of
       onerror="" attributes (the CSP blocks inline handlers): "next" hides the
       image and shows the placeholder after it; any other value is a selector
       for the box around it to hide. Once the page is parsed, a sweep catches
       any that failed before this ran. */}
  <script is:inline>
    (function(){var re=/i\.ytimg\.com\/vi(_webp)?\/([^/]+)\/maxresdefault\.(jpg|webp)/;function f(e){var i=e.target,s=i&&i.tagName==='IMG'&&(i.currentSrc||i.src),m=s&&re.exec(s);if(!m||(e.type==='load'&&i.naturalWidth>120))return;var p=i.closest('picture');if(p)p.querySelectorAll('source').forEach(function(x){x.remove()});i.style.aspectRatio='16/9';i.style.objectFit='cover';i.src='https://i.ytimg.com/vi/'+m[2]+'/hqdefault.jpg'}function g(i){var v=i.getAttribute('data-img-fallback'),n;if(v==='next'){i.style.display='none';if(n=i.nextElementSibling)n.style.display=''}else if(v&&(n=i.closest(v)))n.style.display='none'}document.addEventListener('load',f,true);document.addEventListener('error',function(e){f(e);var i=e.target;if(i&&i.tagName==='IMG'&&i.hasAttribute('data-img-fallback'))g(i)},true);document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('img[data-img-fallback]').forEach(function(i){if(i.complete&&i.decode)i.decode().catch(function(){if(i.complete&&!i.naturalWidth)g(i)})})})})();
  </script>

  {/* Page-specific head content (preloads, etc.) */}
  <slot name="head" />
</head>
<body class={bodyClass}>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <AuctionBar />
  {/* The top spot is the auction's on its day, the application's the rest of the season */}
  {!auctionIsOpen() && <ApplicationBar />}
  <Header />
  <main id="main-content">
    <slot />
  </main>
  {/* Admin Preview: the admin frames this page with ?admin-preview and swaps
       in unsaved edits here, before any page script starts */}
  <script is:inline>if(/[?&]admin-preview=/.test(location.search)&&window.parent!==window)try{parent.__soardPreview&&parent.__soardPreview(document,window)}catch(e){}</script>
  <Footer />
  <LiveIndicator />
  <ScrollReveal />
  <LqipReveal />
  {/* Register service worker for repeat visitor speed */}
  <script is:inline>
    if('serviceWorker' in navigator){navigator.serviceWorker.register('/sw.js',{scope:'/'}).catch(function(){})}
  </script>
</body>
</html>
